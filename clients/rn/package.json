{
  "name": "wyrdsekai-rn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start": "react-native start",
    "test": "jest",
    "test:e2e:web:smoke": "npx playwright test --config e2e/web/playwright.config.ts --project ct1-smoke",
    "test:e2e:web:flows": "npx playwright test --config e2e/web/playwright.config.ts --project ct2-flows",
    "test:e2e:web:inference": "WYRD_WEBGPU=1 npx playwright test --config e2e/web/playwright.config.ts --project ct3-inference",
    "test:e2e:web": "npx playwright test --config e2e/web/playwright.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@mlc-ai/web-llm": "^0.2.81",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "babel-preset-expo": "~55.0.11",
    "expo": "~55.0.0",
    "expo-camera": "^55.0.19",
    "expo-sqlite": "~55.0.11",
    "js-sha256": "^0.11.0",
    "llama.rn": "^0.11.2",
    "nats.ws": "^1.29.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.83.0",
    "react-native-fs": "^2.20.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.24.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "~0.7.4",
    "wyrd-household-trust": "file:./modules/wyrd-household-trust",
    "wyrd-onnx": "file:./modules/wyrd-onnx",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.58.0",
    "@react-native-community/cli": "^20.1.0",
    "@react-native/babel-preset": "^0.83.0",
    "@react-native/metro-config": "^0.83.0",
    "@react-native/typescript-config": "^0.83.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "moduleNameMapper": {
      "^wyrd-onnx$": "<rootDir>/__mocks__/wyrd-onnx.ts",
      "^react-native$": "<rootDir>/__mocks__/react-native.ts"
    }
  }
}
