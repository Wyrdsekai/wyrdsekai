  "inferenceRouting": {
    "comment": "Per-role backend order. VOICE prefers the device \u2014 the on-device model IS voice-class. DRIVE borrows first because planning and tool emission want the 9B the phone does not have. `local` stays LAST in the drive chain rather than being removed: with nothing to borrow from, the phone is genuinely standalone and a 4B attempting drive beats refusing to think. That is the whole 'standalone attempts drive' rule \u2014 it falls out of the ordering, so there is no mode test to drift. A pin moves one backend to the front and never removes the others, so a pinned-but-unreachable backend degrades instead of failing the request.",
    "cases": [
      {
        "name": "voice prefers the device",
        "role": "voice",
        "available": [
          "local",
          "remote",
          "server"
        ],
        "expectChain": [
          "local",
          "remote",
          "server"
        ],
        "expectServedBy": "local"
      },
      {
        "name": "voice falls through when no model is loaded",
        "role": "voice",
        "available": [
          "remote",
          "server"
        ],
        "expectChain": [
          "local",
          "remote",
          "server"
        ],
        "expectServedBy": "remote"
      },
      {
        "name": "drive borrows first",
        "role": "drive",
        "available": [
          "local",
          "remote",
          "server"
        ],
        "expectChain": [
          "remote",
          "server",
          "local"
        ],
        "expectServedBy": "remote"
      },
      {
        "name": "drive prefers the household over the cloud",
        "role": "drive",
        "available": [
          "remote",
          "server"
        ],
        "expectChain": [
          "remote",
          "server",
          "local"
        ],
        "expectServedBy": "remote"
      },
      {
        "name": "truly standalone: drive attempts the on-device model",
        "role": "drive",
        "available": [
          "local"
        ],
        "expectChain": [
          "remote",
          "server",
          "local"
        ],
        "expectServedBy": "local"
      },
      {
        "name": "nothing configured is an error, not a silent no-op",
        "role": "drive",
        "available": [],
        "expectChain": [
          "remote",
          "server",
          "local"
        ],
        "expectServedBy": null
      },
      {
        "name": "pin moves a backend up without removing the rest",
        "role": "voice",
        "pin": "server",
        "available": [
          "local",
          "server"
        ],
        "expectChain": [
          "server",
          "local",
          "remote"
        ],
        "expectServedBy": "server"
      },
      {
        "name": "pinned-but-unreachable degrades to the next option",
        "role": "voice",
        "pin": "remote",
        "available": [
          "local"
        ],
        "expectChain": [
          "remote",
          "local",
          "server"
        ],
        "expectServedBy": "local"
      }
    ]
  },
  "phoneMode": {
    "comment": "Mode decision from TWO axes: does the phone want its own node, and where does inference come from. 'has a home zone' alone can never decide \u2014 modes 1 and 4 both have one, and assuming otherwise conflates a terminal with a phone that runs its own node. `expectMode: null` means undecided, which must surface as a finish-setup state, never a silent fallback. onDeviceModelViable is the gate on running a model on the device at all, and it is FALSE by default: measured phone throughput for a 4B is around 10 tok/s on a current flagship and 3-6 mid-range, against a reading speed of 7-10, and on iOS a 4B frequently cannot be loaded within the per-app memory limit at all. So the shipped default reaches only modes 1 and 2, where the thinking happens somewhere that can do it well. Today only an explicit user opt-in sets it true (labelled EXPERIMENTAL); when hardware catches up a measurement sets it instead, and none of these cases change shape.",
    "cases": [
      {
        "name": "default: home zone becomes a terminal",
        "onDeviceModelViable": false,
        "wantsOwnNode": true,
        "hasHomeZone": true,
        "hasCloudKey": false,
        "hasOnDeviceModel": false,
        "preferredBacking": "home",
        "expectMode": 1
      },
      {
        "name": "default: home zone, terminal even if a model is downloaded",
        "onDeviceModelViable": false,
        "wantsOwnNode": true,
        "hasHomeZone": true,
        "hasCloudKey": false,
        "hasOnDeviceModel": true,
        "preferredBacking": "home",
        "expectMode": 1
      },
      {
        "name": "default: home zone wins over a cloud key for a terminal user",
        "onDeviceModelViable": false,
        "wantsOwnNode": false,
        "hasHomeZone": true,
        "hasCloudKey": true,
        "hasOnDeviceModel": false,
        "preferredBacking": "home",
        "expectMode": 1
      },
      {
        "name": "default: own node plus a cloud key is mode 2",
        "onDeviceModelViable": false,
        "wantsOwnNode": true,
        "hasHomeZone": false,
        "hasCloudKey": true,
        "hasOnDeviceModel": false,
        "preferredBacking": "home",
        "expectMode": 2
      },
      {
        "name": "default: own node plus a cloud key is mode 2 even with a home zone",
        "onDeviceModelViable": false,
        "wantsOwnNode": true,
        "hasHomeZone": true,
        "hasCloudKey": true,
        "hasOnDeviceModel": false,
        "preferredBacking": "home",
        "expectMode": 2
      },
      {
        "name": "default: cloud key alone is mode 2",
        "onDeviceModelViable": false,
        "wantsOwnNode": false,
        "hasHomeZone": false,
        "hasCloudKey": true,
        "hasOnDeviceModel": false,
        "preferredBacking": "home",
        "expectMode": 2
      },
      {
        "name": "default: nothing configured is undecided, never a local model",
        "onDeviceModelViable": false,
        "wantsOwnNode": true,
        "hasHomeZone": false,
        "hasCloudKey": false,
        "hasOnDeviceModel": true,
        "preferredBacking": "home",
        "expectMode": null
      },
      {
        "name": "experimental: terminal onto the home zone",
        "onDeviceModelViable": true,
        "wantsOwnNode": false,
        "hasHomeZone": true,
        "hasCloudKey": false,
        "hasOnDeviceModel": false,
        "preferredBacking": "home",
        "expectMode": 1
      },
      {
        "name": "experimental: terminal ignores a cloud key",
        "onDeviceModelViable": true,
        "wantsOwnNode": false,
        "hasHomeZone": true,
        "hasCloudKey": true,
        "hasOnDeviceModel": true,
        "preferredBacking": "cloud",
        "expectMode": 1
      },
      {
        "name": "experimental: own node, home GPU behind it",
        "onDeviceModelViable": true,
        "wantsOwnNode": true,
        "hasHomeZone": true,
        "hasCloudKey": false,
        "hasOnDeviceModel": true,
        "preferredBacking": "home",
        "expectMode": 4
      },
      {
        "name": "experimental: own node, cloud behind it",
        "onDeviceModelViable": true,
