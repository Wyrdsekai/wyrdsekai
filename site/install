#!/bin/sh
# wyrdsekai one-line installer — https://wyrdsekai.org/install
#
#   curl -fsSL https://wyrdsekai.org/install | bash
#
# Downloads the latest release artifact for this platform from GitHub
# (WYRDSEKAI_VERSION=0.3.3 installs that release instead), verifies it against
# the release's SHA256SUMS, and installs it. Nothing here is served from
# wyrdsekai.org except this script — artifacts and checksums both come from
# the same GitHub release, so this script cannot substitute a payload the
# checksums don't match.
set -eu

REPO="Wyrdsekai/wyrdsekai"

say() { printf '\033[36m[wyrdsekai]\033[0m %s\n' "$*"; }
die() { printf '\033[31m[wyrdsekai]\033[0m %s\n' "$*" >&2; exit 1; }

VERSION="${WYRDSEKAI_VERSION:-}"
if [ -z "$VERSION" ]; then
    VERSION=$(curl -fsSL -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -1)
    [ -n "$VERSION" ] || die "could not find the latest release. Set WYRDSEKAI_VERSION=0.3.3 and re-run."
fi
say "release $VERSION"
BASE="https://github.com/$REPO/releases/download/v${VERSION}"

OS=$(uname -s)
ARCH=$(uname -m)

case "$OS" in
    Linux)
        [ "$ARCH" = "x86_64" ] || die "Prebuilt Linux packages are x86_64 only (this is $ARCH) — build from source: https://github.com/Wyrdsekai/wyrdsekai#build-from-source"
        if command -v dpkg >/dev/null 2>&1; then
            ART="wyrdsekai_${VERSION}_amd64.deb"
        else
            ART="wyrdsekai-${VERSION}.tar.gz"
        fi
        ;;
    Darwin)
        ART="Wyrdsekai-${VERSION}.pkg"
        ;;
    *)
        die "Unsupported platform: $OS. Windows: download Wyrdsekai-${VERSION}.msi from ${BASE%/download/*}/releases"
        ;;
esac

TMP=$(mktemp -d)
# A failed sudo (or any abort) used to take the 1.5 GB download with it. Keep the
# artifact where the person can find it and re-run; clean up only after success.
_finish() {
    if [ -n "${ART:-}" ] && [ -f "$TMP/$ART" ]; then
        KEEP="${HOME:-/tmp}/Downloads"; mkdir -p "$KEEP" 2>/dev/null || KEEP=/tmp
        if mv "$TMP/$ART" "$KEEP/$ART" 2>/dev/null; then
            say "kept the download at $KEEP/$ART — install it with: sudo dpkg -i \"$KEEP/$ART\" (or the matching installer for .pkg/.tar.gz)"
        fi
    fi
    rm -rf "$TMP"
}
trap _finish EXIT
cd "$TMP"

say "downloading $ART (~1.2-1.7 GB)…"
curl -fL --progress-bar -O "$BASE/$ART"
curl -fsSL -O "$BASE/SHA256SUMS"

say "verifying checksum…"
if command -v sha256sum >/dev/null 2>&1; then
    grep " $ART\$" SHA256SUMS | sha256sum -c - || die "CHECKSUM MISMATCH — refusing to install. Re-run, and if it persists, report it."
else
    grep " $ART\$" SHA256SUMS | shasum -a 256 -c - || die "CHECKSUM MISMATCH — refusing to install. Re-run, and if it persists, report it."
fi

case "$ART" in
    *.deb)
        say "installing (needs sudo)…"
        sudo dpkg -i "$ART" || { sudo apt-get -f install -y && sudo dpkg -i "$ART"; }
        rm -f "$ART"
        say "installed. Next:  wyrd setup"
        ;;
    *.pkg)
        say "installing (needs sudo)…"
        sudo installer -pkg "$ART" -target /
        rm -f "$ART"
        say "installed. Next:  wyrd setup"
        ;;
    *.tar.gz)
        say "no dpkg on this system — unpacking the generic dist to /opt/wyrdsekai (needs sudo)…"
        sudo mkdir -p /opt
        sudo tar -xzf "$ART" -C /opt
        sudo mv /opt/wyrdsekai-${VERSION} /opt/wyrdsekai 2>/dev/null || true
        rm -f "$ART"
        say "unpacked. Next:  sudo /opt/wyrdsekai/bin/wyrd setup"
        ;;
esac

say "verify anytime: the checksums live with the release —"
say "  ${BASE}/SHA256SUMS"
