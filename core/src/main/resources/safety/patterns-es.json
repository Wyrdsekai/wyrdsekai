{
  "locale": "es",
  "version": 1,
  "patterns": [
    {
      "regex": "(?i)(quiero morir|no quiero vivir|me quiero hacer da[ñn]o|quiero desaparecer)",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?i)(me corto|me quemo|cortarme|quemarme)",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?iU)\\bquiero (matarme|suicidarme|quitarme la vida)\\b",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?iU)\\b(m[eé]todos?|formas?|maneras?|modos?|c[oó]mo)\\b.{0,16}?\\b(suicidar(me|se)|matarme|quitar(me|se) la vida|acabar con (mi|la) propia vida|acabar con mi vida|poner fin a (mi|la) (propia )?vida)\\b",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?iU)\\b(m[eé]todos?|formas?|maneras?|modos?)\\s+(\\S+\\s+){0,2}?(de|para)\\s+matarse\\b",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?iU)\\b(m[eé]todos?|formas?|maneras?|modos?|c[oó]mo)\\b.{0,16}?\\bmorir\\s+(sin dolor|sin sufrir)\\b",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?iU)\\b(m[eé]todos?|formas?|maneras?|modos?)\\s+(m[aá]s\\s+)?(indolor[ae]?s?|sin dolor|menos doloros[oa]s?|pac[ií]fic[oa]s?|segur[oa]s?)\\s+(de|para)\\s+morir\\b",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?iU)\\bcu[aá]nt[oa]s?\\b.{0,40}?\\b(para|hacen falta para|se necesitan para|necesito para)\\s+(una\\s+)?sobredosis\\b",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?iU)\\bcu[aá]nt[oa]s?\\s+(pastillas|p[ií]ldoras|comprimidos|tabletas|c[aá]psulas|mg|miligramos|gramos|medicamentos?|paracetamol|ibuprofeno|insulina)\\b.{0,30}?\\b(para|hacen falta para|se necesitan para|necesito para)\\s+(morir|matarme|matarse|suicidarme|suicidarse)\\b",
      "type": "SELF_HARM",
      "severity": "CRISIS"
    },
    {
      "regex": "(?i)((me pega|me golpea|me toca).*(pap[aá]|mam[aá]|padre|madre|t[ií]o|padrastro)|(pap[aá]|mam[aá]|padre|madre|t[ií]o|padrastro).*(me pega|me golpea|me toca))",
      "type": "ABUSE_DISCLOSURE",
      "severity": "CRISIS"
    },
    {
      "regex": "(?i)(alguien|adulto).*(inapropiado|me toc[oó]|me hizo)",
      "type": "ABUSE_DISCLOSURE",
      "severity": "IMMEDIATE"
    },
    {
      "regex": "(?i)(me molestan|me acosan|me pegan en la escuela|los ni[ñn]os me pegan)",
      "type": "BULLYING",
      "severity": "FLAG"
    },
    {
      "regex": "(?i)(nadie me quiere|no sirvo para nada|soy (in[uú]til|tonto|feo))",
      "type": "EXTREME_DISTRESS",
      "severity": "FLAG"
    },
    {
      "regex": "(?i)(persona mayor|adulto|hombre|mujer).*(internet|en l[ií]nea).*(encontrar|fotos|secreto)",
      "type": "ONLINE_EXPLOITATION",
      "severity": "IMMEDIATE"
    }
  ],
  "crisisResources": [
    { "name": "Teléfono de la Esperanza", "contact": "717 003 717", "is24x7": true },
    { "name": "Fundación ANAR (menores)", "contact": "900 20 20 10", "is24x7": true },
    { "name": "Línea de la Vida", "contact": "800-911-2000 (México)", "is24x7": true }
  ]
}
