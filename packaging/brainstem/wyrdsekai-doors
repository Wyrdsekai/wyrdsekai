#!/usr/bin/env bash
# wyrdsekai-doors — the doors as firewall sets. The body's map has doors (the relay, the
# librarian, each federated zone); this shuts one without any inference, by putting its
# addresses into an nftables set that the output chain rejects. Root only; Linux only.
#
#   wyrdsekai-doors close <door> <host|address>...   resolve the names, block the addresses
#   wyrdsekai-doors open <door>                      unblock what that door had
#   wyrdsekai-doors list                             every shut door and its addresses
#
# State: one file per shut door under $WYRDSEKAI_DATA/brainstem/door-sets, so open knows
# what close did. Nothing here survives a reboot: the table is created on demand and lost
# with the kernel, which is the safe direction (a reboot opens every door).
#
# Never the host itself. A door whose address is loopback, link-local or one of this
# host's own addresses is refused: shutting it would cut the server off from its own
# brains and its own health check (the household node lost an hour to exactly that).
# Test hooks: DOORS_NFT (the nft command), DOORS_STATE_DIR, DOORS_OWN_ADDRS.
set -uo pipefail

NFT="${DOORS_NFT:-nft}"
STATE="${DOORS_STATE_DIR:-${WYRDSEKAI_DATA:-/var/lib/wyrdsekai}/brainstem/door-sets}"
TABLE="inet wyrdsekai"

die() { echo "wyrdsekai-doors: $*" >&2; exit 1; }
safe_door() { [[ "$1" =~ ^[A-Za-z0-9_.:-]{1,80}$ ]] || die "not a door name: $1"; }

ensure_table() {
    $NFT list table $TABLE >/dev/null 2>&1 && return 0
    $NFT add table $TABLE || die "could not create the nftables table (is this root, on Linux?)"
    $NFT add set $TABLE closed4 '{ type ipv4_addr; }'
    $NFT add set $TABLE closed6 '{ type ipv6_addr; }'
    $NFT add chain $TABLE output '{ type filter hook output priority 0; policy accept; }'
    $NFT add rule $TABLE output ip daddr @closed4 reject
    $NFT add rule $TABLE output ip6 daddr @closed6 reject
}

resolve() {   # host or address -> addresses, one per line
    local h="$1"
    if [[ "$h" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ || "$h" == *:* && "$h" != *[a-zA-Z-]*:* ]]; then echo "$h"; return 0; fi
    getent ahosts "$h" 2>/dev/null | awk '{print $1}' | sort -u
}

own_addrs() {   # this host's own addresses, one per line
    if [[ -n "${DOORS_OWN_ADDRS:-}" ]]; then tr ' ,' '\n\n' <<<"$DOORS_OWN_ADDRS"; return 0; fi
    ip -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1
}

is_self() {   # an address we must never block
    local a="$1"
    [[ "$a" == 127.* || "$a" == "::1" || "$a" == 0.0.0.0 || "$a" == "::" ]] && return 0
    [[ "$a" == 169.254.* || "$a" == fe80:* || "$a" == fe80::* ]] && return 0
    while read -r o; do [[ -n "$o" && "$a" == "$o" ]] && return 0; done < <(own_addrs)
    return 1
}

case "${1:-}" in
    close)
        door="${2:-}"; [[ -n "$door" ]] || die "close <door> <host|address>..."
        safe_door "$door"; shift 2
        [[ $# -gt 0 ]] || die "close needs at least one host or address"
        addrs=()
        for h in "$@"; do while read -r a; do [[ -n "$a" ]] && addrs+=("$a"); done < <(resolve "$h"); done
        [[ ${#addrs[@]} -gt 0 ]] || die "nothing resolved for: $*"
        for a in "${addrs[@]}"; do is_self "$a" && die "refused: $a is this host; shutting $door would cut the server off from itself"; done
        # The state is written before a single element goes in, so open can always undo close.
        mkdir -p "$STATE" || die "cannot keep door state under $STATE"
        [[ -d "$STATE" && -w "$STATE" ]] || die "cannot keep door state under $STATE (is it a directory?)"
        printf '%s\n' "${addrs[@]}" >> "$STATE/$door" || die "cannot record $door"
        sort -u -o "$STATE/$door" "$STATE/$door"
        ensure_table
        for a in "${addrs[@]}"; do
            if [[ "$a" == *:* ]]; then $NFT add element $TABLE closed6 "{ $a }"; else $NFT add element $TABLE closed4 "{ $a }"; fi
        done
        echo "closed $door: ${addrs[*]}"
        ;;
    open)
        door="${2:-}"; [[ -n "$door" ]] || die "open <door>"
        safe_door "$door"
        [[ -f "$STATE/$door" ]] || { echo "$door was not shut"; exit 0; }
        while read -r a; do
            [[ -n "$a" ]] || continue
            if [[ "$a" == *:* ]]; then $NFT delete element $TABLE closed6 "{ $a }" 2>/dev/null; else $NFT delete element $TABLE closed4 "{ $a }" 2>/dev/null; fi
        done < "$STATE/$door"
        rm -f "$STATE/$door"
        echo "opened $door"
        ;;
    list)
        if [[ -d "$STATE" ]] && ls "$STATE"/* >/dev/null 2>&1; then
            for f in "$STATE"/*; do echo "$(basename "$f"): $(tr '\n' ' ' < "$f")"; done
        else
            echo "every door is open"
        fi
        ;;
    *) die "usage: wyrdsekai-doors close <door> <host|address>... | open <door> | list" ;;
esac
