# Local overrides for Wyrdsekai inference backends.
# Copy to docker-compose.override.yml and customize for your hardware.
#
# Examples below show common configurations. Uncomment and modify as needed.

services:
  # --- Example: SGLang on 16GB GPU with Qwen 4B ---
  # sglang:
  #   environment:
  #     - SGLANG_MODEL=Qwen/Qwen3-4B
  #     - SGLANG_MAX_MODEL_LEN=16384
  #     - SGLANG_GPU_MEM_UTIL=0.92

  # --- Example: vLLM multi-GPU with quantization ---
  # vllm:
  #   deploy:
  #     resources:
  #       reservations:
  #         devices:
  #           - driver: nvidia
  #             device_ids: ["0", "1"]
  #             capabilities: [gpu]
  #   command:
  #     - "vllm"
  #     - "serve"
  #     - "Qwen/Qwen3-30B-A3B"
  #     - "--host"
  #     - "0.0.0.0"
  #     - "--port"
  #     - "8000"
  #     - "--tensor-parallel-size"
  #     - "2"
  #     - "--max-model-len"
  #     - "16384"
  #     - "--gpu-memory-utilization"
  #     - "0.90"
  #     - "--quantization"
  #     - "awq"

  # --- Example: Ollama CPU-only (disable GPU) ---
  # ollama:
  #   deploy: {}

  # --- Example: AMD ROCm GPU (alternative to NVIDIA) ---
  # For AMD, use the separate override file instead:
  #   docker compose -f docker/docker-compose.yml -f docker/docker-compose.rocm.yml up
  # This provides ROCm images, /dev/kfd + /dev/dri device access, and video/render groups.
  placeholder: {}
