# `wyrd cred set|get|list|unset <slot>` — steward credential slots for item
# scripts (external adapters), stored in the zone Safe (credentials.safe,
# 600-mode, encrypted at rest with the node identity key). Shells out to
# CredAdminMain (same server-classpath shape as do_key) so bash never touches
# the key derivation or file format. Values ride stdin (hidden prompt on a
# TTY) — never argv. WYRDSEKAI_DATA_DIR is passed explicitly so the CLI opens
# the SAME safe the running service reads at boot.
do_cred() {
    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
            log "$(_t common.building_server)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    if [[ ! -d "$SERVER_LIB" ]]; then
        err "$(_t common.server_libs_missing_hint "$SERVER_LIB")"
        return 1
    fi
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
    # #29: the safe must be written AS the user the zone runs as (the
    # data-dir owner — world.db's owner when present), else the service
    # can't read its own credentials (root-owned 600 safe ⇒ slots invisible
    # to a server running as operator, and vice versa). When the current user
    # isn't that owner, re-run the JVM under sudo -u <owner>.
    local cred_data_dir cred_owner cred_probe
    cred_data_dir="${WYRDSEKAI_DATA_DIR:-$DATA_DIR}"
    cred_probe="$cred_data_dir/world.db"
    [[ -e "$cred_probe" ]] || cred_probe="$cred_data_dir"
    cred_owner=""
    if [[ -e "$cred_probe" ]]; then
        cred_owner=$(stat -c %U "$cred_probe" 2>/dev/null || stat -f %Su "$cred_probe" 2>/dev/null || true)
    fi
    if [[ -n "$cred_owner" && "$cred_owner" != "$(id -un)" ]] && command -v sudo >/dev/null 2>&1; then
        log "credentials.safe belongs to '$cred_owner' (the zone's service user) — running as them"
        # `env` carries the var through sudo regardless of sudoers SETENV policy.
        sudo -u "$cred_owner" env WYRDSEKAI_DATA_DIR="$cred_data_dir" "$JAVA_CMD" \
            -Djava.net.preferIPv4Stack=true \
            --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
            --add-opens java.base/java.lang=ALL-UNNAMED \
            --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
            -XX:+UseCompactObjectHeaders \
            --enable-native-access=ALL-UNNAMED \
            -cp "$CP" \
            org.wyrdsekai.server.CredAdminMain "$@"
        return $?
    fi
    WYRDSEKAI_DATA_DIR="$cred_data_dir" "$JAVA_CMD" \
        -Djava.net.preferIPv4Stack=true \
        --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
        --add-opens java.base/java.lang=ALL-UNNAMED \
        --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
        -XX:+UseCompactObjectHeaders \
        --enable-native-access=ALL-UNNAMED \
        -cp "$CP" \
        org.wyrdsekai.server.CredAdminMain "$@"
}

