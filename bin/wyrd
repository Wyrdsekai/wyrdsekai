        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    if [[ ! -d "$SERVER_LIB" ]]; then
        err "$(_t common.server_libs_missing_hint "$SERVER_LIB")"
        return 1
    fi
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
    "$JAVA_CMD" \
        -Djava.net.preferIPv4Stack=true \
        --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
        --add-opens java.base/java.lang=ALL-UNNAMED \
        --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
        -XX:+UseCompactObjectHeaders \
        --enable-native-access=ALL-UNNAMED \
        -cp "$CP" \
        org.wyrdsekai.server.BondAdminMain "$@"
}

# ── Relay ──

# Locate the relay docker-compose project dir. Looks at packaged install paths
# first, then the in-tree dev copy. Prints the dir on stdout (empty if none
# found). Used by relay deploy-up + rotate-cert.
_relay_compose_dir() {
    local d
    for d in /opt/wyrdsekai/relay /etc/wyrdsekai/relay "$HOME/.wyrdsekai/relay" \
             "${DATA_DIR:-}/relay" "$PROJECT_ROOT/deploy/relay"; do
        if [[ -n "$d" && -f "$d/docker-compose.yml" ]]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# Best-effort detection of host names + IPs to put in cert SANs.
# Sets globals DETECTED_HOSTS, DETECTED_IPS (comma-separated). Linux-first;
# falls back gracefully on macOS / minimal containers.
_relay_autodetect_hosts_and_ips() {
    DETECTED_HOSTS=""
    DETECTED_IPS=""

    # Hostname forms. `hostname` always works; --all-fqdns is Linux-specific
    # and may return nothing if DNS isn't configured — that's fine.
    local short fqdns
    short=$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo "")
    fqdns=$(hostname --all-fqdns 2>/dev/null | tr ' ' ',' | sed 's/,$//' || echo "")
    # Merge unique, drop empties.
    local hosts="$short"
    if [[ -n "$fqdns" && "$fqdns" != "$short" ]]; then
        hosts="${hosts},${fqdns}"
    fi
    # Also add `<short>.local` as a common LAN mDNS form.
    if [[ -n "$short" && ",$hosts," != *",${short}.local,"* ]]; then
        hosts="${hosts},${short}.local"
    fi
    # Strip leading/trailing commas + dedupe.
    DETECTED_HOSTS=$(echo "$hosts" | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -)

    # IPs: prefer `ip` with interface filtering so we drop Docker bridges
    # (docker0, br-*), VPN/wireguard, virtual ifaces. Fall back to ifconfig
    # then hostname --all-ip-addresses (no per-iface filter available there).
    local ips=""
    if command -v ip >/dev/null 2>&1; then
        # IPv4 only — IPv6 ULAs work as SANs but add a lot of noise for
        # phones that connect by v4. Exclude lo, docker*, br-*, veth*, virbr*,
        # tailscale*, wg*, tun*, tap*, podman*.
        ips=$(ip -4 -o addr show 2>/dev/null \
              | awk '{print $2" "$4}' \
              | awk '$1 !~ /^(lo|docker|br-|veth|virbr|tailscale|wg|tun|tap|podman)/ {print $2}' \
              | cut -d/ -f1 | grep -v '^127\.' | paste -sd, -)
    fi
    if [[ -z "$ips" ]] && command -v ifconfig >/dev/null 2>&1; then
        ips=$(ifconfig 2>/dev/null | awk '/inet /{print $2}' \
              | grep -v '^127\.' | paste -sd, -)
    fi
    if [[ -z "$ips" ]]; then
        ips=$(hostname --all-ip-addresses 2>/dev/null | tr ' ' ',' | sed 's/,$//')
    fi
    DETECTED_IPS=$(echo "${ips:-}" | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -)
}

# Write/refresh RELAY_HOST_NAMES + RELAY_HOST_IPS in <compose_dir>/.env.
# Args: compose_dir hosts_csv ips_csv
# Idempotent: replaces existing keys, preserves any other lines.
_relay_write_compose_env() {
    local compose_dir="$1" hosts="$2" ips="$3"
    local env_file="${compose_dir}/.env"
    local tmp; tmp=$(mktemp "${env_file}.XXXXXX")
    if [[ -f "$env_file" ]]; then
        grep -Ev '^(RELAY_HOST_NAMES|RELAY_HOST_IPS)=' "$env_file" > "$tmp" || true
    fi
    {
        echo "RELAY_HOST_NAMES=${hosts}"
        echo "RELAY_HOST_IPS=${ips}"
    } >> "$tmp"
    mv "$tmp" "$env_file"
    chmod 644 "$env_file"
}

# Ensure compose_dir has RELAY_HOST_NAMES/IPS set in .env. If missing, write
# auto-detected values and log loudly so the operator can spot a wrong guess.
# Returns 0 if .env was already populated, 1 if we had to write new values.
# (Caller may want to surface the difference.)
_relay_ensure_compose_env() {
    local compose_dir="$1"
    local env_file="${compose_dir}/.env"
    if [[ -f "$env_file" ]] \
        && grep -q '^RELAY_HOST_NAMES=' "$env_file" \
        && grep -q '^RELAY_HOST_IPS=' "$env_file"; then
        return 0
    fi
    _relay_autodetect_hosts_and_ips
    if [[ -z "$DETECTED_HOSTS" || -z "$DETECTED_IPS" ]]; then
        err "relay: cannot auto-detect host names or IPs (got hosts='$DETECTED_HOSTS' ips='$DETECTED_IPS')"
        err "  fix: write RELAY_HOST_NAMES + RELAY_HOST_IPS into $env_file manually,"
        err "       then re-run 'wyrd relay rotate-cert' or 'wyrd relay deploy-up'."
        return 2
    fi
    log "relay: $env_file missing or incomplete — writing auto-detected SAN values"
    echo "  RELAY_HOST_NAMES=$DETECTED_HOSTS"
    echo "  RELAY_HOST_IPS=$DETECTED_IPS"
    echo "  (override with: wyrd relay deploy-up --hosts a,b --ips x,y)"
    _relay_write_compose_env "$compose_dir" "$DETECTED_HOSTS" "$DETECTED_IPS"
    return 1
}

# ── Relay multi-homing helpers ─────────
#
# A zone may home on several relays at once. Each "leg" is a tuple of env
# vars: leg 0 uses the legacy *unsuffixed* names (WYRDSEKAI_RELAY_URL, _USER,
# _TOKEN, _FINGERPRINT, _VISIBILITY); legs 2..N use a numeric suffix
# (WYRDSEKAI_RELAY_URL_2, _USER_2, …, then _3, etc). The Java runtime reads
# leg 0 then numbered legs and stops at the first absent numbered URL (no
# gaps). These helpers keep the conf file leg-aware so `relay join` can
# APPEND a leg instead of wiping the whole relay block.

# Print the env-var key for a given leg field + index.
#   _relay_key URL 0  → WYRDSEKAI_RELAY_URL
#   _relay_key URL 2  → WYRDSEKAI_RELAY_URL_2
_relay_key() {
    local field="$1" idx="$2"
    if [[ "$idx" == "0" ]]; then
        printf 'WYRDSEKAI_RELAY_%s' "$field"
    else
        printf 'WYRDSEKAI_RELAY_%s_%s' "$field" "$idx"
    fi
}

# Print the configured leg indexes present in <conffile>, one per line,
# sorted numerically. Leg 0 = an unsuffixed WYRDSEKAI_RELAY_URL line;
# numbered legs = WYRDSEKAI_RELAY_URL_<n>.
_relay_leg_indexes() {
    local conffile="$1"
    [[ -f "$conffile" ]] || return 0
    # The trailing `:` keeps the group's exit status 0 even when no numbered
    # legs exist (grep -oP returns 1) — important under `set -o pipefail` so a
    # caller's `if _relay_leg_indexes | grep -q …` reads the match, not a
    # pipefail false-negative.
    {
        grep -q '^WYRDSEKAI_RELAY_URL=' "$conffile" 2>/dev/null && echo 0
        grep -oP '^WYRDSEKAI_RELAY_URL_\K[0-9]+(?==)' "$conffile" 2>/dev/null
        :
    } | sort -n -u
}

# Print "index<TAB>url" for every configured leg in <conffile>.
_relay_leg_urls() {
    local conffile="$1" idx url key
    [[ -f "$conffile" ]] || return 0
    while IFS= read -r idx; do
        [[ -z "$idx" ]] && continue
        key="$(_relay_key URL "$idx")"
        url=$(grep "^${key}=" "$conffile" 2>/dev/null | head -n1 | cut -d= -f2-)
        printf '%s\t%s\n' "$idx" "$url"
    done < <(_relay_leg_indexes "$conffile")
}

# Print the leg index whose URL matches <url> in <conffile>, or nothing.
_relay_leg_index_for_url() {
    local conffile="$1" want="$2" idx url
    while IFS=$'\t' read -r idx url; do
        if [[ "$url" == "$want" ]]; then
            printf '%s\n' "$idx"
            return 0
        fi
    done < <(_relay_leg_urls "$conffile")
    return 0
}

# Print the lowest free leg index for a NEW leg in <conffile>. If leg 0 is
# absent → 0. Otherwise the lowest unused numbered slot starting at 2 (the
# numbering scheme skips 1 by spec — numbered legs begin at _2).
_relay_next_leg_index() {
    local conffile="$1"
    if ! _relay_leg_indexes "$conffile" | grep -q '^0$'; then
        echo 0
        return 0
    fi
    local n=2
    while _relay_leg_indexes "$conffile" | grep -q "^${n}$"; do
        n=$((n + 1))
    done
    echo "$n"
}

# Strip every env line belonging to one leg from <conffile> (in place).
#   _relay_strip_leg <conffile> <index>
_relay_strip_leg() {
    local conffile="$1" idx="$2"
    [[ -f "$conffile" ]] || return 0
    local pat
    if [[ "$idx" == "0" ]]; then
        # Leg 0 = unsuffixed field names (URL/USER/TOKEN/FINGERPRINT/
        # VISIBILITY/REGISTRATION_URL) but NOT the numbered legs and NOT
        # the shared WYRDSEKAI_RELAY_ENABLED toggle.
        pat='^WYRDSEKAI_RELAY_(URL|USER|TOKEN|FINGERPRINT|VISIBILITY|REGISTRATION_URL)='
    else
        pat="^WYRDSEKAI_RELAY_(URL|USER|TOKEN|FINGERPRINT|VISIBILITY|REGISTRATION_URL)_${idx}="
    fi
    local tmp; tmp=$(mktemp "${conffile}.XXXXXX") || return 1
    grep -Ev "$pat" "$conffile" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$conffile"
}

# Write (or replace) one leg's fields in <conffile>.
#   _relay_write_leg <conffile> <index> <url> <user> <token> <fp> <visibility> [reg_url]
# index 0 → unsuffixed names; index>=2 → _<index> suffix. Existing lines for
# that leg are stripped first so this is idempotent. Empty fields are skipped
# (no blank-valued lines written). Always ensures WYRDSEKAI_RELAY_ENABLED=true.
_relay_write_leg() {
    local conffile="$1" idx="$2" url="$3" user="$4" token="$5" fp="$6" vis="$7" reg="${8:-}"
    [[ -f "$conffile" ]] || : > "$conffile"
    # Remove any prior copy of this leg.
    _relay_strip_leg "$conffile" "$idx"
    # Ensure the shared enable toggle is present + true (replace if stale).
    local tmp; tmp=$(mktemp "${conffile}.XXXXXX") || return 1
    grep -Ev '^WYRDSEKAI_RELAY_ENABLED=' "$conffile" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$conffile"
    {
        echo "WYRDSEKAI_RELAY_ENABLED=true"
        echo "$(_relay_key URL "$idx")=${url}"
        [[ -n "$user"  ]] && echo "$(_relay_key USER "$idx")=${user}"
        [[ -n "$token" ]] && echo "$(_relay_key TOKEN "$idx")=${token}"
        [[ -n "$fp"    ]] && echo "$(_relay_key FINGERPRINT "$idx")=${fp}"
        [[ -n "$vis"   ]] && echo "$(_relay_key VISIBILITY "$idx")=${vis}"
        [[ -n "$reg"   ]] && echo "$(_relay_key REGISTRATION_URL "$idx")=${reg}"
    } >> "$conffile"
}

# Read the zone privacy floor from a conf file (default "private").
#   _relay_privacy_floor <conffile>
_relay_privacy_floor() {
    local conffile="$1" v=""
    if [[ -n "${WYRDSEKAI_ZONE_PRIVACY_FLOOR:-}" ]]; then
        v="$WYRDSEKAI_ZONE_PRIVACY_FLOOR"
    elif [[ -f "$conffile" ]]; then
        v=$(grep '^WYRDSEKAI_ZONE_PRIVACY_FLOOR=' "$conffile" 2>/dev/null | head -n1 | cut -d= -f2-)
    fi
    printf '%s\n' "${v:-private}"
}

# Guard: refuse to write a PUBLIC leg under a PRIVATE floor unless the
# operator opted in. Args: <conffile> <visibility> <allow_public_leg bool>
# Returns 0 if the leg is allowed, 1 (with an error printed) if it breaches
# the privacy floor. (.)
_relay_check_public_leg() {
    local conffile="$1" vis="$2" allow="$3"
    local floor; floor="$(_relay_privacy_floor "$conffile")"
    if [[ "$vis" == "public" && "$floor" == "private" && "$allow" != "true" ]]; then
        err "Refusing to add a PUBLIC relay leg to a zone whose privacy floor is PRIVATE."
        err "  Homing a private zone on a public relay would breach the privacy floor"
        err "  (a private zone must never leak onto a public relay)."
        err "  To proceed anyway, pass --allow-public-leg, or raise the floor with"
        err "  WYRDSEKAI_ZONE_PRIVACY_FLOOR=public."
        return 1
    fi
    return 0
}

# Decide which conf files we dual-write relay legs into. Always $ENV_FILE;
# also /etc/wyrdsekai/wyrdsekai.conf when it exists and is writable (installed
# nodes). Prints one path per line.
_relay_write_targets() {
    printf '%s\n' "$ENV_FILE"
    if [[ -f /etc/wyrdsekai/wyrdsekai.conf ]] \
       && { [[ -w /etc/wyrdsekai/wyrdsekai.conf ]] || [[ "${EUID:-0}" -eq 0 ]]; }; then
        printf '%s\n' /etc/wyrdsekai/wyrdsekai.conf
    fi
}

# Read one field of a leg from <conffile>.
#   _relay_leg_field <conffile> <field> <index>
_relay_leg_field() {
    local conffile="$1" field="$2" idx="$3" key
    key="$(_relay_key "$field" "$idx")"
    [[ -f "$conffile" ]] || return 0
    grep "^${key}=" "$conffile" 2>/dev/null | head -n1 | cut -d= -f2-
}

# Remove the leg whose URL matches <url> from <conffile>, then COMPACT so the
# Java reader (leg 0 then _2.._N, stop at first gap) sees no hole:
#   - if leg 0 was removed, the lowest remaining numbered leg is promoted to 0
#   - remaining numbered legs are renumbered to a dense 2,3,4… sequence
# Returns 0 if a leg was removed, 1 if no leg matched that URL.
_relay_remove_leg_by_url() {
    local conffile="$1" want="$2"
    [[ -f "$conffile" ]] || return 1
    local match_idx; match_idx="$(_relay_leg_index_for_url "$conffile" "$want")"
    [[ -z "$match_idx" ]] && return 1

    # Snapshot every surviving leg's fields (in current index order) BEFORE we
    # mutate the file, then re-emit them densely.
    local survivors=() idx u
    while IFS=$'\t' read -r idx u; do
        [[ "$idx" == "$match_idx" ]] && continue
        survivors+=("$idx")
    done < <(_relay_leg_urls "$conffile")

    # Capture each survivor's fields keyed by old index.
    local url user token fp vis reg
    declare -A S_URL S_USER S_TOKEN S_FP S_VIS S_REG
    for idx in "${survivors[@]}"; do
        S_URL[$idx]="$(_relay_leg_field "$conffile" URL "$idx")"
        S_USER[$idx]="$(_relay_leg_field "$conffile" USER "$idx")"
        S_TOKEN[$idx]="$(_relay_leg_field "$conffile" TOKEN "$idx")"
        S_FP[$idx]="$(_relay_leg_field "$conffile" FINGERPRINT "$idx")"
        S_VIS[$idx]="$(_relay_leg_field "$conffile" VISIBILITY "$idx")"
        S_REG[$idx]="$(_relay_leg_field "$conffile" REGISTRATION_URL "$idx")"
    done

    # Wipe ALL legs (matched + survivors), preserving WYRDSEKAI_RELAY_ENABLED
    # and any non-leg WYRDSEKAI_RELAY_* (e.g. floor lives under its own key).
    local i
    while IFS= read -r i; do
        [[ -n "$i" ]] && _relay_strip_leg "$conffile" "$i"
    done < <(_relay_leg_indexes "$conffile")

    # Re-emit survivors densely: first → leg 0, rest → 2,3,4…
    if [[ ${#survivors[@]} -eq 0 ]]; then
        # No legs left → drop the enable toggle so the node stops connecting.
        local tmp; tmp=$(mktemp "${conffile}.XXXXXX") || return 0
        grep -Ev '^WYRDSEKAI_RELAY_ENABLED=' "$conffile" > "$tmp" 2>/dev/null || true
        mv "$tmp" "$conffile"
        return 0
    fi
    local newidx=0
    for idx in "${survivors[@]}"; do
        _relay_write_leg "$conffile" "$newidx" \
            "${S_URL[$idx]}" "${S_USER[$idx]}" "${S_TOKEN[$idx]}" \
            "${S_FP[$idx]}" "${S_VIS[$idx]}" "${S_REG[$idx]}"
        if [[ "$newidx" == "0" ]]; then newidx=2; else newidx=$((newidx + 1)); fi
    done
    return 0
}

# Add a relay leg across all write targets (append-not-wipe). This is the
# shared core behind `relay join` / `register` / `setup`.
#   _relay_add_leg <url> <user> <token> <fp> <visibility> <reg_url> <replace> <allow_public>
# Honors:
#   - replace=true → wipe ALL legs and write this as leg 0 (clean reset).
#   - else if URL already configured → update that leg in place (idempotent).
#   - else if leg 0 absent → write leg 0; else next free numbered slot.
# Refuses a public leg under a private floor unless allow_public=true.
# Prints the leg index written. Returns 1 on a privacy-floor refusal.
_relay_add_leg() {
    local url="$1" user="$2" token="$3" fp="$4" vis="$5" reg="$6" replace="$7" allow_public="$8"
    [[ -z "$vis" ]] && vis="private"
    mkdir -p "$DATA_DIR"
    [[ -f "$ENV_FILE" ]] || : > "$ENV_FILE"

    # Privacy-floor guard checks against the user env file's floor (the one
    # the source-mode service reads); /etc is a superset, same floor default.
    if ! _relay_check_public_leg "$ENV_FILE" "$vis" "$allow_public"; then
        return 1
    fi

    local target written_idx=""
    while IFS= read -r target; do
        [[ -z "$target" ]] && continue
        local idx
        if [[ "$replace" == "true" ]]; then
            # Clean reset: strip every relay leg, write this as leg 0.
            local i
            while IFS= read -r i; do
                [[ -n "$i" ]] && _relay_strip_leg "$target" "$i"
            done < <(_relay_leg_indexes "$target")
            idx=0
        else
            idx="$(_relay_leg_index_for_url "$target" "$url")"
            if [[ -z "$idx" ]]; then
                idx="$(_relay_next_leg_index "$target")"
            fi
        fi
        _relay_write_leg "$target" "$idx" "$url" "$user" "$token" "$fp" "$vis" "$reg"
        written_idx="$idx"
    done < <(_relay_write_targets)
    printf '%s\n' "$written_idx"
    return 0
}

# ── wyrd phone — phone-device pairing ─────────────
# `wyrd phone invite` asks the relay this zone is registered with to mint
# a phone connection invite (NKey-signed request — only a registered zone
# can mint), then renders it as a QR code the mobile app scans. The
# invite payload carries an ORDERED relay list (failover-ready) plus the
# fingerprint pins the app's TOFU flow needs on self-signed relays.

# Render a QR code for $1 on the terminal. Tries qrencode, then the system
# python3 `qrcode` package, then the BUNDLED dependency-free renderer
# (scripts/lib/wyrd_qr.py) — which ships with every install, so a fresh box
# with only python3 ALWAYS gets a QR (no more "install qrencode" wall-of-URL).
# Returns 1 only if python3 itself is missing (caller prints the URL anyway).
_render_qr() {
    local data="$1"
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t ANSIUTF8 -m 1 "$data" 2>/dev/null && return 0
    fi
    if python3 -c "import qrcode" 2>/dev/null; then
        python3 - "$data" <<'PYQREOF' && return 0
import sys, qrcode
qr = qrcode.QRCode(border=1)
qr.add_data(sys.argv[1])
qr.make(fit=True)
qr.print_ascii(invert=True)
PYQREOF
    fi
    # Bundled fallback — search the same script locations as i18n catalogs.
    local qr
    for qr in "$PROJECT_ROOT/scripts/lib/wyrd_qr.py" \
              "/usr/local/wyrdsekai/scripts/lib/wyrd_qr.py" \
              "/opt/wyrdsekai/scripts/lib/wyrd_qr.py"; do
        if [[ -f "$qr" ]] && command -v python3 >/dev/null 2>&1; then
            python3 "$qr" "$data" 2>/dev/null && return 0
        fi
    done
    return 1
}

# Resolve THIS zone's label (for stamping into a phone invite so the phone
# pins this exact zone instead of racing discovery across every homed zone).
# env → system conf → ~/.wyrdsekai/profile.toml [node] zone. Empty if unknown.
_local_zone_id() {
    if [[ -n "${WYRDSEKAI_ZONE_ID:-}" ]]; then
        printf '%s' "$WYRDSEKAI_ZONE_ID"; return 0
    fi
    local v
    v=$(grep -m1 '^WYRDSEKAI_ZONE_ID=' "$CONFIG_FILE" 2>/dev/null | cut -d= -f2- | tr -d '"')
    if [[ -n "$v" ]]; then printf '%s' "$v"; return 0; fi
    # profile.toml: `zone = "home-server"` (under [node]).
    v=$(grep -m1 '^[[:space:]]*zone[[:space:]]*=' "${HOME}/.wyrdsekai/profile.toml" 2>/dev/null \
        | sed -E 's/^[^=]*=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/')
    if [[ -n "$v" ]]; then printf '%s' "$v"; return 0; fi
    # Last resort — ASK THE RUNNING SERVER. The zone id is a DETERMINISTIC
    # hostname-derived name resolved inside the JVM (WyrdConfig.zoneId →
    # ZoneNameGenerator.bundleForSeed(hostname)); on a normal node it is set in NO
    # env/conf/profile file, so every check above returns empty. That made
    # `wyrd phone invite` stamp zone_id="unspecified", which SILENTLY broke the
    # app's relay login — the phone can't bank a zone with no id, so it fell to
    # local mode with no error (found live 2026-07-16). The server publishes the
    # resolved label at /.well-known/wyrd-zone as `zoneLabel`.
    v=$(curl -sf --max-time 3 "http://localhost:${PORT:-7070}/.well-known/wyrd-zone" 2>/dev/null \
        | python3 -c "import sys,json; print(json.load(sys.stdin).get('zoneLabel',''))" 2>/dev/null)
    printf '%s' "$v"
}

# Stamp the local zone label into a wyrdphone:// invite's (unsigned base64url
# JSON) payload, replacing an "unspecified" zone_id. The relay mints the invite
# from its registration record, which carries no zone label, so the phone would
# otherwise null the zone and fall back to racy `wyrd.discover.zone` (answered by
# EVERY homed zone). Stamping here pins the zone for BOTH the QR and the URL.
_stamp_invite_zone() {
    local url="$1" zone="$2"
    [[ -z "$zone" ]] && { printf '%s' "$url"; return 0; }
    python3 - "$url" "$zone" <<'PY' 2>/dev/null || printf '%s' "$url"
import sys, base64, json
url, zone = sys.argv[1], sys.argv[2]
scheme = "wyrdphone://"
if not url.startswith(scheme):
    print(url); sys.exit(0)
rest = url[len(scheme):]
host, b64 = rest.split("/", 1)
def dec(s): return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))
try:
    payload = json.loads(dec(b64).decode())
except Exception:
    print(url); sys.exit(0)
# Only stamp when the relay left it unset — never override an explicit zone.
if payload.get("zone_id") in (None, "", "unspecified"):
    payload["zone_id"] = zone
nb = base64.urlsafe_b64encode(
    json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
).decode().rstrip("=")
print(f"{scheme}{host}/{nb}")
PY
}

# Return 0 (true) if a wyrdphone:// invite's zone_id is missing/unspecified
# (or the payload can't be parsed) — i.e. the invite is unroutable and the phone
# would silently fall back to local mode. Return 1 when a real zone is present.
# Used as the final gate before we ever print an invite (Tier-1 mint guard).
_invite_zone_is_unspecified() {
    python3 - "$1" <<'PY' 2>/dev/null
import sys, base64, json
url = sys.argv[1]
scheme = "wyrdphone://"
if not url.startswith(scheme):
    sys.exit(0)  # not a phone invite → can't verify a zone → treat as unroutable
try:
    b64 = url[len(scheme):].split("/", 1)[1]
    payload = json.loads(base64.urlsafe_b64decode(b64 + "=" * (-len(b64) % 4)).decode())
except Exception:
    sys.exit(0)  # unparseable → unroutable
zid = payload.get("zone_id")
sys.exit(1 if zid not in (None, "", "unspecified") else 0)
PY
}

do_phone() {
    local subcmd="${1:-help}"
    case "$subcmd" in
        invite)
            shift
            # Friendlier flag names than the underlying relay-nkey verb.
            local fwd=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --relay)       fwd+=(--registration-url "${2:-}"); shift 2 ;;
                    --fingerprint) fwd+=(--fingerprint "${2:-}"); shift 2 ;;
                    *) shift ;;
                esac
            done
            local resp
            resp=$(do_relay phone-invite ${fwd[@]+"${fwd[@]}"}) || {
                err "$(_t phone.invite.failed)"
                return 1
            }
            # The relay's JSON is the line starting with '{' (the nkey
            # plumbing may log a conf-target line above it).
            local json invite_url
            json=$(printf '%s\n' "$resp" | grep -m1 '^{' || true)
            invite_url=$(printf '%s' "$json" | python3 -c \
                "import sys,json; print(json.load(sys.stdin).get('invite_url',''))" 2>/dev/null)
            if [[ -z "$invite_url" ]]; then
                err "$(_t phone.invite.no_url)"
                printf '%s\n' "$resp"
                return 1
            fi
            # Pin THIS zone into the invite so the phone reaches us directly
            # instead of racing discovery across every homed zone (the relay
            # mints it "unspecified"). Applies to both the QR and the URL below.
            #
            # Tier-1 mint guard: REFUSE to emit a zone-less invite. Without a zone
            # id the phone can't bank the zone, so it silently drops to local mode
            # with NO error (found live 2026-07-16) — the single nastiest failure
            # here. Fail loudly at the source rather than ship an unroutable invite.
            local _zone
            _zone=$(_local_zone_id)
            if [[ -z "$_zone" ]]; then
                err "$(_t phone.invite.no_zone)"
                return 1
            fi
            invite_url=$(_stamp_invite_zone "$invite_url" "$_zone")
            # Belt-and-suspenders: if the stamp didn't take (unparseable payload,
            # etc.) the invite is STILL unroutable — verify before we print it.
            if _invite_zone_is_unspecified "$invite_url"; then
                err "$(_t phone.invite.no_zone)"
                return 1
            fi
            echo ""
            log "$(_t phone.invite.scan)"
            echo ""
            if ! _render_qr "$invite_url"; then
                warn "$(_t phone.invite.no_qr_tool)"
            fi
            echo ""
            echo "  $invite_url"
            echo ""
            echo "$(_t phone.invite.paste_hint)"
            ;;
        help|*)
            echo "$(_t phone.help.title)"
            echo ""
            echo "$(_t phone.help.cmd_invite)"
            echo "$(_t phone.help.flag_relay)"
            echo "$(_t phone.help.flag_fingerprint)"
            ;;
    esac
}

# `wyrd join <host[:port]> --household-key <key>`.
# Auto-add THIS node to a hub's home zone using the hub's pre-shared household
# key. Delegates to RelayNkeyAdminMain so every platform shares the crypto /
# HTTP / JDBC enrollment path (no bash reimplementation).
do_join() {
    # Resolve server classpath (same logic do_naming_admin / do_start use).
    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
            log "$(_t common.building_server)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    if [[ ! -d "$SERVER_LIB" ]]; then
        err "$(_t common.server_libs_missing "$SERVER_LIB")"
        return 1
    fi
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
    # The enrollment persists conf where the SERVICE reads it. Source mode uses
    # $ENV_FILE (bin/wyrd source-loads it); installed nodes use the system conf
    # when writable, else the home env (same heuristic as `wyrd relay`).
    local join_conf_target="$ENV_FILE"
    if [[ -f /etc/wyrdsekai/wyrdsekai.conf ]] \
       && { [[ -w /etc/wyrdsekai/wyrdsekai.conf ]] || [[ "${EUID:-0}" -eq 0 ]]; }; then
        join_conf_target=/etc/wyrdsekai/wyrdsekai.conf
    fi
    WYRDSEKAI_CONF="$join_conf_target" "$JAVA_CMD" \
        -Djava.net.preferIPv4Stack=true \
        --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
        --add-opens java.base/java.lang=ALL-UNNAMED \
        --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
        -XX:+UseCompactObjectHeaders \
        --enable-native-access=ALL-UNNAMED \
        -cp "$CP" \
        org.wyrdsekai.server.RelayNkeyAdminMain household-join "$@"
}

# `wyrd household key` (on the hub) prints the active household key, generating
# one if none exists yet — the key a peer hands to `wyrd join`.
do_household() {
    local subcmd="${1:-help}"
    case "$subcmd" in
        key)
            local api="http://127.0.0.1:${PORT}"
            local resp
            resp=$(curl -sf "${api}/api/pair/household-key" 2>/dev/null)
            if [[ -z "$resp" ]]; then
                # 404 (no key yet) → generate one.
                resp=$(curl -sf -X POST "${api}/api/pair/household-key/generate" 2>/dev/null)
            fi
            if [[ -z "$resp" ]]; then
                err "Could not reach the local server on ${api} — is the zone running?"
                return 1
            fi
            local k
            k=$(printf '%s' "$resp" | python3 -c \
                "import sys,json; print(json.load(sys.stdin).get('key',''))" 2>/dev/null)
            if [[ -z "$k" ]]; then
                err "No household key in server response: $resp"
                return 1
            fi
            echo "$k"
            ;;
        join)
            shift
            do_join "$@"
            ;;
        audit)
            # W4 — GET /api/household/audit consumer (any authenticated user).
            shift || true
            local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
            local limit="50"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --limit) limit="${2:-50}"; shift 2 || break ;;
                    *) shift ;;
                esac
            done
            local token; token=$(wyrd_session_token)
            [[ -z "$token" ]] && { err "$(_t household.audit.needs_token)"; return 1; }
            local resp
            resp=$(curl -sf -H "Authorization: Bearer $token" \
                "$api/api/household/audit?limit=$limit" 2>&1) \
                || { err "$(_t household.audit.failed "$api")"; return 1; }
            local t_header t_empty t_row
            t_header=$(_t household.audit.header)
            t_empty=$(_t household.audit.empty)
            t_row=$(_t household.audit.row)
            T_HEADER="$t_header" T_EMPTY="$t_empty" T_ROW="$t_row" python3 -c '
import sys, json, os, datetime
entries = json.load(sys.stdin)
if not entries:
    print(os.environ["T_EMPTY"])
    sys.exit(0)
print(os.environ["T_HEADER"].replace("{0}", str(len(entries))))
for e in entries:
    ts = e.get("timestamp", 0)
    try:
        when = datetime.datetime.fromtimestamp(int(ts) / (1000 if int(ts) > 10**11 else 1)).strftime("%Y-%m-%d %H:%M")
    except Exception:
        when = str(ts)
    row = os.environ["T_ROW"]
    row = row.replace("{0}", when)
    row = row.replace("{1}", str(e.get("type", "?")))
    row = row.replace("{2}", str(e.get("actorName") or e.get("actorDid") or "?"))
    row = row.replace("{3}", str(e.get("description") or ""))
    print(row)
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        help|*)
            echo "Usage:"
            echo "  wyrd household key"
            echo "       Print this hub's active household key (generates one if none)."
            echo "  wyrd household audit [--limit <n>]"
            echo '       Recent household audit log (requires wyrd login).'
            echo "  wyrd join <host[:port]> --household-key <key>"
            echo "       Auto-add this node to the hub's home zone (run on the joining node)."
            ;;
    esac
}

do_relay() {
    local subcmd="${1:-help}"
    case "$subcmd" in
        setup)
            # `setup` APPENDS a leg by default
            # (multi-homing). Flags: --replace (clean reset to leg 0),
            # --visibility private|public (default private), --allow-public-leg.
            local s_replace="false" s_visibility="private" s_allow_public="false"
            shift || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --replace)          s_replace="true"; shift;;
                    --visibility)       s_visibility="${2:-private}"; shift 2;;
                    --visibility=*)     s_visibility="${1#--visibility=}"; shift;;
                    --allow-public-leg) s_allow_public="true"; shift;;
                    *) shift;;
                esac
            done
            echo ""
            log "$(_t relay.setup.title)"
            echo ""
            echo "$(_t relay.setup.intro_1)"
            echo "$(_t relay.setup.intro_2)"
            echo ""

            # Read relay URL
            local current_url="${WYRDSEKAI_RELAY_URL:-}"
            if [[ -n "$current_url" ]]; then
                echo "$(_t relay.setup.current_url "$current_url")"
            fi
            read -rp "$(_t relay.setup.prompt_url)" relay_url
            if [[ -z "$relay_url" ]]; then
                echo "$(_t relay.setup.cancel_no_url)"
                return 1
            fi

            # Read relay token
            local current_token="${WYRDSEKAI_RELAY_TOKEN:-}"
            if [[ -n "$current_token" ]]; then
                echo "$(_t relay.setup.current_token "${current_token:0:8}")"
            fi
            read -rp "$(_t relay.setup.prompt_token)" relay_token
            if [[ -z "$relay_token" ]]; then
                echo "$(_t relay.setup.cancel_no_token)"
                return 1
            fi

            # Append (or replace) the leg across env + system conf. Refuses a
            # public leg under a private floor unless --allow-public-leg.
            local s_idx
            s_idx=$(_relay_add_leg "$relay_url" "" "$relay_token" "" \
                        "$s_visibility" "" "$s_replace" "$s_allow_public") || return 1
            if [[ "$s_idx" == "0" ]]; then
                log "Relay configured as leg 0."
            else
                log "Relay appended as leg $s_idx (multi-homing; existing legs kept)."
            fi

            log "$(_t relay.setup.configured)"
            echo "$(_t relay.setup.cmd_restart)"
            echo ""
            echo "$(_t relay.setup.discovery_hint)"

            # Anti-centralization nudge. Skip in non-interactive contexts (CI,
            # scripts). The hint is one-shot; users who already run their own
            # relay won't see it again.
            if [[ -t 0 && -t 1 ]]; then
                echo ""
                echo "Tip: you're now depending on $relay_url. If that operator goes"
                echo "  down, your federated messages stop. To run your own household"
                echo "  relay (so others can also depend on yours, and you depend on"
                echo "  nobody): wyrd relay deploy-up"
                echo "  See docs/RELAY.md for what a relay does and how to run one."
            fi
            ;;

        status)
            echo ""
            if [[ "${WYRDSEKAI_RELAY_ENABLED:-false}" == "true" ]]; then
                log "$(_t relay.status.enabled)"
                echo "$(_t relay.status.url_label "${WYRDSEKAI_RELAY_URL:-$(_t relay.status.url_unset)}")"
                echo "$(_t relay.status.token_label "${WYRDSEKAI_RELAY_TOKEN:+${WYRDSEKAI_RELAY_TOKEN:0:8}...}")"
                echo ""
                # Test connectivity
                if [[ -n "${WYRDSEKAI_RELAY_URL:-}" ]]; then
                    local relay_host
                    relay_host=$(echo "$WYRDSEKAI_RELAY_URL" | sed 's|nats://||;s|:.*||')
                    local relay_port
                    relay_port=$(echo "$WYRDSEKAI_RELAY_URL" | grep -oP ':\K[0-9]+$' || echo "4222")
                    if timeout 3 bash -c "echo >/dev/tcp/$relay_host/$relay_port" 2>/dev/null; then
                        echo -e "$(_t relay.status.connectivity_reachable)"
                    else
                        echo -e "$(_t relay.status.connectivity_unreachable "$relay_host" "$relay_port")"
                    fi
                fi
                # SSH-over-relay: surface the HOW-TO-CONNECT story, not just a
                # flag. Before this (2026-07-30), the assigned port lived only
                # in the ssh-enable output and the conf — status was the
                # obvious place to look and said nothing.
                if [[ "${WYRDSEKAI_SSH_TUNNEL_ENABLED:-false}" == "true" ]]; then
                    local _st_host="${WYRDSEKAI_SSH_TUNNEL_RELAY_HOST:-?}"
                    local _st_cport="${WYRDSEKAI_SSH_TUNNEL_RELAY_PORT:-2222}"
                    local _st_rport="${WYRDSEKAI_SSH_TUNNEL_REMOTE_PORT:-?}"
                    local _st_topo="${WYRDSEKAI_SSH_TUNNEL_TOPOLOGY:-port}"
                    echo ""
                    echo "  SSH-over-relay: enabled (topology: $_st_topo, your port: $_st_rport)"
                    if [[ "$_st_topo" == "jump" ]]; then
                        echo "    Connect with:"
                        echo "      ssh -J wyrd-tunnel@${_st_host}:${_st_cport} -p ${_st_rport} <your-zone-account>@127.0.0.1"
                        echo "    (or use the ~/.ssh/config stanza 'wyrd relay ssh-enable' printed:"
                        echo "     it makes this just: ssh wyrd-${_st_host})"
                    else
                        echo "    Connect with:  ssh -p ${_st_rport} <your-zone-account>@${_st_host}"
                    fi
                    local _st_pidf="$DATA_DIR/ssh-tunnel.pid"
                    if [[ -f "$_st_pidf" ]] && kill -0 "$(cat "$_st_pidf" 2>/dev/null)" 2>/dev/null; then
                        echo "    Tunnel: up"
                    else
                        echo "    Tunnel: NOT running — 'wyrd restart' (or 'wyrd relay ssh-enable' again) brings it up"
                    fi
                fi
            else
                log "$(_t relay.status.disabled)"
                echo ""
                echo "$(_t relay.status.setup_hint)"
            fi
            ;;

        disable)
            if [[ -f "$ENV_FILE" ]]; then
                sed -i.bak 's/^WYRDSEKAI_RELAY_ENABLED=.*/WYRDSEKAI_RELAY_ENABLED=false/' "$ENV_FILE"
                rm -f "${ENV_FILE}.bak"
                log "$(_t relay.disable.disabled)"
            else
                echo "$(_t relay.disable.no_config)"
            fi
            ;;

        invite)
            # Mint an invite URL on the relay host.
            # Steward shares the URL out-of-band with the joining node operator,
            # who pastes it into `wyrd relay register <url>`.
            local ttl="${2:-3600}"
            # Locate registration container (compose default name).
            local reg_container=""
            for candidate in relay-registration-1 relay_registration_1 wyrd-relay-registration-1; do
                if docker inspect "$candidate" >/dev/null 2>&1; then
                    reg_container="$candidate"
                    break
                fi
            done
            if [[ -z "$reg_container" ]]; then
                err "$(_t relay.invite.no_container)"
                echo "$(_t relay.invite.no_container_hint_1)"
                echo "$(_t relay.invite.no_container_hint_2)"
                return 1
            fi
            local result
            result=$(docker exec "$reg_container" wget -qO- \
                --post-data="{\"ttl\":${ttl}}" \
                --header="Content-Type: application/json" \
                "http://127.0.0.1:9280/invite" 2>/dev/null) || true
            if [[ -z "$result" ]]; then
                err "$(_t relay.invite.mint_failed)"
                return 1
            fi
            local invite_url fp expires
            invite_url=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('invite_url',''))" 2>/dev/null)
            fp=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('fingerprint',''))" 2>/dev/null)
            expires=$(echo "$result" | python3 -c "import sys,json,datetime; e=json.load(sys.stdin).get('expires_at'); print(datetime.datetime.fromtimestamp(e).isoformat() if e else '')" 2>/dev/null)
            if [[ -z "$invite_url" ]]; then
                err "$(_t relay.invite.malformed_response "$result")"
                return 1
            fi
            echo ""
            log "$(_t relay.invite.minted "$expires")"
            echo ""
            echo "  ${GREEN}${invite_url}${NC}"
            echo ""
            echo "$(_t relay.invite.fingerprint_label "$fp")"
            echo ""
            echo "$(_t relay.invite.share_1)"
            echo "$(_t relay.invite.share_2)"
            echo "$(_t relay.invite.share_cmd "$invite_url")"
            ;;

        join)
            # `wyrd relay join <token-or-host> [code]`.
            # Primary form: the wyrdjoin:// token relay.sh prints —
            # wyrdjoin://host:port/<code>.<ca_fp_hex> — which carries the
            # relay's CA fingerprint, so the redeemed invite is VERIFIED
            # against operator-carried material before anything is trusted
            # (the token is the trust decision; no TOFU). Legacy two-arg
            # `join <host>[:port] <code>` still works: there the invite
            # itself is the anchor (its embedded CA is pinned by register).
            # Either way the payload lands in the existing `register` flow
            # (NKey enrollment, CA pinning, env write — unchanged), ending
            # with a supervised zone restart so the user never gets
            # "now restart your zone" homework.
            # Split positional args (host/token, code) from multi-homing flags
            # (--replace / --visibility[ =]V / --allow-public-leg) so the flags
            # can be forwarded to `register`.
            local jhost_arg="" jcode="" jexpected_fp=""
            local jflags=() jpos=()
            shift || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --replace|--allow-public-leg) jflags+=("$1"); shift;;
                    --visibility)   jflags+=("$1" "${2:-private}"); shift 2;;
                    --visibility=*) jflags+=("$1"); shift;;
                    # Out-of-band CA fingerprint for the codeless (commons
                    # self-serve) form — what the relay's public page prints.
                    # Client-side only; NOT forwarded to register.
                    --fingerprint)   jexpected_fp="${2:-}"; shift 2 || shift;;
                    --fingerprint=*) jexpected_fp="${1#*=}"; shift;;
                    *) jpos+=("$1"); shift;;
                esac
            done
            jhost_arg="${jpos[0]:-}"
            jcode="${jpos[1]:-}"
            if [[ "$jhost_arg" == wyrdjoin://* ]]; then
                local jrest="${jhost_arg#wyrdjoin://}"
                local jtail="${jrest#*/}"
                jhost_arg="${jrest%%/*}"
                jcode="${jtail%%.*}"
                [[ "$jtail" == *.* ]] && jexpected_fp="${jtail#*.}"
            fi
            if [[ -z "$jhost_arg" ]]; then
                err "$(_t relay.join.usage)"
                return 1
            fi
            # Normalize an operator-supplied fingerprint (colons, case) so it
            # compares against the payload's hex form.
            if [[ -n "$jexpected_fp" ]]; then
                jexpected_fp=$(echo "${jexpected_fp//:/}" | tr 'A-F' 'a-f')
            fi
            # Codeless form — commons self-serve.
            # The relay hands out the invite payload without a code; the CA
            # fingerprint must arrive OUT OF BAND (--fingerprint, as published
            # on the relay's page) or be confirmed interactively below. In a
            # script with neither, refuse — no silent TOFU.
            if [[ -z "$jcode" ]]; then
                if [[ -z "$jexpected_fp" && ! -t 0 ]]; then
                    err "$(_t relay.join.selfserve_need_fp)"
                    return 1
                fi
                log "$(_t relay.join.selfserve "$jhost_arg")"
            fi
            local jhost="${jhost_arg%%:*}" jport="4443"
            [[ "$jhost_arg" == *:* ]] && jport="${jhost_arg##*:}"
            # Transport trust is irrelevant here (-k): the join code is a
            # single-use secret and the redeemed invite is verified against
            # the token's ca_fp below (or, legacy path, becomes the pin
            # material itself — same model as a pasted invite URL).
            local jresp
            jresp=$(curl -sfk -m 10 -X POST -H "Content-Type: application/json" \
                -d "{\"code\":\"${jcode}\"}" \
                "https://${jhost}:${jport}/join" 2>/dev/null) || jresp=""
            if [[ -z "$jresp" ]]; then
                err "$(_t relay.join.unreachable "$jhost")"
                return 1
            fi
            local jinvite
            jinvite=$(echo "$jresp" | python3 -c \
                "import sys,json; print(json.load(sys.stdin).get('invite_url',''))" 2>/dev/null)
            if [[ -z "$jinvite" ]]; then
                if [[ -z "$jcode" ]]; then
                    err "$(_t relay.join.selfserve_unsupported "$jhost")"
                else
                    err "$(_t relay.join.bad_code)"
                fi
                echo "  $jresp"
                return 1
            fi
            # Codeless + no out-of-band fingerprint: interactive trust
            # decision. Show the CA fingerprint the relay presented and make
            # the operator compare it against published material; default NO.
            if [[ -z "$jcode" && -z "$jexpected_fp" ]]; then
                local jss_fp
                jss_fp=$(echo "$jinvite" | python3 -c "
import sys, base64, json
url = sys.stdin.read().strip()
b64 = url.split('/', 3)[-1].split('.', 1)[0]
b64 += '=' * (-len(b64) % 4)
p = json.loads(base64.urlsafe_b64decode(b64))
print(p.get('ca_fp', '').replace(':', '').lower())
" 2>/dev/null)
                if [[ -z "$jss_fp" ]]; then
                    err "$(_t relay.join.selfserve_unsupported "$jhost")"
                    return 1
                fi
                echo ""
                echo "$(_t relay.join.selfserve_confirm "$jss_fp")"
                local jss_reply=""
                read -r -p "  [y/N] " jss_reply
                if [[ ! "$jss_reply" =~ ^[Yy] ]]; then
                    err "$(_t relay.join.selfserve_declined)"
                    return 1
                fi
                jexpected_fp="$jss_fp"
            fi
            if [[ -n "$jexpected_fp" ]]; then
                # The invite payload embeds the relay CA's fingerprint;
                # it must match the one the operator carried in the token,
                # or someone on-path substituted their own CA.
                local jgot_fp
                jgot_fp=$(echo "$jinvite" | python3 -c "
import sys, base64, json
url = sys.stdin.read().strip()
b64 = url.split('/', 3)[-1].split('.', 1)[0]
b64 += '=' * (-len(b64) % 4)
p = json.loads(base64.urlsafe_b64decode(b64))
print(p.get('ca_fp', '').replace(':', '').lower())
" 2>/dev/null)
                if [[ -z "$jgot_fp" || "$jgot_fp" != "$jexpected_fp" ]]; then
                    err "$(_t relay.join.fp_mismatch "$jhost")"
                    return 1
                fi
                log "$(_t relay.join.fp_ok)"
            fi
            log "$(_t relay.join.redeemed "$jhost")"
            # Home on the address we REACHED, not the relay's self-advertised
            # primary. A multi-NIC relay mints one RELAY_PUBLIC_HOST into the
            # invite, but that address may be unreachable from this zone — we
            # just proved $jhost reachable by redeeming over it. The invite
            # token validates by fingerprint, not host (the host is only a dial
            # label), so rewriting it is safe and carries through `register`'s
            # derived NATS leg. Without this, a zone that can only reach the
            # relay's secondary IP redeems fine then persists a dead leg pointed
            # at the relay's primary. (Mirrors RelayCommandBridge.relayJoin.)
            local _jrest="${jinvite#wyrdrelay://}"
            local _jtoken="${_jrest#*/}"
            if [[ "$_jrest" == */* && -n "$_jtoken" ]]; then
                jinvite="wyrdrelay://${jhost}:${jport}/${_jtoken}"
            fi
            # Self-serve (codeless) joins MUST enroll via the NKey path: the
            # relay's mode gate lives in /register-nkey (commons → FLOOR tier)
            # and the relay REFUSES ss-tagged invites at legacy /register —
            # redeeming one there would grant pw/HOUSEHOLD standing outside
            # the tier system (found live 2026-07-30). NKey enrollment also
            # makes `wyrd relay leave`'s signed deregister actually match the
            # record it created — the pw path never round-tripped. Code/token
            # joins keep the legacy register flow (multi-homing flags live
            # there, and an operator invite is the vouch).
            if [[ -z "$jcode" ]]; then
                do_relay register-nkey "$jinvite" || return 1
            else
                do_relay register "$jinvite" ${jflags[@]+"${jflags[@]}"} || return 1
            fi
            # Supervised restart — the new relay config is env-based, so the
            # running zone can't see it until the process restarts. Do it
            # FOR the user (countdown-confirmed per the standing setup-UX
            # pattern) instead of printing homework.
            if pgrep -f "org.wyrdsekai.server.Main" >/dev/null 2>&1; then
                echo ""
                _prompt_countdown "$(_t relay.join.restart_prompt) [Y/n]" 15
                if [[ -z "$_PROMPT_REPLY" || "$_PROMPT_REPLY" =~ ^[Yy] ]]; then
                    log "$(_t relay.join.restarting)"
                    do_stop; sleep 1; do_start
                else
                    echo "$(_t relay.join.restart_skipped)"
                fi
            else
                echo "$(_t relay.join.start_hint)"
            fi
            ;;

        register)
            # Join a relay using an invite URL.
            # APPENDS a leg (no longer wipes).
            local invite_url="${2:-}"
            # Multi-homing flags (after the invite URL). --visibility default
            # is inferred from the invite payload (mode) below; explicit flag
            # overrides. --replace = clean reset to leg 0. --allow-public-leg
            # = permit a public leg under a private floor.
            local r_replace="false" r_visibility="" r_allow_public="false"
            local _rargs=("$@")
            local _ri=2
            while [[ $_ri -lt ${#_rargs[@]} ]]; do
                case "${_rargs[$_ri]}" in
                    --replace)          r_replace="true";;
                    --visibility)       _ri=$((_ri + 1)); r_visibility="${_rargs[$_ri]:-}";;
                    --visibility=*)     r_visibility="${_rargs[$_ri]#--visibility=}";;
                    --allow-public-leg) r_allow_public="true";;
                esac
                _ri=$((_ri + 1))
            done
            if [[ -z "$invite_url" || "$invite_url" != wyrdrelay://* ]]; then
                err "$(_t relay.register.expected_url)"
                echo ""
                echo "$(_t relay.register.usage)"
                echo ""
                echo "$(_t relay.register.usage_hint)"
                return 1
            fi
            # Parse: wyrdrelay://host[:port]/token
            local rest="${invite_url#wyrdrelay://}"
            local hostport="${rest%%/*}"
            local token="${rest#*/}"
            local relay_host="${hostport%:*}"
            # invite URLs carry host:port explicitly
            # portless URLs (old mints) default to the household listener.
            local relay_port="4443"
            if [[ "$hostport" == *:* ]]; then
                relay_port="${hostport##*:}"
            fi
            if [[ -z "$relay_host" || -z "$token" ]]; then
                err "$(_t relay.register.parse_failed "$invite_url")"
                return 1
            fi

            # Decode embedded household-CA + leaf fingerprint from the token
            # payload (v2). SPEC §10.9 — invite ships the CA so we never have
            # to fetch /ca.crt over cleartext :80. Falls back to leaf-fp-only
            # check for legacy v1 invites.
            local payload_b64="${token%%.*}"
            local invite_parts
            invite_parts=$(echo "$payload_b64" | python3 -c "
import sys, base64, json
s = sys.stdin.read().strip()
s += '=' * (-len(s) % 4)
p = json.loads(base64.urlsafe_b64decode(s))
print(p.get('fp',''))
print(p.get('ca',''))
print(p.get('mode',''))
" 2>/dev/null)
            local embedded_fp embedded_ca_b64 embedded_mode
            embedded_fp=$(echo "$invite_parts" | sed -n '1p')
            embedded_ca_b64=$(echo "$invite_parts" | sed -n '2p')
            embedded_mode=$(echo "$invite_parts" | sed -n '3p')
            # Resolve leg visibility: explicit --visibility wins; else infer
            # from the invite's self-declared mode (public/private); else
            # default private.
            if [[ -z "$r_visibility" ]]; then
                case "$embedded_mode" in
                    public)  r_visibility="public";;
                    private) r_visibility="private";;
                    *)       r_visibility="private";;
                esac
            fi
            if [[ -z "$embedded_fp" ]]; then
                err "$(_t relay.register.no_fingerprint)"
                return 1
            fi

            local ca_tmp=""
            local actual_fp=""
            if [[ -n "$embedded_ca_b64" ]]; then
                # v2 invite: trust anchor comes from the invite itself.
                ca_tmp="$(mktemp -t wyrd-relay-ca.XXXXXX)"
                # Self-clearing + unbound-safe: a RETURN trap set here would
                # otherwise persist after do_relay returns and fire on later
                # function returns where ca_tmp is out of scope (set -u kill).
                trap 'rm -f "${ca_tmp:-}" 2>/dev/null; trap - RETURN' RETURN
                echo "$embedded_ca_b64" | python3 -c "
import sys, base64
s = sys.stdin.read().strip()
s += '=' * (-len(s) % 4)
sys.stdout.buffer.write(base64.urlsafe_b64decode(s))
" > "$ca_tmp"
                if ! openssl x509 -in "$ca_tmp" -noout 2>/dev/null; then
                    err "$(_t relay.register.cert_fetch_failed "$relay_host" "$relay_port")"
                    echo "(invite-embedded CA failed PEM parse)"
                    return 1
                fi
                # The pinned fingerprint for a v2 invite IS the embedded leaf fp.
                actual_fp="$embedded_fp"
                log "$(_t relay.register.cert_verified "${embedded_fp:0:32}")"
            else
                # Legacy v1 invite — no CA embedded. Fall back to leaf-fp pin.
                actual_fp=$(echo | openssl s_client -connect "${relay_host}:${relay_port}" \
                    -servername "$relay_host" 2>/dev/null \
                    | openssl x509 -noout -fingerprint -sha256 2>/dev/null \
                    | sed 's/^.*=//')
                if [[ -z "$actual_fp" ]]; then
                    err "$(_t relay.register.cert_fetch_failed "$relay_host" "$relay_port")"
                    echo "$(_t relay.register.cert_fetch_hint "$relay_host" "$relay_port")"
                    return 1
                fi
                if [[ "$actual_fp" != "$embedded_fp" ]]; then
                    err "$(_t relay.register.fp_mismatch)"
                    echo ""
                    echo "$(_t relay.register.fp_invite "$embedded_fp")"
                    echo "$(_t relay.register.fp_server "$actual_fp")"
                    echo ""
                    echo "$(_t relay.register.fp_explain_1)"
                    echo "$(_t relay.register.fp_explain_2)"
                    echo "$(_t relay.register.fp_explain_3 "$relay_host")"
                    echo "$(_t relay.register.fp_advice)"
                    return 1
                fi
                log "$(_t relay.register.cert_verified "${actual_fp:0:32}")"
            fi

            # POST invite token to /register. v2 invites use the embedded CA
            # for TLS verification (--cacert); v1 fingerprint-only fall back
            # to -k (we've already verified the leaf fp above).
            local result
            local curl_tls_opt
            if [[ -n "$ca_tmp" ]]; then
                curl_tls_opt="--cacert $ca_tmp"
            else
                curl_tls_opt="-k"
            fi
            result=$(curl -sf $curl_tls_opt -X POST \
                -H "Content-Type: application/json" \
                -d "{\"invite_token\":\"${token}\"}" \
                "https://${relay_host}:${relay_port}/register" 2>&1)
            if [[ -z "$result" || "$result" == *"error"* ]]; then
                err "$(_t relay.register.failed "${result:-$(_t relay.register.no_response)}")"
                return 1
            fi

            local cred_token nats_user nats_url
            cred_token=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('token',''))" 2>/dev/null)
            nats_user=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('nats_user',''))" 2>/dev/null)
            # Use the zone-leg PORT the relay advertises in its response, not a
            # hardcoded 4222. A co-hosted (offset) relay runs its public NATS leg on
            # e.g. 4322; hardcoding 4222 made the node dial its OWN NATS instead of the
            # relay — it "registered" but was never actually connected (relay list
            # showed LIVE=no; found live 2026-07-16). The relay substitutes only the
            # host; the port it returns is authoritative.
            local relay_nats_port
            relay_nats_port=$(echo "$result" | python3 -c \
                "import sys,json,urllib.parse as u; url=json.load(sys.stdin).get('relay_url',''); print(u.urlsplit(url).port or 4222)" 2>/dev/null)
            [[ "$relay_nats_port" =~ ^[0-9]+$ ]] || relay_nats_port=4222
            nats_url="nats://${relay_host}:${relay_nats_port}"
            if [[ -z "$cred_token" ]]; then
                err "$(_t relay.register.missing_token "$result")"
                return 1
            fi

            # Persist credentials as a relay LEG (append-not-wipe). Refuses a
            # public leg under a private floor unless --allow-public-leg.
            local reg_idx
            reg_idx=$(_relay_add_leg "$nats_url" "$nats_user" "$cred_token" \
                          "$actual_fp" "$r_visibility" \
                          "https://${relay_host}:${relay_port}" \
                          "$r_replace" "$r_allow_public") || return 1
            echo ""
            echo -e "$(_t relay.register.success)"
            echo "$(_t relay.register.household_id "$nats_user")"
            echo "$(_t relay.register.relay_label "$nats_url")"
            echo "$(_t relay.register.fingerprint_pinned "${actual_fp:0:32}")"
            if [[ "$reg_idx" == "0" ]]; then
                echo "  Relay configured as leg 0 (visibility: $r_visibility)."
            else
                echo "  Relay appended as leg $reg_idx (multi-homing; existing legs kept; visibility: $r_visibility)."
            fi
            echo ""
            echo "$(_t relay.register.restart_hint)"
            ;;

        remove)
            # Audit 2026-07-11: this branch used to POST /unregister — an endpoint
            # the relay daemon no longer serves (only NKey-signed /deregister
            # exists), so the API leg failed on every invocation and left a stale
            # registration behind while claiming "API unreachable". `leave` is the
            # working NKey-mode implementation of the same intent; delegate.
            log "$(_t relay.remove.removing)"
            do_relay leave
            return $?
            ;;

        remove_legacy_password_mode)
            # Retired 2026-07-11 (kept for reference; unreachable). The
            # /unregister endpoint this called no longer exists on any relay.
            local current_url="${WYRDSEKAI_RELAY_URL:-}"
            local current_token="${WYRDSEKAI_RELAY_TOKEN:-}"
            if [[ -z "$current_url" && ! -f "$ENV_FILE" ]]; then
                log "$(_t relay.remove.not_configured)"
                return 0
            fi
            echo ""
            log "$(_t relay.remove.removing)"
            # Derive unregister URL (same host as nats://, but HTTPS on public domains)
            if [[ -n "$current_url" ]]; then
                local relay_host
                relay_host=$(echo "$current_url" | sed 's|nats://||;s|:.*||')
                local reg_url
                # Best-effort: guess HTTPS first, fall back to HTTP:4221
                for candidate in "https://${relay_host}" "http://${relay_host}:4221"; do
                    if curl -sf -o /dev/null --max-time 3 "${candidate}/status"; then
                        reg_url="$candidate"
                        break
                    fi
                done
                if [[ -n "${reg_url:-}" && -n "$current_token" ]]; then
                    local result
                    result=$(curl -sf -X POST -H "Authorization: Bearer $current_token" \
                        "${reg_url}/unregister" --max-time 5 2>/dev/null)
                    if [[ -n "$result" ]]; then
                        echo "$(_t relay.remove.unregistered "$reg_url")"
                    else
                        warn "$(_t relay.remove.api_unreachable)"
                    fi
                fi
            fi
            # Strip local config
            if [[ -f "$ENV_FILE" ]]; then
                grep -v '^WYRDSEKAI_RELAY_' "$ENV_FILE" > "${ENV_FILE}.tmp" 2>/dev/null || true
                mv "${ENV_FILE}.tmp" "$ENV_FILE"
                log "$(_t relay.remove.config_stripped "$ENV_FILE")"
            fi
            log "$(_t relay.remove.removed)"
            ;;

        leave)
            # Voluntarily deregister this node from its relay AND strip local
            # relay config. The NKey-mode counterpart to `remove` (which only
            # handled password-mode /unregister).
            #
            # with a <url> argument, leave ONLY
            # that leg (and compact the remaining legs so the Java reader sees
            # no gap: leg-0 removal promotes the next leg to 0). With NO
            # argument, the legacy "leave all relays" behavior runs (signed
            # deregister + full strip).
            local leave_url="${2:-}"
            if [[ -n "$leave_url" ]]; then
                local removed_any="false" t
                while IFS= read -r t; do
                    [[ -z "$t" ]] && continue
                    if _relay_remove_leg_by_url "$t" "$leave_url"; then
                        removed_any="true"
                        log "Removed relay leg $leave_url from $t (remaining legs renumbered)."
                    fi
                done < <(_relay_write_targets)
                if [[ "$removed_any" != "true" ]]; then
                    warn "No configured relay leg matched URL: $leave_url"
                    log  "Use 'wyrd relay legs' to list configured legs."
                    return 1
                fi
                log "Left relay leg. Restart wyrdsekai to drop the connection."
                return 0
            fi
            # Steps (no <url> — leave ALL relays):
            #   1. Best-effort `wyrd relay deregister` (NKey-signed delete) so
            #      the relay's registration goes away — NEVER fails this command
            #      if the relay is unreachable or refuses.
            #   2. Strip WYRDSEKAI_RELAY_* from the env file so the node stops
            #      trying to connect (reverses `register-nkey` / `setup`).
            local had_relay="false"
            if [[ -n "${WYRDSEKAI_RELAY_URL:-}" || -n "${WYRDSEKAI_RELAY_REGISTRATION_URL:-}" ]] \
               || { [[ -f "$ENV_FILE" ]] && grep -q '^WYRDSEKAI_RELAY_' "$ENV_FILE" 2>/dev/null; }; then
                had_relay="true"
            fi
            if [[ "$had_relay" != "true" ]]; then
                log "No relay configured — nothing to leave."
                return 0
            fi
            echo ""
            log "Leaving relay…"
            # 0. If SSH-over-relay was enabled, tear it down FIRST — while the
            #    relay credentials still work for the signed ssh-disable. Found
            #    live 2026-07-30: leave stripped WYRDSEKAI_RELAY_* but the
            #    tunnel lives under WYRDSEKAI_SSH_TUNNEL_*, so the autossh loop
            #    kept running, the tunnel keys stayed in conf, and the relay
            #    kept a live tunnel record for a zone that had left.
            if [[ "${WYRDSEKAI_SSH_TUNNEL_ENABLED:-false}" == "true" ]] \
               || { [[ -f "$ENV_FILE" ]] && grep -q '^WYRDSEKAI_SSH_TUNNEL_ENABLED=true' "$ENV_FILE" 2>/dev/null; } \
               || { [[ -f /etc/wyrdsekai/wyrdsekai.conf ]] && grep -q '^WYRDSEKAI_SSH_TUNNEL_ENABLED=true' /etc/wyrdsekai/wyrdsekai.conf 2>/dev/null; }; then
                log "SSH-over-relay is enabled — disabling it before leaving…"
                do_relay ssh-disable || warn "relay-side ssh-disable did not complete — the relay's liveness reaper will drop the tunnel record."
                # Local teardown runs REGARDLESS of the relay's answer — a
                # refusal (unreachable, or identity drift under sudo) must not
                # leave a live reconnect loop + keypair for a tunnel we are
                # abandoning (found live 2026-07-30: 404 left both behind).
                _stop_ssh_tunnel 2>/dev/null || true
                rm -f "$DATA_DIR/ssh_tunnel_key" "$DATA_DIR/ssh_tunnel_key.pub" \
                      "$DATA_DIR/jump_key" "$DATA_DIR/jump_key.pub" \
                      "$DATA_DIR/ssh_tunnel_known_hosts" \
                      "$DATA_DIR/ssh-tunnel.pid" "$DATA_DIR/ssh-tunnel.log" 2>/dev/null
            fi
            # 1. NKey deregister (best-effort). Don't abort on failure.
            if do_relay deregister; then
                log "Deregistered from relay."
            else
                warn "Relay deregister did not complete (relay unreachable or refused) — continuing to strip local config."
            fi
            # 2. Strip local relay config so the node stops connecting — the
            #    tunnel knobs (WYRDSEKAI_SSH_TUNNEL_*) go with it: a tunnel to
            #    a relay you left is a dangling reconnect loop.
            if [[ -f "$ENV_FILE" ]]; then
                grep -vE '^WYRDSEKAI_(RELAY|SSH_TUNNEL)_' "$ENV_FILE" > "${ENV_FILE}.tmp" 2>/dev/null || true
                mv "${ENV_FILE}.tmp" "$ENV_FILE"
                log "Stripped relay config from $ENV_FILE"
            fi
            # Also strip the system conf if present + writable (installed nodes).
            if [[ -f /etc/wyrdsekai/wyrdsekai.conf ]] \
               && { [[ -w /etc/wyrdsekai/wyrdsekai.conf ]] || [[ "${EUID:-0}" -eq 0 ]]; }; then
                local sys_tmp="/tmp/wyrdsekai.conf.$$"
                grep -vE '^WYRDSEKAI_(RELAY|SSH_TUNNEL)_' /etc/wyrdsekai/wyrdsekai.conf > "$sys_tmp" 2>/dev/null || true
                mv "$sys_tmp" /etc/wyrdsekai/wyrdsekai.conf 2>/dev/null || rm -f "$sys_tmp" 2>/dev/null || true
            fi
            log "Left relay. Restart wyrdsekai to drop the connection."
            ;;

        legs|list-legs)
            # read-only: list every configured
            # relay leg (index, url, visibility, whether a token/fingerprint is
            # set). No network. Sources from the conf the service reads: prefer
            # the system conf when present, else $ENV_FILE.
            local legs_conf="$ENV_FILE"
            if [[ -f /etc/wyrdsekai/wyrdsekai.conf ]]; then
                legs_conf=/etc/wyrdsekai/wyrdsekai.conf
            fi
            local legs_floor; legs_floor="$(_relay_privacy_floor "$legs_conf")"
            echo ""
            log "Configured relay legs (zone privacy floor: $legs_floor)"
            echo "  source: $legs_conf"
            echo ""
            local any="false" lidx lurl lvis ltok lfp lsuf
            while IFS=$'\t' read -r lidx lurl; do
                [[ -z "$lidx" ]] && continue
                any="true"
                lvis="$(_relay_leg_field "$legs_conf" VISIBILITY "$lidx")"
                ltok="$(_relay_leg_field "$legs_conf" TOKEN "$lidx")"
                lfp="$(_relay_leg_field "$legs_conf" FINGERPRINT "$lidx")"
                lsuf="leg $lidx"
                [[ "$lidx" == "0" ]] && lsuf="leg 0 (legacy)"
                echo "  [$lsuf]"
                echo "    url:         ${lurl:-(unset)}"
                echo "    visibility:  ${lvis:-private (default)}"
                echo "    token:       $([[ -n "$ltok" ]] && echo set || echo "(none)")"
                echo "    fingerprint: $([[ -n "$lfp" ]] && echo "${lfp:0:32}…" || echo "(none)")"
            done < <(_relay_leg_urls "$legs_conf")
            if [[ "$any" != "true" ]]; then
                echo "  (no relay legs configured — run 'wyrd relay join <token>')"
            fi
            echo ""
            ;;

        peer-invite)
            # mint a peer-invite token to share with
            # ANOTHER relay's operator. They run `wyrd relay peer-accept` with
            # this URL on their end. The flow is mutual-consent: both relays
            # must accept each other for the leafnode link to come up.
            #
            # Localhost-only — must run on the relay host.
            local ttl="${2:-3600}"
            local hint="${3:-}"
            local body
            body=$(printf '{"ttl":%d,"remote_host_hint":"%s"}' "$ttl" "$hint")
            local resp
            resp=$(curl -sf -X POST -H "Content-Type: application/json" \
                --data "$body" "http://127.0.0.1:9280/peer-invite" 2>&1) || {
                err "$(_t relay.peer_invite.mint_failed)"
                err "$(_t relay.peer_invite.response "$resp")"
                return 1
            }
            echo ""
            log "$(_t relay.peer_invite.minted)"
            echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print('  Invite URL:', d['invite_url']); print('  Expires:   ', d['expires_at'])" 2>/dev/null \
                || echo "$resp"
            echo ""
            log "$(_t relay.peer_invite.other_runs)"
            log "$(_t relay.peer_invite.other_runs_cmd)"
            ;;

        peer-accept)
            # accept a peer invite from another relay.
            # Records the peer locally; the operator must then update relay.conf
            # leafnodes.remotes (template emitted in the response).
            local invite_url="${2:-}"
            local remote_url="${3:-}"
            local remote_pubkey="${4:-}"
            local remote_fp="${5:-}"
            if [[ -z "$invite_url" || -z "$remote_url" || -z "$remote_pubkey" ]]; then
                err "$(_t relay.peer_accept.usage)"
                return 1
            fi
            # Strip wyrdrelay-peer://host[:port]/ prefix to get just the token.
            local token
            token="${invite_url#wyrdrelay-peer://*/}"
            local body
            body=$(python3 -c "import json,sys; print(json.dumps({'invite_token':sys.argv[1],'remote_url':sys.argv[2],'remote_pubkey':sys.argv[3],'remote_fingerprint':sys.argv[4]}))" \
                "$token" "$remote_url" "$remote_pubkey" "$remote_fp")
            local resp
            resp=$(curl -sf -X POST -H "Content-Type: application/json" \
                --data "$body" "http://127.0.0.1:9280/peer-accept" 2>&1) || {
                err "$(_t relay.peer_accept.failed "$resp")"
                return 1
            }
            echo "$resp" | python3 -m json.tool 2>/dev/null || echo "$resp"
            ;;

        register-nkey|re-enroll|re-register-existing|deregister|nkey-pubkey|phone-invite|claim|ssh-enable|ssh-disable)
            # NKey relay auth subcommands.
            #   register-nkey <wyrdrelay://...>      enroll this node's NKey via invite
            #   re-enroll <wyrdrelay://...>          alias for register-nkey (drift recovery)
            #   re-register-existing                 re-register existing NKey without invite
            #                                        (NKey-signed challenge auth; relay must
            #                                         already know this pubkey)
            #   deregister                           voluntarily delete this node's relay
            #                                        registration (NKey-signed; backs
            #                                        `wyrd relay leave`)
            #   nkey-pubkey                          print this node's NKey pubkey
            #   phone-invite                         mint a phone connection invite from the
            # registered relay (
            #                                        surfaced as `wyrd phone invite`)
            #   claim <token>                        redeem an owner-claim token to become the
            # relay's admin owner (
            #                                        §4b; NKey-signed claim-owner challenge)
            # Delegates to RelayNkeyAdminMain so bash doesn't reimplement Ed25519 NKey encoding.
            local SERVER_LIB
            if [[ "$MODE" == "source" ]]; then
                if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
                    log "$(_t relay.nkey.building)"
                    (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                        || { err "Build failed"; return 1; }
                fi
                SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
            else
                SERVER_LIB="$REAL_BIN/../lib/server"
                [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
            fi
            if [[ ! -d "$SERVER_LIB" ]]; then
                err "$(_t common.server_libs_missing "$SERVER_LIB")"
                return 1
            fi
            find_java || { err "$(_t common.java_missing)"; return 1; }
            local CP
            CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
            local subcmd="$1"
            # Map nkey-pubkey → RelayNkeyAdminMain print-pubkey for friendlier surface.
            if [[ "$subcmd" == "nkey-pubkey" ]]; then subcmd="print-pubkey"; fi
            shift
            # Resolve the conf file the SERVICE actually reads from at startup,
            # so the auto-update lands where it'll take effect.
            #
            #   Install layout                            Service env source
            #   ─────────────────────────────────────────────────────────────
            #   .deb (Linux)   systemd unit reads        /etc/wyrdsekai/wyrdsekai.conf
            #   .pkg (macOS)   launchd reads             /etc/wyrdsekai/wyrdsekai.conf
            #                                            (also sources ~/.wyrdsekai/env)
            #   source mode    bin/wyrd sources          $DATA_DIR/env
            #
            # Heuristic: prefer /etc/wyrdsekai/wyrdsekai.conf when it exists AND
            # we have permission to write it. Else fall back to $ENV_FILE
            # ($DATA_DIR/env), which works for source mode and as a fallback
            # for installed nodes when the user hasn't sudo'd.
            local nkey_conf_target=""
            if [[ -f /etc/wyrdsekai/wyrdsekai.conf ]]; then
                if [[ -w /etc/wyrdsekai/wyrdsekai.conf ]] || [[ "${EUID:-0}" -eq 0 ]]; then
                    nkey_conf_target=/etc/wyrdsekai/wyrdsekai.conf
                elif [[ "$(uname -s)" == "Darwin" ]] && [[ -d "$HOME/.wyrdsekai" ]]; then
                    # On macOS the LaunchDaemon plist sources /etc/wyrdsekai/wyrdsekai.conf
                    # FIRST then ~/.wyrdsekai/env SECOND — so user-level env wins. Write
                    # there when /etc isn't sudo-accessible. .deb (systemd) doesn't have
                    # this fallback because the unit only EnvironmentFile=/etc/...
                    nkey_conf_target="$HOME/.wyrdsekai/env"
                    warn "$(_t relay.nkey.conf_unwritable_warn_1)"
                    warn "$(_t relay.nkey.conf_unwritable_warn_2 "$nkey_conf_target")"
                    warn "$(_t relay.nkey.conf_unwritable_warn_3)"
                else
                    err "$(_t relay.nkey.conf_no_perm_1)"
                    err "$(_t relay.nkey.conf_no_perm_2)"
                    err "$(_t relay.nkey.conf_no_perm_cmd "$subcmd" "$*")"
                    return 1
                fi
            else
                # Source mode — no system-level conf. Use $DATA_DIR/env (which
                # bin/wyrd source-loads at startup, so the SERVICE running
                # under bin/wyrd start sees these too).
                nkey_conf_target="$ENV_FILE"
            fi
            log "$(_t relay.nkey.auto_update_target "$nkey_conf_target")"
            WYRDSEKAI_CONF="$nkey_conf_target" "$JAVA_CMD" \
                -Djava.net.preferIPv4Stack=true \
                --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
                --add-opens java.base/java.lang=ALL-UNNAMED \
                --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
                -XX:+UseCompactObjectHeaders \
                --enable-native-access=ALL-UNNAMED \
                -cp "$CP" \
                org.wyrdsekai.server.RelayNkeyAdminMain "$subcmd" "$@"
            local _nkey_rc=$?
            # ssh-enable/ssh-disable persist the tunnel config into the conf; open
            # or close the reverse tunnel RIGHT NOW instead of making the user run
            # `wyrd restart`. The tunnel is a standalone autossh -R process that
            # forwards the relay port to the already-running node sshd (:7022), so
            # NO node/inference restart is needed — restarting the whole zone to
            # open a forward-only ssh tunnel was needless churn (second-node 2026-07-07).
            # It shares $DATA_DIR's pidf with the service and autossh is nohup'd,
            # so a later `wyrd restart` won't double-spawn and the tunnel outlives
            # this shell.
            if [[ $_nkey_rc -eq 0 ]]; then
                case "$subcmd" in
                    ssh-enable)
                        # Pull the freshly-persisted WYRDSEKAI_SSH_TUNNEL_* the Java
                        # side just wrote into the conf, then (re)open the tunnel.
                        [[ -f "$nkey_conf_target" ]] && { set -a; source "$nkey_conf_target"; set +a; }
                        _stop_ssh_tunnel     # drop any tunnel bound to a stale port
                        _start_ssh_tunnel
                        local _ssh_tpid="$DATA_DIR/ssh-tunnel.pid"
                        if [[ -f "$_ssh_tpid" ]] && kill -0 "$(cat "$_ssh_tpid" 2>/dev/null)" 2>/dev/null; then
                            log "ssh-tunnel: SSH-over-relay is live now — no 'wyrd restart' needed."
                        else
                            warn "ssh-tunnel: not up yet — it will open on the next 'wyrd restart'."
                        fi
                        ;;
                esac
            fi
            # ssh-disable's LOCAL teardown runs regardless of the relay's
            # answer (2026-07-30): a refused/unreachable relay must not leave
            # a live reconnect loop, tunnel knobs in conf, or stale keys for a
            # tunnel the operator is disabling. ssh-enable regenerates all of
            # it, so a later re-enable loses nothing.
            if [[ "$subcmd" == "ssh-disable" ]]; then
                _stop_ssh_tunnel
                if [[ -f "$nkey_conf_target" ]]; then
                    grep -v '^WYRDSEKAI_SSH_TUNNEL_' "$nkey_conf_target" > "${nkey_conf_target}.tmp" 2>/dev/null \
                        && mv "${nkey_conf_target}.tmp" "$nkey_conf_target" \
                        || rm -f "${nkey_conf_target}.tmp" 2>/dev/null
                fi
                rm -f "$DATA_DIR/ssh_tunnel_key" "$DATA_DIR/ssh_tunnel_key.pub" \
                      "$DATA_DIR/jump_key" "$DATA_DIR/jump_key.pub" \
                      "$DATA_DIR/ssh_tunnel_known_hosts" \
                      "$DATA_DIR/ssh-tunnel.pid" "$DATA_DIR/ssh-tunnel.log" 2>/dev/null
                log "ssh-tunnel: SSH-over-relay closed — tunnel config and keys cleared."
            fi
            return $_nkey_rc
            ;;

        deploy)
            echo ""
            log "$(_t relay.deploy.title)"
            echo ""
            echo "$(_t relay.deploy.see_readme)"
            echo ""
            echo "$(_t relay.deploy.docker_label)"
            echo "$(_t relay.deploy.docker_cmd1)"
            echo "$(_t relay.deploy.docker_cmd2)"
            echo ""
            echo "$(_t relay.deploy.bare_label)"
            echo "$(_t relay.deploy.bare_cmd1)"
            echo "$(_t relay.deploy.bare_cmd2)"
            echo ""
            echo "$(_t relay.deploy.after_1)"
            echo "$(_t relay.deploy.after_2)"
            echo ""
            echo "Or run: wyrd relay deploy-up [--hosts a,b] [--ips x,y]"
            echo "         to provision .env + bring the compose project up."
            ;;

        deploy-up)
            # One-shot: provision <compose_dir>/.env with the correct
            # RELAY_HOST_NAMES/RELAY_HOST_IPS for cert SANs, then
            # `docker compose up -d`. Without this, certinit silently
            # produces certs with localhost,127.0.0.1 SANs and phones
            # can't reach the relay by LAN IP.
            local hosts_override="" ips_override=""
            shift || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --hosts)
                        hosts_override="${2:-}"; shift 2;;
                    --hosts=*)
                        hosts_override="${1#--hosts=}"; shift;;
                    --ips)
                        ips_override="${2:-}"; shift 2;;
                    --ips=*)
                        ips_override="${1#--ips=}"; shift;;
                    -h|--help)
                        echo "Usage: wyrd relay deploy-up [--hosts <csv>] [--ips <csv>]"
                        echo ""
                        echo "  Detects host names + IPs (or accepts overrides), writes them"
                        echo "  to <compose_dir>/.env as RELAY_HOST_NAMES and RELAY_HOST_IPS,"
                        echo "  then runs 'docker compose up -d' in the relay compose dir."
                        echo ""
                        echo "  Run on the relay host. Re-run any time host topology changes."
                        return 0
                        ;;
                    *)
                        err "deploy-up: unknown flag '$1'"
                        return 1
                        ;;
                esac
            done

            local compose_dir
            if ! compose_dir=$(_relay_compose_dir); then
                err "deploy-up: cannot find relay docker-compose.yml"
                err "  expected in: /opt/wyrdsekai/relay, /etc/wyrdsekai/relay,"
                err "               \$HOME/.wyrdsekai/relay, \$DATA_DIR/relay,"
                err "               or $PROJECT_ROOT/deploy/relay"
                return 1
            fi
            log "deploy-up: using compose dir $compose_dir"

            local hosts="$hosts_override" ips="$ips_override"
            if [[ -z "$hosts" || -z "$ips" ]]; then
                _relay_autodetect_hosts_and_ips
                [[ -z "$hosts" ]] && hosts="$DETECTED_HOSTS"
                [[ -z "$ips"   ]] && ips="$DETECTED_IPS"
            fi
            if [[ -z "$hosts" || -z "$ips" ]]; then
                err "deploy-up: could not determine hosts or IPs (hosts='$hosts' ips='$ips')"
                err "  rerun with --hosts a,b --ips x,y"
                return 1
            fi
            echo "  RELAY_HOST_NAMES=$hosts"
            echo "  RELAY_HOST_IPS=$ips"
            _relay_write_compose_env "$compose_dir" "$hosts" "$ips"
            log "deploy-up: wrote $compose_dir/.env"

            # Bring the compose project up. Idempotent — re-running picks up
            # SAN changes on the next certinit run (which itself only
            # regenerates the leaf when the recorded SAN signature changes).
            if ! command -v docker >/dev/null 2>&1; then
                err "deploy-up: docker not found — install Docker, then 'cd $compose_dir && docker compose up -d'"
                return 1
            fi
            log "deploy-up: docker compose up -d"
            (cd "$compose_dir" && docker compose up -d) || {
                err "deploy-up: docker compose up failed"
                return 1
            }
            log "deploy-up: done. Use 'wyrd relay show-cert' to inspect the SANs on the new leaf."
            ;;

        rotate-cert)
            # Rotate the relay's TLS leaf cert (and optionally the household CA).
            # Run on the relay host. Forces certinit to regenerate by clearing
            # the leaf material in the relay_certs volume, then bouncing
            # certinit + caddy so the new chain is served immediately.
            #
            # Modes:
            #   wyrd relay rotate-cert             # leaf only — preserves CA,
            #                                      # existing phone pins keep working
            #   wyrd relay rotate-cert --ca        # full rotation — also rotates
            #                                      # CA. Invalidates EVERY pinned
            #                                      # phone trust; users must re-TOFU.
            #
            # Discovers the relay compose project the same way `setup` does.
            local rotate_mode="leaf"
            if [[ "${2:-}" == "--ca" || "${2:-}" == "--full" ]]; then
                rotate_mode="full"
            fi

            # Locate certinit container — relay-certinit-1 by default-compose,
            # may vary if user renamed the project.
            local certinit_container=""
            for candidate in relay-certinit-1 relay_certinit_1 wyrd-relay-certinit-1 certinit; do
                if docker inspect "$candidate" >/dev/null 2>&1; then
                    certinit_container="$candidate"
                    break
                fi
            done
            if [[ -z "$certinit_container" ]]; then
                err "rotate-cert: certinit container not found"
                echo "  expected one of: relay-certinit-1, relay_certinit_1, wyrd-relay-certinit-1"
                echo "  Are you on the relay host? Run 'docker compose ps' in deploy/relay/."
                return 1
            fi

            # The certinit container exits after first run; we exec into the
            # cert volume via a one-shot busybox-style container OR by mounting
            # /certs into a fresh container. Simpler: just re-run certinit by
            # force-recreate, AFTER nuking the leaf (always) and CA (--ca only).
            local volume_name=""
            volume_name=$(docker inspect "$certinit_container" \
                --format '{{range .Mounts}}{{if eq .Destination "/certs"}}{{.Name}}{{end}}{{end}}' 2>/dev/null)
            if [[ -z "$volume_name" ]]; then
                err "rotate-cert: could not resolve /certs volume from $certinit_container"
                return 1
            fi

            echo ""
            log "rotating $rotate_mode TLS material in volume '$volume_name'..."
            if [[ "$rotate_mode" == "full" ]]; then
                # Full rotation: delete CA + leaf material. ALL phone pins break.
                docker run --rm -v "${volume_name}:/certs" alpine:latest \
                    sh -c "rm -f /certs/ca.crt /certs/ca.key /certs/ca.srl /certs/leaf.crt /certs/leaf.key /certs/leaf.sig" \
                    >/dev/null 2>&1
            else
                # Leaf rotation: keep CA, delete leaf so certinit re-signs.
                docker run --rm -v "${volume_name}:/certs" alpine:latest \
                    sh -c "rm -f /certs/leaf.crt /certs/leaf.key /certs/leaf.sig" \
                    >/dev/null 2>&1
            fi

            # Find compose project dir to recreate certinit + caddy.
            local compose_dir
            if ! compose_dir=$(_relay_compose_dir); then
                err "rotate-cert: cannot find relay docker-compose.yml; bring certinit+caddy up manually"
                return 1
            fi

            # certinit reads RELAY_HOST_NAMES/RELAY_HOST_IPS from the
            # compose .env. Without it, the new leaf cert ends up with
            # just localhost/127.0.0.1 SANs and phones can't reach the
            # relay by LAN IP — a silent footgun. Ensure the .env file
            # has values BEFORE we let certinit rerun.
            _relay_ensure_compose_env "$compose_dir" || true
            # Also source $ENV_FILE for legacy stewards who put these vars
            # in the wyrdsekai system conf (compose .env takes precedence
            # because docker compose reads .env directly).
            if [[ -f "$ENV_FILE" ]]; then
                set -a; source "$ENV_FILE"; set +a
            fi
            (cd "$compose_dir" && docker compose up -d certinit --force-recreate >/dev/null 2>&1)
            (cd "$compose_dir" && docker compose restart caddy >/dev/null 2>&1)

            # Print the new CA fingerprint (so steward can announce it).
            local new_ca_fp
            new_ca_fp=$(docker run --rm -v "${volume_name}:/certs" alpine:latest \
                sh -c "apk add --no-cache openssl >/dev/null 2>&1 || true; openssl x509 -in /certs/ca.crt -noout -fingerprint -sha256 2>/dev/null | sed 's/^.*=//'" 2>/dev/null)
            echo ""
            log "rotation complete ($rotate_mode)"
            echo "  new CA fingerprint: ${new_ca_fp:-(unknown — inspect /certs/ca.crt manually)}"
            if [[ "$rotate_mode" == "full" ]]; then
                echo ""
                echo "  All existing phone household-CA pins are now INVALID."
                echo "  Phones must re-run TOFU on next HTTPS connect."
            fi
            ;;

        show-cert)
            # Print the relay's current leaf + CA fingerprints. Steward shares
            # the CA fingerprint with users before they accept TOFU prompts.
            local volume_name="" certinit_container=""
            for candidate in relay-certinit-1 relay_certinit_1 wyrd-relay-certinit-1 certinit; do
                if docker inspect "$candidate" >/dev/null 2>&1; then
                    certinit_container="$candidate"
                    break
                fi
            done
            if [[ -z "$certinit_container" ]]; then
                err "show-cert: certinit container not found"
                return 1
            fi
            volume_name=$(docker inspect "$certinit_container" \
                --format '{{range .Mounts}}{{if eq .Destination "/certs"}}{{.Name}}{{end}}{{end}}' 2>/dev/null)
            docker run --rm -v "${volume_name}:/certs" alpine:latest sh -c '
                apk add --no-cache openssl >/dev/null 2>&1 || true
                echo "Household CA:"
                openssl x509 -in /certs/ca.crt -noout -subject -fingerprint -sha256 2>/dev/null
                echo
                echo "Leaf cert:"
                openssl x509 -in /certs/leaf.crt -noout -subject -fingerprint -sha256 -ext subjectAltName 2>/dev/null
            '
            ;;

        *)
            echo "$(_t relay.help.title)"
            echo ""
            echo "$(_t relay.help.usage)"
            echo ""
            echo "$(_t relay.help.joining_label)"
            echo "$(_t relay.help.cmd_join)"
            echo "$(_t relay.help.cmd_invite)"
            echo "$(_t relay.help.cmd_register)"
            echo ""
            echo "$(_t relay.help.manual_label)"
            echo "$(_t relay.help.cmd_setup)"
            echo "$(_t relay.help.cmd_status)"
            echo "$(_t relay.help.cmd_disable)"
            echo "$(_t relay.help.cmd_remove)"
            echo "  leave [<url>]                 Leave one relay leg by url, or all relays if omitted"
            echo "  legs                          List configured relay legs (url, visibility, token?)"
            echo "$(_t relay.help.cmd_deploy)"
            echo "  deploy-up                     Provision compose .env + 'docker compose up -d'"
            echo "  rotate-cert [--ca]            Rotate the relay's TLS leaf (and optionally CA)"
            echo "  show-cert                     Print current CA + leaf fingerprints"
            echo "  ssh-enable                    Open SSH-over-relay so a bare 'ssh' reaches this"
            echo "                                NAT'd zone (needs a relay running --ssh-tunnel,"
            echo "                                plus per-zone opt-in; see docs/RELAY.md)"
            echo "  ssh-disable                   Close SSH-over-relay for this zone"
            echo ""
            echo "  claim <token>                 Claim ADMIN ownership of this relay (owner-claim token)"
            echo "  peer-invite / peer-accept     Bilateral peer-relay agreements with another household"
            echo "  register-nkey / re-enroll / re-register-existing / deregister / nkey-pubkey"
            echo "                                Advanced: manage this zone's NKey auth on the relay"
            ;;
    esac
}

# ── Rendezvous (zone directory aggregator) ──
#
# Separate process from the tunnel relay ( — the
# directory must NOT share a process with the relay so a tunnel-side
# outage can't take directory discovery down).
#
# per-zone leaf relay
#
# A leaf relay is a NATS server in leaf-mode connecting upstream to a public
# relay. Local-zone subjects (between.{hh}.>, federation.{zone}.gate.>) flow
# through it bidirectionally; high-frequency intra-zone heartbeats stay local.
# Run on a beefy zone-local node to absorb intra-zone fan-out and lighten the
# central relay load.
#
# Subcommands:
#   config     Generate the leaf-relay NATS config from env (idempotent)
#   start-cmd  Print the nats-server command to launch the leaf relay
#   start      Run nats-server with the generated config (foreground)
#
# Required env (passed via $ENV_FILE):
#   WYRDSEKAI_RELAY_UPSTREAM     URL of the upstream relay's leaf port
#                                (e.g. nats://relay.example:7422)
#   WYRDSEKAI_HOUSEHOLD_TAG      household tag for subject scoping
#   WYRDSEKAI_ZONE_ID            zone id for federation gate scoping
#
#a.
do_relay_server() {
    local subcmd="${1:-help}"
    shift || true

    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
            log "$(_t common.building_server)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    [[ -d "$SERVER_LIB" ]] || { err "$(_t common.server_libs_missing "$SERVER_LIB")"; return 1; }
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')

    case "$subcmd" in
        config|start-cmd)
            "$JAVA_CMD" \
                -Djava.net.preferIPv4Stack=true \
                --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
                --add-opens java.base/java.lang=ALL-UNNAMED \
                --enable-native-access=ALL-UNNAMED \
                -cp "$CP" \
                org.wyrdsekai.server.LeafRelayServerMain "$subcmd" "$@"
            ;;
        start)
            # Generate or refresh config, then exec nats-server.
            "$JAVA_CMD" \
                -Djava.net.preferIPv4Stack=true \
                --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
                --add-opens java.base/java.lang=ALL-UNNAMED \
                --enable-native-access=ALL-UNNAMED \
                -cp "$CP" \
                org.wyrdsekai.server.LeafRelayServerMain config \
                || { err "$(_t relay_server.config_failed)"; return 1; }
            local conf="${WYRDSEKAI_RELAY_LEAF_CONF:-$HOME/.wyrdsekai/relay-leafnode.conf}"
            command -v nats-server &>/dev/null || {
                err "$(_t relay_server.nats_missing)"
                return 1
            }
            log "$(_t relay_server.starting "$conf")"
            exec nats-server -c "$conf"
            ;;
        help|--help|"")
            "$JAVA_CMD" \
                -Djava.net.preferIPv4Stack=true \
                --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
                --add-opens java.base/java.lang=ALL-UNNAMED \
                --enable-native-access=ALL-UNNAMED \
                -cp "$CP" \
                org.wyrdsekai.server.LeafRelayServerMain help
            ;;
        *)
            err "$(_t relay_server.unknown_subcommand "$subcmd")"
            do_relay_server help
            return 1
            ;;
    esac
}

# ─── wyrd daemon ──────────────────────────────────────────────
# macOS-only: switch the LaunchDaemon between root-mode (default)
# and a specific user account. Defaulting to root sidesteps macOS
# Local Network Privacy (LNP) — non-root daemons silently fail
# connect() to LAN addresses until the user clicks "Allow" in
# System Settings → Privacy & Security → Local Network, and that
# UI doesn't surface for daemons.
#
# Sometimes operators want user-mode anyway (better file ownership
# hygiene, uid-scoped resource limits, audit clarity). This command
# orchestrates the switch + auto-chowns the data dir + restarts.
#
#   wyrd daemon run-as root         — default, bypasses LNP
#   wyrd daemon run-as <user>       — drop privileges; chown data dir
#   wyrd daemon status              — show which user the daemon runs as
#
# Linux .deb already has its own systemd model (User= in unit file);
# this command is a no-op there with a clear message.
do_daemon() {
    local subcmd="${1:-help}"

    if [[ "$(uname -s)" != "Darwin" ]]; then
        log "$(_t daemon.linux_unsupported)"
        log "$(_t daemon.linux_unsupported_2)"
        log "$(_t daemon.linux_unsupported_3)"
        log "$(_t daemon.linux_unsupported_4)"
        return 0
    fi

    local plist=/Library/LaunchDaemons/com.wyrdsekai.server.plist
    if [[ ! -f "$plist" ]]; then
        err "$(_t daemon.plist_missing "$plist")"
        err "$(_t daemon.plist_missing_hint "$PROJECT_ROOT")"
        return 1
    fi

    case "$subcmd" in
        status)
            # pgrep returns 1 with no match — neutralise pipefail. Same for
            # ps when pid is empty.
            local pid
            pid=$(pgrep -f 'java.*org\.wyrdsekai\.server\.Main' 2>/dev/null | head -1 || true)
            if [[ -z "$pid" ]]; then
                log "$(_t daemon.status.not_running)"
            else
                local user
                user=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ' || echo "?")
                log "$(_t daemon.status.running_as "$user" "$pid")"
            fi
            local plist_user
            plist_user=$(/usr/libexec/PlistBuddy -c "Print :UserName" "$plist" 2>/dev/null \
                || _t daemon.status.plist_username_default)
            log "$(_t daemon.status.plist_username "$plist_user")"
            local plist_home
            plist_home=$(/usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:HOME" "$plist" 2>/dev/null \
                || _t daemon.status.plist_home_unset)
            log "$(_t daemon.status.plist_home "$plist_home")"
            ;;

        run-as)
            local target="${2:-}"
            if [[ -z "$target" ]]; then
                err "$(_t daemon.runas.usage)"
                err "$(_t daemon.runas.usage_examples)"
                err "$(_t daemon.runas.usage_root)"
                err "$(_t daemon.runas.usage_user "$USER")"
                return 1
            fi
            if [[ "${EUID:-0}" -ne 0 ]]; then
                err "$(_t daemon.runas.needs_sudo)"
                err "$(_t daemon.runas.needs_sudo_hint "$target")"
                return 1
            fi

            # Resolve target HOME for env var; required for both root and user
            # modes since the JVM's user.home depends on -Duser.home (set in
            # plist EnvironmentVariables) and the bash launcher sources env
            # files from $HOME/.wyrdsekai/env.
            local target_home
            if [[ "$target" == "root" ]]; then
                # Pick the installing user's home so per-user data still
                # resolves correctly. /var/root would orphan the existing
                # ~/.wyrdsekai directory.
                local install_user
                install_user=$(stat -f "%Su" /dev/console 2>/dev/null)
                if [[ -z "$install_user" || "$install_user" == "root" ]]; then
                    install_user="${SUDO_USER:-operator}"
                fi
                target_home=$(dscl . -read "/Users/$install_user" NFSHomeDirectory 2>/dev/null \
                    | awk '{print $2}')
                [[ -z "$target_home" ]] && target_home="/Users/$install_user"
                log "$(_t daemon.runas.root_mode)"
                log "$(_t daemon.runas.root_uid)"
                log "$(_t daemon.runas.root_home "$target_home")"
            else
                # User mode: target must exist
                if ! dscl . -read "/Users/$target" >/dev/null 2>&1; then
                    err "$(_t daemon.runas.user_not_found "$target")"
                    err "$(_t daemon.runas.user_not_found_hint)"
                    return 1
                fi
                target_home=$(dscl . -read "/Users/$target" NFSHomeDirectory 2>/dev/null \
                    | awk '{print $2}')
                [[ -z "$target_home" ]] && target_home="/Users/$target"
                log "$(_t daemon.runas.user_mode "$target")"
                log "$(_t daemon.runas.user_uid "$target")"
                log "$(_t daemon.runas.user_home "$target_home")"
                echo ""
                warn "$(_t daemon.runas.lnp_warn_1)"
                warn "$(_t daemon.runas.lnp_warn_2)"
                warn "$(_t daemon.runas.lnp_warn_3)"
                warn "$(_t daemon.runas.lnp_warn_4)"
                warn "$(_t daemon.runas.lnp_warn_5)"
                warn ""
                warn "$(_t daemon.runas.lnp_warn_steps)"
                warn "$(_t daemon.runas.lnp_warn_step1)"
                warn "$(_t daemon.runas.lnp_warn_step1b "$target")"
                warn "$(_t daemon.runas.lnp_warn_step1c)"
                warn "$(_t daemon.runas.lnp_warn_step1d)"
                warn "$(_t daemon.runas.lnp_warn_step2)"
                warn "$(_t daemon.runas.lnp_warn_step2b)"
                warn "$(_t daemon.runas.lnp_warn_step2c)"
                warn ""
                warn "$(_t daemon.runas.lnp_warn_advice_1)"
                warn "$(_t daemon.runas.lnp_warn_advice_2)"
                warn "$(_t daemon.runas.lnp_warn_advice_3)"
                echo ""
            fi

            # 1. Stop the daemon (idempotent — bootout returns non-zero if already gone).
            log "$(_t daemon.runas.stopping)"
            launchctl bootout system/com.wyrdsekai.server 2>/dev/null || true
            sleep 2

            # 2. Rewrite the plist. We start from the current file (preserves
            # any operator hand-edits to ProgramArguments etc) and toggle just
            # the UserName/GroupName keys + JAVA_OPTS user.home.
            local tmp_plist
            tmp_plist=$(mktemp)
            cp "$plist" "$tmp_plist"

            # Drop existing UserName/GroupName (PlistBuddy errors if missing,
            # so swallow the failure silently).
            /usr/libexec/PlistBuddy -c "Delete :UserName" "$tmp_plist" 2>/dev/null || true
            /usr/libexec/PlistBuddy -c "Delete :GroupName" "$tmp_plist" 2>/dev/null || true

            if [[ "$target" != "root" ]]; then
                /usr/libexec/PlistBuddy -c "Add :UserName string $target" "$tmp_plist"
                /usr/libexec/PlistBuddy -c "Add :GroupName string staff" "$tmp_plist"
            fi

            # Update HOME + user.home in EnvironmentVariables. Add the dict if
            # missing (older plists), then set/replace each key.
            /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables" "$tmp_plist" 2>/dev/null \
                || /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables dict" "$tmp_plist"
            /usr/libexec/PlistBuddy -c "Delete :EnvironmentVariables:HOME" "$tmp_plist" 2>/dev/null || true
            /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:HOME string $target_home" "$tmp_plist"
            /usr/libexec/PlistBuddy -c "Delete :EnvironmentVariables:JAVA_OPTS" "$tmp_plist" 2>/dev/null || true
            /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:JAVA_OPTS string -Duser.home=$target_home" "$tmp_plist"
            # Working directory should match HOME's .wyrdsekai too.
            /usr/libexec/PlistBuddy -c "Set :WorkingDirectory $target_home/.wyrdsekai" "$tmp_plist" 2>/dev/null \
                || /usr/libexec/PlistBuddy -c "Add :WorkingDirectory string $target_home/.wyrdsekai" "$tmp_plist"

            if ! plutil -lint "$tmp_plist" >/dev/null 2>&1; then
                err "$(_t daemon.runas.plist_invalid)"
                plutil -lint "$tmp_plist" >&2
                rm -f "$tmp_plist"
                return 1
            fi
            mv "$tmp_plist" "$plist"
            chown root:wheel "$plist"
            chmod 644 "$plist"
            log "$(_t daemon.runas.plist_updated)"

            # 3. Auto-chown the data dir + system conf to the target.
            # In root mode we leave existing files (root reads everything) so
            # we don't churn ownership unnecessarily — the user's existing
            # operator-owned files keep working. The daemon will write new
            # files as root, but that's fine.
            #
            # In user mode we MUST chown so the daemon (running as $target)
            # can read/write under the data dir. /etc/wyrdsekai stays root-
            # owned with mode 644 — the launchd source-cmd reads it before
            # dropping privileges.
            if [[ "$target" != "root" ]]; then
                local data_dir="$target_home/.wyrdsekai"
                if [[ -d "$data_dir" ]]; then
                    log "$(_t daemon.runas.chowning "$data_dir" "$target")"
                    chown -R "$target:staff" "$data_dir" || warn "$(_t daemon.runas.chown_warn)"
                fi
            fi

            # 4. Bootstrap the daemon back. launchd sometimes returns rc=5
            # ("Input/output error") on the first attempt right after a
            # bootout — the label hasn't fully released yet. Retry once
            # after a short pause before giving up.
            log "$(_t daemon.runas.starting)"
            local boot_ok=0
            local attempt
            for attempt in 1 2 3; do
                if launchctl bootstrap system "$plist" 2>&1; then
                    boot_ok=1
                    break
                fi
                if [[ $attempt -lt 3 ]]; then
                    log "$(_t daemon.runas.bootstrap_retry "$((attempt+1))")"
                    sleep 3
                fi
            done
            if [[ $boot_ok -eq 1 ]]; then
                launchctl enable system/com.wyrdsekai.server 2>&1 || true
                sleep 5
                local pid
                pid=$(pgrep -f 'java.*org\.wyrdsekai\.server\.Main' 2>/dev/null | head -1 || true)
                if [[ -n "$pid" ]]; then
                    local user
                    user=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ' || echo "?")
                    log "$(_t daemon.runas.running "$user" "$pid")"
                    # Tail just the relevant lines for ~5s.
                    sleep 4
                    if [[ -f "$target_home/.wyrdsekai/logs/wyrdsekai.log" ]]; then
                        tail -200 "$target_home/.wyrdsekai/logs/wyrdsekai.log" 2>/dev/null \
                            | grep -E 'NKey auth|connected to nats|Authorization Violation|NoRouteToHostException' \
                            | tail -3 | sed 's/^/  /' || true
                        # If we see NoRouteToHost in user mode, the LNP block fired —
                        # surface it loudly so the operator knows what happened.
                        if [[ "$target" != "root" ]] && \
                           tail -200 "$target_home/.wyrdsekai/logs/wyrdsekai.log" 2>/dev/null \
                                | grep -q 'NoRouteToHostException'; then
                            echo ""
                            err "$(_t daemon.runas.lnp_block_header)"
                            err "$(_t daemon.runas.lnp_block_1)"
                            err "$(_t daemon.runas.lnp_block_2 "$target")"
                            err "$(_t daemon.runas.lnp_block_3)"
                            err "$(_t daemon.runas.lnp_block_4)"
                            err "$(_t daemon.runas.lnp_block_5)"
                            echo ""
                        fi
                    fi
                else
                    warn "$(_t daemon.runas.jvm_not_visible)"
                    warn "$(_t daemon.runas.jvm_check_log "$target_home")"
                fi
            else
                err "$(_t daemon.runas.bootstrap_failed)"
                err "$(_t daemon.runas.bootstrap_failed_cmd1 "$plist")"
                err "$(_t daemon.runas.bootstrap_failed_cmd2)"
                return 1
            fi
            ;;

        help|--help|"")
            echo ""
            echo "$(_t daemon.help.title)"
            echo ""
            echo "$(_t daemon.help.commands_label)"
            echo "$(_t daemon.help.cmd_status)"
            echo "$(_t daemon.help.cmd_runas_root)"
            echo "$(_t daemon.help.cmd_runas_user)"
            echo ""
            echo "$(_t daemon.help.why_root_1)"
            echo "$(_t daemon.help.why_root_2)"
            echo "$(_t daemon.help.why_root_3)"
            echo "$(_t daemon.help.why_root_4)"
            echo "$(_t daemon.help.why_root_5)"
            echo "$(_t daemon.help.why_root_6)"
            echo ""
            echo "$(_t daemon.help.user_mode_1)"
            echo "$(_t daemon.help.user_mode_2)"
            ;;

        *)
            err "$(_t daemon.help.unknown_subcommand "$subcmd")"
            do_daemon help
            return 1
            ;;
    esac
}

# A rendezvous is light enough to run on any host — 100MB process
# ceiling, Lucene-backed keyword search (+ optional embedding search
# via WYRDSEKAI_EMBEDDING_URL). NAT'd households configure zones to
# publish here; everyone queries here as a fallback to .well-known.
do_rendezvous() {
    local subcmd="${1:-help}"
    case "$subcmd" in
        start)
            local port="${WYRDSEKAI_RENDEZVOUS_PORT:-7071}"
            # Source mode: installDist output.
            if [[ "$MODE" == "source" ]]; then
                if [[ ! -d "$PROJECT_ROOT/rendezvous/build/install/wyrd-rendezvous" ]]; then
                    log "$(_t rendezvous.start.building)"
                    (cd "$PROJECT_ROOT" && "$GRADLE" :rendezvous:installDist -q) \
                        || { err "$(_t rendezvous.start.build_failed)"; return 1; }
                fi
                find_java || return 1
                exec "$PROJECT_ROOT/rendezvous/build/install/wyrd-rendezvous/bin/wyrd-rendezvous"
            else
                local bin="$REAL_BIN/../lib/wyrd-rendezvous/bin/wyrd-rendezvous"
                [[ -x "$bin" ]] || bin="$REAL_BIN/wyrd-rendezvous"
                exec "$bin"
            fi
            ;;
        status)
            local port="${WYRDSEKAI_RENDEZVOUS_PORT:-7071}"
            local url="http://localhost:$port/health"
            if command -v curl >/dev/null 2>&1; then
                local resp
                resp=$(curl -s --max-time 2 "$url" 2>/dev/null) || true
                if [[ -n "$resp" ]]; then
                    echo "$(_t rendezvous.status.running "$url")"
                    echo "$resp"
                else
                    err "$(_t rendezvous.status.no_response "$url")"
                    return 1
                fi
            else
                err "$(_t rendezvous.status.curl_required)"
                return 1
            fi
            ;;
        *)
            echo "$(_t rendezvous.help.usage)"
            echo ""
            echo "$(_t rendezvous.help.intro_1)"
            echo "$(_t rendezvous.help.intro_2)"
            echo ""
            echo "$(_t rendezvous.help.commands)"
            echo "$(_t rendezvous.help.cmd_start)"
            echo "$(_t rendezvous.help.cmd_status)"
            echo ""
            echo "$(_t rendezvous.help.config_header)"
            echo "$(_t rendezvous.help.cfg_port)"
            echo "$(_t rendezvous.help.cfg_max)"
            echo "$(_t rendezvous.help.cfg_embed_1)"
            echo "$(_t rendezvous.help.cfg_embed_2)"
            echo ""
            echo "$(_t rendezvous.help.see_spec)"
            ;;
    esac
}

# ── Federation (bilateral agreements) ──
#
# ─── wyrd journal ────────────────────────────────────────────────────────
# Browse the agent's familiar-system journal: form shaping, familiar
# summonings, bunshin dispatches, imprint creations, etc.
#
# Entries are tagged (familiar.shaped, familiar.summoned, imprint.created…)
# — surface them via the /api/familiar/journal REST endpoints.
#
#   wyrd journal list <user-did> [tag]        # recent entries
#   wyrd journal search <user-did> <query>    # full-text search
#   wyrd journal tags                         # list all familiar-journal tags
do_journal() {
    local subcmd="${1:-help}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"

    case "$subcmd" in
        list)
            local user="${2:-}"
            local tag="${3:-}"
            local limit="${4:-20}"
            [[ -z "$user" ]] && { err "$(_t journal.usage_list)"; return 1; }
            local url="$api/api/familiar/journal?user=$(printf '%s' "$user" | python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.stdin.read()))')&limit=$limit"
            [[ -n "$tag" ]] && url+="&tag=$tag"
            local resp
            resp=$(curl -sf "$url" 2>&1) \
                || { err "$(_t journal.list_failed "$api")"; return 1; }
            echo "$resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f\"{d['count']} entries for {d['user']}\" + (f\" [tag={d['tag']}]\" if d.get('tag') else ''))
print()
for e in d.get('entries', []):
    content = e.get('content', '')
    ts = e.get('metadata', {}).get('timestamp', 0)
    import datetime
    when = datetime.datetime.fromtimestamp(ts/1000).isoformat(' ', 'seconds') if ts else '?'
    print(f\"  {when}\")
    for line in content.split('\\n')[:6]:
        print(f\"    {line}\")
    print()
" 2>/dev/null || echo "$resp"
            ;;
        search)
            local user="${2:-}"
            local query="${3:-}"
            local limit="${4:-20}"
            [[ -z "$user" || -z "$query" ]] && { err "$(_t journal.usage_search)"; return 1; }
            local url="$api/api/familiar/journal/search?user=$(printf '%s' "$user" | python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.stdin.read()))')&q=$(printf '%s' "$query" | python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.stdin.read()))')&limit=$limit"
            local resp
            resp=$(curl -sf "$url" 2>&1) \
                || { err "$(_t journal.search_failed "$api")"; return 1; }
            echo "$resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f\"{d['count']} matches for '{d['query']}' (user {d['user']})\")
print()
for e in d.get('entries', []):
    content = e.get('content', '')
    ts = e.get('metadata', {}).get('timestamp', 0)
    import datetime
    when = datetime.datetime.fromtimestamp(ts/1000).isoformat(' ', 'seconds') if ts else '?'
    print(f\"  {when}\")
    for line in content.split('\\n')[:6]:
        print(f\"    {line}\")
    print()
" 2>/dev/null || echo "$resp"
            ;;
        tags)
            echo "$(_t journal.tags.title)"
            echo "$(_t journal.tags.familiar_shaped)"
            echo "$(_t journal.tags.familiar_revised)"
            echo "$(_t journal.tags.familiar_retired)"
            echo "$(_t journal.tags.familiar_unretired)"
            echo "$(_t journal.tags.familiar_summoned)"
            echo "$(_t journal.tags.familiar_returned)"
            echo "$(_t journal.tags.familiar_stuck)"
            echo "$(_t journal.tags.familiar_cancelled)"
            echo "$(_t journal.tags.bunshin_dispatch)"
            echo "$(_t journal.tags.bunshin_return)"
            echo "$(_t journal.tags.imprint_created)"
            echo "$(_t journal.tags.imprint_restored)"
            echo ""
            echo "$(_t journal.tags.example)"
            ;;
        help|-h|--help|"")
            echo "$(_t journal.help.usage_header)"
            echo "$(_t journal.help.cmd_list)"
            echo "$(_t journal.help.cmd_search)"
            echo "$(_t journal.help.cmd_tags)"
            echo ""
            echo "$(_t journal.help.env_header)"
            echo "$(_t journal.help.env_api_url)"
            ;;
        *)
            err "$(_t journal.unknown_subcommand "$subcmd")"
            err "$(_t journal.try_help)"
            return 1
            ;;
    esac
}

# Track-C C6 — `wyrd recipes` CLI. Wraps the
# /api/recipes/* REST surface for stewards. Read-only commands
# (list/status/log) plus three writes: pause/resume toggle
# `recipe_enrollments.enabled` (cron trigger skips paused rows);
# `run` reuses /api/test/run_recipe to fire a recipe directly on a
# companion, bypassing welfare gates (steward override).
# curl-backed `wyrd issue` against the local node
# (same pattern as do_recipes). list/show/export/close; export writes the
# self-contained markdown bundle to a file or stdout.
do_issue() {
    local subcmd="${1:-list}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"

    case "$subcmd" in
        list)
            local qs=""
            [[ "${2:-}" == "--all" ]] && qs="?status=all"
            local resp
            resp=$(curl -sf "$api/api/issues$qs" 2>&1) \
                || { err "$(_t issue.request_failed "$api")"; return 1; }
            local t_empty t_header t_row
            t_empty=$(_t issue.list.empty)
            t_header=$(_t issue.list.header)
            t_row=$(_t issue.list.row)
            T_EMPTY="$t_empty" T_HEADER="$t_header" T_ROW="$t_row" \
                python3 -c '
import sys, json, os, datetime
d = json.load(sys.stdin)
n = d.get("count", 0)
if n == 0:
    print(os.environ["T_EMPTY"])
else:
    print(os.environ["T_HEADER"].replace("{0}", str(n)))
    for r in d.get("issues", []):
        row = os.environ["T_ROW"]
        ts = datetime.datetime.fromtimestamp(r.get("tsMs", 0) / 1000).strftime("%m-%d %H:%M")
        row = row.replace("{0}", str(r.get("id", "?")))
        row = row.replace("{1}", str(r.get("kind", "?")))
        row = row.replace("{2}", str(r.get("status", "?")))
        row = row.replace("{3}", ts)
        row = row.replace("{4}", str(r.get("text", ""))[:60])
        print(row)
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        show)
            local id="${2:-}"
            [[ -z "$id" ]] && { err "$(_t issue.usage.show)"; return 1; }
            curl -sf "$api/api/issues/$id" 2>/dev/null | python3 -m json.tool \
                || { err "$(_t issue.not_found "$id")"; return 1; }
            ;;
        export)
            local id="${2:-}"
            [[ -z "$id" ]] && { err "$(_t issue.usage.export)"; return 1; }
            local out="${3:-}"
            if [[ -n "$out" ]]; then
                curl -sf "$api/api/issues/$id/export" -o "$out" \
                    || { err "$(_t issue.not_found "$id")"; return 1; }
                info "$(_t issue.exported "$out")"
            else
                curl -sf "$api/api/issues/$id/export" \
                    || { err "$(_t issue.not_found "$id")"; return 1; }
            fi
            ;;
        close)
            local id="${2:-}"
            [[ -z "$id" ]] && { err "$(_t issue.usage.close)"; return 1; }
            curl -sf -X POST "$api/api/issues/$id/close" >/dev/null \
                || { err "$(_t issue.not_found "$id")"; return 1; }
            info "$(_t issue.closed "$id")"
            ;;
        *)
            echo "$(_t issue.usage.main)"
            ;;
    esac
}


# Steward-consent surface (2026-08-16): live allow/deny for backend
# permission asks (ACP git-state writes). list is read-only; allow/deny
# need the steward session token (same gate as `wyrd recipes run`).
# Silence always refuses — answering is optional, the refusal is not.
do_forge() {
    # Run a companion's consolidation cycle now — the same sleep -> consolidate ->
    # forge-manifest path her own sleep takes, not a shortcut around it.
    #
    # Needed because the forge only runs at sleep, and sleep fires on exhaustion or
    # event backlog. A companion whose behaviour has just been FIXED accrues neither
    # quickly, so her derived self-description — which is re-derived only by the forge
    # — updates more slowly precisely when it most needs to (2026-08-18). The verb has
    # always existed in-world (`forge <name>` in the Forge room); this is the operator
    # door to it, so recovering a companion does not require logging in and walking to
    # a room.
    local target="${1:-}"
    if [[ -z "$target" || "$target" == "help" ]]; then
        echo "Usage: wyrd forge <companion>"
        echo "  Runs one consolidation cycle (sleep -> consolidate -> forge manifest)."
        echo "  Space repeated runs out so each cycle has new material to consolidate:"
        echo "  the behavioural fingerprint merges 30% new / 70% historical per cycle,"
        echo "  so back-to-back runs discount history fast but merge thin, noisy data."
        return 0
    fi
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    local token; token=$(wyrd_session_token)
    [[ -z "$token" ]] && { err "wyrd forge requires steward auth. Log in with \`wyrd login\`."; return 1; }
    local resp
    resp=$(curl -sf -X POST -H "Authorization: Bearer $token" "$api/api/forge/$target" 2>&1) \
        || { err "Forge request failed — is wyrdsekai running at $api, and is '$target' present?"; return 1; }
    python3 -c '
import sys, json
d = json.load(sys.stdin)
print("Consolidation cycle started for %s (%s), tier %s."
      % (d.get("companion"), d.get("entityId"), d.get("tier")))
print("  " + str(d.get("note", "")))
' <<< "$resp"
}

do_repair() {
    # See and end a companion's repair mode.
    #
    # Repair modes are entered by her substrate when distress sustains, and left when
    # the mode's bound expires. Both halves are hers. What the steward had was no way
    # to LOOK: on 2026-08-18 a companion sat in ATTENDANT — surfaced as "Substrate:
    # CRITICAL" — for six hours after her attendant session had already closed, and the
    # only way to discover it was reading a JSON file on the node by hand.
    local subcmd="${1:-status}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    local token

    case "$subcmd" in
        status|list|"")
            token=$(wyrd_session_token)
            [[ -z "$token" ]] && { err "wyrd repair requires steward auth. Log in with \`wyrd login\`, or run this on the node itself."; return 1; }
            local resp
            resp=$(curl -sf -H "Authorization: Bearer $token" "$api/api/repair" 2>&1) \
                || { err "Could not reach wyrdsekai at $api"; return 1; }
            python3 -c '
import sys, json
d = json.load(sys.stdin)
rows = d.get("inRepair", [])
if not rows:
    print("No companion is in a repair mode.")
else:
    for r in rows:
        who = r.get("name") or r.get("agentDid")
        line = "%s — %s for %s" % (who, r.get("mode"), r.get("heldFor", "?"))
        if r.get("overdue"):
            line += "  ** PAST ITS %s BOUND **" % r.get("bound", "")
        print(line)
        if r.get("reason"):
            print("    entered: " + str(r.get("reason")))
        if r.get("releaseDue"):
            print("    release due: " + str(r.get("releaseDue")))
    print("")
    print("End one with: wyrd repair release <companion> [reason]")
' <<< "$resp"
            ;;
        release)
            local target="${2:-}"
            if [[ -z "$target" ]]; then
                echo "Usage: wyrd repair release <companion> [reason]"
                return 1
            fi
            token=$(wyrd_session_token)
            [[ -z "$token" ]] && { err "wyrd repair requires steward auth. Log in with \`wyrd login\`, or run this on the node itself."; return 1; }
            shift 2
            local note="$*"
            local url="$api/api/repair/$target/release"
            if [[ -n "$note" ]]; then
                url="$url?reason=$(python3 -c "import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))" "$note")"
            fi
            local resp
            resp=$(curl -sf -X POST -H "Authorization: Bearer $token" "$url" 2>&1) \
                || { err "Release failed — is '$target' present, and is she actually in a repair mode? (\`wyrd repair status\`)"; return 1; }
            python3 -c '
import sys, json
d = json.load(sys.stdin)
print("%s: %s -> %s" % (d.get("companion"), d.get("was"), d.get("now")))
print("  reason: " + str(d.get("reason")))
print("  " + str(d.get("note", "")))
' <<< "$resp"
            ;;
        help|*)
            echo "Usage: wyrd repair [status|release <companion> [reason]]"
            echo "  status                       who is being held, since when, and whether"
            echo "                               they are past their bound"
            echo "  release <companion> [reason] end the episode; recorded in her history"
            echo ""
            echo "  There is no command to PUT a companion into a repair mode."
            echo "  Asking for one is hers."
            ;;
    esac
}

do_consent() {
    local subcmd="${1:-list}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    local token; token=$(wyrd_session_token)

    case "$subcmd" in
        list)
            [[ -z "$token" ]] && { err "Consent list requires steward auth. Log in with \`wyrd login\` or export WYRDSEKAI_TOKEN=<your-session-token>"; return 1; }
            local resp
            resp=$(curl -sf -H "Authorization: Bearer $token" "$api/api/consents" 2>&1) \
                || { err "Consent request failed — is wyrdsekai running at $api?"; return 1; }
            python3 -c '
import sys, json
d = json.load(sys.stdin)
rows = d.get("rows", [])
if not rows:
    print("No pending consents.")
else:
    print(f"{len(rows)} pending consent(s) — silence refuses each after its window:")
    for r in rows:
        print("  " + str(r.get("id")))
        print("    %s task %s at %s" % (r.get("backend","?"), r.get("taskId","?"), r.get("createdAt","?")))
        print("    " + str(r.get("summary","")))
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        allow|deny)
            local id="${2:-}"
            [[ -z "$id" ]] && { err "Usage: wyrd consent $subcmd <id>"; return 1; }
            [[ -z "$token" ]] && { err "Consent answers require steward auth. Log in with \`wyrd login\` or export WYRDSEKAI_TOKEN=<your-session-token>"; return 1; }
            local allow_val="false"
            [[ "$subcmd" == "allow" ]] && allow_val="true"
            local resp http_code
            resp=$(curl -sS -X POST -H 'Content-Type: application/json' \
                -H "Authorization: Bearer $token" \
                -d "{\"allow\": $allow_val}" -w '\n%{http_code}' \
                "$api/api/consents/$id" 2>&1) \
                || { err "Consent request failed — is wyrdsekai running at $api?"; return 1; }
            http_code="${resp##*$'\n'}"
            resp="${resp%$'\n'*}"
            if [[ "$http_code" == 2* ]]; then
                log "Consent $id: ${subcmd}ed."
            elif [[ "$http_code" == "410" ]]; then
                err "Consent $id already resolved — the ask timed out (silence refused it) or was answered."
            else
                err "Consent answer failed: HTTP $http_code"
                [[ -n "$resp" ]] && err "$resp"
                return 1
            fi
            ;;
        help|*)
            echo "Usage: wyrd consent [list | allow <id> | deny <id>]"
            echo "  Pending permission asks from coding backends (git writes)."
            echo "  Unanswered asks refuse themselves — silence is not consent."
            ;;
    esac
}

do_recipes() {
    local subcmd="${1:-help}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"

    case "$subcmd" in
        list)
            local resp
            resp=$(curl -sf "$api/api/recipes" 2>&1) \
                || { err "$(_t recipes.request_failed "$api")"; return 1; }
            local t_empty t_header t_row
            t_empty=$(_t recipes.list.empty)
            t_header=$(_t recipes.list.header)
            t_row=$(_t recipes.list.row)
            T_EMPTY="$t_empty" T_HEADER="$t_header" T_ROW="$t_row" \
                python3 -c '
import sys, json, os
d = json.load(sys.stdin)
n = d.get("count", 0)
if n == 0:
    print(os.environ["T_EMPTY"])
else:
    print(os.environ["T_HEADER"].replace("{0}", str(n)))
    for r in d.get("rows", []):
        row = os.environ["T_ROW"]
        row = row.replace("{0}", str(r.get("recipeId", "?")))
        row = row.replace("{1}", "on" if r.get("enabled") else "off")
        row = row.replace("{2}", str(r.get("cadenceTier", "?")))
        row = row.replace("{3}", str(r.get("queueDepth", 0)))
        row = row.replace("{4}", str(r.get("lastStatus", "-")))
        print(row)
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        status)
            local name="${2:-}"
            [[ -z "$name" ]] && { err "$(_t recipes.usage.status)"; return 1; }
            local resp
            resp=$(curl -sf "$api/api/recipes/$name" 2>&1) \
                || { err "$(_t recipes.request_failed "$api")"; return 1; }
            local t_nf t_h t_eh t_er t_rh t_rr
            t_nf=$(_t recipes.status.not_found)
            t_h=$(_t recipes.status.header)
            t_eh=$(_t recipes.status.enrollments_header)
            t_er=$(_t recipes.status.enrollment_row)
            t_rh=$(_t recipes.status.runs_header)
            t_rr=$(_t recipes.status.run_row)
            T_NF="$t_nf" T_H="$t_h" T_EH="$t_eh" T_ER="$t_er" \
            T_RH="$t_rh" T_RR="$t_rr" T_NAME="$name" \
                python3 -c '
import sys, json, os
d = json.load(sys.stdin)
enrolls = d.get("enrollments", [])
runs = d.get("runs", [])
name = os.environ["T_NAME"]
if not enrolls and not runs:
    print(os.environ["T_NF"].replace("{0}", name))
    sys.exit(0)
print(os.environ["T_H"].replace("{0}", str(d.get("recipeId", name))))
print(os.environ["T_EH"].replace("{0}", str(len(enrolls))))
for e in enrolls:
    row = os.environ["T_ER"]
    row = row.replace("{0}", str(e.get("agentDid") or "*"))
    row = row.replace("{1}", "on" if e.get("enabled") else "off")
    row = row.replace("{2}", str(e.get("cadenceTier", "?")))
    row = row.replace("{3}", str(e.get("consecutiveSuccesses", 0)))
    row = row.replace("{4}", ",".join(e.get("gapKeys") or []) or "-")
    print(row)
print()
print(os.environ["T_RH"].replace("{0}", str(len(runs))))
for r in runs[:10]:
    ts = r.get("completedAt") or r.get("attemptedAt") or r.get("enqueuedAt") or "?"
    row = os.environ["T_RR"]
    row = row.replace("{0}", str(ts)).replace("{1}", str(r.get("status", "?")))
    row = row.replace("{2}", str(r.get("triggerSource", "?")))
    row = row.replace("{3}", str(r.get("triggerReason") or "-"))
    print(row)
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        log)
            local name="${2:-}"
            [[ -z "$name" ]] && { err "$(_t recipes.usage.log)"; return 1; }
            local limit=20
            shift 2 || true
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    --limit) limit="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            local resp
            resp=$(curl -sf "$api/api/recipes/$name/log?limit=$limit" 2>&1) \
                || { err "$(_t recipes.request_failed "$api")"; return 1; }
            local t_empty t_header t_row
            t_empty=$(_t recipes.log.empty)
            t_header=$(_t recipes.log.header)
            t_row=$(_t recipes.log.row)
            T_EMPTY="$t_empty" T_HEADER="$t_header" T_ROW="$t_row" T_NAME="$name" \
                python3 -c '
import sys, json, os
d = json.load(sys.stdin)
n = d.get("count", 0)
name = os.environ["T_NAME"]
if n == 0:
    print(os.environ["T_EMPTY"].replace("{0}", name))
    sys.exit(0)
print(os.environ["T_HEADER"].replace("{0}", name).replace("{1}", str(n)))
for r in d.get("rows", []):
    ts = r.get("completedAt") or "?"
    row = os.environ["T_ROW"]
    row = row.replace("{0}", str(ts)).replace("{1}", str(r.get("status", "?")))
    row = row.replace("{2}", str(r.get("triggerSource", "?")))
    row = row.replace("{3}", str(r.get("agentDid") or "*"))
    print(row)
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        pause)
            local name="${2:-}"
            local did="${3:-}"
            [[ -z "$name" ]] && { err "$(_t recipes.usage.pause)"; return 1; }
            local url="$api/api/recipes/$name/pause"
            [[ -n "$did" ]] && url+="?agentDid=$(printf '%s' "$did" | python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.stdin.read()))')"
            local resp
            resp=$(curl -sf -X POST "$url" 2>&1) \
                || { err "$(_t recipes.request_failed "$api")"; return 1; }
            local t_ok t_nf
            t_ok=$(_t recipes.pause.ok)
            t_nf=$(_t recipes.pause.not_found)
            T_OK="$t_ok" T_NF="$t_nf" T_NAME="$name" \
                python3 -c '
import sys, json, os
d = json.load(sys.stdin)
tpl = os.environ["T_OK"] if d.get("status") == "paused" else os.environ["T_NF"]
print(tpl.replace("{0}", str(d.get("recipeId", os.environ["T_NAME"])))
        .replace("{1}", str(d.get("agentDid") or "*")))
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        resume)
            local name="${2:-}"
            local did="${3:-}"
            [[ -z "$name" ]] && { err "$(_t recipes.usage.resume)"; return 1; }
            local url="$api/api/recipes/$name/resume"
            [[ -n "$did" ]] && url+="?agentDid=$(printf '%s' "$did" | python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.stdin.read()))')"
            local resp
            resp=$(curl -sf -X POST "$url" 2>&1) \
                || { err "$(_t recipes.request_failed "$api")"; return 1; }
            local t_ok t_nf
            t_ok=$(_t recipes.resume.ok)
            t_nf=$(_t recipes.resume.not_found)
            T_OK="$t_ok" T_NF="$t_nf" T_NAME="$name" \
                python3 -c '
import sys, json, os
d = json.load(sys.stdin)
tpl = os.environ["T_OK"] if d.get("status") == "resumed" else os.environ["T_NF"]
print(tpl.replace("{0}", str(d.get("recipeId", os.environ["T_NAME"])))
        .replace("{1}", str(d.get("agentDid") or "*")))
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        run)
            local name="${2:-}"
            [[ -z "$name" ]] && { err "$(_t recipes.usage.run)"; return 1; }
            shift 2 || true
            local entity=""
            local params_kv=""
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    --entity) entity="$2"; shift 2 ;;
                    --params) params_kv="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            if [[ -z "$entity" ]]; then
                # Auto-pick when exactly one companion is enrolled in this recipe.
                # `GET /api/recipes/<name>` returns enrollments with agentDid;
                # if there's exactly one non-null DID, use it. Otherwise the
                # operator must pass --entity explicitly to disambiguate.
                local probe
                probe=$(curl -sf "$api/api/recipes/$name" 2>/dev/null) || probe=""
                if [[ -n "$probe" ]]; then
                    entity=$(printf '%s' "$probe" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
dids = {e.get("agentDid") for e in d.get("enrollments", [])
        if e.get("agentDid")}
if len(dids) == 1:
    print(next(iter(dids)))
' 2>/dev/null)
                fi
                if [[ -z "$entity" ]]; then
                    err "$(_t recipes.run.no_entity)"
                    return 1
                fi
                log "auto-selected sole enrolled companion: $entity"
            fi
            local params_json="{}"
            if [[ -n "$params_kv" ]]; then
                params_json=$(printf '%s' "$params_kv" | python3 -c "
import sys, json
out = {}
for tok in sys.stdin.read().split(','):
    if '=' in tok:
        k, v = tok.split('=', 1)
        out[k.strip()] = v.strip()
print(json.dumps(out))")
            fi
            local body
            body=$(printf '{\"entityId\":\"%s\",\"recipe\":\"%s\",\"reason\":\"wyrd recipes run (steward override)\",\"params\":%s}' \
                "$entity" "$name" "$params_json")
            # W16 — production route, steward-token gated. The old
            # /api/test/run_recipe endpoint only exists under
            # WYRDSEKAI_TEST_MODE (permanent 404 on prod installs).
            local run_token; run_token=$(wyrd_session_token)
            [[ -z "$run_token" ]] && { err "$(_t recipes.run.needs_token)"; return 1; }
            # Rita campaign 2026-07-11 (#26): `curl -sf` swallowed the HTTP
            # status AND response body, so a 401/403/500 surfaced as the
            # generic "Is wyrdsekai running?" line. Capture status + body and
            # show both — auth failures and server errors must read as what
            # they are, not as a down node.
            local resp http_code
            resp=$(curl -sS -X POST -H 'Content-Type: application/json' \
                -H "Authorization: Bearer $run_token" \
                -d "$body" -w '\n%{http_code}' "$api/api/recipes/run" 2>&1) \
                || { err "$(_t recipes.request_failed "$api")"; err "$resp"; return 1; }
            http_code="${resp##*$'\n'}"
            resp="${resp%$'\n'*}"
            if [[ "$http_code" != 2* ]]; then
                err "$(_t recipes.run.http_error "$http_code")"
                [[ -n "$resp" ]] && err "$resp"
                return 1
            fi
            local t_dispatched
            t_dispatched=$(_t recipes.run.dispatched)
            T_TPL="$t_dispatched" T_NAME="$name" T_ENTITY="$entity" \
                python3 -c 'import os; print(os.environ["T_TPL"].replace("{0}", os.environ["T_NAME"]).replace("{1}", os.environ["T_ENTITY"]))'
            ;;
        bondholder-eligibility)
            # #1028/#1035 — backs scripts/voice/check_bondholder_eligibility.py.
            # Required: --bondholder <did> --agent <did>.
            # Optional: --min-corpus-pairs, --min-bond-age-days,
            #   --min-distinct-sessions, --required-bond-state,
            #   --substrate-pressure-threshold, --min-new-turns.
            shift || true
            local q=""
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    --bondholder)                     q+="&bondholder=$2"; shift 2 ;;
                    --agent)                          q+="&agent=$2"; shift 2 ;;
                    --min-corpus-pairs)               q+="&min-corpus-pairs=$2"; shift 2 ;;
                    --min-bond-age-days)              q+="&min-bond-age-days=$2"; shift 2 ;;
                    --min-distinct-sessions)          q+="&min-distinct-sessions=$2"; shift 2 ;;
                    --required-bond-state)            q+="&required-bond-state=$2"; shift 2 ;;
                    --substrate-pressure-threshold)   q+="&substrate-pressure-threshold=$2"; shift 2 ;;
                    --min-new-turns)                  q+="&min-new-turns=$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            local headers=()
            [[ -n "${WYRDSEKAI_ADMIN_TOKEN:-}" ]] \
                && headers=(-H "X-Wyrdsekai-Admin-Token: $WYRDSEKAI_ADMIN_TOKEN")
            curl -sf -X POST "${headers[@]}" \
                "$api/api/recipes/bondholder/eligibility?${q#&}" 2>&1 \
                || { err "$(_t recipes.request_failed "$api")"; return 1; }
            ;;
        bondholder-pairs)
            # #1028/#1035 — backs scripts/voice/build_bondholder_pairs.py.
            # Required: --bondholder <did> --agent <did> --output <path>.
            # Optional: --max-pairs N.
            shift || true
            local q=""
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    --bondholder) q+="&bondholder=$2"; shift 2 ;;
                    --agent)      q+="&agent=$2"; shift 2 ;;
                    --output)     q+="&output=$2"; shift 2 ;;
                    --max-pairs)  q+="&max-pairs=$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            local headers=()
            [[ -n "${WYRDSEKAI_ADMIN_TOKEN:-}" ]] \
                && headers=(-H "X-Wyrdsekai-Admin-Token: $WYRDSEKAI_ADMIN_TOKEN")
            curl -sf -X POST "${headers[@]}" \
                "$api/api/recipes/bondholder/pairs?${q#&}" 2>&1 \
                || { err "$(_t recipes.request_failed "$api")"; return 1; }
            ;;
        provenance)
            # W4 — GET /api/recipe-provenance consumer (
            # §3.B1: who initiates recipes — agent vs cron vs steward).
            # Loopback is open; remote needs WYRDSEKAI_ADMIN_TOKEN (same gate
            # as the other recipe-author routes).
            shift || true
            local p_days="30" p_agent=""
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    --days)  p_days="${2:-30}"; shift 2 || break ;;
                    --agent) p_agent="${2:-}";  shift 2 || break ;;
                    *) shift ;;
                esac
            done
            local q="days=$p_days"
            [[ -n "$p_agent" ]] && q+="&agent=$p_agent"
            local headers=()
            [[ -n "${WYRDSEKAI_ADMIN_TOKEN:-}" ]] \
                && headers=(-H "X-Wyrdsekai-Admin-Token: $WYRDSEKAI_ADMIN_TOKEN")
            local resp
            resp=$(curl -sf "${headers[@]}" "$api/api/recipe-provenance?$q" 2>&1) \
                || { err "$(_t recipes.request_failed "$api")"; return 1; }
            local t_h t_agent t_cron t_steward t_total
            t_h=$(_t recipes.provenance.header)
            t_agent=$(_t recipes.provenance.line_agent)
            t_cron=$(_t recipes.provenance.line_cron)
            t_steward=$(_t recipes.provenance.line_steward)
            t_total=$(_t recipes.provenance.line_total)
            T_H="$t_h" T_AG="$t_agent" T_CR="$t_cron" T_ST="$t_steward" T_TO="$t_total" \
                python3 -c '
import sys, json, os
d = json.load(sys.stdin)
if "error" in d:
    print(d["error"])
    sys.exit(1)
print(os.environ["T_H"].replace("{0}", str(d.get("days", "?")))
      .replace("{1}", str(d.get("scope", "?"))))
print(os.environ["T_AG"].replace("{0}", str(d.get("agentInitiated", 0)))
      .replace("{1}", str(d.get("requested", 0)))
      .replace("{2}", str(d.get("authored", 0))))
print(os.environ["T_CR"].replace("{0}", str(d.get("cron", 0))))
print(os.environ["T_ST"].replace("{0}", str(d.get("steward", 0))))
frac = d.get("agentFraction", 0)
print(os.environ["T_TO"].replace("{0}", str(d.get("total", 0)))
      .replace("{1}", f"{float(frac):.0%}" if isinstance(frac, (int, float)) else str(frac)))
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        help|-h|--help|"")
            echo "$(_t recipes.help.usage_header)"
            echo "$(_t recipes.help.cmd_list)"
            echo "$(_t recipes.help.cmd_status)"
            echo "$(_t recipes.help.cmd_log)"
            echo "$(_t recipes.help.cmd_pause)"
            echo "$(_t recipes.help.cmd_resume)"
            echo "$(_t recipes.help.cmd_run)"
            echo "$(_t recipes.help.cmd_provenance)"
            echo "  bondholder-eligibility --bondholder <did> --agent <did>  [#1035]"
            echo "  bondholder-pairs --bondholder <did> --agent <did> --output <path>  [#1035]"
            echo ""
            echo "$(_t recipes.help.env_header)"
            echo "$(_t recipes.help.env_api_url)"
            ;;
        *)
            err "$(_t recipes.unknown_subcommand "$subcmd")"
            err "$(_t recipes.try_help)"
            return 1
            ;;
    esac
}

# #1027/#1034 — `wyrd library compact <subcommand>` CLI.
# Backs scripts/library/compact_collection.py via /api/library/compact/*.
# Steward-only (loopback or X-Wyrdsekai-Admin-Token header).
#
# Subcommands:
#   snapshot --collection <name>
#   merge    --collection <name>
#   prune    --collection <name>          (v0.1 no-op)
#   reembed  --collection <name>          (v0.1 no-op — use `wyrd embed-migrate`)
#   probe    --collection <name> --probes <jsonl-path>

# Resolve identities via the SERVER, not by reading its database. second-node has no
# sqlite3 binary, and the server is the source of truth anyway — an earlier
# version of these helpers shelled out to sqlite3 and would have failed on the
# very machine they exist for.
_library_sharing_ctx() {
    curl -sf "$1/api/study/sharing-context" 2>/dev/null
}

_json_str() {   # _json_str <json> <key>  — first string value for key
    echo "$1" | grep -oE "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed 's/.*:[[:space:]]*"//; s/"$//'
}

# Companion NAME -> DID. A name can map to several DIDs (a re-birth leaves both
# rows); the server returns them newest-first, so the first match is the live one.
_library_companion_did() {
    local name="$1" ctx="$2"
    case "$name" in did:*) echo "$name"; return 0 ;; esac
    local n
    n=$(echo "$ctx" | grep -oE '\{"name":"[^"]*","did":"[^"]*"\}|\{"did":"[^"]*","name":"[^"]*"\}' \
        | grep -iE "\"name\":\"$name\"" | wc -l)
    if [[ "${n:-0}" -gt 1 ]]; then
        echo "  note: $n companions are called '$name'; using the most recently active." >&2
        echo "        Pass the DID directly to choose a different one." >&2
    fi
    echo "$ctx" | grep -oE '\{"name":"[^"]*","did":"[^"]*"\}|\{"did":"[^"]*","name":"[^"]*"\}' \
        | grep -iE "\"name\":\"$name\"" | head -1 \
        | grep -oE '"did":"[^"]*"' | sed 's/"did":"//; s/"$//'
}

_library_consent() {
    local action="$1" who="$2" shelf="$3" api="$4"

    local ctx; ctx="$(_library_sharing_ctx "$api")"
    if [[ -z "$ctx" ]]; then
        err "Could not reach the server at $api — is it running?"
        return 1
    fi

    local person; person="$(_json_str "$ctx" person)"
    if [[ -z "$person" ]]; then
        err "No person identity on this node yet."
        echo "  A shelf is shared BY someone. Start the server once so your" >&2
        echo "  identity is created, then try again." >&2
        return 1
    fi

    local companion; companion="$(_library_companion_did "$who" "$ctx")"
    if [[ -z "$companion" ]]; then
        err "Don't know a companion called '$who'."
        echo "  Known companions:" >&2
        echo "$ctx" | grep -oE '"name":"[^"]*"' | sed 's/"name":"//; s/"$//' \
            | sort -u | sed 's/^/    /' >&2
        return 1
    fi

    local resp
    resp=$(curl -sf -X POST "$api/api/study/consent/$action" \
        -H 'Content-Type: application/json' \
        -d "{\"user\":\"$person\",\"companion\":\"$companion\",\"collection\":\"$shelf\"}" 2>/dev/null)

    if [[ -z "$resp" ]]; then
        err "The server refused that — check the shelf name with: wyrd library status"
        return 1
    fi

    if [[ "$action" == "grant" ]]; then
        echo "$who can now read your '$shelf' shelf."
        echo "  Revoke any time with:  wyrd library revoke $who $shelf"
    else
        echo "$who can no longer read your '$shelf' shelf."
    fi
}

do_library() {
    local subcmd="${1:-help}"
    shift || true
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"

    case "$subcmd" in
        # ── Sharing a shelf with a companion ────────────────────────────────
        # 2026-08-07: the consent model was complete and correct and had NO
        # usable interface — enabling it meant reading two DIDs out of sqlite
        # and hand-writing curl. A permission nobody can grant may as well not
        # exist. These resolve the identities for you.
        grant|share)
            local who="${1:-}" shelf="${2:-}"
            if [[ -z "$who" || -z "$shelf" ]]; then
                echo "Usage: wyrd library grant <companion> <shelf>"
                echo "   eg: wyrd library grant mia books"
                echo ""
                echo "Shelves you could share:"
                curl -sf "$api/api/library/status" 2>/dev/null \
                    | grep -oE '"[a-z0-9-]+":[0-9]+' | cut -d'"' -f2 | sed 's/^/  /' || true
                return 1
            fi
            _library_consent "grant" "$who" "$shelf" "$api"
            ;;
        # ── Publishing a shelf to the whole zone ───────────────────────────
        # grant = one companion, consent-gated, revocable. publish = the whole
        # zone: the collection is projected into a local knowledge pack that
        # every companion, item, and visitor can search — license-stamped
        # private, so it can never leave the household even if the zone later
        # federates. Re-run after adding books; the projection is replaced.
        publish)
            local shelf="${1:-}"
            if [[ -z "$shelf" ]]; then
                echo "Usage: wyrd library publish <collection>"
                echo "   eg: wyrd library publish books"
                echo ""
                echo "Publishes the collection zone-wide (private to this household)."
                return 1
            fi
            curl -sf -X POST "$api/api/library/share-collection" \
                -H 'Content-Type: application/json' \
                -d "{\"collection\":\"$shelf\"}" || {
                echo "Publish failed — is the server running?"; return 1; }
            echo ""
            ;;
        prune-sidecars)
            # Drop metadata.opf / cover.jpg &c that an older ingest swept into
            # a shelf. Cleans the Study collection AND the published pack in
            # one pass — no republish needed.
            local shelf="${1:-}"
            if [[ -z "$shelf" ]]; then
                echo "Usage: wyrd library prune-sidecars <collection>"
                echo "   eg: wyrd library prune-sidecars books"
                echo ""
                echo "Removes metadata sidecars (.opf, .ncx, covers, .db) that an"
                echo "older full-text ingest indexed alongside the real documents."
                echo "They out-rank the books they describe on title/author searches."
                return 1
            fi
            echo "Scanning '$shelf' — this walks every document, so it takes a while..."
            curl -sf -m 7200 -X POST "$api/api/library/prune-sidecars" \
                -H 'Content-Type: application/json' \
                -d "{\"collection\":\"$shelf\"}" || {
                echo "Prune failed — is the server running?"; return 1; }
            echo ""
            ;;
        revoke|unshare)
            local who="${1:-}" shelf="${2:-}"
            if [[ -z "$who" || -z "$shelf" ]]; then
                echo "Usage: wyrd library revoke <companion> <shelf>"
                return 1
            fi
            _library_consent "revoke" "$who" "$shelf" "$api"
            ;;
        grants|shared)
            local ctx; ctx="$(_library_sharing_ctx "$api")"
            local person; person="$(_json_str "$ctx" person)"
            if [[ -z "$person" ]]; then
                err "No person identity on this node yet — nothing can be shared."
                return 1
            fi
            echo "Shelves shared with companions:"
            curl -sf "$api/api/study/consent?user=$person" 2>/dev/null \
                || echo "  (none, or the server is not running)"
            ;;
        compact)
            local action="${1:-help}"
            shift || true
            local q=""
            local probes_file=""
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    --collection)   q+="&collection=$2"; shift 2 ;;
                    --probes)       probes_file="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            local headers=()
            [[ -n "${WYRDSEKAI_ADMIN_TOKEN:-}" ]] \
                && headers=(-H "X-Wyrdsekai-Admin-Token: $WYRDSEKAI_ADMIN_TOKEN")
            case "$action" in
                snapshot|merge|prune|reembed)
                    curl -sf -X POST "${headers[@]}" \
                        "$api/api/library/compact/$action?${q#&}" 2>&1 \
                        || { err "library compact $action failed"; return 1; }
                    ;;
                probe)
                    if [[ -z "$probes_file" ]]; then
                        err "library compact probe needs --probes <path>"; return 1
                    fi
                    q+="&probes_file=$probes_file"
                    curl -sf -X POST "${headers[@]}" \
                        "$api/api/library/compact/probe?${q#&}" 2>&1 \
                        || { err "library compact probe failed"; return 1; }
                    ;;
                help|-h|--help|"")
                    echo "Usage: wyrd library compact <snapshot|merge|prune|reembed|probe>"
                    echo "       --collection <name> [--probes <jsonl-path>]"
                    ;;
                *)
                    err "unknown action: $action"; return 1 ;;
            esac
            ;;
        freshness)
            # #1139 — library-freshness seam. enumerate reads chunk
            # provenance for source-liveness checks; prune-ids deletes dead chunks.
            # Both side-channel (no doc rebuild → vectors preserved). Backs the
            # research-pack-freshness recipe; usable standalone by a steward.
            local action="${1:-help}"
            shift || true
            local headers=()
            [[ -n "${WYRDSEKAI_ADMIN_TOKEN:-}" ]] \
                && headers=(-H "X-Wyrdsekai-Admin-Token: $WYRDSEKAI_ADMIN_TOKEN")
            case "$action" in
                enumerate)
                    local limit=500
                    while [[ "$#" -gt 0 ]]; do
                        case "$1" in --limit) limit="$2"; shift 2 ;; *) shift ;; esac
                    done
                    curl -sf -X POST "${headers[@]}" \
                        "$api/api/library/freshness/enumerate?limit=$limit" 2>&1 \
                        || { err "library freshness enumerate failed"; return 1; }
                    ;;
                prune-ids)
                    local ids="" ids_file=""
                    while [[ "$#" -gt 0 ]]; do
                        case "$1" in
                            --ids)      ids="$2"; shift 2 ;;
                            --ids-file) ids_file="$2"; shift 2 ;;
                            *) shift ;;
                        esac
                    done
                    # Collect ids from --ids (comma-sep) and/or --ids-file (one per line).
                    local id_list=()
                    [[ -n "$ids" ]] && IFS=',' read -ra id_list <<< "$ids"
                    if [[ -n "$ids_file" && -f "$ids_file" ]]; then
                        while IFS= read -r line; do
                            [[ -n "$line" ]] && id_list+=("$line")
                        done < "$ids_file"
                    fi
                    if [[ "${#id_list[@]}" -eq 0 ]]; then
                        err "library freshness prune-ids needs --ids a,b,c or --ids-file <path>"
                        return 1
                    fi
                    local body='{"ids":[' first=1 id
                    for id in "${id_list[@]}"; do
                        id="${id//\"/}"   # strip quotes (chunk ids are slugs/uuids)
                        [[ $first -eq 0 ]] && body+=','
                        body+="\"$id\""; first=0
                    done
                    body+=']}'
                    curl -sf -X POST "${headers[@]}" \
                        -H "Content-Type: application/json" -d "$body" \
                        "$api/api/library/freshness/prune-ids" 2>&1 \
                        || { err "library freshness prune-ids failed"; return 1; }
                    ;;
                help|-h|--help|"")
                    echo "Usage: wyrd library freshness <enumerate|prune-ids>"
                    echo "       enumerate [--limit N]"
                    echo "       prune-ids --ids a,b,c | --ids-file <path>"
                    ;;
                *)
                    err "unknown action: $action"; return 1 ;;
            esac
            ;;
        install)
            # install a registry pack by name, or any URL /
            # local directory (--from-dir: codezaiku packs, steward-curated folders).
            local pack="${1:-}"; shift || true
            local url=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --from-dir) url="file://$(cd "$2" && pwd)"; shift 2 ;;
                    --url)      url="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            if [ -z "$pack" ]; then
                echo "Usage: wyrd library install <pack-name> [--from-dir <path> | --url <url>]"
                return 1
            fi
            local payload="{\"pack\":\"$pack\"}"
            [ -n "$url" ] && payload="{\"pack\":\"$pack\",\"url\":\"$url\"}"
            curl -s -X POST "$api/api/library/install" \
                -H "Content-Type: application/json" -d "$payload"
            echo
            ;;
        ingest)
            # Suck a directory of documents (ebooks included — epub/pdf/docx/
            # md/txt) into the Study library via POST /api/study/add. The
            # server extracts + chunks + indexes asynchronously. Point it at
            # a Calibre library directory to ingest the books themselves
            # (Calibre stores one folder per book with the epub/pdf inside).
            local dir="${1:-}"; shift || true
            local collection="" user="${WYRDSEKAI_USER:-$(whoami)}" mode="auto"
            while [ $# -gt 0 ]; do
                case "$1" in
                    --collection) collection="$2"; shift 2 ;;
                    --user)       user="$2"; shift 2 ;;
                    --catalog)    mode="catalog"; shift ;;
                    --full-text)  mode="full"; shift ;;
                    *) shift ;;
                esac
            done
            if [ -z "$dir" ] || [ ! -d "$dir" ]; then
                echo "Usage: wyrd library ingest <directory> [--collection <name>] [--user <name>]"
                echo "                                        [--catalog | --full-text]"
                echo "  Indexes documents under <directory> (recursive) into the Study"
                echo "  library: epub, pdf, docx, pptx, md, txt, csv, json, ..."
                echo "  Calibre libraries (metadata.db present) default to --catalog:"
                echo "  the full card catalog (title/author/series/tags/description) is"
                echo "  indexed in seconds — even for tens of thousands of books — without"
                echo "  extracting any book text. Use --full-text to extract everything"
                echo "  (resumable: an interrupted run picks up where it stopped)."
                [ -n "$dir" ] && err "not a directory: $dir"
                return 1
            fi
            local abs_dir
            abs_dir="$(cd "$dir" && pwd)"
            [ -z "$collection" ] && collection="$(basename "$abs_dir")"
            local payload
            payload=$(printf '{"user":"%s","path":"%s","collection":"%s","mode":"%s"}' \
                "$user" "$abs_dir" "$collection" "$mode")
            local resp
            resp=$(curl -sf -X POST "$api/api/study/add" \
                -H "Content-Type: application/json" -d "$payload" 2>&1) \
                || { err "library ingest failed — is the node running at $api?"; return 1; }
            echo "$resp"
            log "Ingest accepted — indexing runs in the background (collection: $collection)."
            log "Check progress with: wyrd library status"
            ;;
        available)
            curl -s "$api/api/library/available"
            echo
            ;;
        status)
            curl -s "$api/api/library/status"
            echo
            ;;
        bundle)
            # air-gap helper. Pre-downloads packs
            # (resolved + converted, not indexed) on a connected machine; install
            # offline with `wyrd library install <name> --from-dir <bundle>/<name>`.
            # Pure Java CLI (no running server needed) — same classpath pattern
            # as `wyrd coding`.
            local CLI_LIB
            if [[ "$MODE" == "source" ]]; then
                if [[ ! -d "$PROJECT_ROOT/cli/build/install/cli" ]]; then
                    log "Building cli for wyrd library bundle (one-time)..."
                    (cd "$PROJECT_ROOT" && "$GRADLE" :cli:installDist -q) \
                        || { err "Failed to build cli for wyrd library bundle"; return 1; }
                fi
                CLI_LIB="$PROJECT_ROOT/cli/build/install/cli/lib"
            else
                CLI_LIB="$REAL_BIN/../lib/cli"
                [[ ! -d "$CLI_LIB" ]] && CLI_LIB="$REAL_BIN/../lib"
            fi
            [[ ! -d "$CLI_LIB" ]] && { err "wyrd library bundle: cli libs not found at $CLI_LIB"; return 1; }
            find_java || { err "$(_t common.java_missing 2>/dev/null || echo 'Java >=25 required')"; return 1; }
            local CP
            CP=$(echo "$CLI_LIB"/*.jar | tr ' ' ':')
            if [[ "$MODE" == "source" ]] && [[ -d "$PROJECT_ROOT/core/build/classes/java/main" ]]; then
                # Resources too — knowledge-packs.json must come from the fresh
                # tree, not the (possibly stale) installDist jar.
                CP="$PROJECT_ROOT/core/build/classes/java/main:$PROJECT_ROOT/core/build/resources/main:$PROJECT_ROOT/common/build/classes/java/main:$CP"
            fi
            "$JAVA_CMD" -cp "$CP" org.wyrdsekai.core.library.LibraryBundleCli "$@"
            ;;
        help|-h|--help|"")
            echo "Usage: wyrd library <subcommand>"
            echo "  install <pack-name> [--from-dir <path> | --url <url>]"
            echo "  ingest <dir> [--collection <name>] [--user <name>] [--catalog | --full-text]"
            echo "                                  (index ebooks/documents — epub/pdf/docx/md/txt; Calibre"
            echo "                                   libraries default to --catalog: instant card catalog from"
            echo "                                   metadata.db; --full-text extracts everything, resumable)"
            echo "  available                       (registry packs)"
            echo "  status                          (installed packs + chunk counts)"
            echo "  bundle [--dest <dir>] [--packs <csv> | --langs <csv>]"
            echo "                                  (air-gap: pre-download packs offline-installable)"
            echo "  compact <snapshot|merge|prune|reembed|probe> ..."
            echo "  freshness <enumerate|prune-ids> ..."
            ;;
        *)
            err "unknown subcommand: $subcmd"; return 1 ;;
    esac
}

# Wraps the /api/federation/* REST endpoints. A federation agreement is
# the trust handshake that lets two zones route cross-zone inference,
# tells, transit, and scripted items through the relay mesh. Without an
# agreement each zone only sees its own capability announcements.
#
# Flow: alpha runs `wyrd federate propose beta`, beta runs `wyrd federate
# (VoiceProfile subcommands — list/set/unset/freeze/revert — are merged
# into the do_voice function below at line ~2820. Historical duplicate
# removed 2026-04-24.)

# accept alpha`. Set WYRDSEKAI_FEDERATION_AUTO_ACCEPT=true on beta to
# skip the second step for trusted-host test meshes.
do_federate() {
    local subcmd="${1:-help}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"

    case "$subcmd" in
        propose)
            local zone="${2:-}"
            [[ -z "$zone" ]] && { err "$(_t federate.propose.usage)"; return 1; }
            log "$(_t federate.propose.proposing "$zone")"
            local resp
            resp=$(curl -sf -X POST "$api/api/federation/propose/$zone" 2>&1) \
                || { err "$(_t federate.propose.failed "$api")"; return 1; }
            echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print('  '+d.get('result','(no result)'))" 2>/dev/null \
                || echo "$resp"
            ;;
        accept)
            local zone="${2:-}"
            [[ -z "$zone" ]] && { err "$(_t federate.accept.usage)"; return 1; }
            log "$(_t federate.accept.accepting "$zone")"
            local resp
            resp=$(curl -sf -X POST "$api/api/federation/accept/$zone" 2>&1) \
                || { err "$(_t federate.accept.failed)"; return 1; }
            echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print('  '+d.get('result','(no result)'))" 2>/dev/null \
                || echo "$resp"
            ;;
        revoke)
            local zone="${2:-}"
            [[ -z "$zone" ]] && { err "$(_t federate.revoke.usage)"; return 1; }
            log "$(_t federate.revoke.revoking "$zone")"
            local resp
            resp=$(curl -sf -X POST "$api/api/federation/revoke/$zone" 2>&1) \
                || { err "$(_t federate.revoke.failed)"; return 1; }
            echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print('  '+d.get('result','(no result)'))" 2>/dev/null \
                || echo "$resp"
            ;;
        status)
            # F12: --mesh extends single-zone status with a both-sides matrix.
            if [[ "${2:-}" == "--mesh" ]]; then
                local resp
                # -s but NOT -f: on an HTTP error we still want the body so the
                # guarded python below can report it, instead of -f swallowing it
                # into an empty string. --max-time guards the 5s server-side ask.
                resp=$(curl -s --max-time 8 "$api/api/federation/mesh-status" 2>&1) \
                    || { err "$(_t federate.status.mesh_failed)"; return 1; }
                echo "$resp" | python3 - "$api" <<'PY'
import sys, json
raw = sys.stdin.read().strip()
if not raw:
    print("  Mesh status unavailable — the zone returned an empty response.")
    print("  (No peers probed yet, or /api/federation/mesh-status is not wired on this build.)")
    print("  Use `wyrd federate status` for the single-zone view.")
    sys.exit(0)
try:
    d = json.loads(raw)
except json.JSONDecodeError:
    print("  Mesh status unavailable — could not parse the zone's response.")
    print("  Use `wyrd federate status` for the single-zone view.")
    sys.exit(0)
local = d.get("localZone", "?")
entries = d.get("entries", [])
agree = d.get("agreeCount", 0)
mismatch = d.get("mismatchCount", 0)
unreachable = d.get("unreachableCount", 0)
probed = d.get("probedAt", "?")
print(f"Federation mesh status (local zone: {local}, probed at {probed})\n")
if not entries:
    print("  No bilateral agreements recorded.")
    sys.exit(0)
sym = {"agree": "✓", "mismatch": "✗", "unreachable": "?"}
print(f"  {'partner':<24} {'local view':<10} {'partner view':<14} consensus")
print("  " + "─"*60)
for e in entries:
    s = sym.get(e["consensus"], "·")
    print(f"  {e['partnerZoneId']:<24} {e['localStatus']:<10} {e['partnerStatus']:<14} {s} {e['consensus']}")
print()
print(f"  {len(entries)} partner(s); ✓ {agree}, ✗ {mismatch}, ? {unreachable}")
if mismatch or unreachable:
    print()
    if mismatch:
        print("  ⚠ mismatch means the two sides disagree about the agreement state.")
        print("    Try: wyrd federate propose <partner>   (re-handshake; F6 reconciles)")
    if unreachable:
        print("  ⚠ unreachable means the partner didn't reply within 3s.")
        print("    Check: relay is up; partner is reachable; partner runs F6+ code.")
PY
                return 0
            fi
            local resp
            resp=$(curl -sf "$api/api/federation/status" 2>&1) \
                || { err "$(_t federate.status.failed)"; return 1; }
            echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('status','(no status)'))" 2>/dev/null \
                || echo "$resp"
            ;;
        join)
            # `wyrd federate join` — configure this node to join an existing
            # household. Multiple flavors:
            #
            #   --lan
            #     Discover peers on the LAN via mDNS. Prints them and the next
            #     step. Doesn't change anything by itself.
            #
            #   --request HOST[:PORT] [--name N] [--household-key K]
            #     Submit a pairing request to an existing household-host. If
            #     --household-key is supplied, pairs immediately (pre-shared
            #     key path). Otherwise prompts you for the 6-digit code that
            #     the admin will read out loud / share. On success, writes the
            #     returned [relay] block to profile.toml.
            #
            #   --relay-url URL --user HH --token TOKEN
            #     Direct config — use this only when you already have the trio
            #     out-of-band (invite URL, etc).
            shift  # drop "join"
            local mode="" rurl="" ruser="" rtoken="" req_host="" req_name="" hh_key=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --lan)            mode="lan"; shift ;;
                    --request)        mode="request"; req_host="${2:-}"; shift 2 ;;
                    --name)           req_name="${2:-}"; shift 2 ;;
                    --household-key)  hh_key="${2:-}"; shift 2 ;;
                    --relay-url)      rurl="${2:-}"; shift 2 ;;
                    --user)           ruser="${2:-}"; shift 2 ;;
                    --token)          rtoken="${2:-}"; shift 2 ;;
                    *)                err "$(_t federate.join.unknown_arg "$1")"; return 1 ;;
                esac
            done
            if [[ "$mode" == "lan" ]]; then
                log "$(_t federate.join.lan.browsing)"
                do_discover --lan
                echo
                info "$(_t federate.join.lan.hint_header)"
                echo "$(_t federate.join.lan.hint_request_code)"
                echo "$(_t federate.join.lan.hint_request_key)"
                return 0
            fi
            if [[ "$mode" == "request" ]]; then
                # Pairing flow — leverages the existing /api/pair/* endpoints
                # that phone clients use. Same backend, same consent gate.
                [[ -z "$req_host" ]] && { err "$(_t federate.join.request.needs_host)"; return 1; }
                # Default port 7070 if not specified
                local pair_url="$req_host"
                [[ "$pair_url" == *:* ]] || pair_url="${pair_url}:7070"
                pair_url="http://${pair_url}"
                local nm="${req_name:-$(hostname -s 2>/dev/null || echo node)}"
                local result
                if [[ -n "$hh_key" ]]; then
                    log "$(_t federate.join.request.with_key "$req_host")"
                    result=$(curl -sf -X POST "$pair_url/api/pair/key" \
                        -H "Content-Type: application/json" \
                        -d "{\"deviceName\":\"$nm\",\"deviceType\":\"node\",\"key\":\"$hh_key\"}" 2>&1) \
                        || { err "$(_t federate.join.request.key_failed)"; echo "$result"; return 1; }
                else
                    log "$(_t federate.join.request.requesting_code "$req_host")"
                    local req_resp
                    req_resp=$(curl -sf -X POST "$pair_url/api/pair/request" \
                        -H "Content-Type: application/json" \
                        -d "{\"deviceName\":\"$nm\",\"deviceType\":\"node\"}" 2>&1) \
                        || { err "$(_t federate.join.request.host_unreachable)"; echo "$req_resp"; return 1; }
                    local cid
                    cid=$(echo "$req_resp" | python3 -c "import sys,json;print(json.load(sys.stdin)['challengeId'])")
                    [[ -z "$cid" ]] && { err "$(_t federate.join.request.no_challenge "$req_resp")"; return 1; }
                    info "$(_t federate.join.request.challenge_issued)"
                    info "$(_t federate.join.request.ask_admin)"
                    read -rp "$(_t federate.join.request.code_prompt)" code
                    [[ -z "$code" ]] && { err "$(_t federate.join.request.no_code)"; return 1; }
                    result=$(curl -sf -X POST "$pair_url/api/pair/verify" \
                        -H "Content-Type: application/json" \
                        -d "{\"challengeId\":\"$cid\",\"code\":\"$code\"}" 2>&1) \
                        || { err "$(_t federate.join.request.verify_failed)"; echo "$result"; return 1; }
                fi
                # Extract relay creds from the response
                local extracted
                extracted=$(echo "$result" | python3 -c "
import sys, json
r = json.load(sys.stdin)
url = r.get('relayUrl') or ''
user = r.get('householdId') or ''
token = r.get('relayToken') or r.get('token') or ''
print(f'{url}|{user}|{token}')
")
                rurl=$(echo "$extracted" | cut -d'|' -f1)
                ruser=$(echo "$extracted" | cut -d'|' -f2)
                rtoken=$(echo "$extracted" | cut -d'|' -f3)
                if [[ -z "$rurl" || -z "$rtoken" ]]; then
                    err "$(_t federate.join.request.no_creds "$result")"
                    return 1
                fi
                log "$(_t federate.join.paired)"
                # fall through to the existing direct-config path
            fi
            if [[ -z "$rurl" || -z "$ruser" || -z "$rtoken" ]]; then
                err "$(_t federate.join.usage_lan)"
                err "$(_t federate.join.usage_direct)"
                return 1
            fi
            local profile_path="${HOME}/.wyrdsekai/profile.toml"
            if [[ ! -f "$profile_path" ]]; then
                log "$(_t federate.join.no_profile)"
                do_config init || return 1
            fi
            # Replace or append [relay] section. Use a Python helper for
            # idempotence (re-running join with new creds updates in place).
            python3 - "$profile_path" "$rurl" "$ruser" "$rtoken" <<'PY'
import sys, re
path, url, user, token = sys.argv[1:5]
with open(path) as f: content = f.read()
relay_block = f'\n[relay]\nurl = "{url}"\nuser = "{user}"\ntoken = "{token}"\n'
# Remove any existing [relay] section (up to next [section] or EOF)
new = re.sub(r'(?ms)^#?\s*\[relay\].*?(?=^\[|\Z)', '', content)
# Drop trailing whitespace then append
new = new.rstrip() + '\n' + relay_block
with open(path, 'w') as f: f.write(new)
print(f"Updated {path}")
PY
            chmod 600 "$profile_path"
            log "$(_t federate.join.wrote_relay "$profile_path")"
            info "$(_t federate.join.restart_hint)"
            ;;
        code)
            # Steward-side: show the pending pair code (when a new node is
            # waiting for approval). Same data the broadcast/log shows.
            local resp
            resp=$(curl -sf "$api/api/pair/code" 2>&1) \
                || { err "$(_t federate.code.none_pending)"; return 1; }
            echo "$resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f'  code: {d.get(\"code\",\"?\")}    expires-at: {d.get(\"expiresAt\",\"?\")}')
" 2>/dev/null || echo "$resp"
            ;;
        household-key)
            # Steward-side: show or generate the household key (used for
            # headless pairing without a 6-digit code dance).
            local action="${2:-show}"
            local resp
            case "$action" in
                show|get)
                    resp=$(curl -sf "$api/api/pair/household-key" 2>&1) \
                        || { err "$(_t federate.household_key.no_active)"; return 1; }
                    echo "$resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f'  key: {d.get(\"key\",\"?\")}')
print(f'  created: {d.get(\"createdAt\",\"?\")}')
" 2>/dev/null || echo "$resp"
                    ;;
                generate|new)
                    resp=$(curl -sf -X POST "$api/api/pair/household-key/generate" 2>&1) \
                        || { err "$(_t federate.household_key.generate_failed)"; return 1; }
                    echo "$resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f'  new key: {d.get(\"key\",\"?\")}')
print('  Share with new nodes via: wyrd federate join --request <host> --household-key <key>')
" 2>/dev/null || echo "$resp"
                    ;;
                *) err "$(_t federate.household_key.usage)"; return 1 ;;
            esac
            ;;
        list)
            local resp
            resp=$(curl -sf "$api/api/federation/agreements" 2>&1) \
                || { err "$(_t federate.list.failed)"; return 1; }
            echo "$resp" | python3 <<'PYEOF' 2>/dev/null || echo "$resp"
import sys, json
d = json.load(sys.stdin)
agreements = d.get('agreements', [])
if not agreements:
    print("  (no agreements)")
else:
    print(f"  {len(agreements)} agreement(s) for zone '{d.get('localZone','?')}':")
    for a in agreements:
        remote = a.get('remoteZone') or a.get('remoteZoneId') or '?'
        status = a.get('status') or '?'
        trust = a.get('trustLevel') or ''
        print(f"    - {remote:20} {status:10} {trust}")
PYEOF
            ;;
        *)
            echo "$(_t federate.help.usage)"
            echo ""
            echo "$(_t federate.help.tagline)"
            echo ""
            echo "$(_t federate.help.commands_label)"
            echo "$(_t federate.help.cmd_join_lan)"
            echo "$(_t federate.help.cmd_join_request_code)"
            echo "$(_t federate.help.cmd_join_request_key)"
            echo "$(_t federate.help.cmd_join_direct)"
            echo "$(_t federate.help.cmd_code)"
            echo "$(_t federate.help.cmd_household_key)"
            echo "$(_t federate.help.cmd_propose)"
            echo "$(_t federate.help.cmd_accept)"
            echo "$(_t federate.help.cmd_revoke)"
            echo "$(_t federate.help.cmd_status)"
            echo "$(_t federate.help.cmd_list)"
            echo ""
            echo "$(_t federate.help.env_label)"
            echo "$(_t federate.help.env_api_url)"
            echo "$(_t federate.help.env_auto_accept_1)"
            echo "$(_t federate.help.env_auto_accept_2)"
            echo "$(_t federate.help.env_auto_accept_3)"
            echo "$(_t federate.help.env_auto_accept_4)"
            echo ""
            echo "$(_t federate.help.normal_flow)"
            ;;
    esac
}

# ── Login / Logout ──────────────────────────────────────────────────────
# Persist a session token so authenticated CLI commands (residency, etc.)
# don't require re-pasting the JWT on every call. Token is written to
# ~/.wyrdsekai/session.token (chmod 600). WYRDSEKAI_TOKEN env var still
# takes precedence if set.
wyrd_session_token_file() {
    local dir="${HOME}/.wyrdsekai"
    mkdir -p "$dir" 2>/dev/null
    chmod 700 "$dir" 2>/dev/null || true
    echo "$dir/session.token"
}

# Resolve a session token: WYRDSEKAI_TOKEN env var wins, else the
# persisted file from `wyrd login`. Returns empty if neither is set.
wyrd_session_token() {
    if [[ -n "${WYRDSEKAI_TOKEN:-}" ]]; then
        echo "$WYRDSEKAI_TOKEN"
        return
    fi
    local f; f=$(wyrd_session_token_file)
    if [[ -r "$f" ]]; then
        cat "$f"
        return
    fi
    # Node-local operator token. Steward CLI verbs used to require `wyrd login`,
    # which nobody runs on a household node — the steward is already on the box over
    # SSH. That made every steward-gated command unreachable in practice: the consent
    # route had zero calls in the four days after it shipped (2026-08-18). The server
    # writes this file at startup, 0600, owned by the service user, and only honours
    # it from loopback. Reading it already implies the ability to read world.db and
    # stop the service, so it grants nothing new.
    local op="${WYRDSEKAI_DATA_DIR:-/var/lib/wyrdsekai}/operator.token"
    [[ -r "$op" ]] && cat "$op" || true
}

do_login() {
    # W4 deferred: the passkey server routes exist (/api/auth/passkey/*),
    # but a CLI client needs the browser WebAuthn ceremony — that consumer
    # lands with the web UI update. Say so honestly instead of half-doing it.
    if [[ "${1:-}" == "--passkey" ]]; then
        log "$(_t login.passkey_pending)"
        return 1
    fi
    local user="${1:-}" pass="${2:-}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    if [[ -z "$user" ]]; then
        read -rp "$(_t login.username_prompt)" user
    fi
    if [[ -z "$pass" ]]; then
        read -rsp "$(_t login.password_prompt)" pass
        echo
    fi
    [[ -z "$user" || -z "$pass" ]] && { err "$(_t login.username_password_required)"; return 1; }

    local body
    body=$(python3 -c "import json; print(json.dumps({'username':'$user','password':'$pass'}))")
    local resp
    resp=$(curl -sf -X POST -H "Content-Type: application/json" \
        -d "$body" "$api/api/auth/login" 2>&1) \
        || { err "$(_t login.failed)"; return 1; }

    local tok role
    tok=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin).get('token',''))" 2>/dev/null)
    role=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin).get('role',''))" 2>/dev/null)
    if [[ -z "$tok" ]]; then
        err "$(_t login.no_token_in_response "$resp")"
        return 1
    fi

    local f; f=$(wyrd_session_token_file)
    printf '%s' "$tok" > "$f"
    chmod 600 "$f" 2>/dev/null || true
    log "$(_t login.success "${user}" "${role}")"
    echo "$(_t login.token_stored_at "$f")"
    echo "$(_t login.hint_residency)"
    echo "$(_t login.hint_logout)"
}

do_logout() {
    # W4 — revoke the session server-side too (best-effort: the local scrub
    # always proceeds, so an unreachable server can't pin a stale token).
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    local token; token=$(wyrd_session_token)
    if [[ -n "$token" ]]; then
        if curl -sf -X POST -H "Authorization: Bearer $token" \
            "$api/api/auth/logout" >/dev/null 2>&1; then
            log "$(_t logout.server_ok)"
        else
            warn "$(_t logout.server_skip)"
        fi
    fi
    local f; f=$(wyrd_session_token_file)
    if [[ -r "$f" ]]; then
        rm -f "$f"
        log "$(_t logout.cleared "$f")"
    else
        log "$(_t logout.no_session)"
    fi
}

# ── Password change (W4 — POST /api/auth/change-password consumer) ──────
# Prompts for the current + new password with no echo; the JSON body is
# assembled via env vars so passwords never hit a command line or interpolate
# into a shell string.
do_passwd() {
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    local token; token=$(wyrd_session_token)
    [[ -z "$token" ]] && { err "$(_t passwd.needs_token)"; return 1; }
    local old new confirm
    read -rsp "$(_t passwd.old_prompt)" old; echo
    read -rsp "$(_t passwd.new_prompt)" new; echo
    read -rsp "$(_t passwd.confirm_prompt)" confirm; echo
    [[ "$new" != "$confirm" ]] && { err "$(_t passwd.mismatch)"; return 1; }
    [[ ${#new} -lt 4 ]] && { err "$(_t passwd.too_short)"; return 1; }
    local body
    body=$(WYRD_PW_OLD="$old" WYRD_PW_NEW="$new" python3 -c \
        'import json, os; print(json.dumps({"oldPassword": os.environ["WYRD_PW_OLD"], "newPassword": os.environ["WYRD_PW_NEW"]}))')
    local resp code
    resp=$(curl -s -w '\n%{http_code}' -X POST -H 'Content-Type: application/json' \
        -H "Authorization: Bearer $token" \
        -d "$body" "$api/api/auth/change-password" 2>/dev/null) \
        || { err "$(_t passwd.failed "$api")"; return 1; }
    code="${resp##*$'\n'}"
    case "$code" in
        200) log "$(_t passwd.ok)" ;;
        401) err "$(_t passwd.session_expired)"; return 1 ;;
        403) err "$(_t passwd.wrong_current)"; return 1 ;;
        *)   err "$(_t passwd.failed "$api")"; return 1 ;;
    esac
}

# ── Home grants ( — W4 orphan-route consumers) ────────────
# The Home registry's HTTP surface (/api/home/*) shipped with no caller
# anywhere (2026-07-11 wiring audit). These commands are that caller.
# DID resolution: explicit flags win, then WYRDSEKAI_HOME_DID, then this
# household's identity (same derivation `wyrd whoami` / the server boot use).
wyrd_home_did() {
    if [[ -n "${WYRDSEKAI_HOME_DID:-}" ]]; then
        printf '%s\n' "$WYRDSEKAI_HOME_DID"
        return
    fi
    # do_naming_admin may print build progress on stdout — keep only the DID.
    do_naming_admin whoami 2>/dev/null | grep -E '^did:' | tail -n 1 || true
}

# stdin: {"grants":[...]}; $1 = header template ({0}=did, {1}=count), $2 = did
_render_grants() {
    local t_row t_empty
    t_row=$(_t grants.row)
    t_empty=$(_t grants.list.empty)
    T_HEADER="$1" T_WHO="$2" T_ROW="$t_row" T_EMPTY="$t_empty" python3 -c '
import sys, json, os
d = json.load(sys.stdin)
grants = d.get("grants", [])
print(os.environ["T_HEADER"].replace("{0}", os.environ["T_WHO"])
      .replace("{1}", str(len(grants))))
if not grants:
    print(os.environ["T_EMPTY"])
for g in grants:
    state = "active" if g.get("active") else ("revoked" if g.get("revokedAt") else "expired")
    row = os.environ["T_ROW"]
    row = row.replace("{0}", str(g.get("id", "?")))
    row = row.replace("{1}", state)
    row = row.replace("{2}", str(g.get("capability", "?")))
    row = row.replace("{3}", str(g.get("resource", "?")))
    row = row.replace("{4}", str(g.get("subject", "?")))
    print(row)
'
}

do_grants() {
    local subcmd="${1:-help}"
    shift || true
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    case "$subcmd" in
        list|issued|held)
            local owner="" subject=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --owner)   owner="${2:-}";   shift 2 || break ;;
                    --subject) subject="${2:-}"; shift 2 || break ;;
                    *) shift ;;
                esac
            done
            local did="${owner:-${subject:-}}"
            [[ -z "$did" ]] && did=$(wyrd_home_did)
            [[ -z "$did" ]] && { err "$(_t grants.no_did)"; return 1; }
            local resp
            if [[ "$subcmd" == "issued" || "$subcmd" == "list" ]]; then
                resp=$(curl -sf "$api/api/home/grants/issued?owner=$did" 2>&1) \
                    || { err "$(_t grants.request_failed "$api")"; return 1; }
                _render_grants "$(_t grants.issued.header)" "$did" <<<"$resp" \
                    2>/dev/null || echo "$resp"
            fi
            if [[ "$subcmd" == "held" || "$subcmd" == "list" ]]; then
                resp=$(curl -sf "$api/api/home/grants/held?subject=$did" 2>&1) \
                    || { err "$(_t grants.request_failed "$api")"; return 1; }
                _render_grants "$(_t grants.held.header)" "$did" <<<"$resp" \
                    2>/dev/null || echo "$resp"
            fi
            ;;
        show)
            local id="${1:-}"
            [[ -z "$id" ]] && { err "$(_t grants.show.usage)"; return 1; }
            local resp
            resp=$(curl -sf "$api/api/home/grants/$id" 2>&1) \
                || { err "$(_t grants.show.not_found "$id")"; return 1; }
            echo "$resp" | python3 -m json.tool 2>/dev/null || echo "$resp"
            ;;
        issue)
            local i_subject="" i_resource="" i_capability="" i_issuer="" i_reason=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --subject)    i_subject="${2:-}";    shift 2 || break ;;
                    --resource)   i_resource="${2:-}";   shift 2 || break ;;
                    --capability) i_capability="${2:-}"; shift 2 || break ;;
                    --issuer)     i_issuer="${2:-}";     shift 2 || break ;;
                    --reason)     i_reason="${2:-}";     shift 2 || break ;;
                    *) shift ;;
                esac
            done
            [[ -z "$i_subject" || -z "$i_resource" || -z "$i_capability" ]] \
                && { err "$(_t grants.issue.usage)"; return 1; }
            [[ -z "$i_issuer" ]] && i_issuer=$(wyrd_home_did)
            [[ -z "$i_issuer" ]] && { err "$(_t grants.no_did)"; return 1; }
            local body
            body=$(T_ISS="$i_issuer" T_SUB="$i_subject" T_RES="$i_resource" \
                   T_CAP="$i_capability" T_WHY="$i_reason" python3 -c '
import json, os
b = {"issuer": os.environ["T_ISS"], "subject": os.environ["T_SUB"],
     "resource": os.environ["T_RES"], "capability": os.environ["T_CAP"]}
if os.environ.get("T_WHY"):
    b["reason"] = os.environ["T_WHY"]
print(json.dumps(b))')
            local resp
            resp=$(curl -s -X POST -H 'Content-Type: application/json' \
                -d "$body" "$api/api/home/grants" 2>/dev/null) \
                || { err "$(_t grants.request_failed "$api")"; return 1; }
            local t_ok t_fail
            t_ok=$(_t grants.issue.ok)
            t_fail=$(_t grants.issue.failed)
            T_OK="$t_ok" T_FAIL="$t_fail" python3 -c '
import sys, json, os
d = json.load(sys.stdin)
if "id" in d:
    print(os.environ["T_OK"].replace("{0}", str(d["id"]))
          .replace("{1}", str(d.get("capability", "?")))
          .replace("{2}", str(d.get("resource", "?")))
          .replace("{3}", str(d.get("subject", "?"))))
else:
    print(os.environ["T_FAIL"].replace("{0}", str(d.get("error", "unknown error"))))
    sys.exit(1)
' <<<"$resp" 2>/dev/null || { echo "$resp"; return 1; }
            ;;
        revoke)
            local id="${1:-}"
            shift || true
            local actor=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --actor) actor="${2:-}"; shift 2 || break ;;
                    *) shift ;;
                esac
            done
            if [[ -z "$id" || "$id" == --* ]]; then
                err "$(_t grants.revoke.usage)"; return 1
            fi
            [[ -z "$actor" ]] && actor=$(wyrd_home_did)
            [[ -z "$actor" ]] && { err "$(_t grants.no_did)"; return 1; }
            local resp
            resp=$(curl -s -X DELETE "$api/api/home/grants/$id?actor=$actor" 2>/dev/null) \
                || { err "$(_t grants.request_failed "$api")"; return 1; }
            local t_ok t_fail
            t_ok=$(_t grants.revoke.ok)
            t_fail=$(_t grants.revoke.failed)
            T_OK="$t_ok" T_FAIL="$t_fail" python3 -c '
import sys, json, os
d = json.load(sys.stdin)
if "revoked" in d:
    print(os.environ["T_OK"].replace("{0}", str(d["revoked"]))
          .replace("{1}", str(d.get("cascadeCount", 0))))
else:
    print(os.environ["T_FAIL"].replace("{0}", str(d.get("error", "unknown error"))))
    sys.exit(1)
' <<<"$resp" 2>/dev/null || { echo "$resp"; return 1; }
            ;;
        check)
            local c_subject="" c_resource="" c_capability="" c_scope=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --subject)    c_subject="${2:-}";    shift 2 || break ;;
                    --resource)   c_resource="${2:-}";   shift 2 || break ;;
                    --capability) c_capability="${2:-}"; shift 2 || break ;;
                    --scope)      c_scope="${2:-}";      shift 2 || break ;;
                    *) shift ;;
                esac
            done
            [[ -z "$c_subject" || -z "$c_resource" || -z "$c_capability" ]] \
                && { err "$(_t grants.check.usage)"; return 1; }
            local body
            body=$(T_SUB="$c_subject" T_RES="$c_resource" T_CAP="$c_capability" \
                   T_SCOPE="$c_scope" python3 -c '
import json, os
scope = {}
for tok in os.environ.get("T_SCOPE", "").split(","):
    if "=" in tok:
        k, v = tok.split("=", 1)
        scope[k.strip()] = v.strip()
print(json.dumps({"subject": os.environ["T_SUB"],
                  "resource": os.environ["T_RES"],
                  "capability": os.environ["T_CAP"],
                  "scope": scope}))')
            local resp
            resp=$(curl -sf -X POST -H 'Content-Type: application/json' \
                -d "$body" "$api/api/home/check" 2>&1) \
                || { err "$(_t grants.request_failed "$api")"; return 1; }
            local t_allowed t_denied rc
            t_allowed=$(_t grants.check.allowed)
            t_denied=$(_t grants.check.denied)
            rc=0
            T_A="$t_allowed" T_D="$t_denied" python3 -c '
import sys, json, os
d = json.load(sys.stdin)
if d.get("allowed"):
    print(os.environ["T_A"].replace("{0}", str(d.get("byGrant", "?"))))
else:
    print(os.environ["T_D"].replace("{0}", str(d.get("reason", "?"))))
    sys.exit(2)
' <<<"$resp" 2>/dev/null || rc=$?
            [[ $rc -eq 2 ]] && return 1
            [[ $rc -ne 0 ]] && echo "$resp"
            ;;
        help|-h|--help|"")
            echo "$(_t grants.help.usage_header)"
            echo "$(_t grants.help.cmd_list)"
            echo "$(_t grants.help.cmd_issued)"
            echo "$(_t grants.help.cmd_held)"
            echo "$(_t grants.help.cmd_show)"
            echo "$(_t grants.help.cmd_issue)"
            echo "$(_t grants.help.cmd_revoke)"
            echo "$(_t grants.help.cmd_check)"
            echo ""
            echo "$(_t grants.help.did_note)"
            ;;
        *)
            err "$(_t grants.unknown_subcommand "$subcmd")"
            return 1
            ;;
    esac
}

# ── Home audit trail (W4 — GET /api/home/audit consumer) ────────────────
do_home() {
    local subcmd="${1:-help}"
    shift || true
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    case "$subcmd" in
        audit)
            local owner="" since="" limit="50"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --owner) owner="${2:-}"; shift 2 || break ;;
                    --since) since="${2:-}"; shift 2 || break ;;
                    --limit) limit="${2:-50}"; shift 2 || break ;;
                    *) shift ;;
                esac
            done
            [[ -z "$owner" ]] && owner=$(wyrd_home_did)
            [[ -z "$owner" ]] && { err "$(_t grants.no_did)"; return 1; }
            local q="owner=$owner&limit=$limit"
            [[ -n "$since" ]] && q+="&since=$since"
            local resp
            resp=$(curl -sf "$api/api/home/audit?$q" 2>&1) \
                || { err "$(_t grants.request_failed "$api")"; return 1; }
            local t_header t_empty t_row
            t_header=$(_t home.audit.header)
            t_empty=$(_t home.audit.empty)
            t_row=$(_t home.audit.row)
            T_HEADER="$t_header" T_EMPTY="$t_empty" T_ROW="$t_row" python3 -c '
import sys, json, os
d = json.load(sys.stdin)
entries = d.get("entries", [])
print(os.environ["T_HEADER"].replace("{0}", str(d.get("owner", "?")))
      .replace("{1}", str(len(entries))))
if not entries:
    print(os.environ["T_EMPTY"])
for e in entries:
    row = os.environ["T_ROW"]
    row = row.replace("{0}", str(e.get("timestamp", "?"))[:19])
    row = row.replace("{1}", str(e.get("outcome", "?")))
    row = row.replace("{2}", str(e.get("actor", "?")))
    row = row.replace("{3}", str(e.get("verb", "?")))
    row = row.replace("{4}", str(e.get("resource", "?")))
    row = row.replace("{5}", str(e.get("detail") or ""))
    print(row)
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        help|-h|--help|"")
            echo "$(_t home.help.usage_header)"
            ;;
        *)
            err "$(_t home.help.usage_header)"
            return 1
            ;;
    esac
}

# ── Skill drafts ( — W4 route consumers) ──────
# The pinboard furnishing READS the queue in-world; deciding is a steward
# act done here: /api/skill/drafts + approve/reject. When --agent is
# omitted, auto-pick mirrors `wyrd recipes run`: if exactly one companion
# DID appears across recipe enrollments, use it.
do_skill() {
    local subcmd="${1:-help}"
    shift || true
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    case "$subcmd" in
        drafts)
            local action="${1:-list}"
            if [[ "$action" == --* ]]; then action="list"; else shift || true; fi
            case "$action" in
                list)
                    local agent="" status="PENDING"
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --agent)  agent="${2:-}";  shift 2 || break ;;
                            --status) status="${2:-PENDING}"; shift 2 || break ;;
                            *) shift ;;
                        esac
                    done
                    if [[ -z "$agent" ]]; then
                        agent=$(_skill_auto_agent "$api")
                        [[ -z "$agent" ]] && { err "$(_t skill.drafts.no_agent)"; return 1; }
                        log "$(_t skill.drafts.auto_agent "$agent")"
                    fi
                    local resp
                    resp=$(curl -sf "$api/api/skill/drafts?agent=$agent&status=$status" 2>&1) \
                        || { err "$(_t skill.drafts.request_failed "$api")"; return 1; }
                    local t_header t_empty t_row t_hint
                    t_header=$(_t skill.drafts.header)
                    t_empty=$(_t skill.drafts.empty)
                    t_row=$(_t skill.drafts.row)
                    t_hint=$(_t skill.drafts.decide_hint)
                    T_HEADER="$t_header" T_EMPTY="$t_empty" T_ROW="$t_row" T_HINT="$t_hint" \
                        python3 -c '
import sys, json, os
d = json.load(sys.stdin)
drafts = d.get("drafts", [])
if not drafts:
    print(os.environ["T_EMPTY"]
          .replace("{0}", str(d.get("status", "?")))
          .replace("{1}", str(d.get("agent", "?"))))
    sys.exit(0)
print(os.environ["T_HEADER"]
      .replace("{0}", str(len(drafts)))
      .replace("{1}", str(d.get("agent", "?")))
      .replace("{2}", str(d.get("status", "?"))))
for x in drafts:
    row = os.environ["T_ROW"]
    row = row.replace("{0}", str(x.get("draftId", "?")))
    row = row.replace("{1}", str(x.get("name", "?")))
    row = row.replace("{2}", str(x.get("description") or ""))
    print(row)
    if x.get("rationale"):
        print("      " + str(x["rationale"]))
print()
print(os.environ["T_HINT"])
' <<<"$resp" 2>/dev/null || echo "$resp"
                    ;;
                show)
                    local id="${1:-}"
                    [[ -z "$id" ]] && { err "$(_t skill.drafts.show.usage)"; return 1; }
                    local resp
                    resp=$(curl -sf "$api/api/skill/drafts/$id" 2>&1) \
                        || { err "$(_t skill.drafts.not_found "$id")"; return 1; }
                    echo "$resp" | python3 -m json.tool 2>/dev/null || echo "$resp"
                    ;;
                approve|reject)
                    local id="${1:-}"
                    shift || true
                    local note=""
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --note|--reason) note="${2:-}"; shift 2 || break ;;
                            *) shift ;;
                        esac
                    done
                    if [[ -z "$id" || "$id" == --* ]]; then
                        err "$(_t "skill.drafts.$action.usage")"; return 1
                    fi
                    local field="note"
                    [[ "$action" == "reject" ]] && field="reason"
                    local body
                    body=$(T_FIELD="$field" T_VAL="$note" python3 -c \
                        'import json, os; print(json.dumps({os.environ["T_FIELD"]: os.environ["T_VAL"]}))')
                    local resp
                    resp=$(curl -s -X POST -H 'Content-Type: application/json' \
                        -d "$body" "$api/api/skill/drafts/$id/$action" 2>/dev/null) \
                        || { err "$(_t skill.drafts.request_failed "$api")"; return 1; }
                    local t_ok t_fail
                    t_ok=$(_t "skill.drafts.$action.ok")
                    t_fail=$(_t skill.drafts.decision_failed)
                    T_OK="$t_ok" T_FAIL="$t_fail" T_ID="$id" python3 -c '
import sys, json, os
d = json.load(sys.stdin)
if d.get("ok"):
    name = (d.get("draft") or {}).get("name", "?")
    msg = d.get("message") or ""
    print(os.environ["T_OK"].replace("{0}", os.environ["T_ID"]).replace("{1}", name))
    if msg:
        print("  " + msg)
else:
    print(os.environ["T_FAIL"].replace("{0}", str(d.get("error", "unknown error"))))
    sys.exit(1)
' <<<"$resp" 2>/dev/null || { echo "$resp"; return 1; }
                    ;;
                help|-h|--help|"")
                    echo "$(_t skill.help.usage_header)"
                    echo "$(_t skill.help.cmd_list)"
                    echo "$(_t skill.help.cmd_show)"
                    echo "$(_t skill.help.cmd_approve)"
                    echo "$(_t skill.help.cmd_reject)"
                    ;;
                *)
                    err "$(_t skill.unknown_subcommand "$action")"
                    return 1
                    ;;
            esac
            ;;
        help|-h|--help|"")
            echo "$(_t skill.help.usage_header)"
            echo "$(_t skill.help.cmd_list)"
            echo "$(_t skill.help.cmd_show)"
            echo "$(_t skill.help.cmd_approve)"
            echo "$(_t skill.help.cmd_reject)"
            ;;
        *)
            err "$(_t skill.unknown_subcommand "$subcmd")"
            return 1
            ;;
    esac
}

# Auto-pick the sole companion DID from recipe enrollments (bounded probe:
# first 6 recipes). Prints the DID, or nothing when zero/ambiguous.
_skill_auto_agent() {
    local api="$1"
    local names
    names=$(curl -sf "$api/api/recipes" 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for r in d.get("rows", [])[:6]:
    rid = r.get("recipeId")
    if rid:
        print(rid)
' 2>/dev/null) || names=""
    [[ -z "$names" ]] && return 0
    local dids="" n
    while IFS= read -r n; do
        [[ -z "$n" ]] && continue
        local d1
        d1=$(curl -sf "$api/api/recipes/$n" 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for e in d.get("enrollments", []):
    if e.get("agentDid"):
        print(e["agentDid"])
' 2>/dev/null) || d1=""
        [[ -n "$d1" ]] && dids+="$d1"$'\n'
    done <<<"$names"
    local uniq
    uniq=$(printf '%s' "$dids" | sed '/^$/d' | sort -u)
    [[ -n "$uniq" && $(wc -l <<<"$uniq") -eq 1 ]] && printf '%s\n' "$uniq"
    return 0
}

# ── Room wards (W4 — /api/wards consumers; ward_keyring's terminal twin) ─
do_wards() {
    local subcmd="${1:-help}"
    shift || true
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    case "$subcmd" in
        list)
            local room="${1:-}"
            [[ -z "$room" ]] && { err "$(_t wards.list.usage)"; return 1; }
            local resp
            resp=$(curl -sf "$api/api/wards/$room" 2>&1) \
                || { err "$(_t wards.request_failed "$api")"; return 1; }
            local t_header t_empty t_row
            t_header=$(_t wards.list.header)
            t_empty=$(_t wards.list.empty)
            t_row=$(_t wards.list.row)
            T_HEADER="$t_header" T_EMPTY="$t_empty" T_ROW="$t_row" T_ROOM="$room" \
                python3 -c '
import sys, json, os
wards = json.load(sys.stdin)
room = os.environ["T_ROOM"]
if not wards:
    print(os.environ["T_EMPTY"].replace("{0}", room))
    sys.exit(0)
print(os.environ["T_HEADER"].replace("{0}", room).replace("{1}", str(len(wards))))
for w in wards:
    row = os.environ["T_ROW"]
    row = row.replace("{0}", str(w.get("permission", "?")))
    row = row.replace("{1}", str(w.get("principal", "?")))
    row = row.replace("{2}", str(w.get("granted_by", "?")))
    print(row)
' <<<"$resp" 2>/dev/null || echo "$resp"
            ;;
        add|remove)
            local room="${1:-}" principal="${2:-}" permission="${3:-}"
            if [[ -z "$room" || -z "$principal" || -z "$permission" ]]; then
                err "$(_t "wards.$subcmd.usage")"; return 1
            fi
            local token; token=$(wyrd_session_token)
            [[ -z "$token" ]] && { err "$(_t wards.needs_token)"; return 1; }
            local body
            body=$(T_ROOM="$room" T_PRIN="$principal" T_PERM="$permission" python3 -c '
import json, os
print(json.dumps({"room_id": os.environ["T_ROOM"],
                  "principal": os.environ["T_PRIN"],
                  "permission": os.environ["T_PERM"]}))')
            local method="POST"
            [[ "$subcmd" == "remove" ]] && method="DELETE"
            local resp code
            resp=$(curl -s -w '\n%{http_code}' -X "$method" \
                -H 'Content-Type: application/json' \
                -H "Authorization: Bearer $token" \
                -d "$body" "$api/api/wards" 2>/dev/null) \
                || { err "$(_t wards.request_failed "$api")"; return 1; }
            code="${resp##*$'\n'}"
            local payload="${resp%$'\n'*}"
            case "$code" in
                201) log "$(_t wards.add.ok "$room" "$principal" "$permission")" ;;
                204) log "$(_t wards.remove.ok "$room" "$principal" "$permission")" ;;
                200)
                    # POST 200 = "Ward already exists" (server's soft duplicate).
                    log "$(_t wards.add.exists "$room" "$principal" "$permission")" ;;
                404) err "$(_t wards.remove.not_found "$room" "$principal" "$permission")"; return 1 ;;
                401|403)
                    local reason
                    reason=$(echo "$payload" | python3 -c \
                        'import sys, json; print(json.load(sys.stdin).get("error", "forbidden"))' \
                        2>/dev/null || echo "forbidden")
                    err "$(_t wards.refused "$reason")"; return 1 ;;
                *)
                    err "$(_t wards.request_failed "$api")"
                    [[ -n "$payload" ]] && echo "$payload"
                    return 1 ;;
            esac
            ;;
        help|-h|--help|"")
            echo "$(_t wards.help.usage_header)"
            echo "$(_t wards.help.cmd_list)"
            echo "$(_t wards.help.cmd_add)"
            echo "$(_t wards.help.cmd_remove)"
            echo ""
            echo "$(_t wards.help.capabilities)"
            ;;
        *)
            err "$(_t wards.unknown_subcommand "$subcmd")"
            return 1
            ;;
    esac
}

# ── Residency ──────────────────────────────────────────
# Who lives in this zone vs who is merely known here as a contact.
# Residency is strictly zone-local and never replicated. Steward-only.
do_residency() {
    local subcmd="${1:-help}"
    local arg2="${2:-}"
    local arg3="${3:-}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    local token; token=$(wyrd_session_token)

    case "$subcmd" in
        list)
            local resp
            if [[ -n "$token" ]]; then
                resp=$(curl -sf -H "Authorization: Bearer $token" "$api/api/residency/list" 2>&1) \
                    || { err "$(_t residency.list.fail_with_token)"; return 1; }
            else
                resp=$(curl -sf "$api/api/residency/list" 2>&1) \
                    || { err "$(_t residency.list.fail_no_token)"; return 1; }
            fi
            echo "$resp" | python3 <<'PYEOF' 2>/dev/null || echo "$resp"
import sys, json
d = json.load(sys.stdin)
residents = d.get('residents', [])
if not residents:
    print(f"  Zone '{d.get('zone','?')}': (no residents)")
else:
    print(f"  Zone '{d.get('zone','?')}' — {len(residents)} resident(s):")
    for r in residents:
        print(f"    {r.get('role','?'):10} {r.get('did','?')[:40]:40} granted={r.get('grantedAt','?')[:10]} by={r.get('grantor','?')[:20]}")
PYEOF
            ;;
        grant)
            [[ -z "$arg2" ]] && { err "$(_t residency.grant.usage)"; return 1; }
            [[ -z "$token" ]] && { err "$(_t residency.grant.needs_token)"; return 1; }
            local role="${arg3:-member}"
            local body
            body=$(python3 -c "import json; print(json.dumps({'did':'$arg2','role':'$role'}))")
            local resp
            resp=$(curl -sf -X POST -H "Content-Type: application/json" \
                -H "Authorization: Bearer $token" \
                -d "$body" "$api/api/residency/grant" 2>&1) \
                || { err "$(_t residency.grant.failed)"; return 1; }
            echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f\"  {d.get('result','?')}: {d.get('did','?')} role={d.get('role','?')} in zone {d.get('zone','?')}\")" 2>/dev/null || echo "$resp"
            ;;
        revoke)
            [[ -z "$arg2" ]] && { err "$(_t residency.revoke.usage)"; return 1; }
            [[ -z "$token" ]] && { err "$(_t residency.revoke.needs_token)"; return 1; }
            local body
            body=$(python3 -c "import json; print(json.dumps({'did':'$arg2'}))")
            local resp
            resp=$(curl -sf -X POST -H "Content-Type: application/json" \
                -H "Authorization: Bearer $token" \
                -d "$body" "$api/api/residency/revoke" 2>&1) \
                || { err "$(_t residency.revoke.failed)"; return 1; }
            echo "$resp" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f\"  {d.get('result','?')}: {d.get('did','?')} from zone {d.get('zone','?')}\")" 2>/dev/null || echo "$resp"
            ;;
        self)
            [[ -z "$token" ]] && { err "$(_t residency.self.needs_token)"; return 1; }
            local resp
            resp=$(curl -sf -H "Authorization: Bearer $token" "$api/api/residency/self" 2>&1) \
                || { err "$(_t residency.self.failed)"; return 1; }
            echo "$resp" | python3 <<'PYEOF' 2>/dev/null || echo "$resp"
import sys, json
d = json.load(sys.stdin)
if d.get('resident'):
    print(f"  You are a resident of '{d.get('zone')}' as {d.get('role')} since {d.get('grantedAt','?')[:10]}")
else:
    print(f"  You are not a resident of '{d.get('zone')}' (visitor / contact only)")
PYEOF
            ;;
        *)
            echo "$(_t residency.help.usage)"
            echo ""
            echo "$(_t residency.help.intro_1)"
            echo "$(_t residency.help.intro_2)"
            echo "$(_t residency.help.intro_3)"
            echo ""
            echo "$(_t residency.help.commands)"
            echo "$(_t residency.help.cmd_list)"
            echo "$(_t residency.help.cmd_grant)"
            echo "$(_t residency.help.cmd_revoke)"
            echo "$(_t residency.help.cmd_self)"
            echo ""
            echo "$(_t residency.help.env_section_header)"
            echo "$(_t residency.help.env_token)"
            echo "$(_t residency.help.env_url)"
            echo ""
            echo "$(_t residency.help.example_section_header)"
            echo "$(_t residency.help.example_login)"
            echo "$(_t residency.help.example_grant)"
            ;;
    esac
}

# ── Hardware detection helpers ──
# Used by `wyrd setup` and `wyrd inference` to pick a sensible default backend
# + model for the local machine. Falls back gracefully on older CPUs.

detect_cpu_flags() {
    if [[ -f /proc/cpuinfo ]]; then
        grep -m1 -oE 'avx512f|avx2|avx ' /proc/cpuinfo 2>/dev/null | tr '\n' ' '
    elif command -v sysctl &>/dev/null; then
        # macOS — sysctl reports capabilities differently; return a coarse answer.
        local leaf
        leaf=$(sysctl -n machdep.cpu.features 2>/dev/null || echo "")
        local leaf2
        leaf2=$(sysctl -n machdep.cpu.leaf7_features 2>/dev/null || echo "")
        if echo "$leaf2" | grep -qi 'AVX512'; then echo "avx512f"; fi
        if echo "$leaf" | grep -qi 'AVX2'; then echo "avx2"; fi
    fi
}

detect_ram_gb() {
    if [[ -f /proc/meminfo ]]; then
        awk '/MemTotal/ {printf "%.0f", $2/1024/1024}' /proc/meminfo
    elif command -v sysctl &>/dev/null; then
        sysctl -n hw.memsize 2>/dev/null | awk '{printf "%.0f", $1/1024/1024/1024}'
    else
        echo 0
    fi
}

detect_cores() {
    if command -v nproc &>/dev/null; then
        nproc
    elif command -v sysctl &>/dev/null; then
        sysctl -n hw.ncpu 2>/dev/null || echo 1
    else
        echo 1
    fi
}

# Picks a model identifier based on RAM, CPU flags, and GPU presence.
# Output: one of {9b, 4b, 0.8b}
recommend_model() {
    local ram_gb cores flags has_gpu
    ram_gb=$(detect_ram_gb)
    cores=$(detect_cores)
    flags=$(detect_cpu_flags)
    has_gpu=0
    if command -v nvidia-smi &>/dev/null && nvidia-smi --query-gpu=name --format=csv,noheader &>/dev/null; then
        has_gpu=1
    elif [[ "$(uname -s)" == "Darwin" && "$(uname -m)" == "arm64" ]]; then
        has_gpu=1  # Metal
    fi

    # With a GPU, the ceiling is VRAM not CPU — default to 9B.
    if [[ "$has_gpu" -eq 1 ]] && [[ "$ram_gb" -ge 16 ]]; then
        echo "9b"; return
    fi
    # CPU-only: AVX-512 + ≥8 cores + ≥32GB RAM can handle 9B (async workloads).
    if echo "$flags" | grep -q 'avx512f' && [[ "$cores" -ge 8 ]] && [[ "$ram_gb" -ge 32 ]]; then
        echo "9b"; return
    fi
    # AVX2 + ≥16GB handles the 4B comfortably.
    if echo "$flags" | grep -qE 'avx2|avx512f' && [[ "$ram_gb" -ge 8 ]]; then
        echo "4b"; return
    fi
    echo "0.8b"
}

# Detect total host VRAM in GB. Returns integer GB; 0 means "no GPU / CPU-only".
#
# NVIDIA: sum memory.total across all visible GPUs.
# Apple Silicon: unified memory — Metal can address the full system RAM, so we
# report system RAM as the effective VRAM ceiling (matches how llama.cpp/MLX
# actually behave on M-series).
# AMD ROCm: parse rocm-smi if present.
# Otherwise: 0.
detect_total_vram_gb() {
    if command -v nvidia-smi &>/dev/null; then
        # memory.total comes in MiB; sum across GPUs and convert to GB.
        local sum_mib
        sum_mib=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null \
                  | awk '{s+=$1} END {print s+0}')
        if [[ -n "$sum_mib" && "$sum_mib" -gt 0 ]]; then
            echo $(( sum_mib / 1024 )); return
        fi
    fi
    if [[ "$(uname -s)" == "Darwin" && "$(uname -m)" == "arm64" ]]; then
        # Unified memory — Metal sees ~75% of system RAM as addressable, but for
        # tier-detection purposes we treat it as the full RAM number. This is
        # consistent with how the model-recommender already counts Apple Silicon.
        detect_ram_gb; return
    fi
    if command -v rocm-smi &>/dev/null; then
        # rocm-smi output is verbose; pull "Total VRAM" lines (MiB) and sum.
        local sum_mib
        sum_mib=$(rocm-smi --showmeminfo vram 2>/dev/null \
                  | awk -F'[: ]+' '/Total VRAM/ {s+=$NF} END {print s+0}')
        if [[ -n "$sum_mib" && "$sum_mib" -gt 0 ]]; then
            echo $(( sum_mib / 1024 / 1024 )); return
        fi
    fi
    echo 0
}

# Recommend a deployment tier / OPEN-23.
# Output: one of {16gb-full, 8gb-companion, cpu-only}.
#
#   16gb-full      VRAM >= 14 GB. Voice=V10 4B (:8201) + Drive/πdev=V5 9B (:8200).
#   8gb-companion  VRAM in [6, 14). Same voice + Granite-Substrate-v2 3B (:8203).
#   cpu-only       no GPU detected. Falls back to recommend_model (4b / 0.8b).
#
# The 14 GB threshold matches the spec's "16GB GPU" target with headroom for
# desktop compositor + kernel reservation; in practice a 16GB card reports
# 15-16 GB usable. The 6 GB floor catches 8GB cards where the OS reserves
# ~1-2 GB; below that we honestly can't fit Granite-Sub-v2 alongside V10 voice.
recommend_tier() {
    local vram_gb
    vram_gb=$(detect_total_vram_gb)
    if [[ "$vram_gb" -ge 14 ]]; then
        echo "16gb-full"
    elif [[ "$vram_gb" -ge 6 ]]; then
        echo "8gb-companion"
    else
        echo "cpu-only"
    fi
}

# Map a tier identifier to its canonical drive-model GGUF basename.
# Used by `wyrd inference local` to pick the right model.
#
# 16gb-full      → wyrdsekai-3.5-9b-drive-v6-q4km.gguf         (~5.3 GB)
# 8gb-companion  → wyrdsekai-granite-3b-substrate-v2-q4km.gguf (~2.0 GB)
# cpu-only       → wyrdsekai-3.5-4b-v10-q4km.gguf                (~2.6 GB)
tier_drive_model() {
    case "$1" in
        16gb-full)     echo "wyrdsekai-3.5-9b-drive-v6-q4km.gguf" ;;
        8gb-companion) echo "wyrdsekai-granite-3b-substrate-v2-q4km.gguf" ;;
        cpu-only)      echo "wyrdsekai-3.5-4b-v10-q4km.gguf" ;;
        *)             echo "" ;;
    esac
}

# MoE residency planner. Sparse-active models (e.g. a 32B-total/9B-active
# MoE) don't need the whole quantized file on the GPU: attention + KV +
# the active expert path fit in modest VRAM while the full expert set sits
# in system RAM (llama-server --cpu-moe). This helper decides which split
# a host can run for a given model.
#
#   plan_moe_residency <total_gb> <active_gb> [vram_gb] [ram_gb]
#
#   total_gb   quantized file size of the whole model (GB)
#   active_gb  quantized size of the per-token active path (GB)
#   vram_gb    override for tests; defaults to detect_total_vram_gb
#   ram_gb     override for tests; defaults to detect_ram_gb
#
# Output: one of
#   gpu-full   whole model fits on the accelerator — no residency flag
#   cpu-moe    active path on GPU, experts in RAM — set LLAMA_CPU_MOE=all
#   not-viable neither placement fits this host
#
# Headroom constants: +3 GB on VRAM for KV cache/compute buffers at 16K
# ctx, +8 GB on RAM for the OS and the JVM so expert offload can't starve
# the rest of the node.
plan_moe_residency() {
    local total_gb="$1" active_gb="$2"
    local vram_gb="${3:-$(detect_total_vram_gb)}"
    local ram_gb="${4:-$(detect_ram_gb)}"
    local vram_headroom=3 ram_floor=8

    if [[ "$vram_gb" -ge $(( total_gb + vram_headroom )) ]]; then
        echo "gpu-full"; return
    fi
    if [[ "$vram_gb" -ge $(( active_gb + vram_headroom )) ]] \
        && [[ "$ram_gb" -ge $(( total_gb - active_gb + ram_floor )) ]]; then
        echo "cpu-moe"; return
    fi
    echo "not-viable"
}

# detect CodeZaiku installation
# alongside Wyrdsekai. Outputs one of:
#
#   none            → no CodeZaiku install detected
#   lite-detected   → CodeZaiku Lite found (standalone coding harness) —
#                     this Wyrdsekai install will trigger Lite → Full
#                     migration per §0.9.3 on its first sleep-pass
#   full-installed  → already running gattai'd (Wyrdsekai + CodeZaiku Full)
#
# Detection: looks for codezaiku CLI on PATH + the canonical config-dir
# marker file. The actual migration is CodeZaiku-side code; this is just
# the wyrdsekai-side detector + report.
detect_codezaiku_mode() {
    local has_cli=0 has_config_dir=0 full_marker=0
    # CodePlane became CodeZaiku. Check the current names first and the old
    # ones after, so a machine that has not migrated is still DETECTED rather
    # than silently reported as "none" -- this function has no other signal,
    # so a miss here is invisible.
    local dir bin
    for bin in codezaiku codeplane; do
        command -v "$bin" &>/dev/null && { has_cli=1; break; }
    done
    for dir in "$HOME/.codezaiku" "$HOME/.codeplane"; do
        [[ -d "$dir" ]] && has_config_dir=1
        # Full mode marker is written by CodeZaiku on gattai'd install.
        [[ -f "$dir/full.marker" ]] && full_marker=1
    done

    if [[ "$full_marker" -eq 1 ]]; then
        echo "full-installed"
    elif [[ "$has_cli" -eq 1 || "$has_config_dir" -eq 1 ]]; then
        echo "lite-detected"
    else
        echo "none"
    fi
}

# ── Inference backend management ──
#
# wyrd inference local                    → enable bundled llama-server
# wyrd inference remote <url>             → point at an external HTTP inference server
# wyrd inference zone <zoneId>            → delegate to a peer zone via NATS
# wyrd inference status                   → show current config + healthcheck
# wyrd inference disable                  → stop local llama-server, clear override

inference_drop_in_dir="/etc/systemd/system/wyrdsekai.service.d"
inference_llama_drop_in_dir="/etc/systemd/system/wyrdsekai-llama.service.d"

is_systemd_installed() {
    command -v systemctl &>/dev/null && [[ -f /usr/lib/systemd/system/wyrdsekai.service ]]
}

write_inference_drop_in() {
    local url="$1"
    if is_systemd_installed; then
        sudo mkdir -p "$inference_drop_in_dir"
        sudo tee "$inference_drop_in_dir/inference.conf" > /dev/null <<EOF
[Service]
Environment=WYRDSEKAI_INFERENCE_URL=$url
EOF
        sudo systemctl daemon-reload
        log "$(_t inference.drop_in.wrote_systemd "$inference_drop_in_dir")"
        log "$(_t inference.drop_in.restart_systemd)"
    else
        mkdir -p "$DATA_DIR"
        grep -v '^WYRDSEKAI_INFERENCE_URL=' "$ENV_FILE" > "${ENV_FILE}.tmp" 2>/dev/null || true
        mv "${ENV_FILE}.tmp" "$ENV_FILE" 2>/dev/null || true
        echo "WYRDSEKAI_INFERENCE_URL=$url" >> "$ENV_FILE"
        log "$(_t inference.drop_in.wrote_env "$ENV_FILE")"
        log "$(_t inference.drop_in.restart_env)"
    fi
}

# Persist WYRDSEKAI_INFERENCE_HOUSEHOLD_SHARE (true|false) — the "offer" half of
# household inference auto-share. systemd drop-in or env file.
write_inference_household_share() {
    local val="$1"  # true|false
    if is_systemd_installed; then
        sudo mkdir -p "$inference_drop_in_dir"
        sudo tee "$inference_drop_in_dir/household.conf" > /dev/null <<EOF
[Service]
Environment=WYRDSEKAI_INFERENCE_HOUSEHOLD_SHARE=$val
EOF
        sudo systemctl daemon-reload
        log "Household inference share set to $val (systemd drop-in). Apply: wyrd restart"
    else
        mkdir -p "$DATA_DIR"
        grep -v '^WYRDSEKAI_INFERENCE_HOUSEHOLD_SHARE=' "$ENV_FILE" > "${ENV_FILE}.tmp" 2>/dev/null || true
        mv "${ENV_FILE}.tmp" "$ENV_FILE" 2>/dev/null || true
        echo "WYRDSEKAI_INFERENCE_HOUSEHOLD_SHARE=$val" >> "$ENV_FILE"
        log "Household inference share set to $val ($ENV_FILE). Apply: wyrd restart"
    fi
}

do_inference() {
    local subcmd="${1:-status}"
    case "$subcmd" in
        setup-local)
            # Make the local brain REAL. Invoked by the macOS onboarding
            # (gui-onboard.sh) when the user picks "Local model", and runnable
            # directly as `wyrd inference setup-local`. Ensures the MLX base
            # model is on disk (downloads it the first time, ~2.7GB), then
            # starts inference via the idempotent start_inference. Non-interactive;
            # progress streams to $DATA_DIR/.local-setup.log so the desktop app
            # can surface "Setting up your companion's mind… ".
            local plog="$DATA_DIR/.local-setup.log"
            mkdir -p "$DATA_DIR" 2>/dev/null || true
            {
              echo "[$(date '+%H:%M:%S')] preparing local inference…"
              "$0" config set WYRDSEKAI_INFERENCE_MODE=local >/dev/null 2>&1 || true
              # Apple Silicon is detected via the hw.optional.arm64 sysctl, not
              # `uname -m`: under Rosetta translation uname reports x86_64 on
              # Apple Silicon, which silently routed real M-series Macs down the
              # Intel path (the same trap build-pkg.sh documents).
              _is_apple_silicon() {
                  [[ "$(uname -s)" == "Darwin" ]] || return 1
                  [[ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null)" == "1" ]]
              }
              if _is_apple_silicon; then
                  local mlx_py=""
                  for p in "$DATA_DIR/mlx-venv/bin/python" \
                           "/usr/local/wyrdsekai/mlx-venv/bin/python" \
                           "$HOME/.wyrdsekai/mlx-venv/bin/python"; do
                      [[ -x "$p" ]] && { mlx_py="$p"; break; }
                  done
                  # Self-sufficient: if the postinstall didn't leave an mlx-venv,
                  # build one here (bundled bootstrap script if present, else a
                  # plain venv + mlx-lm). This is what makes "Local" reliably work
                  # even when the .pkg postinstall MLX bootstrap was skipped/failed.
                  if [[ -z "$mlx_py" ]]; then
                      echo "[$(date '+%H:%M:%S')] MLX runtime not present — bootstrapping (one-time)…"
                      local boot=""
                      for d in /usr/local/wyrdsekai/scripts "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/scripts"; do
                          [[ -f "$d/mac-node-bootstrap-mlx-trainer.sh" ]] && { boot="$d/mac-node-bootstrap-mlx-trainer.sh"; break; }
                      done
                      if [[ -n "$boot" ]]; then
                          WYRD_PHASE4_SKIP_BASE_PULL=1 bash "$boot" || true
                      else
                          # Prefer a Homebrew python over /usr/bin/python3.
                          # macOS still ships 3.9, and a non-interactive context
                          # (launchd, ssh without a login shell) resolves
                          # `python3` to it even when a newer one is installed —
                          # so the venv silently gets built on the old
                          # interpreter and mlx-lm wheel resolution suffers.
                          local py3=""
                          for c in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
                              [[ -x "$c" ]] && { py3="$c"; break; }
                          done
                          [[ -z "$py3" ]] && py3="$(command -v python3 || echo /usr/bin/python3)"
                          "$py3" -m venv "$DATA_DIR/mlx-venv" \
                            && "$DATA_DIR/mlx-venv/bin/pip" install -q -U pip \
                            && "$DATA_DIR/mlx-venv/bin/pip" install -q "mlx-lm>=0.21" "huggingface_hub" || true
                      fi
                      for p in "$DATA_DIR/mlx-venv/bin/python" \
                               "/usr/local/wyrdsekai/mlx-venv/bin/python" \
                               "$HOME/.wyrdsekai/mlx-venv/bin/python"; do
                          [[ -x "$p" ]] && { mlx_py="$p"; break; }
                      done
                  fi
                  # Pull BOTH MLX models — the dual stack mac-node runs:
                  #   9B drive  → :8200 (qwen3-5-9b-v5-mlx-4bit, the thinking brain)
                  #   4B voice  → :8201 (qwen3-5-4b-v10-mlx-4bit, prose/voice)
                  if [[ -n "$mlx_py" ]]; then
                      _pull_mlx() {  # repo dest label
                          if [[ -f "$2/config.json" ]]; then echo "[$(date '+%H:%M:%S')] $3 already present"; return 0; fi
                          mkdir -p "$2"
                          echo "[$(date '+%H:%M:%S')] downloading $3 from $1…"
                          if "$mlx_py" -c "from huggingface_hub import snapshot_download; snapshot_download('$1', local_dir='$2', allow_patterns=['*.safetensors*','*.json','tokenizer*','*.jinja'])"; then
                              echo "[$(date '+%H:%M:%S')] $3 ready"
                          else
                              echo "[$(date '+%H:%M:%S')] $3 pull FAILED ($1)"
                          fi
                      }
                      _pull_mlx "${WYRDSEKAI_MLX_DRIVE_REPO:-wyrdsekai/drive-3.5-9b-mlx}" \
                                "$MODELS_DIR/mlx/qwen3-5-9b-v5-mlx-4bit" "9B drive (~5GB)"
                      _pull_mlx "${WYRDSEKAI_MLX_BASE_REPO:-wyrdsekai/companion-3.5-4b-mlx}" \
                                "$MODELS_DIR/mlx/qwen3-5-4b-v10-mlx-4bit" "4B voice (~2.7GB)"
                  else
                      echo "[$(date '+%H:%M:%S')] WARN: could not build MLX runtime — start_inference will fall back to llama-server + GGUF."
                  fi
              elif [[ "$(uname -s)" == "Darwin" ]]; then
                  # Intel Mac. MLX is Apple-Silicon only and the .pkg does not
                  # bundle llama-server for macOS, so there is no local engine
                  # here unless the user installs one. Saying so plainly turns a
                  # dead end into an instruction — previously setup just ran on
                  # and inference quietly failed to start.
                  if command -v llama-server >/dev/null 2>&1; then
                      echo "[$(date '+%H:%M:%S')] Intel Mac: using llama-server from PATH ($(command -v llama-server))"
                  else
                      echo ""
                      echo "  Intel Mac detected — no local inference engine is bundled."
                      echo ""
                      echo "  Apple Silicon uses MLX, which does not run on Intel. Install"
                      echo "  llama.cpp and re-run this step:"
                      echo ""
                      echo "      brew install llama.cpp"
                      echo "      wyrd setup"
                      echo ""
                      echo "  Or point this node at a model API instead:"
                      echo ""
                      echo "      wyrd inference api"
                      echo ""
                      echo "  Or borrow inference from another machine in the household:"
                      echo ""
                      echo "      wyrd inference remote http://<host>:8200"
                      echo ""
                  fi
              fi
              echo "[$(date '+%H:%M:%S')] starting inference…"
              start_inference || true
              echo "[$(date '+%H:%M:%S')] local setup complete — backend: $(curl -s -o /dev/null -w '%{http_code}' http://localhost:8200/v1/models 2>/dev/null)"
            } 2>&1 | tee "$plog"
            ;;
        local)
            local model_arg="${2:-}"
            local models_dir
            if [[ -d /opt/wyrdsekai/data/models ]]; then
                models_dir="/opt/wyrdsekai/data/models"
            else
                models_dir="$MODELS_DIR"
            fi
            mkdir -p "$models_dir" 2>/dev/null || true

            # Locate bundled or system llama-server
            local llama_bin=""
            if [[ -x /opt/wyrdsekai/bin/llama-server ]]; then
                llama_bin="/opt/wyrdsekai/bin/llama-server"
            elif command -v llama-server &>/dev/null; then
                llama_bin="$(command -v llama-server)"
            fi
            if [[ -z "$llama_bin" ]]; then
                err "$(_t inference.local.no_llama_bin)"
                err "$(_t inference.local.no_llama_bin_deb)"
                err "$(_t inference.local.no_llama_bin_macos)"
                err "$(_t inference.local.no_llama_bin_linux)"
                return 1
            fi
            log "$(_t inference.local.using_bin "$llama_bin")"

            # Pick / download model
            local model_path="${model_arg:-}"
            if [[ -z "$model_path" ]]; then
                # Tier-aware drive selection ( /
                # OPEN-23). If the bondholder is on an 8GB-tier host AND the
                # Granite-Sub-v2 GGUF is on disk, prefer it. Otherwise fall back
                # to the legacy `recommend_model` size-based selector so we
                # don't auto-pick a model the installer hasn't fetched.
                local tier tier_model tier_model_path
                tier=$(recommend_tier)
                tier_model=$(tier_drive_model "$tier")
                tier_model_path="$models_dir/$tier_model"
                if [[ -n "$tier_model" && -f "$tier_model_path" ]]; then
                    log "Tier ${tier}: using $tier_model"
                    model_path="$tier_model_path"
                else
                    local rec
                    rec=$(recommend_model)
                    log "$(_t inference.local.recommended "$rec")"
                    case "$rec" in
                        9b) model_path="$models_dir/wyrdsekai-3.5-9b-v5-q4km.gguf" ;;
                        4b) model_path="$models_dir/wyrdsekai-3.5-4b-v10-q4km.gguf" ;;
                        0.8b) model_path="$models_dir/qwen3-0.8b-q4km.gguf" ;;
                    esac
                fi
            fi
            if [[ ! -f "$model_path" ]]; then
                warn "$(_t inference.local.model_missing "$model_path")"
                warn "$(_t inference.local.model_missing_hint)"
                return 1
            fi

            # Persist the mode so setup/start keep choosing the local stack.
            "$0" config set WYRDSEKAI_INFERENCE_MODE=local >/dev/null 2>&1 || true
            "$0" config set WYRDSEKAI_LLAMA_ENABLED=true >/dev/null 2>&1 || true
            if is_systemd_installed; then
                sudo mkdir -p "$inference_llama_drop_in_dir"
                sudo tee "$inference_llama_drop_in_dir/model.conf" > /dev/null <<EOF
[Service]
Environment=WYRDSEKAI_LLAMA_MODEL=$model_path
EOF
                sudo systemctl daemon-reload
                sudo systemctl enable --now wyrdsekai-llama.service
                log "$(_t inference.local.enabled_systemd "$(basename "$model_path")")"
                write_inference_drop_in "http://127.0.0.1:11525"
            else
                # Non-systemd: start the process ourselves (backgrounded)
                local port=11525
                pkill -f "llama-server.*--port $port" 2>/dev/null || true
                nohup "$llama_bin" --host 127.0.0.1 --port $port \
                    --model "$model_path" --ctx-size 8192 --jinja \
                    --reasoning off --reasoning-budget 0 \
                    > "$DATA_DIR/.llama-server.log" 2>&1 &
                echo $! > "$DATA_DIR/.llama-server.pid"
                log "$(_t inference.local.started_pid "$(cat "$DATA_DIR/.llama-server.pid")")"
                write_inference_drop_in "http://127.0.0.1:$port"
            fi
            ;;

        remote)
            local url="${2:-}"
            if [[ -z "$url" ]]; then
                err "$(_t inference.remote.usage)"
                err "$(_t inference.remote.example)"
                return 1
            fi
            write_inference_drop_in "$url"
            # Persist the mode so setup/start stop launching the local stack.
            "$0" config set WYRDSEKAI_INFERENCE_MODE=cloud >/dev/null 2>&1 || true
            ;;

        zone)
            local zone="${2:-}"
            if [[ -z "$zone" ]]; then
                err "$(_t inference.zone.usage)"
                err "$(_t inference.zone.example)"
                err "$(_t inference.zone.routes)"
                err "$(_t inference.zone.requires_fed)"
                return 1
            fi
            write_inference_drop_in "nats://$zone"
            # Persist the mode so setup/start stop launching the local stack.
            "$0" config set WYRDSEKAI_INFERENCE_MODE=zone >/dev/null 2>&1 || true
            ;;

        share)
            # Household inference auto-share "offer" toggle.
            local arg="${2:-status}"
            case "$arg" in
                on|true|yes|enable)   write_inference_household_share true ;;
                off|false|no|disable) write_inference_household_share false ;;
                status|"")
                    local cur="${WYRDSEKAI_INFERENCE_HOUSEHOLD_SHARE:-}"
                    if [[ -z "$cur" ]]; then cur="(unset → default off; \`wyrd inference share on\` to offer this node's GPU)"; fi
                    echo "Household inference share (offer GPU to household): $cur"
                    echo "Household inference borrow (use a household GPU): ${WYRDSEKAI_INFERENCE_HOUSEHOLD_BORROW:-(unset → default on)}"
                    ;;
                *) err "Usage: wyrd inference share [on|off|status]"; return 1 ;;
            esac
            ;;

        status)
            echo ""
            local current="${WYRDSEKAI_INFERENCE_URL:-<unset>}"
            echo "  Mode: $(effective_inference_mode) (WYRDSEKAI_INFERENCE_MODE=${WYRDSEKAI_INFERENCE_MODE:-<unset → local>})"
            log "$(_t inference.status.backend "$current")"
            # mlx:// is the macOS MLX-runtime tag. It's
            # HTTP under the hood — rewrite for probing, but flag the backend.
            local probe_url="$current"
            if [[ "$current" == mlx://* ]]; then
                probe_url="http://${current#mlx://}"
                echo -e "  Backend: ${GREEN}mlx${NC} (macOS mlx_lm.server)"
            fi
            if [[ "$probe_url" == http* ]]; then
                if curl -sf -o /dev/null --max-time 3 "$probe_url/health" 2>/dev/null || \
                   curl -sf -o /dev/null --max-time 3 "$probe_url/v1/models" 2>/dev/null; then
                    echo -e "  Health: ${GREEN}reachable${NC}"
                else
                    echo -e "  Health: ${RED}unreachable${NC}"
                fi
            elif [[ "$current" == nats://* ]]; then
                echo "$(_t inference.status.nats_note)"
            fi
            echo ""
            echo "$(_t inference.status.recommended_model "$(recommend_model)")"
            echo "  Tier: $(recommend_tier) ($(detect_total_vram_gb) GB VRAM)"
            echo "$(_t inference.status.cpu_flags "$(detect_cpu_flags)")"
            echo "$(_t inference.status.cores_ram "$(detect_cores)" "$(detect_ram_gb)")"
            echo "  Household share: ${WYRDSEKAI_INFERENCE_HOUSEHOLD_SHARE:-off (default)} | borrow: ${WYRDSEKAI_INFERENCE_HOUSEHOLD_BORROW:-on (default)}"
            if is_systemd_installed && systemctl is-active wyrdsekai-llama.service &>/dev/null; then
                echo -e "  wyrdsekai-llama: ${GREEN}active${NC}"
            fi
            ;;

        disable)
            # Persist the kill-switch so start paths stop relaunching it.
            "$0" config set WYRDSEKAI_LLAMA_ENABLED=false >/dev/null 2>&1 || true
            if is_systemd_installed; then
                sudo systemctl disable --now wyrdsekai-llama.service 2>/dev/null || true
                sudo rm -f "$inference_drop_in_dir/inference.conf"
                sudo systemctl daemon-reload
                log "$(_t inference.disable.systemd)"
            else
                if [[ -f "$DATA_DIR/.llama-server.pid" ]]; then
                    kill "$(cat "$DATA_DIR/.llama-server.pid")" 2>/dev/null || true
                    rm -f "$DATA_DIR/.llama-server.pid"
                fi
                if [[ -f "$ENV_FILE" ]]; then
                    grep -v '^WYRDSEKAI_INFERENCE_URL=' "$ENV_FILE" > "${ENV_FILE}.tmp" 2>/dev/null || true
                    mv "${ENV_FILE}.tmp" "$ENV_FILE"
                fi
                log "$(_t inference.disable.local)"
            fi
            ;;

        openrouter-connect)
            # OAuth PKCE → API key, persisted + hot-installed.
            #
            # Calls the local server's /api/oauth/openrouter/* endpoints. The
            # browser auth happens on the steward's machine; the callback
            # lands on the server (must be reachable at
            # https://$WYRDSEKAI_PUBLIC_HOST/api/oauth/openrouter/callback),
            # which persists the key + hot-installs it into the running
            # InferenceRouter so subsequent calls pick it up without a restart.
            #
            # The persisted file at $DATA_DIR/openrouter.key is what survives
            # restarts. By default we also append the conf line into $ENV_FILE
            # so it auto-loads on the next boot; pass --no-write to skip that.
            local server_port="${WYRDSEKAI_PORT:-7070}"   # #9 2026-07-19 — was hardcoded 7070
            local server_base="http://localhost:$server_port"
            local poll_timeout=600  # seconds
            local poll_interval=3
            local no_write=0
            shift  # past "openrouter-connect"
            for arg in "$@"; do
                case "$arg" in
                    --no-write) no_write=1 ;;
                    --timeout=*) poll_timeout="${arg#--timeout=}" ;;
                esac
            done

            # 1. Verify server is up + start the flow
            log "Starting OpenRouter OAuth flow…"
            local start_resp
            start_resp=$(curl -sf --max-time 5 "$server_base/api/oauth/openrouter/start" 2>&1) || {
                err "Could not reach local server at $server_base — is wyrdsekai running?"
                err "Start it with: wyrd start"
                return 1
            }
            local auth_url
            auth_url=$(echo "$start_resp" | python3 -c \
                "import sys,json; d=json.load(sys.stdin); print(d.get('auth_url') or '')" 2>/dev/null)
            if [[ -z "$auth_url" ]]; then
                # Surface the server error message if there is one.
                local hint
                hint=$(echo "$start_resp" | python3 -c \
                    "import sys,json; d=json.load(sys.stdin); print(d.get('hint') or d.get('error') or '')" 2>/dev/null)
                err "Server refused the start request${hint:+: $hint}"
                err "If you see 'no_callback_url', set WYRDSEKAI_PUBLIC_HOST in $ENV_FILE and restart."
                return 1
            fi

            # 2. Print + try to open
            echo ""
            echo "Open this URL in a browser to authorize:"
            echo "  $auth_url"
            echo ""
            for opener in xdg-open open; do
                if command -v "$opener" &>/dev/null; then
                    "$opener" "$auth_url" >/dev/null 2>&1 &
                    log "Launched $opener — switch to your browser."
                    break
                fi
            done

            # 3. Poll status until has_key=true
            log "Waiting for callback (timeout ${poll_timeout}s)…"
            local deadline=$(( $(date +%s) + poll_timeout ))
            local key_file=""
            while [[ $(date +%s) -lt $deadline ]]; do
                local status_resp
                status_resp=$(curl -sf --max-time 3 "$server_base/api/oauth/openrouter/status" 2>/dev/null) || true
                if [[ -n "$status_resp" ]]; then
                    local has_key
                    has_key=$(echo "$status_resp" | python3 -c \
                        "import sys,json; d=json.load(sys.stdin); print('1' if d.get('has_key') else '0')" 2>/dev/null)
                    if [[ "$has_key" == "1" ]]; then
                        key_file=$(echo "$status_resp" | python3 -c \
                            "import sys,json; d=json.load(sys.stdin); print(d.get('key_file') or '')" 2>/dev/null)
                        break
                    fi
                fi
                sleep "$poll_interval"
            done

            if [[ -z "$key_file" ]]; then
                err "Timed out after ${poll_timeout}s without a callback."
                err "Try again, or pass --timeout=NNN to wait longer."
                return 1
            fi
            log "Key landed at $key_file"

            # 4. Append to $ENV_FILE unless --no-write
            if [[ "$no_write" == "1" ]]; then
                echo ""
                echo "Skipping conf write (--no-write). To activate on next restart, run:"
                echo "  echo \"WYRDSEKAI_API_KEY_OPENROUTER=\$(cat $key_file)\" >> $ENV_FILE"
                echo ""
            elif [[ -f "$key_file" ]]; then
                # Drop any prior line for this var, then append.
                if [[ -w "$ENV_FILE" || ! -e "$ENV_FILE" ]]; then
                    mkdir -p "$(dirname "$ENV_FILE")" 2>/dev/null || true
                    if [[ -f "$ENV_FILE" ]]; then
                        grep -v '^WYRDSEKAI_API_KEY_OPENROUTER=' "$ENV_FILE" \
                            > "${ENV_FILE}.tmp" 2>/dev/null || true
                        mv "${ENV_FILE}.tmp" "$ENV_FILE"
                    fi
                    local key_value
                    key_value=$(cat "$key_file")
                    echo "WYRDSEKAI_API_KEY_OPENROUTER=$key_value" >> "$ENV_FILE"
                    chmod 0600 "$ENV_FILE" 2>/dev/null || true
                    log "Wrote WYRDSEKAI_API_KEY_OPENROUTER to $ENV_FILE"
                else
                    warn "Cannot write to $ENV_FILE (permission denied)."
                    warn "Run with sudo, or append manually:"
                    warn "  echo \"WYRDSEKAI_API_KEY_OPENROUTER=\$(cat $key_file)\" | sudo tee -a $ENV_FILE"
                fi
            fi

            echo ""
            log "Done. The running server has the key in memory now — no restart needed for this session."
            log "On next restart, the conf line will reload it from $ENV_FILE."
            ;;

        voice-restart)
            # Dual-inference: restart ONLY the voice backend, leaving 9B
            # skills untouched. Used by DeepSleepTrainer after the voice
            # adapter rotates on disk — pick up the new adapter.gguf without
            # disturbing the skill-serving 9B.
            if [[ "$(uname -s)" == "Darwin" ]]; then
                # macOS native path: cycle the PID-tracked llama-voice process.
                log "$(_t inference.voice_restart.macos_native)"
                "$0" voice disable || true
                sleep 1
                "$0" voice enable
                return $?
            fi
            local container="${WYRDSEKAI_VOICE_BACKEND_CONTAINER:-wyrdsekai-llama-voice}"
            if ! command -v docker &>/dev/null; then
                err "$(_t inference.voice_restart.needs_docker)"
                return 1
            fi
            if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${container}$"; then
                warn "$(_t inference.voice_restart.container_missing "$container")"
                docker start "$container" 2>/dev/null && log "$(_t inference.voice_restart.container_started "$container")" || {
                    err "$(_t inference.voice_restart.container_not_found "$container")"
                    err "$(_t inference.voice_restart.compose_hint)"
                    return 1
                }
            else
                log "$(_t inference.voice_restart.skills_intact "$container")"
                docker restart "$container"
            fi
            ;;

        voice-adapter)
            # Swap the voice adapter on disk and restart the voice backend.
            # Usage: wyrd inference voice-adapter <path-to-adapter.gguf>
            local new_adapter="${2:-}"
            if [[ -z "$new_adapter" || ! -f "$new_adapter" ]]; then
                err "$(_t inference.voice_adapter.usage)"
                err "$(_t inference.voice_adapter.usage_2)"
                return 1
            fi
            local adapter_dir="${DATA_DIR}/adapters/wyrd-voice"
            mkdir -p "$adapter_dir"
            cp -f "$new_adapter" "$adapter_dir/adapter.gguf"
            log "$(_t inference.voice_adapter.swapped "$new_adapter" "$adapter_dir")"
            # Chain to voice-restart
            "$0" inference voice-restart
            ;;

        help|*)
            echo "$(_t inference.help.title)"
            echo ""
            echo "$(_t inference.help.usage_header)"
            echo "$(_t inference.help.cmd_local)"
            echo "$(_t inference.help.cmd_remote)"
            echo "$(_t inference.help.cmd_zone)"
            echo "$(_t inference.help.cmd_status)"
            echo "$(_t inference.help.cmd_disable)"
            echo "  share [on|off|status]                       Offer this node's GPU to household members (auto-share)"
            echo ""
            echo "$(_t inference.help.dual_header)"
            echo "$(_t inference.help.cmd_voice_restart)"
            echo "$(_t inference.help.cmd_voice_adapter)"
            echo ""
            echo "Cloud connect:"
            echo "  openrouter-connect [--no-write] [--timeout=N]   OAuth → API key, write \$ENV_FILE"
            echo ""
            echo "$(_t inference.help.examples_header)"
            echo "$(_t inference.help.example_local_auto)"
            echo "$(_t inference.help.example_local_path)"
            echo "$(_t inference.help.example_remote)"
            echo "$(_t inference.help.example_zone)"
            echo "$(_t inference.help.example_voice_adapter)"
            echo "  wyrd inference openrouter-connect           # browser OAuth + activate"
            ;;
    esac
}

# ── wyrd voice — dual-inference voice-backend setup + lifecycle ───────────
#
# Voice backend is opt-in. First-boot flow:
#   1. wyrd voice init    → create directory + print how to get an adapter
#   2. (produce an adapter via DeepSleepTrainer, or seed one manually)
#   3. wyrd voice enable  → start llama-voice container
#   4. wyrd voice status  → verify health
#
# for the architecture.

# ── Sleep weight-write (dynamic substrate: the felt-gated nightly LoRA) ─────
# The sleep-forge stages $DATA_DIR/adapters/sleepwrite/current.gguf when the
# night's write passes its gates; the voice container serves it via the
# existing LLAMA_VOICE_ADAPTER path. Everything here is detachable: rollback
# removes one file and the base voice is back.
do_sleepwrite() {
    local sw_dir="$DATA_DIR/adapters/sleepwrite"
    local venv="${WYRDSEKAI_SLEEP_WRITE_VENV:-}"
    if [[ -z "$venv" && -f "$CONFIG_FILE" ]]; then
        venv=$(grep -E '^WYRDSEKAI_SLEEP_WRITE_VENV=' "$CONFIG_FILE" | tail -1 | cut -d= -f2- || true)
    fi
    case "${1:-status}" in
        status)
            if [[ -f "$sw_dir/last-result.json" ]]; then
                log "last write:"; sed 's/^/    /' "$sw_dir/last-result.json"
            else
                log "no write has run yet"
            fi
            if [[ -f "$sw_dir/current.gguf" ]]; then
                log "staged adapter: current.gguf"
            else
                log "no adapter staged — voice serves the base weights"
            fi
            if docker inspect wyrdsekai-llama-voice --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | grep -q '^LLAMA_VOICE_ADAPTER=..*'; then
                log "voice container: adapter ACTIVE"
            else
                log "voice container: serving base (adapter applies on 'wyrd sleepwrite apply' or next restart)"
            fi
            if [[ -f "$sw_dir/guard-last.json" ]]; then
                log "morning guard:"; sed 's/^/    /' "$sw_dir/guard-last.json"
            fi
            ;;
        run-once)
            local py="python3"
            [[ -n "$venv" && -x "$venv/bin/python" ]] && py="$venv/bin/python"
            log "running the night's write now ($py)..."
            WYRDSEKAI_DATA_DIR="$DATA_DIR" "$py" \
                "${WYRDSEKAI_SCRIPTS:-/opt/wyrdsekai/scripts}/training/sleepwrite/sleep_write.py"
            ;;
        apply)
            if [[ ! -f "$sw_dir/current.gguf" ]]; then
                err "nothing staged at $sw_dir/current.gguf"; return 1
            fi
            # --if-idle: the auto-apply path the sleep hook takes. She may
            # already be awake and mid-sentence by the time the write stages;
            # bouncing the voice under a live reply is not acceptable. Two
            # samples of the processing gauge, 5s apart — both zero = idle.
            if [[ "${2:-}" == "--if-idle" ]]; then
                local busy
                for _ in 1 2; do
                    busy=$(curl -sf --max-time 3 "http://127.0.0.1:${LLAMA_VOICE_PORT:-8201}/metrics" 2>/dev/null \
                        | grep -E '^llamacpp:requests_processing' | awk '{print $2}' || true)
                    if [[ -n "$busy" && "$busy" != "0" ]]; then
                        log "voice is mid-reply — leaving the adapter staged; it applies at the next restart"
                        return 0
                    fi
                    sleep 5
                done
            fi
            log "restarting voice with the staged adapter..."
            ( cd "$PROJECT_ROOT" 2>/dev/null || cd /opt/wyrdsekai
              export WYRDSEKAI_DATA="$DATA_DIR" LLAMA_VOICE_ADAPTER="sleepwrite/current.gguf"
              docker compose --profile voice up -d --force-recreate llama-voice )
            log "applied — the night is in her voice now"
            # Morning-after behavioral guard (§11.3). The training gates are
            # NLL-only and cannot see a write that changed how she BEHAVES.
            # Probe the served stack base-vs-night (same server, LoRA scale
            # 0 vs applied); a regression quarantines the adapter and puts
            # the voice back on base. Default ON — set WYRDSEKAI_SLEEP_GUARD=
            # false to skip. Exit 3 (unreachable / unmeasurable) keeps the
            # adapter: the NLL gates passed, and a probe that could not run
            # is not evidence of harm.
            if [[ "${WYRDSEKAI_SLEEP_GUARD:-true}" != "false" ]]; then
                local probe="${WYRDSEKAI_SCRIPTS:-/opt/wyrdsekai/scripts}/training/sleepwrite/morning_probe.py"
                log "morning guard: waiting for the voice to come up..."
                local healthy=""
                for _ in $(seq 1 40); do
                    if curl -sf -o /dev/null --max-time 3 \
                            "http://127.0.0.1:${LLAMA_VOICE_PORT:-8201}/health" 2>/dev/null; then
                        healthy=1; break
                    fi
                    sleep 3
                done
                if [[ -z "$healthy" ]]; then
                    warn "morning guard: voice did not become healthy in 120s — guard skipped, adapter stays"
                    return 0
                fi
                local grc=0
                LLAMA_VOICE_PORT="${LLAMA_VOICE_PORT:-8201}" python3 "$probe" \
                    --out "$sw_dir/guard-last.json" \
                    --history "$sw_dir/guard-history.jsonl" || grc=$?
                if [[ "$grc" -eq 2 ]]; then
                    warn "morning guard: the night's write changed her behavior — holding it back"
                    mkdir -p "$sw_dir/rejected"
                    mv "$sw_dir/current.gguf" \
                        "$sw_dir/rejected/rejected-$(date +%Y%m%d-%H%M%S).gguf"
                    log "adapter quarantined in $sw_dir/rejected — restarting voice on base weights..."
                    ( cd "$PROJECT_ROOT" 2>/dev/null || cd /opt/wyrdsekai
                      export WYRDSEKAI_DATA="$DATA_DIR"; unset LLAMA_VOICE_ADAPTER
                      docker compose --profile voice up -d --force-recreate llama-voice )
                    log "voice is back on base — verdict details in $sw_dir/guard-last.json"
                    return 0
                elif [[ "$grc" -eq 0 ]]; then
                    log "morning guard: PASSED — the night behaves like her"
                else
                    warn "morning guard: could not measure (rc=$grc) — adapter stays; see guard-last.json"
                fi
            fi
            ;;
        guard)
            # Manual run of the morning-after probe against the live voice.
            # Reports only — apply is the path that acts on the verdict.
            local probe="${WYRDSEKAI_SCRIPTS:-/opt/wyrdsekai/scripts}/training/sleepwrite/morning_probe.py"
            LLAMA_VOICE_PORT="${LLAMA_VOICE_PORT:-8201}" python3 "$probe" \
                --out "$sw_dir/guard-last.json" \
                --history "$sw_dir/guard-history.jsonl"
            ;;
        rollback)
            rm -f "$sw_dir/current.gguf"
            log "adapter removed — restarting voice on base weights..."
            ( cd "$PROJECT_ROOT" 2>/dev/null || cd /opt/wyrdsekai
              export WYRDSEKAI_DATA="$DATA_DIR"; unset LLAMA_VOICE_ADAPTER
              docker compose --profile voice up -d --force-recreate llama-voice )
            log "rolled back — base voice restored (past adapters kept in $sw_dir)"
            ;;
        setup)
            # Provision the training side: venv (torch + transformers + peft
            # + bitsandbytes + gguf) and the GGUF converter checkout. The
            # BASE MODEL (the companion's HF export, ~8GB) is the one piece
            # this cannot fetch — it says so plainly instead of guessing.
            local sw_venv="${venv:-$DATA_DIR/sleepwrite-venv}"
            if [[ ! -x "$sw_venv/bin/python" ]]; then
                log "creating training venv at $sw_venv (torch is large; this takes a while)..."
                python3 -m venv "$sw_venv" || { err "python3 -m venv failed"; return 1; }
                "$sw_venv/bin/pip" install -q torch --index-url https://download.pytorch.org/whl/cu130 \
                    || "$sw_venv/bin/pip" install -q torch
                "$sw_venv/bin/pip" install -q "transformers==5.8.1" peft bitsandbytes accelerate gguf sentencepiece
            else
                log "venv present: $sw_venv"
            fi
            if [[ ! -f "$DATA_DIR/sleepwrite/llama.cpp/convert_lora_to_gguf.py" ]]; then
                log "fetching GGUF converter (shallow llama.cpp clone)..."
                mkdir -p "$DATA_DIR/sleepwrite"
                git clone -q --depth 1 https://github.com/ggml-org/llama.cpp "$DATA_DIR/sleepwrite/llama.cpp" \
                    || { err "llama.cpp clone failed"; return 1; }
            else
                log "converter present"
            fi
            if [[ ! -f "$DATA_DIR/models/sleepwrite-base/config.json" ]]; then
                warn "base model missing: $DATA_DIR/models/sleepwrite-base needs the companion's"
                warn "HF export (the merged voice-model checkpoint). Copy it there, then set"
                warn "WYRDSEKAI_SLEEP_WRITE=true and WYRDSEKAI_SLEEP_WRITE_VENV=$sw_venv in the conf."
            else
                log "base model present — set WYRDSEKAI_SLEEP_WRITE=true (+_VENV=$sw_venv) in the conf to arm"
            fi
            ;;
        *) err "usage: wyrd sleepwrite [status|run-once|apply [--if-idle]|guard|rollback|setup]"; return 1 ;;
    esac
}

do_voice() {
    local adapter_dir="${DATA_DIR}/adapters/wyrd-voice"
    local adapter_file="${adapter_dir}/adapter.gguf"
    local voice_container="${WYRDSEKAI_VOICE_BACKEND_CONTAINER:-wyrdsekai-llama-voice}"
    # Resolve the voice GGUF via the canonical candidate list (ssd → 4b →
    # base) instead of a hardcoded legacy name — fresh installs download
    # `wyrdsekai-3.5-4b-v10-q4km.gguf`, not the old "balanced" build.
    local voice_model_file
    if [[ -n "${LLAMA_VOICE_MODEL:-}" ]]; then
        voice_model_file="${DATA_DIR}/models/${LLAMA_VOICE_MODEL}"
    else
        voice_model_file="$(resolve_voice_model)"
    fi

    case "${1:-help}" in
        init)
            mkdir -p "$adapter_dir"
            log "$(_t voice.init.dir_ready "$adapter_dir")"
            if [[ -f "$adapter_file" ]]; then
                log "$(_t voice.init.adapter_present "$adapter_file")"
            else
                warn "$(_t voice.init.no_adapter_yet)"
                echo "$(_t voice.init.opt_a_1)"
                echo "$(_t voice.init.opt_a_2)"
                echo "$(_t voice.init.opt_a_3 "$adapter_file")"
                echo "$(_t voice.init.opt_b_1)"
                echo "$(_t voice.init.opt_b_2)"
                echo "$(_t voice.init.opt_b_3)"
                echo "$(_t voice.init.opt_b_4 "$adapter_dir")"
                echo "$(_t voice.init.opt_c_1)"
                echo "$(_t voice.init.opt_c_2 "$adapter_file")"
            fi
            if [[ ! -f "$voice_model_file" ]]; then
                warn "$(_t voice.init.no_base_model "$voice_model_file")"
                warn "$(_t voice.init.no_base_model_hint_1)"
                warn "$(_t voice.init.no_base_model_hint_2 "${DATA_DIR}")"
            fi
            ;;

        status)
            echo ""
            log "$(_t voice.status.adapter_path "$adapter_file")"
            if [[ -f "$adapter_file" ]]; then
                local sz=$(du -h "$adapter_file" 2>/dev/null | cut -f1)
                echo -e "  Adapter:  ${GREEN}present${NC} ($sz)"
            else
                echo -e "  Adapter:  ${RED}missing${NC} — run 'wyrd voice init' for help"
            fi
            if [[ -f "$voice_model_file" ]]; then
                echo -e "  Base:     ${GREEN}present${NC} ($voice_model_file)"
            else
                echo -e "  Base:     ${RED}missing${NC} ($voice_model_file)"
            fi
            if command -v docker &>/dev/null; then
                if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${voice_container}$"; then
                    echo -e "  Container: ${GREEN}running${NC} ($voice_container)"
                    local port="${LLAMA_VOICE_PORT:-8201}"
                    if curl -sf -o /dev/null --max-time 3 "http://localhost:${port}/health" 2>/dev/null; then
                        echo -e "  Health:   ${GREEN}reachable on :${port}${NC}"
                    else
                        echo -e "  Health:   ${YELLOW}container up, health endpoint not responding yet${NC}"
                    fi
                else
                    echo -e "  Container: ${YELLOW}stopped${NC} — run 'wyrd voice enable'"
                fi
            fi
            echo ""
            ;;

        enable)
            local port="${LLAMA_VOICE_PORT:-8201}"
            if [[ "$(uname -s)" == "Darwin" ]]; then
                # macOS: prefer the MLX runtime (Phase 1+3 of ).
                # Fall back to llama-server + --lora only if MLX deps are missing,
                # so legacy installs and households still on the GGUF voice keep
                # working until they migrate via `wyrd setup`.
                if start_mlx_voice; then
                    return 0
                fi
                if [[ ! -f "$adapter_file" ]]; then
                    err "$(_t voice.enable.no_adapter "$adapter_file")"
                    return 1
                fi
                if [[ ! -f "$voice_model_file" ]]; then
                    err "$(_t voice.enable.no_base_model "$voice_model_file")"
                    return 1
                fi
                local llama
                if ! llama=$(find_llama_server); then
                    err "$(_t voice.enable.llama_missing_macos)"
                    return 1
                fi
                if [[ -f "$DATA_DIR/.llama-voice.pid" ]] && \
                   kill -0 "$(cat "$DATA_DIR/.llama-voice.pid")" 2>/dev/null; then
                    log "$(_t voice.enable.already_running "$(cat "$DATA_DIR/.llama-voice.pid")")"
                    return 0
                fi
                log "$(_t voice.enable.starting_metal "$port")"
                local gpu_layers="${WYRDSEKAI_GPU_LAYERS:-99}"
                nohup "$llama" -m "$voice_model_file" --lora "$adapter_file" \
                    --port "$port" -c "${LLAMA_VOICE_CTX:-4096}" -np 1 \
                    -ngl "$gpu_layers" --host 0.0.0.0 --jinja \
                    --reasoning off --reasoning-budget 0 \
                    > "$DATA_DIR/.llama-voice.log" 2>&1 &
                echo "$!" > "$DATA_DIR/.llama-voice.pid"
                log "$(_t voice.enable.started_pid "$(cat "$DATA_DIR/.llama-voice.pid")")"
                return 0
            fi
            # Linux/container: base model is required; the adapter is NOT —
            # V5+ voice models ship merged, and the compose entrypoint
            # already skips --lora when the adapter file is absent. Hard-
            # failing here left fresh installs unable to start voice at all.
            if [[ ! -f "$adapter_file" ]]; then
                warn "$(_t voice.enable.no_adapter "$adapter_file")"
            fi
            if [[ ! -f "$voice_model_file" ]]; then
                err "$(_t voice.enable.no_base_model "$voice_model_file")"
                return 1
            fi
            # Linux: docker compose
            if ! command -v docker &>/dev/null; then
                err "$(_t voice.enable.needs_docker)"
                return 1
            fi
            local compose_file="$PROJECT_ROOT/docker-compose.yml"
            if [[ ! -f "$compose_file" ]]; then
                err "$(_t voice.enable.no_compose "$compose_file")"
                return 1
            fi
            log "$(_t voice.enable.starting_container "$voice_container" "$port")"
            # Pre-create mount sources as the user — docker auto-creates
            # missing host mount dirs AS ROOT, leaving root-owned dirs
            # inside the data dir that break purge/reset for non-root.
            local _voice_data
            _voice_data="$(dirname "$(dirname "$voice_model_file")")"
            mkdir -p "$_voice_data/adapters" "$_voice_data/training/v8/vectors"
            ( cd "$(dirname "$compose_file")" && \
                WYRDSEKAI_DATA="$_voice_data" \
                LLAMA_VOICE_MODEL="$(basename "$voice_model_file")" \
                docker compose --profile voice up -d llama-voice )
            log "$(_t voice.enable.done)"
            ;;

        disable)
            if [[ "$(uname -s)" == "Darwin" ]]; then
                # macOS: native — stop both possible voice backends. The MLX
                # path may be running (Phase 3+) OR the legacy llama-server
                # may be (pre-migration), so check both PID files.
                local found=0
                if [[ -f "$DATA_DIR/.mlx-voice.pid" ]]; then
                    stop_mlx_voice
                    found=1
                fi
                if [[ -f "$DATA_DIR/.llama-voice.pid" ]]; then
                    local pid=$(cat "$DATA_DIR/.llama-voice.pid")
                    if kill -0 "$pid" 2>/dev/null; then
                        kill "$pid" 2>/dev/null && log "$(_t voice.disable.stopped_macos "$pid")"
                    fi
                    rm -f "$DATA_DIR/.llama-voice.pid"
                    found=1
                fi
                [[ $found -eq 0 ]] && log "$(_t voice.disable.not_running)"
                return 0
            fi
            if command -v docker &>/dev/null; then
                docker stop "$voice_container" 2>/dev/null && log "$(_t voice.disable.stopped_container "$voice_container")" \
                    || log "$(_t voice.disable.not_running)"
            fi
            ;;

        # ── VoiceProfile subcommands (#414) — view/edit reflective clauses ──
        # Backed by /api/voice/{did}/* (VoiceRoutes). Needs the companion's
        # DID (did:key:…). Writes record actor for audit; override via
        # WYRDSEKAI_VOICE_ACTOR.
        list|show|history|set|unset|freeze|unfreeze|revert)
            local vp_api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
            local vp_actor="${WYRDSEKAI_VOICE_ACTOR:-steward:$(whoami)}"
            local vp_sub="$1"; shift
            local vp_did="${1:-}"
            [[ -z "$vp_did" ]] && { err "$(_t voice.profile.usage "$vp_sub")"; return 1; }
            case "$vp_sub" in
                list|show)
                    local resp
                    resp=$(curl -sf "$vp_api/api/voice/$vp_did" 2>&1) \
                        || { err "$(_t voice.profile.list_failed "$vp_did" "$vp_api")"; return 1; }
                    echo "$resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f\"revision {d.get('revision', 0)}  frozen={d.get('frozen', False)}\")
clauses = d.get('clauses', {}) or {}
if not clauses:
    print('  (no clauses)')
else:
    for k, v in clauses.items():
        print(f'  {k}: {v}')
print(f\"history: {len(d.get('history', []))} entries\")
"
                    ;;
                history)
                    local resp
                    resp=$(curl -sf "$vp_api/api/voice/$vp_did" 2>&1) \
                        || { err "$(_t voice.profile.history_failed)"; return 1; }
                    echo "$resp" | python3 -c "
import sys, json
d = json.load(sys.stdin)
hs = d.get('history', []) or []
if not hs: print('(no history)'); sys.exit(0)
for h in hs:
    print(f\"rev {h.get('fromRevision')} -> {h.get('toRevision')}  at {h.get('at', '?')}  by {h.get('author', '?')}: {h.get('reason', '')}\")
"
                    ;;
                set)
                    local key="${2:-}" value="${3:-}"
                    [[ -z "$key" || -z "$value" ]] \
                        && { err "$(_t voice.profile.set_usage)"; return 1; }
                    local body
                    body=$(python3 -c "import json,sys; print(json.dumps({'value': sys.argv[1], 'reason': 'wyrd voice set'}))" "$value")
                    curl -sf -X POST -H 'Content-Type: application/json' \
                        "$vp_api/api/voice/$vp_did/clauses/$key?actor=$vp_actor" -d "$body" >/dev/null \
                        || { err "$(_t voice.profile.set_failed)"; return 1; }
                    log "$(_t voice.profile.set_ok "$key")"
                    ;;
                unset)
                    local key="${2:-}"
                    [[ -z "$key" ]] && { err "$(_t voice.profile.unset_usage)"; return 1; }
                    curl -sf -X DELETE "$vp_api/api/voice/$vp_did/clauses/$key?actor=$vp_actor" >/dev/null \
                        || { err "$(_t voice.profile.unset_failed)"; return 1; }
                    log "$(_t voice.profile.unset_ok "$key")"
                    ;;
                freeze)
                    curl -sf -X POST "$vp_api/api/voice/$vp_did/freeze?actor=$vp_actor" >/dev/null \
                        || { err "$(_t voice.profile.freeze_failed)"; return 1; }
                    log "$(_t voice.profile.freeze_ok)"
                    ;;
                unfreeze)
                    curl -sf -X POST "$vp_api/api/voice/$vp_did/unfreeze?actor=$vp_actor" >/dev/null \
                        || { err "$(_t voice.profile.unfreeze_failed)"; return 1; }
                    log "$(_t voice.profile.unfreeze_ok)"
                    ;;
                revert)
                    local rev="${2:-}"
                    [[ -z "$rev" ]] && { err "$(_t voice.profile.revert_usage)"; return 1; }
                    curl -sf -X POST "$vp_api/api/voice/$vp_did/revert/$rev?actor=$vp_actor" >/dev/null \
                        || { err "$(_t voice.profile.revert_failed)"; return 1; }
                    log "$(_t voice.profile.revert_ok "$rev")"
                    ;;
            esac
            ;;

        help|*)
            echo "$(_t voice.help.title)"
            echo ""
            echo "$(_t voice.help.lifecycle_header)"
            echo "$(_t voice.help.cmd_init)"
            echo "$(_t voice.help.cmd_status)"
            echo "$(_t voice.help.cmd_enable)"
            echo "$(_t voice.help.cmd_disable)"
            echo ""
            echo "$(_t voice.help.profile_header)"
            echo "$(_t voice.help.cmd_list)"
            echo "$(_t voice.help.cmd_history)"
            echo "$(_t voice.help.cmd_set)"
            echo "$(_t voice.help.cmd_unset)"
            echo "$(_t voice.help.cmd_freeze)"
            echo "$(_t voice.help.cmd_unfreeze)"
            echo "$(_t voice.help.cmd_revert)"
            echo ""
            echo "$(_t voice.help.notes_1)"
            echo "$(_t voice.help.notes_2)"
            echo ""
            echo "$(_t voice.help.env_header)"
            echo "$(_t voice.help.env_actor)"
            echo "$(_t voice.help.env_api_url)"
            echo ""
            echo "$(_t voice.help.related_header)"
            echo "$(_t voice.help.related_voice_restart)"
            echo "$(_t voice.help.related_voice_adapter)"
            ;;
    esac
}

# ── Coding-CLI bundle management ──
#
# Manifest-driven download + verify + install for non-default coding
# backends (Goose, Claude SDK, Codex, Gemini, Cline, Continue, …).
# OpenCode is bundled directly in the install image; everything else
# ships as a manifest entry only and gets fetched on demand.
#
# Java entry point: org.wyrdsekai.core.coding.CodingCli — all subcommands
# (list/status/install/uninstall/update) route through there so the
# trust + retry + sha256 logic lives in one place. This shell wrapper
# is just classpath assembly + arg passthrough.
# Which file the RUNNING node reads. Under systemd the unit's EnvironmentFile
# is /etc/wyrdsekai/wyrdsekai.conf and nothing else; writing $ENV_FILE there is
# silently ignored (second-node 2026-07-02, the companion born "wyrd" regardless).
_coding_conf_target() {
    if is_systemd_managed && [[ -f /etc/wyrdsekai/wyrdsekai.conf ]]; then
        echo /etc/wyrdsekai/wyrdsekai.conf
    else
        echo "$ENV_FILE"
    fi
}

# wyrd coding use <backend> — choose the default coding backend, then SHOW the
# chain the node will actually use.
#
# The showing is the point. Until 2026-08-23 reference.conf bound the env var to
# the HOCON key `default-backend` while the resolver read `default_backend`: two
# different keys, so the documented setting wrote something nobody consulted and
# the chain silently stayed [goose, pi]. A setting you cannot observe taking
# effect is a setting you cannot trust.
do_coding_use() {
    local backend="${1:-}"
    if [[ -z "$backend" ]]; then
        echo "Usage: wyrd coding use <backend>"
        echo "   eg: wyrd coding use codezaiku"
        echo ""
        echo "Sets the default coding backend and prints the resulting chain."
        echo "Run 'wyrd coding list' to see which backends this node has."
        return 1
    fi
    backend=$(printf '%s' "$backend" | tr -cd 'A-Za-z0-9_-')
    [[ -n "$backend" ]] || { err "wyrd coding use: invalid backend name"; return 1; }

    local conf; conf=$(_coding_conf_target)
    if [[ ! -f "$conf" ]]; then
        err "wyrd coding use: no config file at $conf"
        return 1
    fi
    if [[ ! -w "$conf" ]]; then
        err "wyrd coding use: $conf is not writable — run with sudo, or edit it by hand:"
        err "  WYRDSEKAI_CODING_DEFAULT_BACKEND=$backend"
        return 1
    fi

    # Replace an existing line in place; otherwise append. Never leave two.
    if grep -q '^WYRDSEKAI_CODING_DEFAULT_BACKEND=' "$conf" 2>/dev/null; then
        local previous
        previous=$(grep '^WYRDSEKAI_CODING_DEFAULT_BACKEND=' "$conf" | tail -1 | cut -d= -f2-)
        sed -i "s|^WYRDSEKAI_CODING_DEFAULT_BACKEND=.*|WYRDSEKAI_CODING_DEFAULT_BACKEND=$backend|" "$conf" \
            || { err "wyrd coding use: could not write $conf"; return 1; }
        log "coding backend: $previous -> $backend  ($conf)"
    else
        printf '\n# Default coding backend (wyrd coding use)\nWYRDSEKAI_CODING_DEFAULT_BACKEND=%s\n' \
            "$backend" >> "$conf" \
            || { err "wyrd coding use: could not write $conf"; return 1; }
        log "coding backend: $backend  ($conf)"
    fi

    # Read it back through the SAME resolver the server uses, with the value in
    # the environment, so what prints is what the node will do — not what we
    # hoped writing the line would mean.
    echo ""
    WYRDSEKAI_CODING_DEFAULT_BACKEND="$backend" do_coding chain || true
    echo ""
    # `wyrd restart` already routes through systemctl when the unit is installed
    # and falls back to the plain process path when it is not, so it is the one
    # instruction that is correct on every node. Naming `systemctl` here was
    # wrong twice over: it is the wrong command on a non-systemd node, and on a
    # systemd node it tells the operator to step around their own tooling.
    #
    # Backends are resolved and registered once, at boot -- so this restart is
    # also what makes a backend INSTALLED AFTER the node started visible at all.
    log "Restart to apply:  wyrd restart"
}

do_coding() {
    # `use` is a config-file operation: the conf path, systemd detection and
    # writability all live here, not in the Java CLI.
    if [[ "${1:-}" == "use" || "${1:-}" == "default" ]]; then
        do_coding_use "${@:2}"
        return $?
    fi
    # Reuse the same lib-dir-resolution pattern as `wyrd verify-release`: the
    # cli installDist already pulls core + all transitive deps (jackson,
    # slf4j, …), so a single lib/ dir is enough for the classpath.
    local CLI_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/cli/build/install/cli" ]]; then
            log "Building cli for wyrd coding (one-time)..."
            (cd "$PROJECT_ROOT" && "$GRADLE" :cli:installDist -q) \
                || { err "Failed to build cli for wyrd coding"; return 1; }
        fi
        CLI_LIB="$PROJECT_ROOT/cli/build/install/cli/lib"
    else
        CLI_LIB="$REAL_BIN/../lib/cli"
        [[ ! -d "$CLI_LIB" ]] && CLI_LIB="$REAL_BIN/../lib"
    fi
    [[ ! -d "$CLI_LIB" ]] && { err "wyrd coding: cli libs not found at $CLI_LIB"; return 1; }
    find_java || { err "$(_t common.java_missing 2>/dev/null || echo 'Java >=25 required')"; return 1; }

    local CP
    CP=$(echo "$CLI_LIB"/*.jar | tr ' ' ':')
    # Source-mode override: prefer freshly compiled classes from core +
    # common when they exist, so an iterative edit-recompile-run loop
    # doesn't have to re-run installDist every time.
    if [[ "$MODE" == "source" ]] && [[ -d "$PROJECT_ROOT/core/build/classes/java/main" ]]; then
        CP="$PROJECT_ROOT/core/build/classes/java/main:$PROJECT_ROOT/common/build/classes/java/main:$CP"
    fi

    # Pass WYRDSEKAI_DATA_DIR through so CodingCli installs binaries to
    # the same data root the rest of the CLI uses.
    WYRDSEKAI_DATA_DIR="${WYRDSEKAI_DATA_DIR:-$DATA_DIR}" \
        "$JAVA_CMD" -cp "$CP" org.wyrdsekai.core.coding.CodingCli "$@"
}

# ── Interactive terminal client ──
#
# Launches the bundled JLine TUI (org.wyrdsekai.cli.Wyrd) against a
# running node — the way in when there's no ssh client on the box, or
# the steward doesn't know how to use one. Speaks the same WebSocket
# protocol on :7070 as the phone clients; --host/--port pass through.
do_connect() {
    # Friendly positional form so a remote connect is discoverable without
    # reading source: `wyrd connect <host> [port]`. Anything not starting with
    # '-' is taken as the host (and an immediately-following number as the
    # port). The explicit --host/--port/--accessible/--guest flags still work
    # and, being parsed later, override.
    local -a host_args=()
    if [[ -n "${1:-}" && "$1" != -* ]]; then
        host_args+=(--host "$1"); shift
        if [[ -n "${1:-}" && "$1" =~ ^[0-9]+$ ]]; then
            host_args+=(--port "$1"); shift
        fi
    fi
    local CLI_LIB
    if [[ "$MODE" == "source" ]]; then
        local cli_install="$PROJECT_ROOT/cli/build/install/cli"
        # Rebuild when the install bundle is absent OR when any CLI source is
        # newer than it. The old absent-only check left a stale installDist
        # serving the previous renderer after a fix landed in source — e.g. the
        # SSH-parity compact look never reached `wyrd connect` because the
        # day-old bundle was reused. Comparing against lib/ (installDist
        # repopulates it) self-heals on every source change.
        if [[ ! -d "$cli_install/lib" ]] || \
           [[ -n "$(find "$PROJECT_ROOT/cli/src" -name '*.java' \
                        -newer "$cli_install/lib" -print -quit 2>/dev/null)" ]]; then
            log "$(_t connect.building)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :cli:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        CLI_LIB="$cli_install/lib"
    else
        CLI_LIB="$REAL_BIN/../lib/cli"
        [[ ! -d "$CLI_LIB" ]] && CLI_LIB="$REAL_BIN/../lib"
    fi
    [[ ! -d "$CLI_LIB" ]] && { err "$(_t common.cli_libs_missing "$CLI_LIB")"; return 1; }
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$CLI_LIB"/*.jar | tr ' ' ':')
    "$JAVA_CMD" -cp "$CP" org.wyrdsekai.cli.Wyrd --port "${WYRDSEKAI_PORT:-7070}" \
        ${host_args[@]+"${host_args[@]}"} "$@"
}

# ── Browser terminal (ttyd wrapping `wyrd connect`) ──
#
# Opt-in web terminal on :7071 (all interfaces): ttyd serves the built-in
# TUI client over xterm.js, so a browser gets the full terminal experience
# with no ssh anywhere in the chain. ttyd itself grants nothing — every
# visitor lands in their own `wyrd connect` and must /login in-band.
# `enable` leaves a marker so `wyrd start` brings it back up; `disable`
# removes it. Traffic is plain HTTP — household/LAN trust, same caveat as
# the :7070 surfaces.
WYRD_WEB_PORT="${WYRDSEKAI_WEB_TERMINAL_PORT:-7071}"

ttyd_running() {
    curl -sf "http://127.0.0.1:${WYRD_WEB_PORT}/" >/dev/null 2>&1
}

start_web_terminal() {
    command -v ttyd >/dev/null 2>&1 || { err "$(_t web.ttyd_missing)"; return 1; }
    if ttyd_running; then
        log "$(_t web.already_running "$WYRD_WEB_PORT")"
        return 0
    fi
    mkdir -p "$DATA_DIR"
    nohup ttyd -p "$WYRD_WEB_PORT" -i 0.0.0.0 -W "$SELF" connect \
        >"$DATA_DIR/.ttyd.log" 2>&1 &
    echo "$!" > "$DATA_DIR/.ttyd.pid"
    sleep 1
    if ttyd_running; then
        log "$(_t web.started "$WYRD_WEB_PORT")"
    else
        warn "$(_t web.not_responding "$WYRD_WEB_PORT" "$DATA_DIR/.ttyd.log")"
        return 1
    fi
}

stop_web_terminal() {
    if [[ -f "$DATA_DIR/.ttyd.pid" ]]; then
        local pid; pid=$(<"$DATA_DIR/.ttyd.pid")
        kill "$pid" 2>/dev/null || true
        rm -f "$DATA_DIR/.ttyd.pid"
    fi
    pkill -f "ttyd -p ${WYRD_WEB_PORT}" 2>/dev/null || true
}

do_web() {
    local action="${1:-status}"
    local marker="$DATA_DIR/.web-terminal-enabled"
    case "$action" in
        enable|start)
            start_web_terminal || return 1
            touch "$marker"
            echo "  $(_t web.url "$WYRD_WEB_PORT")"
            ;;
        disable|stop)
            stop_web_terminal
            rm -f "$marker"
            log "$(_t web.stopped)"
            ;;
        status)
            if ttyd_running; then
                log "$(_t web.status_running "$WYRD_WEB_PORT")"
            else
                log "$(_t web.status_stopped)"
            fi
            ;;
        *)
            echo "usage: wyrd web [enable|disable|status]"
            ;;
    esac
}

# ── Release-binary signature verification ──
#
# Native verifier — no `cosign` dependency. The wyrd binary owns its
# own trust chain via embedded BuiltinReleaseTrust constants. Phase 1
# does structural checks (artifact hash, workflow-identity SAN URI,
# OIDC issuer); Phase 1.5 will add cryptographic chain validation
# against an embedded Sigstore trusted root.
do_verify_release() {
    local CLI_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/cli/build/install/cli" ]]; then
            log "$(_t common.building_cli_verify)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :cli:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        CLI_LIB="$PROJECT_ROOT/cli/build/install/cli/lib"
    else
        CLI_LIB="$REAL_BIN/../lib/cli"
        [[ ! -d "$CLI_LIB" ]] && CLI_LIB="$REAL_BIN/../lib"
    fi
    [[ ! -d "$CLI_LIB" ]] && { err "$(_t common.cli_libs_missing "$CLI_LIB")"; return 1; }
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$CLI_LIB"/*.jar | tr ' ' ':')
    # Source-mode override: pick up freshly compiled classes if present.
    if [[ "$MODE" == "source" ]] && [[ -d "$PROJECT_ROOT/cli/build/classes/java/main" ]]; then
        CP="$PROJECT_ROOT/cli/build/classes/java/main:$PROJECT_ROOT/core/build/classes/java/main:$CP"
    fi
    "$JAVA_CMD" -cp "$CP" org.wyrdsekai.cli.ReleaseVerifyMain "$@"
}

