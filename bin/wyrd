    config)     do_config "${2:-help}" "${3:-}" ;;
    reset)      do_reset "${2:-soft}" ;;
    reseed)     do_reseed ;;
    zone)       do_zone "${2:-help}" "${3:-}" ;;
    # Zone-naming admin. Forward all remaining args straight
    # through — NamingAdminMain owns the subcommand + validation surface.
    contacts)   do_naming_admin contacts "${@:2}" ;;
    zones)      do_naming_admin zones "${@:2}" ;;
    whoami)     do_naming_admin whoami ;;
    block)      do_naming_admin block "${@:2}" ;;
    unblock)    do_naming_admin unblock "${@:2}" ;;
    blocks)     do_naming_admin blocks ;;
    safety)     do_naming_admin safety "${@:2}" ;;
