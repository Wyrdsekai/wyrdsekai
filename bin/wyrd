    setup)      do_setup "${@:2}" ;;
    # spec-named verb: `wyrd openclaw setup` ≡ `wyrd setup openclaw`.
    openclaw)
        case "${2:-}" in
            setup) do_setup_openclaw "${@:3}" ;;
            *)     err "usage: wyrd openclaw setup [--image <ref>] [--port <n>] [--skip-pull] [--no-start]"; exit 1 ;;
        esac ;;
    start)      do_start ;;
    stop)       do_stop ;;
    restart)    do_stop; sleep 1; do_start ;;
    status)     do_status ;;
    log)        do_log ;;
    backup)     do_backup ;;
    model)      do_model "${2:-}" "${3:-}" ;;
    restore)    do_restore "$2" ;;
