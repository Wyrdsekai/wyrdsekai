    nuke)       do_nuke ;;
    version)    do_version "${@:2}" ;;
    *)
        echo "$(_t usage.title)"
        echo ""
        echo "$(_t usage.line)"
        echo ""
        echo "$(_t usage.commands_label)"
        echo "$(_t usage.cmd.setup)"
        echo "$(_t usage.cmd.start)"
        echo "$(_t usage.cmd.stop)"
        echo "$(_t usage.cmd.restart)"
        echo "$(_t usage.cmd.status)"
        echo "$(_t usage.cmd.connect)"
        echo "$(_t usage.cmd.web)"
        echo "$(_t usage.cmd.log)"
        echo "$(_t usage.cmd.backup)"
        echo "$(_t usage.cmd.vault)"
        echo "$(_t usage.cmd.model)"
        echo "$(_t usage.cmd.restore)"
        echo "$(_t usage.cmd.config)"
        echo "$(_t usage.cmd.reset)"
        echo "$(_t usage.cmd.reseed)"
        echo "$(_t usage.cmd.update)"
        echo "$(_t usage.cmd.doctor)"
        echo "$(_t usage.cmd.state)"
        echo "  embed-migrate     Re-embed all stored embeddings on the bundled model (--plan/--run/--status/--reset)"
        echo "  embedding-model   Manage which embedding model is active (status/list/recommend/set/download)"
        echo "$(_t usage.cmd.inference)"
        echo "  coding       Manage coding-CLI backends: list/status/install/uninstall/update <backend>"
        echo "  researcher   ResearchZosho, the research librarian: setup (the wizard) / install / link / status / gpu / update / unlink"
        echo "  items        Scripted items: check — every item's world.* calls against the API this build serves
