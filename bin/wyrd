#!/usr/bin/env bash
#
# wyrd — Wyrdsekai control CLI
#
# Works in two modes:
#   Source checkout: builds from source via gradlew
#   Package install: uses pre-built JARs from /opt/wyrdsekai (deb) or /usr/local/wyrdsekai (pkg)
#
# Usage:
#   wyrd setup      First-time setup (models, inference, docker services)
#                   Use `--auto-yes` (`-y`) for unattended installs (CI/scripts):
#                   applies hardware-recommended embedding model on fresh hosts.
#   wyrd start      Start server
#   wyrd stop       Stop server
#   wyrd restart    Stop then start
#   wyrd status     Show what's running
#   wyrd log        Tail server log
#   wyrd nuke       Kill all wyrdsekai processes
#   wyrd version    Show version info
#
set -euo pipefail

# ── Detect install location ──
SELF="$0"
if [[ -L "$SELF" ]]; then SELF="$(readlink -f "$SELF")"; fi
REAL_BIN="$(cd "$(dirname "$SELF")" && pwd)"
PROJECT_ROOT="$(cd "$REAL_BIN/.." && pwd)"

# Detect mode: source checkout or package install
if [[ -f "$PROJECT_ROOT/gradlew" ]]; then
    MODE="source"
    GRADLE="$PROJECT_ROOT/gradlew"
else
    MODE="package"
fi

# macOS defaults to 256 file descriptors — way too low for Pekko + NATS + Javalin.
# Increase to 10240 (same as what Homebrew services use).
ulimit -n 10240 2>/dev/null || ulimit -n 4096 2>/dev/null || true

# Canonical data-dir resolution. Must match SystemPaths.java so the CLI
# and the root-run systemd service never disagree about where state lives.
# Resolution order:
#   1. $WYRDSEKAI_DATA_DIR (explicit — wins if set)
#   2. /var/lib/wyrdsekai when a .deb service is installed (detected via the
#      canonical /etc/wyrdsekai/wyrdsekai.conf). Lets you@test-node run
#      `wyrd config set X=Y` and have it actually land where the root-run
#      service reads, instead of writing to /home/you/.wyrdsekai/ silently.
#   3. $HOME/.wyrdsekai for source / dev installs.
if [[ -n "${WYRDSEKAI_DATA_DIR:-}" ]]; then
    DATA_DIR="$WYRDSEKAI_DATA_DIR"
elif [[ "$(uname -s)" == "Darwin" ]]; then
    # macOS .pkg install: the LaunchDaemon plist substitutes __HOME__ at
    # install time with the installer's user-home, and the daemon runs as
    # root with -Duser.home=__HOME__ so its data dir resolves to
    # __HOME__/.wyrdsekai. We need the CLI to land on the SAME path even
    # when invoked under sudo (which would otherwise reset HOME to
    # /var/root). Use $SUDO_USER's home when running under sudo; fall back
    # to $HOME for non-sudo CLI invocations. The /etc/wyrdsekai/wyrdsekai.conf
    # convention from .deb does NOT apply on macOS because the .pkg places
    # all data under the user-home, not /var/lib.
    # GROUND TRUTH first: if a LaunchDaemon is installed, its plist pins the
    # EXACT WYRDSEKAI_DATA_DIR the root daemon uses (do_start writes it into
    # EnvironmentVariables). Trust that over HOME/$SUDO_USER inference so a
    # `sudo wyrd …` CLI (whose HOME resets to /var/root) can NOT silently target
    # a different data dir than the running daemon. That mismatch lands invites,
    # keys, and ssh-tunnel config in a DB/dir the daemon never reads — the root
    # cause of the mac-node "ssh-enable / invite create didn't take" class of bugs
    # (relay-reinstall 2026-06-21). Honour explicit $WYRDSEKAI_DATA_DIR above all.
    _daemon_data_dir=""
    if [[ -x /usr/libexec/PlistBuddy ]]; then
        for _lbl in com.wyrdsekai.server org.wyrdsekai.server dev.wyrdsekai.server; do
            _plist="/Library/LaunchDaemons/$_lbl.plist"
            [[ -f "$_plist" ]] || continue
            _daemon_data_dir="$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:WYRDSEKAI_DATA_DIR' "$_plist" 2>/dev/null)" || _daemon_data_dir=""
            [[ -n "$_daemon_data_dir" ]] && break
        done
    fi
    if [[ -n "$_daemon_data_dir" ]]; then
        DATA_DIR="$_daemon_data_dir"
    elif [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
        # `sudo` was used — resolve $SUDO_USER's home dir via `dscl` (macOS-
        # native; `getent passwd` is Linux-only). Falls back to the standard
        # /Users/$SUDO_USER on failure.
        _sudo_home="$(dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
        [[ -z "$_sudo_home" || ! -d "$_sudo_home" ]] && _sudo_home="/Users/$SUDO_USER"
        DATA_DIR="$_sudo_home/.wyrdsekai"
    else
        DATA_DIR="$HOME/.wyrdsekai"
    fi
    export WYRDSEKAI_DATA_DIR="$DATA_DIR"
elif [[ -f /etc/wyrdsekai/wyrdsekai.conf ]] || [[ -d /var/lib/wyrdsekai ]]; then
    DATA_DIR="/var/lib/wyrdsekai"
    export WYRDSEKAI_DATA_DIR="$DATA_DIR"
else
    DATA_DIR="$HOME/.wyrdsekai"
fi
CONFIG_FILE="${WYRDSEKAI_CONFIG_FILE:-/etc/wyrdsekai/wyrdsekai.conf}"
[[ ! -f "$CONFIG_FILE" ]] && CONFIG_FILE="$DATA_DIR/wyrdsekai.conf"
ENV_FILE="$DATA_DIR/env"
# The ONLY file the packaged service reads (systemd unit / launchd plist).
# $ENV_FILE is source-mode's config and a record; in package mode it is inert.
CANONICAL_CONF="${WYRDSEKAI_CANONICAL_CONF:-/etc/wyrdsekai/wyrdsekai.conf}"

# ── The two config formats are NOT the same language ─────────────────────────
# $ENV_FILE is sourced by bash: `FOO=$(hostname)` runs hostname.
# $CANONICAL_CONF is read by systemd's EnvironmentFile (and launchd): there is
# no command substitution, no parameter expansion, no subshell. `FOO=$(hostname)`
# sets FOO to the eleven characters `$(hostname)`.
#
# Nothing warns about this. The value simply arrives at the JVM as nonsense, and
# how far it gets depends on who reads it: WYRDSEKAI_NODE_ID reached Pekko's
# ReplicationId, which rejected it for containing `|`, and the exception killed
# Main *after* systemd had reported the unit active — "Server started (pid N)
# but port 7070 not yet responding", with a green `systemctl status`.
#
# So: a value crossing into $CANONICAL_CONF must be a literal.
_has_deferred_substitution() {
    case "$1" in
        *'$('*|*'${'*|*'`'*) return 0 ;;
        *) return 1 ;;
    esac
}

# Resolve one such value the way bash would have when sourcing $ENV_FILE, so the
# canonical conf gets what the operator meant. Runs in a subshell with no
# arguments and a scrubbed IFS; on any failure it prints nothing and fails, and
# the caller skips the key rather than writing a value it cannot vouch for.
_resolve_deferred_value() {
    local _raw="$1" _out
    _out=$( IFS=$' \t\n'; eval "printf '%s' \"$_raw\"" 2>/dev/null ) || return 1
    # A multi-line or empty result is not something a systemd conf can carry.
    [[ -n "$_out" && "$_out" != *$'\n'* ]] || return 1
    printf '%s' "$_out"
}

# Repair a canonical conf that already carries an unexpanded substitution.
# Installs made between 2026-07-27 and 2026-07-29 have a poisoned
# WYRDSEKAI_NODE_ID and will not bind :7070; those hosts must heal on the next
# `wyrd setup` rather than needing the file hand-edited.
_repair_canonical_conf() {
    [[ -f "$CANONICAL_CONF" ]] || return 0
    local _line _key _val _fixed _repaired=0 _tmp
    _tmp="${CANONICAL_CONF}.repair.$$"
    : > "$_tmp" || return 0
    while IFS= read -r _line || [[ -n "$_line" ]]; do
        case "$_line" in
            ''|'#'*) printf '%s\n' "$_line" >> "$_tmp"; continue ;;
            *=*) _key="${_line%%=*}"; _val="${_line#*=}" ;;
            *) printf '%s\n' "$_line" >> "$_tmp"; continue ;;
        esac
        if _has_deferred_substitution "$_val" && _fixed=$(_resolve_deferred_value "$_val"); then
            printf '%s=%s\n' "$_key" "$_fixed" >> "$_tmp"
            _repaired=$((_repaired + 1))
        else
            printf '%s\n' "$_line" >> "$_tmp"
        fi
    done < "$CANONICAL_CONF"
    if [[ $_repaired -gt 0 ]]; then
        cat "$_tmp" > "$CANONICAL_CONF" && \
            log "$(_t setup.config.canonical_repaired "$_repaired" "$CANONICAL_CONF")"
    fi
    rm -f "$_tmp"
}

MODELS_DIR="$DATA_DIR/models"
PID_FILE="$DATA_DIR/.server.pid"
LOG_FILE="$DATA_DIR/.server.log"
PORT="${WYRDSEKAI_PORT:-7070}"

# ── Where the JVM side writes its rolling log ────────────────────────────────
# logback.xml resolves ${WYRDSEKAI_LOG_DIR:-logs} — a RELATIVE default. Left
# unset, every `wyrd` subcommand that shells into Java dropped a logs/ directory
# into whatever directory the operator happened to be standing in, and a single
# `sudo wyrd …` left behind a root-owned wyrdsekai.log that every later non-root
# run could not open. Logback treats a failed appender as a CONFIGURATION error,
# so it then dumped ~60 lines of internal status plus a stack trace over the
# command's real output — the command had actually succeeded (second-node, 2026-07-28).
#
# Pin it to one absolute per-user path. Per-user, not shared, because that is
# what keeps root and the operator from fighting over the same file. The
# packaged daemon does not come through this script — systemd runs
# wyrdsekai-server directly with its own WorkingDirectory — so its log location
# is unchanged.
: "${WYRDSEKAI_LOG_DIR:=${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/wyrdsekai/logs}"
export WYRDSEKAI_LOG_DIR
mkdir -p "$WYRDSEKAI_LOG_DIR" 2>/dev/null || true

# Ensure standard macOS paths are in PATH (SSH sessions often miss these)
if [[ "$(uname -s)" == "Darwin" ]]; then
    for p in /opt/homebrew/bin /usr/local/bin; do
        [[ -d "$p" && ":$PATH:" != *":$p:"* ]] && export PATH="$p:$PATH"
    done
fi

# Source env if exists
if [[ -f "$ENV_FILE" ]]; then
    set -a; source "$ENV_FILE"; set +a
fi
# Also source the canonical service conf when it's a DIFFERENT file. On an
# installed .deb node the systemd unit reads /etc/wyrdsekai/wyrdsekai.conf —
# that is where `wyrd config set`, `wyrd relay` and `wyrd join` persist. Source
# it last so the CLI's view can never silently disagree with what the running
# service actually reads. (Single-canonical-conf invariant; see build-deb.sh.)
# Guard on -r (readable), NOT -f (exists): the system conf may be root-owned 0600
# (it can hold an API key), so a non-root invocation — e.g. the .pkg postinstall
# running `sudo -u <user> wyrd oracle bootstrap` — can't read it. Under
# `set -euo pipefail` a failed `source` of an unreadable file aborts the whole
# command, which is how oracle bootstrap was silently "deferred". Skip it instead.
if [[ -r "$CONFIG_FILE" && "$CONFIG_FILE" != "$ENV_FILE" ]]; then
    set -a; source "$CONFIG_FILE"; set +a
fi

# ── Colors ──
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; NC='\033[0m'
log()  { echo -e "${GREEN}[wyrd]${NC} $*"; }
warn() { echo -e "${YELLOW}[wyrd]${NC} $*"; }
err()  { echo -e "${RED}[wyrd]${NC} $*" >&2; }

# ── i18n ──
# Catalogs live at scripts/i18n/wyrd_<locale>.json. Locale resolution:
#   1. $WYRDSEKAI_LOCALE — explicit override (en|es|ja)
#   2. $LANG / $LC_ALL    — derive 2-letter code (es_MX.UTF-8 → es)
#   3. en — fallback
# Missing keys fall through to English; missing key in English returns the
# key itself (so a stray reference is visible rather than blank). New CLI
# strings should land in wyrd_en.json first; es/ja inherit by fallback.
_resolve_wyrd_locale() {
    local L="${WYRDSEKAI_LOCALE:-${WYRDSEKAI_LANG:-}}"
    if [[ -z "$L" ]]; then
        L="${LC_ALL:-${LANG:-}}"
        L="${L%%.*}"   # strip ".UTF-8"
        L="${L%%_*}"   # strip "_MX" / "_JP"
    fi
    case "$L" in
        es|ja|en) echo "$L" ;;
        *) echo "en" ;;
    esac
}
WYRD_LOCALE="$(_resolve_wyrd_locale)"
_resolve_wyrd_i18n_dir() {
    # Search order matches MODE: source checkout vs package install
    for d in \
        "$PROJECT_ROOT/scripts/i18n" \
        "/usr/local/wyrdsekai/scripts/i18n" \
        "/opt/wyrdsekai/scripts/i18n"; do
        [[ -f "$d/wyrd_en.json" ]] && { echo "$d"; return; }
    done
    echo ""
}
WYRD_I18N_DIR="$(_resolve_wyrd_i18n_dir)"

# Config catalog (scripts/config-catalog.json) — every WYRDSEKAI_* key this
# build understands, with a one-line description + default. Generated from the
# in-world Scroll of Settings so `wyrd config list --all`, the scroll, and the
# Windows CLI all read ONE inventory (2026-07-31: `config list` could only show
# keys already written to the conf, so there was no way to discover the rest).
_resolve_wyrd_config_catalog() {
    for f in \
        "$PROJECT_ROOT/scripts/config-catalog.json" \
        "/usr/local/wyrdsekai/scripts/config-catalog.json" \
        "/opt/wyrdsekai/scripts/config-catalog.json"; do
        [[ -f "$f" ]] && { echo "$f"; return; }
    done
    echo ""
}
WYRD_CONFIG_CATALOG="$(_resolve_wyrd_config_catalog)"

# _t KEY [arg1 arg2 ...]
# Returns the translated string for KEY in the current locale, with {0}, {1},
# ... substitutions filled from the positional args. On any error (catalog
# missing, key missing, malformed), falls back to the key itself so the user
# sees something, not silence.
_t() {
    local key="$1"; shift || true
    if [[ -z "$WYRD_I18N_DIR" ]]; then
        echo "$key"
        return
    fi
    WYRD_T_KEY="$key" WYRD_T_LOCALE="$WYRD_LOCALE" WYRD_T_DIR="$WYRD_I18N_DIR" \
        python3 - "$@" <<'PY' 2>/dev/null || echo "$key"
import json, os, sys
key = os.environ.get('WYRD_T_KEY', '')
loc = os.environ.get('WYRD_T_LOCALE', 'en')
d   = os.environ.get('WYRD_T_DIR', '')
val = None
for L in (loc, 'en'):
    p = f'{d}/wyrd_{L}.json'
    if not os.path.exists(p):
        continue
    try:
        cat = json.load(open(p))
    except Exception:
        continue
    if key in cat:
        val = cat[key]
        break
if val is None:
    val = key
for i, arg in enumerate(sys.argv[1:]):
    val = val.replace('{' + str(i) + '}', arg)
# Expand ${COLOR} tokens that i18n strings carry into real ANSI escapes, so
# they render whether the caller uses `echo` or `echo -e` (a bare `echo -e`
# on the raw token left "${GREEN}Registered!${NC}" printing literally).
for tok, esc in (('${GREEN}', '\033[0;32m'), ('${YELLOW}', '\033[1;33m'),
                 ('${RED}', '\033[0;31m'), ('${CYAN}', '\033[0;36m'),
                 ('${NC}', '\033[0m')):
    val = val.replace(tok, esc)
print(val, end='')
PY
}
info() { echo -e "${CYAN}[wyrd]${NC} $*"; }

# Robust large-file download for model pulls. Multi-GB GGUFs from HuggingFace's CDN
# intermittently fail near the end with "HTTP/2 stream was not closed cleanly: CANCEL"
# (curl error 92). Three guards: --http1.1 sidesteps the HTTP/2 stream bug entirely;
# -C - RESUMES the .part on a retry instead of restarting from 0%; --retry rides out
# transient drops. Caller passes the destination path (usually a .part temp).
_download() {  # _download <url> <dest>
    curl -fL --http1.1 --progress-bar \
        --retry 8 --retry-delay 3 --retry-all-errors \
        -C - -o "$2" "$1"
}

# ── Model identity / manifest (P0 data-durability, 2026-07-09) ──
# models-index.json = the RELEASE index (ships with the code: what model material this
# release blesses, with pinned HF revisions + sha256). models-manifest.jsonl = the NODE
# record (what this node actually has, when it got it, hash). model-history.jsonl = the
# audit trail of swaps ("did the model change last Tuesday?").
_models_index() {
    local f
    for f in "$PROJECT_ROOT/models-index.json" /opt/wyrdsekai/models-index.json \
             /usr/local/wyrdsekai/models-index.json; do
        [ -f "$f" ] && { echo "$f"; return 0; }
    done
    return 1
}

# _index_urls <model-id> — download mirrors, in preference order, one per line.
#
# HuggingFace first. It is a global CDN, it costs us nothing, and it keeps one
# popular week from saturating the uplink of the box that also serves the
# website. wyrdsekai.org stays as the fallback so an HF outage — or another CDN
# policy change like the one on 2026-07-13 that started answering 403 to curl —
# never leaves an install unable to fetch its models.
#
# The HF URL is built from the PINNED hf_revision rather than a branch, so both
# mirrors serve identical bytes by construction. That, plus the sha256 check in
# _model_fetch, is what makes trying two sources safe rather than a way to end
# up with something subtly different depending on who answered.
_index_urls() {  # _index_urls <model-id>
    local idx; idx=$(_models_index) || return 1
    python3 - "$idx" "$1" <<'PY_URLS'
import json, sys
idx, mid = sys.argv[1], sys.argv[2]
for m in json.load(open(idx)).get("models", []):
    if m.get("id") != mid:
        continue
    repo, rev, pf = m.get("hf_repo"), m.get("hf_revision"), m.get("published_file")
    urls = []
    if repo and rev and pf:
        urls.append(f"https://huggingface.co/{repo}/resolve/{rev}/{pf}")
    if m.get("url"):
        urls.append(m["url"])
    # The entry's own mirror (wyrdsekai.org) last. The field had been in the index since the
    # 9B/4B shipped and was read by nothing: those two fetches passed the address as a literal,
    # and every later entry's mirror was a promise the fetch never tried.
    if m.get("mirror_url"):
        urls.append(m["mirror_url"])
    # Some entries list the pinned HF link as their `url` too. Retrying a URL
    # that just failed is not a fallback; it only makes the log read as though
    # a second source was tried.
    seen = set()
    for u in urls:
        if u not in seen:
            seen.add(u)
            print(u)
    break
PY_URLS
}

# _model_fetch <model-id> <dest> [extra-fallback-url]
#
# Walks the mirrors until one delivers the file whole. Verifies sha256 from the
# index when there is one: with more than one origin the hash stops being a
# nicety, because "the download succeeded" no longer means "from the source we
# expected". A hash mismatch discards the file and tries the next mirror rather
# than failing outright — that is the case where a mirror is stale or wrong,
# which is exactly what a second mirror is for.
_model_fetch() {
    local mid="$1" dest="$2" extra="${3:-}"
    local urls; urls=$(_index_urls "$mid" 2>/dev/null)
    [ -n "$extra" ] && urls="$urls
$extra"
    local want; want=$(_index_field "$mid" sha256 2>/dev/null)
    # The mirror that actually answered, for the caller to record. Without this
    # the manifest logged whichever URL was in the index rather than where the
    # bytes came from, which makes the provenance trail quietly wrong the moment
    # a fallback is used — the one case you would most want it to be right.
    WYRD_FETCH_URL=""
    local url
    while IFS= read -r url; do
        [ -z "$url" ] && continue
        log "fetching from ${url#https://}"
        if _download "$url" "$dest"; then
            if [ -n "$want" ]; then
                local got; got=$(sha256sum "$dest" 2>/dev/null | cut -d' ' -f1)
                if [ "$got" != "$want" ]; then
                    warn "checksum mismatch from ${url#https://}, discarding and trying next mirror"
                    rm -f "$dest"
                    continue
                fi
            fi
            WYRD_FETCH_URL="$url"
            return 0
        fi
        rm -f "$dest"
        warn "mirror unavailable: ${url#https://}"
    done <<EOF
$urls
EOF
    return 1
}

_index_field() {  # _index_field <model-id> <field>
    local idx; idx=$(_models_index) || return 1
    python3 - "$idx" "$1" "$2" <<'PY'
import json, sys
idx, mid, field = sys.argv[1], sys.argv[2], sys.argv[3]
for m in json.load(open(idx)).get("models", []):
    if m.get("id") == mid:
        v = m.get(field)
        print(v if v is not None else "")
        break
PY
}

# _model_local_path <model-id> — where this entry's file lives on the node. Adapters live
# beside the brain (adapters/brain/<local_file>), everything else under models/. The model
# verbs used models/ for every entry, so `wyrd model update species-floor-35b-a3b` wrote the
# species floor where nothing would load it and `status` called the installed adapters absent.
_model_local_path() {
    local lf kind; lf=$(_index_field "$1" local_file 2>/dev/null); kind=$(_index_field "$1" kind 2>/dev/null)
    [ -z "$lf" ] && return 1
    case "$kind" in
        adapter) echo "$DATA_DIR/adapters/brain/$lf" ;;
        *) echo "$MODELS_DIR/$lf" ;;
    esac
}

# _relink_work_adapter <new-honesty-file> <old-honesty-file> — brain/work.gguf is the honesty
# adapter linked in under the working-turn name. When the honesty file is replaced and work.gguf
# was that same file, follow it; a work.gguf someone put there themselves is left alone.
_relink_work_adapter() {
    local new="$1" old="$2" work="$DATA_DIR/adapters/brain/work.gguf"
    [ -f "$work" ] && [ -f "$old" ] || return 0
    [ "$work" -ef "$old" ] || return 0
    rm -f "$work"
    ln "$new" "$work" 2>/dev/null || cp "$new" "$work"
    log "$(_t brain.setup.linked_work)"
}

_model_record() {  # _model_record <local_file> <id> <version> <url>
    local f="$1" id="$2" ver="$3" url="$4"
    [ -f "$f" ] || return 0
    mkdir -p "$MODELS_DIR"
    local sha; sha=$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1)
    printf '{"v":1,"file":"%s","id":"%s","version":"%s","sha256":"%s","source_url":"%s","recorded_at":"%s"}\n' \
        "$(basename "$f")" "$id" "$ver" "$sha" "$url" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        >> "$MODELS_DIR/models-manifest.jsonl"
}

_model_history() {  # _model_history <id> <action> <detail>
    printf '{"v":1,"id":"%s","action":"%s","detail":"%s","at":"%s"}\n' \
        "$1" "$2" "$3" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$DATA_DIR/model-history.jsonl"
}

_manifest_version() {  # latest recorded version for <local_file basename>
    local mf="$MODELS_DIR/models-manifest.jsonl"
    [ -f "$mf" ] || { echo ""; return; }
    python3 - "$mf" "$1" <<'PY'
import json, sys
mf, name = sys.argv[1], sys.argv[2]
ver = ""
for line in open(mf):
    try:
        e = json.loads(line)
        if e.get("file") == name: ver = e.get("version", "")
    except Exception:
        pass
print(ver)
PY
}

# ── Embedding-bundle resolver ──
# Search order (matches the install-prefix layout used by .deb / .pkg /
# source mode):
#   1. /opt/wyrdsekai/share/embedding-models       (.deb)
#   2. /usr/local/wyrdsekai/share/embedding-models (.pkg)
#   3. $PROJECT_ROOT/packaging/embedding-models    (source mode)
#
# `WYRDSEKAI_EMBEDDING_BUNDLE_DIRS` overrides the search list (colon-
# separated paths) — used by tests to point at temp fixtures without
# coupling them to the real install layout.
#
# Echoes the first directory containing BOTH given files, or empty string.
# Pure stdout/empty contract: callers branch on `[[ -n "$result" ]]`.
_resolve_embedding_bundle() {
    local onnx_name="$1"
    local tok_name="$2"
    [[ -z "$onnx_name" || -z "$tok_name" ]] && return 0

    local dirs_spec="${WYRDSEKAI_EMBEDDING_BUNDLE_DIRS:-}"
    local -a dirs=()
    if [[ -n "$dirs_spec" ]]; then
        # Colon-separated override → array. Empty entries skipped.
        local IFS=':'
        for d in $dirs_spec; do
            [[ -n "$d" ]] && dirs+=("$d")
        done
    else
        dirs=(
            "/opt/wyrdsekai/share/embedding-models"
            "/usr/local/wyrdsekai/share/embedding-models"
            "${PROJECT_ROOT:-}/packaging/embedding-models"
        )
    fi

    for d in "${dirs[@]}"; do
        [[ -z "$d" ]] && continue
        if [[ -f "$d/$onnx_name" && -f "$d/$tok_name" ]]; then
            echo "$d"
            return 0
        fi
    done
    return 0
}

# ── Java finder ──
find_java() {
    if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
        JAVA_CMD="$JAVA_HOME/bin/java"; return 0
    fi
    if command -v java &>/dev/null; then
        local ver
        ver=$(java -version 2>&1 | head -1 | sed 's/.*version "\([0-9]*\).*/\1/' || echo "0")
        if [[ "$ver" -ge 25 ]] 2>/dev/null; then
            JAVA_CMD="java"; return 0
        fi
    fi
    # Standard locations
    for d in /usr/lib/jvm/java-25-openjdk*/bin/java \
             /usr/lib/jvm/temurin-25*/bin/java \
             /Library/Java/JavaVirtualMachines/temurin-*/Contents/Home/bin/java \
             /opt/homebrew/opt/openjdk/bin/java; do
        if [[ -x "$d" ]]; then JAVA_CMD="$d"; return 0; fi
    done
    return 1
}

# ── Inference backend management ──

find_llama_server() {
    if command -v llama-server &>/dev/null; then echo "llama-server"; return 0; fi
    if [[ -x /opt/homebrew/bin/llama-server ]]; then echo "/opt/homebrew/bin/llama-server"; return 0; fi
    if [[ -x /usr/local/bin/llama-server ]]; then echo "/usr/local/bin/llama-server"; return 0; fi
    return 1
}

# ── MLX runtime resolvers ─────────────────
# macOS-only. Each returns 0 + emits the resolved path on stdout, or 1 if
# missing. Probe order is the layered install layout: per-user data dir
# first, then /usr/local/wyrdsekai (.pkg payload), then the legacy
# Phase-0/1 verify paths under $HOME/.wyrdsekai/.

find_mlx_venv_python() {
    for p in \
        "$DATA_DIR/mlx-venv/bin/python" \
        "$DATA_DIR/mlx-venv/bin/python3" \
        "/usr/local/wyrdsekai/mlx-venv/bin/python" \
        "/usr/local/wyrdsekai/mlx-venv/bin/python3" \
        "$HOME/.wyrdsekai/mlx-venv/bin/python" \
        "$HOME/.wyrdsekai/mlx-venv/bin/python3"; do
        [[ -x "$p" ]] && { echo "$p"; return 0; }
    done
    return 1
}

find_mlx_runtime_script() {
    for p in \
        "/usr/local/wyrdsekai/scripts/voice/mlx_runtime.py" \
        "$PROJECT_ROOT/scripts/voice/mlx_runtime.py" \
        "$HOME/wyrd-phase1/scripts/voice/mlx_runtime.py"; do
        [[ -f "$p" ]] && { echo "$p"; return 0; }
    done
    return 1
}

find_mlx_base_dir() {
    # Voice-side MLX base (4B). HuggingFace-format directory (config.json +
    # model.safetensors[.*]) — not a single GGUF. Order:
    #  1. WYRDSEKAI_MLX_BASE_DIR override
    #  2. $DATA_DIR/models/mlx/<canonical-name>
    #  3. /usr/local/wyrdsekai/data/models/mlx/<canonical-name>
    #  4. Phase-0/1 verify path under $HOME/.wyrdsekai/
    if [[ -n "${WYRDSEKAI_MLX_BASE_DIR:-}" && -d "${WYRDSEKAI_MLX_BASE_DIR}" ]]; then
        echo "${WYRDSEKAI_MLX_BASE_DIR}"; return 0
    fi
    for d in \
        "$DATA_DIR/models/mlx/qwen3-5-4b-v10-mlx-4bit" \
        "$DATA_DIR/models/mlx/training-mlx-q4-correct" \
        "/usr/local/wyrdsekai/data/models/mlx/qwen3-5-4b-v10-mlx-4bit" \
        "$HOME/.wyrdsekai/training-mlx-q4-correct"; do
        [[ -f "$d/config.json" ]] && { echo "$d"; return 0; }
    done
    return 1
}

find_mlx_drive_base_dir() {
    # Drive-side MLX base (9B V5 Qwen3.5+DeltaNet). MLX-4bit HF-format dir.
    # Same probe order as voice. Drive uses mlx_lm.server directly (no
    # monkey-patch, no V8 vectors — those are voice-only).
    if [[ -n "${WYRDSEKAI_MLX_DRIVE_BASE_DIR:-}" && -d "${WYRDSEKAI_MLX_DRIVE_BASE_DIR}" ]]; then
        echo "${WYRDSEKAI_MLX_DRIVE_BASE_DIR}"; return 0
    fi
    for d in \
        "$DATA_DIR/models/mlx/qwen3-5-9b-v5-mlx-4bit" \
        "$DATA_DIR/models/mlx/wyrdsekai-9b-v5-mlx-4bit" \
        "/usr/local/wyrdsekai/data/models/mlx/qwen3-5-9b-v5-mlx-4bit" \
        "$HOME/.wyrdsekai/wyrdsekai-9b-v5-mlx-4bit"; do
        [[ -f "$d/config.json" ]] && { echo "$d"; return 0; }
    done
    return 1
}

find_mlx_adapter_dir() {
    # mlx_lm.server --adapter-path expects a directory containing
    # adapters.safetensors + adapter_config.json. Order:
    #  1. WYRDSEKAI_MLX_ADAPTER_DIR override
    #  2. $DATA_DIR/adapters/wyrd-voice-mlx
    #  3. Phase-0/1 path under $HOME/.wyrdsekai/mlx-run-1/adapters
    if [[ -n "${WYRDSEKAI_MLX_ADAPTER_DIR:-}" && -f "${WYRDSEKAI_MLX_ADAPTER_DIR}/adapters.safetensors" ]]; then
        echo "${WYRDSEKAI_MLX_ADAPTER_DIR}"; return 0
    fi
    for d in \
        "$DATA_DIR/adapters/wyrd-voice-mlx" \
        "/usr/local/wyrdsekai/data/adapters/wyrd-voice-mlx" \
        "$HOME/.wyrdsekai/mlx-run-1/adapters"; do
        [[ -f "$d/adapters.safetensors" ]] && { echo "$d"; return 0; }
    done
    return 1
}

find_mlx_vectors_dir() {
    # Directory containing per-vector .safetensors files (Phase 1A output).
    if [[ -n "${WYRDSEKAI_MLX_VECTORS_DIR:-}" && -d "${WYRDSEKAI_MLX_VECTORS_DIR}" ]]; then
        echo "${WYRDSEKAI_MLX_VECTORS_DIR}"; return 0
    fi
    for d in \
        "$DATA_DIR/training/v8/mlx" \
        "$DATA_DIR/vectors/v8-mlx" \
        "/usr/local/wyrdsekai/data/training/v8/mlx" \
        "$HOME/wyrd-phase1/data/training/v8/mlx"; do
        [[ -d "$d" ]] && ls "$d"/*.safetensors >/dev/null 2>&1 && { echo "$d"; return 0; }
    done
    return 1
}

is_inference_running() {
    # llama-server exposes /health; mlx_lm.server doesn't — but both serve
    # /v1/models. Probe /health first, then /v1/models, on each candidate URL.
    for url in "${WYRDSEKAI_INFERENCE_URL:-}" "http://localhost:11525" "http://localhost:8200"; do
        if [[ -n "$url" ]]; then
            curl -sf "$url/health" &>/dev/null && return 0
            curl -sf "$url/v1/models" &>/dev/null && return 0
        fi
    done
    return 1
}

is_voice_inference_running() {
    # llama-server exposes /health; mlx_lm.server doesn't, but both serve
    # /v1/models. Try /health first (fast), then /v1/models (fallback for MLX).
    curl -sf "http://localhost:8201/health" &>/dev/null && return 0
    curl -sf "http://localhost:8201/v1/models" &>/dev/null
}

is_mlx_voice_running() {
    # Tighter check: PID file exists, process is alive, and :8201 responds.
    [[ -f "$DATA_DIR/.mlx-voice.pid" ]] || return 1
    local pid; pid=$(<"$DATA_DIR/.mlx-voice.pid")
    kill -0 "$pid" 2>/dev/null || return 1
    curl -sf "http://localhost:8201/v1/models" &>/dev/null
}

# Spawn mlx_lm.server (via scripts/voice/mlx_runtime.py) on :8201 with V8
# vectors. Darwin-only. Returns 0 if started (or already running), 1 if
# any required piece is missing — callers should treat 1 as "fall back
# to llama-server". PID at $DATA_DIR/.mlx-voice.pid.
start_mlx_voice() {
    [[ "$(uname -s)" == "Darwin" ]] || return 1
    [[ "${WYRDSEKAI_MLX_VOICE_ENABLED:-1}" != "0" ]] || return 1
    if is_mlx_voice_running; then
        log "mlx voice :8201 already running (pid=$(cat "$DATA_DIR/.mlx-voice.pid" 2>/dev/null))"
        return 0
    fi
    local py runtime base adapter vec_dir
    py=$(find_mlx_venv_python) || return 1
    runtime=$(find_mlx_runtime_script) || return 1
    base=$(find_mlx_base_dir) || return 1
    # The LoRA adapter is OPTIONAL. A fresh install has only the 4B base +
    # V8 steering vectors — a perfectly good voice on day one. The per-bondholder
    # adapter is trained later (run-substrate-sft) and rotated in. Without an
    # adapter we start base + vectors; we do NOT skip :8201 (that left the
    # companion mute on every fresh install).
    local adapter_arg=()
    if adapter=$(find_mlx_adapter_dir); then
        adapter_arg=(--adapter-path "$adapter")
    else
        adapter=""
        log "mlx voice: no trained adapter yet — starting base 4B + V8 vectors (adapter trains later via run-substrate-sft)"
    fi

    # Vectors are optional. Skip the --vectors flag if no MLX vectors are
    # present on disk; mlx_runtime.py then runs the vanilla mlx_lm.server.
    local v8_default="anti_defiance:0.15,es_register_hold:0.20,refusal_stability:0.20,first_person_presence:0.15"
    local vectors_arg=()
    if vec_dir=$(find_mlx_vectors_dir); then
        vectors_arg=(--vectors-dir "$vec_dir" --vectors "${WYRDSEKAI_MLX_V8_VECTORS:-$v8_default}")
    fi

    local port="${LLAMA_VOICE_PORT:-8201}"
    local host="${WYRDSEKAI_MLX_VOICE_HOST:-127.0.0.1}"
    log "starting mlx voice (base=$(basename "$base")${adapter:+ adapter=$(basename "$adapter")} :$port${vec_dir:+ +V8 vectors})"
    nohup "$py" "$runtime" \
        "${vectors_arg[@]+"${vectors_arg[@]}"}" \
        -- \
        --model "$base" \
        "${adapter_arg[@]+"${adapter_arg[@]}"}" \
        --host "$host" --port "$port" \
        --chat-template-args '{"enable_thinking": false}' \
        > "$DATA_DIR/.mlx-voice.log" 2>&1 &
    echo "$!" > "$DATA_DIR/.mlx-voice.pid"

    # When invoked from .pkg postinstall (or any sudo path), the PID + log
    # files end up root-owned and the next user-context `wyrd voice` call
    # fails to overwrite them. Re-chown to the data-dir owner so user-side
    # commands keep working without sudo. Silent if chown isn't available
    # (no-op on stat failure → owner is empty → chown is a no-op).
    if [[ "${EUID:-0}" -eq 0 ]]; then
        local _owner
        _owner=$(stat -f '%Su' "$DATA_DIR" 2>/dev/null \
              || stat -c '%U' "$DATA_DIR" 2>/dev/null \
              || echo "")
        if [[ -n "$_owner" && "$_owner" != "root" ]]; then
            chown "$_owner" "$DATA_DIR/.mlx-voice.pid" "$DATA_DIR/.mlx-voice.log" 2>/dev/null || true
        fi
    fi

    # Settle: wait up to 30s for the server to bind. mlx_lm.server takes a
    # few seconds to load the base + apply the LoRA adapter on Apple Silicon.
    local i
    for i in $(seq 1 30); do
        if curl -sf "http://${host}:${port}/v1/models" &>/dev/null; then
            log "mlx voice ready on :$port (pid=$(cat "$DATA_DIR/.mlx-voice.pid"))"
            return 0
        fi
        sleep 1
    done
    warn "mlx voice spawned (pid=$(cat "$DATA_DIR/.mlx-voice.pid")) but :$port not responding after 30s — see $DATA_DIR/.mlx-voice.log"
    return 0  # still report success so we don't double-spawn into llama-server
}

stop_mlx_voice() {
    if [[ -f "$DATA_DIR/.mlx-voice.pid" ]]; then
        local pid; pid=$(<"$DATA_DIR/.mlx-voice.pid")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            # mlx_lm.server spawns a worker child; give the tree a moment.
            sleep 1
            kill -9 "$pid" 2>/dev/null || true
            log "stopped mlx voice (pid=$pid)"
        fi
        rm -f "$DATA_DIR/.mlx-voice.pid"
    fi
    # Belt-and-suspenders against orphaned mlx_lm.server processes on :8201.
    pkill -f "mlx_runtime.py.*--port 8201" 2>/dev/null || true
    pkill -f "mlx_lm.server.*--port 8201" 2>/dev/null || true
}

# ── Oracle forecasting sidecar (oracle-core) ──────────────────────────────
# The Oracle prediction engine is a separate OSS package (oracle-core); the
# Java zone auto-connects to it over HTTP on $ORACLE_PORT (default 7073) when
# reachable. On docker-compose deploys it runs as a container; on native
# installs we bundle its wheel and run it as a managed local service so the
# Oracle is available everywhere — not just under Docker.
ORACLE_PORT="${ORACLE_PORT:-7073}"

# Echo the path to the bundled oracle-core wheel across install layouts, or
# empty. Mirrors _resolve_embedding_bundle. Override search via
# WYRDSEKAI_ORACLE_WHEEL_DIRS (colon-separated).
_resolve_oracle_wheel() {
    local dirs_spec="${WYRDSEKAI_ORACLE_WHEEL_DIRS:-}"
    local -a dirs=()
    if [[ -n "$dirs_spec" ]]; then
        local IFS=':'; for d in $dirs_spec; do [[ -n "$d" ]] && dirs+=("$d"); done
    else
        dirs=(
            "/opt/wyrdsekai/share/oracle"
            "/usr/local/wyrdsekai/share/oracle"
            "${PROJECT_ROOT:-}/packaging/oracle"
        )
    fi
    for d in "${dirs[@]}"; do
        [[ -z "$d" ]] && continue
        local w
        w=$(ls "$d"/oracle_core-*.whl 2>/dev/null | sort | tail -1)
        [[ -n "$w" && -f "$w" ]] && { echo "$w"; return 0; }
    done
    return 0
}

# Create $DATA_DIR/.venv-oracle and pip-install the bundled wheel. Base deps
# (flask/scikit-learn/pandas/numpy/scipy) are light + pure-python-friendly;
# heavy forecasting extras (torch/chronos) stay opt-in. Idempotent via marker.
# Skipped by WYRDSEKAI_SKIP_VENV=1 or WYRDSEKAI_SKIP_ORACLE=1 (CI / air-gap).
bootstrap_oracle() {
    [[ "${WYRDSEKAI_SKIP_VENV:-0}" == "1" ]] && return 0
    [[ "${WYRDSEKAI_SKIP_ORACLE:-0}" == "1" ]] && return 0
    command -v python3 >/dev/null 2>&1 || { warn "oracle: python3 not found — skipping"; return 0; }

    local wheel; wheel=$(_resolve_oracle_wheel)
    if [[ -z "$wheel" ]]; then
        warn "oracle: bundled wheel not found (searched share/oracle + packaging/oracle) — Oracle stays docker-only"
        return 0
    fi
    local venv="$DATA_DIR/.venv-oracle"
    local marker="$venv/.wyrd-oracle-installed"
    if [[ -f "$marker" ]]; then
        log "oracle: venv already present"
        return 0
    fi
    echo ""
    log "oracle: creating prediction-engine venv + installing $(basename "$wheel")"
    if python3 -m venv "$venv" 2>&1; then
        "$venv/bin/pip" install --quiet --upgrade pip 2>&1 || true
        if "$venv/bin/pip" install --quiet "$wheel" 2>&1; then
            date -u +%Y-%m-%dT%H:%M:%SZ > "$marker"
            # chown to the data-dir owner when bootstrapping under sudo (.deb/.pkg)
            if [[ $EUID -eq 0 ]]; then
                local owner; owner=$(stat -c %U "$DATA_DIR" 2>/dev/null || stat -f %Su "$DATA_DIR" 2>/dev/null)
                [[ -n "$owner" && "$owner" != "root" ]] && chown -R "$owner" "$venv" 2>/dev/null || true
            fi
            log "oracle: prediction engine installed"
        else
            warn "oracle: wheel install failed — Oracle stays docker-only"
        fi
    else
        warn "oracle: venv creation failed — Oracle stays docker-only"
    fi
}

oracle_running() {
    curl -sf "http://localhost:${ORACLE_PORT}/health" 2>/dev/null | grep -q '"status"'
}

# True when a systemd unit for the sidecar exists and we are root, i.e. this
# is a .deb/.pkg install whose Oracle is supervised rather than nohup'd.
_oracle_has_systemd() {
    [[ $EUID -eq 0 ]] || return 1
    command -v systemctl >/dev/null 2>&1 || return 1
    systemctl cat wyrdsekai-oracle >/dev/null 2>&1
}

start_oracle() {
    [[ "${WYRDSEKAI_SKIP_ORACLE:-0}" == "1" ]] && return 0
    if oracle_running; then
        # systemd installs keep no pidfile of ours, so the stale-orphan test
        # below cannot see them. Ask the supervisor first — otherwise a healthy
        # supervised sidecar looks exactly like an orphan and gets replaced by
        # an unsupervised one (Restart=on-failure won't undo a clean SIGTERM).
        if _oracle_has_systemd && systemctl is-active --quiet wyrdsekai-oracle 2>/dev/null; then
            log "oracle already running on :${ORACLE_PORT} (systemd)"
            return 0
        fi
        # A wiped/reset data dir orphans a previously spawned sidecar: its
        # /health still answers but every write 500s into the deleted
        # --data-dir. Our pidfile and the oracle data dir vanish with the
        # wipe, so their absence means the responding process belongs to a
        # previous install — replace it instead of trusting /health.
        if [[ -f "$DATA_DIR/.oracle.pid" && -d "$DATA_DIR/oracle" ]]; then
            log "oracle already running on :${ORACLE_PORT}"
            return 0
        fi
        warn "oracle on :${ORACLE_PORT} belongs to a previous install (stale data-dir) — restarting"
        pkill -f "oracle-server.*--port ${ORACLE_PORT}" 2>/dev/null || true
        sleep 1
    fi
    local venv="$DATA_DIR/.venv-oracle"
    local bin="$venv/bin/oracle-server"
    if [[ ! -x "$bin" ]]; then
        warn "oracle: not bootstrapped (no $bin) — run 'wyrd setup' or 'wyrd oracle bootstrap'"
        return 1
    fi
    # Hand back to systemd where it exists, so the sidecar comes up supervised
    # and survives a reboot the same way it does after a fresh install.
    if _oracle_has_systemd; then
        mkdir -p "$DATA_DIR/oracle"
        if systemctl start wyrdsekai-oracle 2>/dev/null; then
            local j
            for j in $(seq 1 20); do
                sleep 0.5
                oracle_running && { log "oracle ready on :${ORACLE_PORT} (systemd)"; return 0; }
            done
            warn "oracle: systemd start issued but :${ORACLE_PORT} not responding after 10s"
            return 0
        fi
        warn "oracle: systemctl start failed — falling back to an unsupervised process"
    fi
    mkdir -p "$DATA_DIR/oracle"
    nohup "$bin" --port "$ORACLE_PORT" --host 127.0.0.1 \
        --data-dir "$DATA_DIR/oracle" \
        >"$DATA_DIR/.oracle.log" 2>&1 &
    echo "$!" > "$DATA_DIR/.oracle.pid"
    if [[ $EUID -eq 0 ]]; then
        local owner; owner=$(stat -c %U "$DATA_DIR" 2>/dev/null || stat -f %Su "$DATA_DIR" 2>/dev/null)
        [[ -n "$owner" && "$owner" != "root" ]] && chown "$owner" "$DATA_DIR/.oracle.pid" "$DATA_DIR/.oracle.log" 2>/dev/null || true
    fi
    local i
    for i in $(seq 1 20); do
        sleep 0.5
        if oracle_running; then
            log "oracle ready on :${ORACLE_PORT} (pid=$(cat "$DATA_DIR/.oracle.pid"))"
            return 0
        fi
    done
    warn "oracle spawned (pid=$(cat "$DATA_DIR/.oracle.pid")) but :${ORACLE_PORT} not responding after 10s — see $DATA_DIR/.oracle.log"
    return 0
}

stop_oracle() {
    # Stop through the supervisor when it owns the process, so the unit lands
    # in a clean inactive state instead of looking like it died on its own.
    if _oracle_has_systemd && systemctl is-active --quiet wyrdsekai-oracle 2>/dev/null; then
        systemctl stop wyrdsekai-oracle 2>/dev/null && log "stopped oracle (systemd)"
        rm -f "$DATA_DIR/.oracle.pid"
        return 0
    fi
    if [[ -f "$DATA_DIR/.oracle.pid" ]]; then
        local pid; pid=$(<"$DATA_DIR/.oracle.pid")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null; sleep 1; kill -9 "$pid" 2>/dev/null || true
            log "stopped oracle (pid=$pid)"
        fi
        rm -f "$DATA_DIR/.oracle.pid"
    fi
    pkill -f "oracle-server.*--port ${ORACLE_PORT}" 2>/dev/null || true
}

do_oracle() {
    local action="${1:-status}"
    case "$action" in
        bootstrap) bootstrap_oracle ;;
        start)     start_oracle ;;
        stop)      stop_oracle ;;
        restart)   stop_oracle; start_oracle ;;
        status)
            if oracle_running; then
                echo "oracle: running on :${ORACLE_PORT}"
                curl -sf "http://localhost:${ORACLE_PORT}/health" 2>/dev/null; echo
            else
                echo "oracle: not running on :${ORACLE_PORT}"
                [[ -x "$DATA_DIR/.venv-oracle/bin/oracle-server" ]] \
                    && echo "  (bootstrapped — 'wyrd oracle start' to launch)" \
                    || echo "  (not bootstrapped — 'wyrd setup' or 'wyrd oracle bootstrap')"
            fi ;;
        *) echo "usage: wyrd oracle {bootstrap|start|stop|restart|status}" ;;
    esac
}

is_mlx_drive_running() {
    # Mirror of is_mlx_voice_running, on :8200.
    [[ -f "$DATA_DIR/.mlx-drive.pid" ]] || return 1
    local pid; pid=$(<"$DATA_DIR/.mlx-drive.pid")
    kill -0 "$pid" 2>/dev/null || return 1
    curl -sf "http://localhost:8200/v1/models" &>/dev/null
}

# Spawn vanilla mlx_lm.server on :8200 with the 9B MLX-4bit base. Darwin-only.
# Returns 0 if started (or already running), 1 if any required piece is missing
# — callers should treat 1 as "fall back to llama-server". PID at
# $DATA_DIR/.mlx-drive.pid. Drive does NOT use mlx_runtime.py: V8 vectors are
# voice-only, and skipping the monkey-patch keeps the 9B server stock.
start_mlx_drive() {
    [[ "$(uname -s)" == "Darwin" ]] || return 1
    [[ "${WYRDSEKAI_MLX_DRIVE_ENABLED:-1}" != "0" ]] || return 1
    if is_mlx_drive_running; then
        log "mlx drive :8200 already running (pid=$(cat "$DATA_DIR/.mlx-drive.pid" 2>/dev/null))"
        return 0
    fi
    local py base
    py=$(find_mlx_venv_python) || return 1
    base=$(find_mlx_drive_base_dir) || return 1

    local port="${LLAMA_DRIVE_PORT:-8200}"
    local host="${WYRDSEKAI_MLX_DRIVE_HOST:-127.0.0.1}"
    log "starting mlx drive (base=$(basename "$base") :$port)"
    nohup "$py" -m mlx_lm.server \
        --model "$base" \
        --host "$host" --port "$port" \
        --chat-template-args '{"enable_thinking": false}' \
        > "$DATA_DIR/.mlx-drive.log" 2>&1 &
    echo "$!" > "$DATA_DIR/.mlx-drive.pid"

    # Settle: wait up to 45s. 9B MLX-4bit loads slower than 4B — ~10-15s on
    # mac-node M-class.
    local i
    for i in $(seq 1 45); do
        if curl -sf "http://${host}:${port}/v1/models" &>/dev/null; then
            log "mlx drive ready on :$port (pid=$(cat "$DATA_DIR/.mlx-drive.pid"))"
            return 0
        fi
        sleep 1
    done
    warn "mlx drive spawned (pid=$(cat "$DATA_DIR/.mlx-drive.pid")) but :$port not responding after 45s — see $DATA_DIR/.mlx-drive.log"
    return 0
}

stop_mlx_drive() {
    if [[ -f "$DATA_DIR/.mlx-drive.pid" ]]; then
        local pid; pid=$(<"$DATA_DIR/.mlx-drive.pid")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            sleep 1
            kill -9 "$pid" 2>/dev/null || true
            log "stopped mlx drive (pid=$pid)"
        fi
        rm -f "$DATA_DIR/.mlx-drive.pid"
    fi
    pkill -f "mlx_lm.server.*--port 8200" 2>/dev/null || true
}

# Resolve the GGUF path the drive (:8200) server should load. Order:
#   1. $WYRDSEKAI_LLAMA_DRIVE_MODEL (steward override)
#   2. tier_drive_model based on VRAM/RAM detection (when present)
#   3. first existing GGUF in MODELS_DIR matching the canonical drive names
#   4. the legacy 4B fallback (matches pre-dual-inference shape)
resolve_drive_model() {
    if [[ -n "${WYRDSEKAI_LLAMA_DRIVE_MODEL:-}" && -f "$MODELS_DIR/${WYRDSEKAI_LLAMA_DRIVE_MODEL}" ]]; then
        echo "$MODELS_DIR/${WYRDSEKAI_LLAMA_DRIVE_MODEL}"; return 0
    fi
    for name in \
        wyrdsekai-3.5-9b-v5-q4km.gguf \
        wyrdsekai-3.5-9b-drive-v6-q4km.gguf \
        wyrdsekai-3.5-9b-vitality-v6.gguf \
        wyrdsekai-3.5-4b-v10-q4km.gguf \
        wyrdsekai-3.5-4b-v10-q4km.gguf; do
        if [[ -f "$MODELS_DIR/$name" ]]; then echo "$MODELS_DIR/$name"; return 0; fi
    done
    echo "$MODELS_DIR/wyrdsekai-3.5-4b-v10-q4km.gguf"
}

# Resolve the GGUF path the voice (:8201) server should load. The voice
# role expects the smaller 4B model; on tier-3 hosts where only the 4B
# exists, this returns the same path as the drive (a single GGUF served
# by two llama-server instances — both endpoints exist, distinct prompt
# contexts, ~5GB total at Q4_K_M).
resolve_voice_model() {
    if [[ -n "${WYRDSEKAI_LLAMA_VOICE_MODEL:-}" && -f "$MODELS_DIR/${WYRDSEKAI_LLAMA_VOICE_MODEL}" ]]; then
        echo "$MODELS_DIR/${WYRDSEKAI_LLAMA_VOICE_MODEL}"; return 0
    fi
    for name in \
        wyrdsekai-3.5-4b-v10-q4km.gguf \
        wyrdsekai-3.5-4b-v10-q4km.gguf \
        Qwen3.5-4B-Q4_K_M.gguf; do
        if [[ -f "$MODELS_DIR/$name" ]]; then echo "$MODELS_DIR/$name"; return 0; fi
    done
    echo "$MODELS_DIR/wyrdsekai-3.5-4b-v10-q4km.gguf"
}

# `docker compose up -d <svc>` is idempotent: a running container whose compose
# definition is unchanged is left alone; one whose definition changed (a package
# upgrade rewrote docker-compose.yml) is recreated with the new flags. Without
# this, an upgraded node kept serving on the PREVIOUS package's llama-server
# flags until a reboot — one node ran a week of 8 GiB prompt caches (the
# llama-server default; OOM-killed four times a day) after the cap shipped.
# Env for the service (model names, data dir, adapter) must already be set by
# the caller exactly as at creation, or the recreate is a needless one.
# Each brain gets a memory cap: the model file (mmapped, so the kernel reclaims its pages
# under the cap before it kills anything) plus the prompt cache (--cache-ram, MiB) plus
# 2 GiB of working room. A runaway brain then dies inside its own cgroup instead of taking
# the record's memory, which is what happened in September 2026. Override with
# LLAMA_DRIVE_MEM_LIMIT / LLAMA_VOICE_MEM_LIMIT / LLAMA_EMBED_MEM_LIMIT in wyrdsekai.conf
# (docker sizes: 6144m, 8g), or set one to 0 for no cap. Every compose call must see the
# same values, or compose recreates the container on each call.
_brain_mem_limit() {   # <model-file-or-name> [cache-ram-mib]
    local f="$1" cache="${2:-${LLAMA_CACHE_RAM:-1024}}" bytes=0
    [[ -f "$f" ]] || f="$MODELS_DIR/$(basename "$f")"
    [[ -f "$f" ]] || f="$PROJECT_ROOT/data/models/$(basename "$f")"
    [[ -f "$f" ]] && bytes=$(stat -c %s "$f" 2>/dev/null || stat -f %z "$f" 2>/dev/null || echo 0)
    [[ "$cache" =~ ^[0-9]+$ ]] || cache=1024
    echo "$(( bytes / 1048576 + cache + 2048 ))m"
}
_export_brain_mem_limits() {
    [[ -z "${LLAMA_DRIVE_MEM_LIMIT:-}" ]] && export LLAMA_DRIVE_MEM_LIMIT="$(_brain_mem_limit "${LLAMA_SKILLS_MODEL:-wyrdsekai-3.5-9b-drive-v6-q4km.gguf}")"
    [[ -z "${LLAMA_VOICE_MEM_LIMIT:-}" ]] && export LLAMA_VOICE_MEM_LIMIT="$(_brain_mem_limit "${LLAMA_VOICE_MODEL:-$(resolve_voice_model)}")"
    [[ -z "${LLAMA_EMBED_MEM_LIMIT:-}" ]] && export LLAMA_EMBED_MEM_LIMIT="$(_brain_mem_limit "${LLAMA_EMBED_MODEL:-bge-m3-Q8_0.gguf}" 0)"
    return 0
}

# ── Serving profile `single-sparse`: one large sparse model serves every lane ──────────────
# The two-model stack (9B drive + 4B voice) is the default and is untouched by any of this.
BRAIN_MODEL_DEFAULT="Qwen3.6-35B-A3B-UD-Q4_K_M.gguf"
BRAIN_CONTAINER="wyrdsekai-llama-brain"
# Residency figures for the default brain model, measured on a 16 GB card (2026-09-18/20):
# all routed experts in system RAM = 3.4 GB of VRAM; each layer's experts moved to the card
# costs ~0.47 GB of VRAM and frees the same from RAM. 40 layers, 22 GB file.
BRAIN_LAYERS=40; BRAIN_SPINE_VRAM_MB=3500; BRAIN_LAYER_MB=480; BRAIN_FILE_MB=22200
BRAIN_VRAM_HEADROOM_MB=2300   # context, the adapters, the desktop
BRAIN_RAM_FLOOR_MB=9000       # the server, the OS, the embedder

_serving_profile() {
    case "$(printf '%s' "${WYRDSEKAI_SERVING_PROFILE:-}" | tr 'A-Z' 'a-z')" in
        single-sparse) echo single-sparse ;;
        sparse-drive) echo sparse-drive ;;
        *) echo two-model ;;
    esac
}

# Profile `sparse-drive`: the large sparse model takes the DRIVE's place on :8200 and the voice
# model keeps speaking on :8201 (polish, the conversation lane and the night's write all stay on
# the voice model). For a companion whose voice already lives in a tuned voice model this gives
# the larger mind without changing who speaks. The card has to hold both, so the planner is
# asked about what is left after the voice model.
BRAIN_VOICE_RESERVE_MB=4300   # the 4B at Q4 with a 16K window, plus its compute buffers

# plan_for_profile <profile> <vram_mb> <ram_mb>
plan_for_profile() {
    local profile="$1" vram="${2:-0}" ram="${3:-0}"
    [[ "$vram" =~ ^[0-9]+$ ]] || vram=0
    if [[ "$profile" == "sparse-drive" ]]; then
        (( vram > BRAIN_VOICE_RESERVE_MB )) && vram=$(( vram - BRAIN_VOICE_RESERVE_MB )) || vram=0
    fi
    plan_brain_residency "$vram" "$ram"
}

# plan_brain_residency <vram_mb> <ram_mb>  →  gpu-full | <N> | all | not-viable
# N is the value for LLAMA_CPU_MOE / --n-cpu-moe: the routed experts of the first N layers stay
# in system RAM. It decides; it does not advise. Pure arithmetic so it can be table-tested.
plan_brain_residency() {
    local vram="${1:-0}" ram="${2:-0}"
    [[ "$vram" =~ ^[0-9]+$ && "$ram" =~ ^[0-9]+$ ]] || { echo not-viable; return; }
    local room=$(( vram - BRAIN_SPINE_VRAM_MB - BRAIN_VRAM_HEADROOM_MB ))
    (( room < 0 )) && { echo not-viable; return; }
    local on_gpu=$(( room / BRAIN_LAYER_MB ))
    (( on_gpu > BRAIN_LAYERS )) && on_gpu=$BRAIN_LAYERS
    local in_ram_mb=$(( BRAIN_FILE_MB - BRAIN_SPINE_VRAM_MB - on_gpu * BRAIN_LAYER_MB ))
    (( in_ram_mb < 0 )) && in_ram_mb=0
    (( ram < in_ram_mb + BRAIN_RAM_FLOOR_MB )) && { echo not-viable; return; }
    if (( on_gpu >= BRAIN_LAYERS )); then echo gpu-full
    elif (( on_gpu == 0 )); then echo all
    else echo $(( BRAIN_LAYERS - on_gpu )); fi
}

_brain_vram_mb() {   # the largest single card: the brain runs on one
    # macOS: the GPU shares system memory, there is no card to measure. Report 0; the Darwin
    # planner below decides from RAM alone.
    if [[ "$(uname -s)" == "Darwin" ]]; then echo 0; return 0; fi
    if command -v nvidia-smi &>/dev/null; then
        nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | sort -n | tail -1
    else echo 0; fi
}
# What others hold on the card right now, in MB: the card's used memory less what our own
# servers and the night's trainer hold. A game or a desktop on this card has no compute-apps
# row, so the difference is the honest measure. 0 without nvidia-smi.
_brain_vram_others_mb() {
    command -v nvidia-smi &>/dev/null || { echo 0; return 0; }
    local used ours=0 pid mem
    used="$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | sort -n | tail -1)"
    [[ "$used" =~ ^[0-9]+$ ]] || { echo 0; return 0; }
    local ourpids=" " c
    for c in wyrdsekai-llama-brain wyrdsekai-llama wyrdsekai-llama-voice wyrdsekai-llama-embed; do
        ourpids+="$(docker top "$c" -o pid 2>/dev/null | tail -n +2 | tr -s ' \n' ' ')"
    done
    ourpids+="$(pgrep -f 'sleepwrite/brain_write.py' 2>/dev/null | tr '\n' ' ') "
    while IFS=, read -r pid mem; do
        pid="${pid// /}"; mem="${mem// /}"
        [[ "$pid" =~ ^[0-9]+$ && "$mem" =~ ^[0-9]+$ ]] || continue
        [[ "$ourpids" == *" $pid "* ]] && ours=$(( ours + mem ))
    done < <(nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits 2>/dev/null)
    local others=$(( used - ours )); (( others < 0 )) && others=0
    echo "$others"
}
# The steward's ceiling for the card in MB (`wyrd brain vram <GB>`); 0 = none.
_brain_vram_cap_mb() {
    local v="${WYRDSEKAI_BRAIN_VRAM_CAP_MB:-}"
    [[ -z "$v" && -f "$CONFIG_FILE" ]] && v="$(grep -E '^WYRDSEKAI_BRAIN_VRAM_CAP_MB=' "$CONFIG_FILE" | tail -1 | cut -d= -f2-)"
    if [[ "$v" =~ ^[0-9]+$ ]]; then echo "$v"; else echo 0; fi
}
# The VRAM a plan may use now: the largest card, less what others hold on it, no more than the
# steward's ceiling. Planning on the whole card put her on top of whatever was already running
# and left the machine hers alone (2026-09-26). Pure given its three inputs; see the table test.
_brain_vram_available_mb() {   # [total_mb others_mb cap_mb] — measured when not given
    local total="${1:-$(_brain_vram_mb)}" others="${2:-$(_brain_vram_others_mb)}" cap="${3:-$(_brain_vram_cap_mb)}"
    [[ "$total" =~ ^[0-9]+$ ]] || total=0; [[ "$others" =~ ^[0-9]+$ ]] || others=0; [[ "$cap" =~ ^[0-9]+$ ]] || cap=0
    local avail=$(( total - others )); (( avail < 0 )) && avail=0
    (( cap > 0 && avail > cap )) && avail=$cap
    echo "$avail"
}
# The plan the running brain container was started with (its LLAMA_CPU_MOE), or "" when it is not up.
_brain_current_plan() {
    local v; v="$(docker inspect wyrdsekai-llama-brain --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | grep -E '^LLAMA_CPU_MOE=' | cut -d= -f2)"
    [[ -z "$v" ]] && { echo ""; return; }
    case "$v" in 0|none) echo gpu-full ;; on) echo all ;; *) echo "$v" ;; esac
}
# The plan in a person's words: how much of the card she uses and what others hold there.
_brain_plan_words() {   # <plan> <avail_mb> <others_mb> <cap_mb>
    local plan="$1" avail="${2:-0}" others="${3:-0}" cap="${4:-0}" on_gpu use_mb
    case "$plan" in gpu-full) on_gpu=$BRAIN_LAYERS ;; all) on_gpu=0 ;; not-viable) _t brain.plan.words_not_viable "$(( others / 1024 ))"; return ;; *) on_gpu=$(( BRAIN_LAYERS - plan )) ;; esac
    use_mb=$(( BRAIN_SPINE_VRAM_MB + on_gpu * BRAIN_LAYER_MB ))
    (( use_mb > avail && avail > 0 )) && use_mb=$avail
    local free_mb=$(( avail - use_mb )); (( free_mb < 0 )) && free_mb=0
    local line; line="$(_t brain.plan.words "$(( (use_mb + 512) / 1024 ))" "$on_gpu" "$BRAIN_LAYERS" "$(( (free_mb + 512) / 1024 ))" "$(( (others + 512) / 1024 ))")"
    (( cap > 0 )) && line+=" $(_t brain.plan.words_cap "$(( cap / 1024 ))")"
    echo "$line"
}
_brain_ram_mb() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        local bytes; bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
        [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
        echo $(( bytes / 1048576 )); return 0
    fi
    awk '/^MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0
}

# plan_brain_residency_darwin <ram_mb> [arch]  →  gpu-full | not-viable
# Apple Silicon only. The 22 GB of weights plus context must fit under the default GPU wired
# limit (about three quarters of unified memory), which a 48 GB Mac clears and a 32 GB Mac
# does not. There is no partial residency on Metal: every layer is on the GPU or the profile
# is not offered. Intel Macs are not viable. Pure arithmetic, like plan_brain_residency.
BRAIN_DARWIN_RAM_MIN_MB=46000
plan_brain_residency_darwin() {
    local ram="${1:-0}" arch="${2:-$(uname -m)}"
    [[ "$ram" =~ ^[0-9]+$ && "$arch" == "arm64" ]] || { echo not-viable; return; }
    if (( ram >= BRAIN_DARWIN_RAM_MIN_MB )); then echo gpu-full; else echo not-viable; fi
}

# The cgroup cap for the brain container: what stays in RAM + prompt cache + 2 GiB.
_brain_single_mem_limit() {   # <plan>
    local plan="$1" on_gpu=0 cache="${LLAMA_CACHE_RAM:-1024}"
    case "$plan" in gpu-full) on_gpu=$BRAIN_LAYERS ;; all) on_gpu=0 ;; *) on_gpu=$(( BRAIN_LAYERS - plan )) ;; esac
    [[ "$cache" =~ ^[0-9]+$ ]] || cache=1024
    # mlock pins the mapped file, so the whole file counts even when layers live on the card.
    echo "$(( BRAIN_FILE_MB + cache + 2048 ))m"
}

# Start (or reconcile) the single brain through compose. Returns 0 when the container is up
# or starting, 1 when this node cannot run it (the caller falls back to the two-model stack).
_start_brain_compose() {
    local model="${LLAMA_BRAIN_MODEL:-$BRAIN_MODEL_DEFAULT}"
    if [[ ! -f "$DATA_DIR/models/$model" ]]; then
        warn "$(_t brain.start.model_missing "$DATA_DIR/models/$model")"
        return 1
    fi
    local plan="${LLAMA_CPU_MOE:-}"
    if [[ -z "$plan" ]]; then
        # Planned on what the card has FREE (less the steward's ceiling), not on the whole card.
        plan="$(plan_for_profile "$(_serving_profile)" "$(_brain_vram_available_mb)" "$(_brain_ram_mb)")"
        if [[ "$plan" == "not-viable" ]]; then
            warn "$(_t brain.start.not_viable "$(_brain_vram_available_mb)" "$(_brain_ram_mb)")"
            return 1
        fi
    fi
    case "$plan" in gpu-full) export LLAMA_CPU_MOE=0 ;; *) export LLAMA_CPU_MOE="$plan" ;; esac
    export LLAMA_BRAIN_MODEL="$model" WYRDSEKAI_DATA="$DATA_DIR"
    [[ -z "${LLAMA_BRAIN_MEM_LIMIT:-}" ]] && export LLAMA_BRAIN_MEM_LIMIT="$(_brain_single_mem_limit "$plan")"
    [[ -f "$DATA_DIR/adapters/brain/honesty.gguf" ]] || warn "$(_t brain.start.no_generic_adapter "$DATA_DIR/adapters/brain/honesty.gguf")"
    # The drive container holds the same port. The voice container is stopped only when this
    # model is to be the voice as well.
    docker stop wyrdsekai-llama >/dev/null 2>&1 || true
    [[ "$(_serving_profile)" == "single-sparse" ]] && { docker stop wyrdsekai-llama-voice >/dev/null 2>&1 || true; }
    _ensure_nvidia_container_runtime
    log "$(_t brain.start.starting "$model" "$plan")"
    if docker compose --profile brain up -d llama-brain 2>/dev/null; then return 0; fi
    warn "$(_t brain.start.failed)"
    return 1
}

# True when the process behind the drive server's PID file is the single model (loading or up).
_brain_native_running() {
    [[ -f "$DATA_DIR/.llama-server.pid" ]] || return 1
    local pid; pid=$(<"$DATA_DIR/.llama-server.pid")
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || return 1
    local args; args="$(ps -p "$pid" -o args= 2>/dev/null || true)"
    [[ "$args" == *"${LLAMA_BRAIN_MODEL:-$BRAIN_MODEL_DEFAULT}"* ]]
}
# macOS: the single model as ONE native llama-server on the drive port. Metal with unified
# memory puts every layer on the GPU, so there is no --cpu-moe; no --mlock either, the GPU
# wired limit already governs what stays resident. Otherwise the flags are the llama-brain
# compose service's, two slots on one shared context pool (-np 2 --kv-unified) and adapter
# order included (id 0 generic, id 1 the night's write, and the night's write only when the
# honesty adapter is there). It writes the drive server's PID and log files so stop and status
# treat it as the drive. Returns 1 when this Mac cannot run it
# (the caller falls back to the two-model start).
_start_brain_native() {
    local model="${LLAMA_BRAIN_MODEL:-$BRAIN_MODEL_DEFAULT}"
    if [[ ! -f "$MODELS_DIR/$model" ]]; then
        warn "$(_t brain.start.model_missing "$MODELS_DIR/$model")"
        return 1
    fi
    local ram; ram="$(_brain_ram_mb)"
    if [[ "$(plan_brain_residency_darwin "${ram:-0}")" == "not-viable" ]]; then
        warn "$(_t brain.start.not_viable_mac "${ram:-0}")"
        return 1
    fi
    local llama=""
    llama=$(find_llama_server 2>/dev/null) || true
    if [[ -z "$llama" ]]; then
        warn "$(_t brain.start.failed)"
        return 1
    fi
    # Adapter 0 is the floor: the species floor when the node has it, else the honesty adapter.
    local generic="$DATA_DIR/adapters/brain/honesty.gguf"
    [[ -f "$DATA_DIR/adapters/brain/species.gguf" ]] && generic="$DATA_DIR/adapters/brain/species.gguf"
    local brain_args=(-m "$MODELS_DIR/$model" --port 8200 -c 32768 -np 2 --kv-unified
        --cache-ram "${WYRDSEKAI_LLAMA_CACHE_RAM:-1024}" -ngl 99
        --batch-size 2048 --ubatch-size 2048 --host 0.0.0.0 --jinja
        --reasoning off --reasoning-budget 0 --flash-attn on --metrics)
    if [[ -f "$generic" ]]; then
        brain_args+=(--lora-scaled "$generic:1.0")
        # The styled species adapter, raised per turn by her state (the register dial); at 0 until asked.
        [[ -f "$DATA_DIR/adapters/brain/styled.gguf" ]] && brain_args+=(--lora-scaled "$DATA_DIR/adapters/brain/styled.gguf:0.0")
        # The working-turn adapter, raised on the turns that call tools and zeroed when she speaks; at 0 until asked.
        [[ -f "$DATA_DIR/adapters/brain/work.gguf" ]] && brain_args+=(--lora-scaled "$DATA_DIR/adapters/brain/work.gguf:0.0")
        # One night adapter per being, in name order, as the compose service loads them.
        local _night
        for _night in "$DATA_DIR"/adapters/brainwrite/*/current.gguf; do
            [[ -f "$_night" ]] && brain_args+=(--lora-scaled "$_night:0.0")
        done
    else
        warn "$(_t brain.start.no_generic_adapter "$generic")"
    fi
    log "$(_t brain.start.starting "$model" gpu-full)"
    nohup "$llama" "${brain_args[@]}" > "$DATA_DIR/.llama-server.log" 2>&1 &
    echo "$!" > "$DATA_DIR/.llama-server.pid"
    return 0
}

_reconcile_container() {  # <profile> <service>
    local out
    _export_brain_mem_limits
    if ! out=$(docker compose --profile "$1" up -d "$2" 2>&1); then
        warn "$2: compose reconcile failed — still running the previous definition"
        return 0
    fi
    if grep -qi "recreat" <<<"$out"; then
        log "$2: recreated — its compose definition changed since it was started"
    fi
    return 0
}

# ── The served embedder: which server answers on :8202 ────────────────────────
# WYRDSEKAI_EMBED_SERVER=llama (llama-server on the bge-m3 GGUF, the default) or tei
# (Hugging Face Text Embeddings Inference on the same bge-m3 — the whole batch stays on
# the card; several times faster on NVIDIA). Same route, same model, same vector stamp.
_embed_server() {
    local m="${WYRDSEKAI_EMBED_SERVER:-}"
    [[ -z "$m" ]] && m="$(grep -E '^WYRDSEKAI_EMBED_SERVER=' "$CONFIG_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d ' ' || true)"
    case "$(echo "${m:-llama}" | tr '[:upper:]' '[:lower:]')" in tei) echo tei ;; *) echo llama ;; esac
}

# TEI ships one image per compute capability. From nvidia-smi and the docker runtimes;
# cpu when either is missing (it works, slowly). 12.0 is Blackwell (the 50-series).
TEI_VERSION="${TEI_VERSION:-1.9}"
_tei_tag() {
    if ! docker info --format '{{.Runtimes}}' 2>/dev/null | grep -q nvidia; then echo "cpu-$TEI_VERSION"; return 0; fi
    local cap; cap="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ' || true)"
    case "$cap" in
        7.5)  echo "turing-$TEI_VERSION" ;;
        8.0)  echo "$TEI_VERSION" ;;
        8.6)  echo "86-$TEI_VERSION" ;;
        8.9)  echo "89-$TEI_VERSION" ;;
        9.0)  echo "hopper-$TEI_VERSION" ;;
        12.0) echo "120-$TEI_VERSION" ;;
        *)    echo "cpu-$TEI_VERSION" ;;
    esac
}

start_inference() {
    local model_path="${1:-}"

    if [[ "$(uname -s)" == "Darwin" ]]; then
        # macOS: native llama-server (Metal acceleration). Run two
        # instances when both a drive model and a voice model are present:
        #   :8200  drive/skills brain (larger model if available)
        #   :8201  voice brain (4B)
        # Apple Silicon unified memory lets the 9B+4B pair fit in ~8GB,
        # leaving headroom inside a 16GB system. When only a 4B is on disk
        # the resolve_* helpers return the same path for both — still two
        # endpoints, just one underlying GGUF.
        # llama-server is only the GGUF FALLBACK on macOS (Intel Macs, or Apple
        # Silicon when the MLX path can't serve). On Apple Silicon the MLX
        # drive/voice serve :8200/:8201 directly, so a MISSING llama-server must
        # NOT abort the launch — resolve it leniently and only use it below if
        # we actually fall through to the GGUF path.
        local llama=""
        llama=$(find_llama_server 2>/dev/null) || true
        local gpu_layers="${WYRDSEKAI_GPU_LAYERS:-99}"
        local drive_model voice_model
        drive_model="${model_path:-$(resolve_drive_model)}"
        voice_model="$(resolve_voice_model)"

        # Serving profile single-sparse: one native llama-server on the drive port instead of
        # the drive + voice pair. A Mac that cannot run it (model missing, too little memory,
        # Intel) falls through to the pair below. Something else already answering on :8200 is
        # left alone, as on every other start; `wyrd restart` is what moves between profiles.
        local _single_brain=0
        if [[ "$(_serving_profile)" == "single-sparse" ]]; then
            if _brain_native_running; then
                log "$(_t start_inference.already_running)"
                _single_brain=1
            elif ! is_inference_running && _start_brain_native; then
                _single_brain=1
            fi
        fi

        # MoE residency + template knobs for the drive server. Mirrors the
        # docker-compose schema (LLAMA_CPU_MOE / LLAMA_CHAT_TEMPLATE_KWARGS /
        # LLAMA_SKILLS_EXTRA_ARGS) under the WYRDSEKAI_ env-file prefix.
        # Sparse-active models keep attention/KV on the accelerator while
        # expert tensors sit in system RAM — no-op for dense models.
        local drive_extra=()
        case "${WYRDSEKAI_LLAMA_CPU_MOE:-}" in
            ""|0) : ;;
            all|on) drive_extra+=(--cpu-moe) ;;
            *) drive_extra+=(--n-cpu-moe "${WYRDSEKAI_LLAMA_CPU_MOE}") ;;
        esac
        if [[ -n "${WYRDSEKAI_LLAMA_CHAT_TEMPLATE_KWARGS:-}" ]]; then
            drive_extra+=(--chat-template-kwargs "${WYRDSEKAI_LLAMA_CHAT_TEMPLATE_KWARGS}")
        fi
        if [[ -n "${WYRDSEKAI_LLAMA_EXTRA_ARGS:-}" ]]; then
            local _extra_words
            read -ra _extra_words <<< "${WYRDSEKAI_LLAMA_EXTRA_ARGS}"
            drive_extra+=("${_extra_words[@]}")
        fi

        if [[ "$_single_brain" == "1" ]]; then
            : # the single model holds :8200 — no MLX drive, no two-model drive.
        elif is_inference_running; then
            log "$(_t start_inference.already_running)"
        elif start_mlx_drive; then
            : # MLX drive path took :8200; log emitted inside helper.
        elif [[ -f "$drive_model" ]]; then
            log "$(_t start_inference.starting_metal) (drive=$(basename "$drive_model") :8200)"
            nohup "$llama" -m "$drive_model" --port 8200 -c "$(( ${WYRDSEKAI_DRIVE_CTX:-16384} * ${WYRDSEKAI_DRIVE_PARALLEL:-1} ))" -np "${WYRDSEKAI_DRIVE_PARALLEL:-1}" --cache-ram "${WYRDSEKAI_LLAMA_CACHE_RAM:-1024}" \
                -ngl "$gpu_layers" --host 0.0.0.0 \
                ${drive_extra[@]+"${drive_extra[@]}"} \
                > "$DATA_DIR/.llama-server.log" 2>&1 &
            echo "$!" > "$DATA_DIR/.llama-server.pid"
        else
            warn "drive model not found at $drive_model — skipping :8200"
        fi

        # :8201 voice server. Skipped when WYRDSEKAI_LLAMA_VOICE_ENABLED=0
        # (single-server tier), and in the single-model profile: every lane is on :8200.
        if [[ "${WYRDSEKAI_LLAMA_VOICE_ENABLED:-1}" != "0" && "$_single_brain" != "1" ]]; then
            if is_voice_inference_running; then
                log "voice :8201 already running"
            elif start_mlx_voice; then
                : # MLX path took it; log lines emitted inside the helper.
            elif [[ -f "$voice_model" ]]; then
                # Fallback: llama-server + V8 GGUF vectors (pre-MLX households,
                # or hosts where MLX deps aren't installed yet).
                local vec_dir=""
                for d in "$DATA_DIR/vectors/v8" "/opt/wyrdsekai/data/vectors/v8" \
                         "/var/lib/wyrdsekai/vectors/v8" \
                         "/usr/local/wyrdsekai/data/vectors/v8"; do
                    [[ -d "$d" ]] && { vec_dir="$d"; break; }
                done
                local v8_default="anti_defiance.gguf:0.15,es_register_hold.gguf:0.20,refusal_stability.gguf:0.20,first_person_presence.gguf:0.15"
                local v8_csv="" v8_pair v8_file v8_scale
                if [[ -n "$vec_dir" ]]; then
                    IFS=',' read -ra v8_pairs <<< "${WYRDSEKAI_V8_VECTORS:-$v8_default}"
                    for v8_pair in "${v8_pairs[@]}"; do
                        v8_file="${v8_pair%%:*}"
                        v8_scale="${v8_pair##*:}"
                        if [[ -f "$vec_dir/$v8_file" ]]; then
                            if [[ -z "$v8_csv" ]]; then
                                v8_csv="$vec_dir/$v8_file:$v8_scale"
                            else
                                v8_csv="$v8_csv,$vec_dir/$v8_file:$v8_scale"
                            fi
                        fi
                    done
                fi
                if [[ -n "$v8_csv" ]]; then
                    log "starting voice llama-server (model=$(basename "$voice_model") :8201 +V8 vectors)"
                    nohup "$llama" -m "$voice_model" --port 8201 -c "$(( 4096 * ${WYRDSEKAI_VOICE_PARALLEL:-1} ))" -np "${WYRDSEKAI_VOICE_PARALLEL:-1}" --cache-ram "${WYRDSEKAI_LLAMA_CACHE_RAM:-1024}" \
                        -ngl "$gpu_layers" --host 0.0.0.0 \
                        --control-vector-scaled "$v8_csv" \
                        > "$DATA_DIR/.llama-server-voice.log" 2>&1 &
                else
                    warn "voice :8201 starting WITHOUT V8 vectors — bundled vectors missing at $DATA_DIR/vectors/v8 (set WYRDSEKAI_V8_VECTORS or reinstall)"
                    nohup "$llama" -m "$voice_model" --port 8201 -c "$(( 4096 * ${WYRDSEKAI_VOICE_PARALLEL:-1} ))" -np "${WYRDSEKAI_VOICE_PARALLEL:-1}" --cache-ram "${WYRDSEKAI_LLAMA_CACHE_RAM:-1024}" \
                        -ngl "$gpu_layers" --host 0.0.0.0 \
                        > "$DATA_DIR/.llama-server-voice.log" 2>&1 &
                fi
                echo "$!" > "$DATA_DIR/.llama-server-voice.pid"
            else
                log "voice model not found at $voice_model — :8201 skipped"
            fi
        fi
    else
        local _drive_was_running=0
        if is_inference_running; then
            # Drive (:8200) already up — note it but DON'T return: the voice
            # (:8201) auto-start further down must still get its chance
            # (e.g. `wyrd restart` after a fresh setup that never ran voice).
            log "$(_t start_inference.already_running)"
            _drive_was_running=1
        fi
        # Fall-through to Linux path
        model_path="${model_path:-$MODELS_DIR/wyrdsekai-3.5-4b-v10-q4km.gguf}"
        # Linux: Docker llama-server with CUDA
        if command -v docker &>/dev/null && _docker_daemon_present; then
            # Ensure model is in the data/models directory for Docker mount
            local models_dir="$DATA_DIR/models"
            mkdir -p "$models_dir"
            if [[ -f "$model_path" && ! -f "$models_dir/$(basename "$model_path")" ]]; then
                log "$(_t start_inference.copying_model "$models_dir")"
                cp "$model_path" "$models_dir/"
            fi

            local compose_file="$PROJECT_ROOT/docker-compose.yml"
            if [[ -f "$compose_file" ]]; then
                cd "$(dirname "$compose_file")"
                # F23 part 2: pick the right models dir. The compose file mounts
                # `${WYRDSEKAI_DATA:-./data}/models:/models:ro` and loads
                # `/models/$LLAMA_SKILLS_MODEL`. If the mounted dir doesn't
                # contain that file the container starts then immediately
                # fails with "No such file or directory" — F22's
                # LocalBackendUnavailable.
                #
                # 2026-06-10 fresh-install fix: a single hardcoded default
                # name can't work — the compose default (v6) predates the
                # `wyrdsekai-3.5-9b-drive-v6-q4km.gguf` that `wyrd setup` now
                # downloads from HF, so a fresh install mounted $DATA_DIR and
                # FNF'd. Resolve the NAME across canonical candidates (fresh
                # download dir first, then the source-tree zoo) and export it
                # so compose serves the same file we found.
                local skills_model="${LLAMA_SKILLS_MODEL:-}"
                local _sm_dir=""
                if [[ -n "$skills_model" ]]; then
                    if [[ -f "$DATA_DIR/models/$skills_model" ]]; then _sm_dir="$DATA_DIR"
                    elif [[ -f "$PROJECT_ROOT/data/models/$skills_model" ]]; then _sm_dir="$PROJECT_ROOT/data"
                    fi
                else
                    local _name
                    for _name in \
                        wyrdsekai-3.5-9b-drive-v6-q4km.gguf \
                        wyrdsekai-3.5-9b-drive-v6-q4km.gguf \
                        wyrdsekai-3.5-9b-v5-q4km.gguf \
                        wyrdsekai-granite-3b-substrate-v2-q4km.gguf \
                        wyrdsekai-3.5-4b-v10-q4km.gguf; do
                        if [[ -f "$DATA_DIR/models/$_name" ]]; then
                            skills_model="$_name"; _sm_dir="$DATA_DIR"; break
                        elif [[ -f "$PROJECT_ROOT/data/models/$_name" ]]; then
                            skills_model="$_name"; _sm_dir="$PROJECT_ROOT/data"; break
                        fi
                    done
                    skills_model="${skills_model:-wyrdsekai-3.5-9b-drive-v6-q4km.gguf}"
                fi
                export LLAMA_SKILLS_MODEL="$skills_model"
                if [[ "$_sm_dir" == "$PROJECT_ROOT/data" ]]; then
                    # Source mode: let compose default `./data` resolve to
                    # $PROJECT_ROOT/data (cwd is already set by `cd` above).
                    unset WYRDSEKAI_DATA 2>/dev/null || true
                else
                    # $DATA_DIR has it — or nowhere does, in which case keep
                    # prior behavior so the user gets the existing FNF error
                    # rather than a silent skip.
                    export WYRDSEKAI_DATA="$DATA_DIR"
                fi
                # F23: match the 9B drive container name *exactly*. The earlier
                # `grep -q llama` matched the unrelated `wyrdsekai-llama-voice`
                # container (4B voice on :8201) and falsely concluded "already
                # running" — every `wyrd restart` then left the 9B drive on
                # :8200 stopped, silently breaking cross-zone inference.
                # Tracks whether Docker brought up (or already had) the drive
                # container. When set, we must NOT fall into the native fallback
                # below: the 9B+4B take ~30-40s to load and the readiness loop
                # at the end of this function handles that wait. Crying
                # "No inference backend found" here — mid-cold-start — was a
                # false alarm that read as a broken install on every fresh run.
                _export_brain_mem_limits
                local _docker_started=0
                # Serving profile single-sparse: one model on the drive port instead of the
                # drive + voice pair. A node that cannot run it falls through to the pair.
                local _single_brain=0 _brain_is_drive=0
                case "$(_serving_profile)" in
                    single-sparse) _start_brain_compose && { _single_brain=1; _brain_is_drive=1; } ;;
                    sparse-drive)  _start_brain_compose && _brain_is_drive=1 ;;
                esac
                if [[ "$_brain_is_drive" == "1" ]]; then
                    _docker_started=1
                elif [[ "$_drive_was_running" == "1" ]]; then
                    _docker_started=1  # :8200 already serving — leave it be…
                    # …unless it is our compose container: reconcile it against
                    # the current docker-compose.yml (no-op when unchanged). The
                    # first cut put this only on the branch below, which :8200
                    # already serving never reaches — the drive kept its old
                    # flags through the very upgrade that changed them.
                    if docker compose --profile inference ps --format '{{.Name}}' 2>/dev/null | grep -qx wyrdsekai-llama; then
                        _reconcile_container inference llama-server
                    fi
                elif docker compose --profile inference ps --format '{{.Name}}' 2>/dev/null | grep -qx wyrdsekai-llama; then
                    log "$(_t start_inference.docker_already_running)"
                    _reconcile_container inference llama-server
                    _docker_started=1
                else
                    # Self-heal: make sure Docker can reach the GPU before the
                    # CUDA container launch (fresh GPU box without the toolkit).
                    _ensure_nvidia_container_runtime
                    log "$(_t start_inference.starting_docker_cuda)"
                    if docker compose --profile inference up -d llama-server 2>/dev/null; then
                        log "$(_t start_inference.container_starting)"
                        _docker_started=1
                    else
                        warn "$(_t start_inference.docker_failed_native)"
                    fi
                fi
                # Embedding server (:8202, bge-m3 on the GPU) — the served
                # embedder behind WYRDSEKAI_EMBEDDING_URL. Started when the
                # conf names it and the GGUF is in the models dir; without it
                # the node embeds in-process (CPU, ~2 chunks/s) and text-only
                # ingests stay text-only until a server exists.
                if [[ "${WYRDSEKAI_EMBEDDING_URL:-}" == *:8202* ]]; then
                    local _em_dir="${_sm_dir:-$DATA_DIR}"
                    local _embed_name="${LLAMA_EMBED_MODEL:-bge-m3-Q8_0.gguf}"
                    local _running_embed; _running_embed="$(docker ps --format '{{.Names}}' 2>/dev/null | grep -E '^wyrdsekai-(llama|tei)-embed$' || true)"
                    if [[ "$(_embed_server)" == "tei" ]]; then
                        # Text Embeddings Inference on the same bge-m3. The other server on :8202
                        # steps aside; the port is the contract, the server behind it is a choice.
                        if grep -qx wyrdsekai-llama-embed <<<"$_running_embed"; then docker stop wyrdsekai-llama-embed >/dev/null 2>&1 || true; log "llama-embed stopped — WYRDSEKAI_EMBED_SERVER=tei"; fi
                        local _tag; _tag="$(_tei_tag)"
                        mkdir -p "$_em_dir/models/tei" 2>/dev/null || true
                        if grep -qx wyrdsekai-tei-embed <<<"$_running_embed"; then
                            log "embedding :8202 already running (TEI $_tag)"
                            TEI_IMAGE_TAG="$_tag" _reconcile_container embed-tei tei-embed
                        else
                            log "$(_t embed.starting_container wyrdsekai-tei-embed "${LLAMA_EMBED_PORT:-8202}") — TEI $_tag, the model fetched on first start"
                            TEI_IMAGE_TAG="$_tag" docker compose --profile embed-tei up -d tei-embed 2>/dev/null \
                                || warn "$(_t voice.enable.needs_docker)"
                        fi
                    else
                        if grep -qx wyrdsekai-tei-embed <<<"$_running_embed"; then docker stop wyrdsekai-tei-embed >/dev/null 2>&1 || true; log "tei-embed stopped — WYRDSEKAI_EMBED_SERVER=llama"; fi
                        if grep -qx wyrdsekai-llama-embed <<<"$_running_embed"; then
                            log "embedding :8202 already running"
                            LLAMA_EMBED_MODEL="$_embed_name" _reconcile_container embed llama-embed
                        elif [[ -f "$_em_dir/models/$_embed_name" ]]; then
                            log "$(_t embed.starting_container wyrdsekai-llama-embed "${LLAMA_EMBED_PORT:-8202}")"
                            LLAMA_EMBED_MODEL="$_embed_name" \
                                docker compose --profile embed up -d llama-embed 2>/dev/null \
                                || warn "$(_t voice.enable.needs_docker)"
                        else
                            log "$(_t embed.model_missing "$_em_dir/models/$_embed_name")"
                        fi
                    fi
                fi
                # Voice brain (:8201, 4B) — Darwin starts both brains by
                # default; mirror that here. Fresh installs never ran
                # `wyrd voice enable`, so without this a Linux node comes
                # up with only the 9B drive (1 backend, no voice pass).
                # Skipped when WYRDSEKAI_LLAMA_VOICE_ENABLED=0 or when no
                # 4B model exists in the same dir compose mounts at /models.
                if [[ "${WYRDSEKAI_LLAMA_VOICE_ENABLED:-1}" != "0" && "$_single_brain" != "1" ]]; then
                    local _vm_dir="${_sm_dir:-$DATA_DIR}"
                    local _voice_name="" _vn
                    for _vn in \
                        wyrdsekai-3.5-4b-v10-q4km.gguf \
                        wyrdsekai-3.5-4b-v10-q4km.gguf \
                        wyrdsekai-3.5-4b-v10-q4km.gguf; do
                        [[ -f "$_vm_dir/models/$_vn" ]] && { _voice_name="$_vn"; break; }
                    done
                    # Sleep weight-write: serve last night's staged micro-LoRA
                    # when present (wyrd sleepwrite rollback removes it).
                    if [[ -z "${LLAMA_VOICE_ADAPTER:-}" && -f "$DATA_DIR/adapters/sleepwrite/current.gguf" ]]; then
                        export LLAMA_VOICE_ADAPTER="sleepwrite/current.gguf"
                        log "voice: sleepwrite adapter staged — serving current.gguf"
                    fi
                    if docker compose --profile voice ps --format '{{.Name}}' 2>/dev/null | grep -qx wyrdsekai-llama-voice; then
                        log "voice :8201 already running"
                        if [[ -n "$_voice_name" ]]; then
                            LLAMA_VOICE_MODEL="$_voice_name" _reconcile_container voice llama-voice
                        fi
                    elif [[ -n "$_voice_name" ]]; then
                        # Pre-create mount sources as the user — docker
                        # auto-creates missing host dirs AS ROOT, which
                        # breaks purge/reset for non-root (shakedown #6).
                        # Seed V8 vectors from the source tree when the data
                        # dir doesn't have them yet (dev installs) — voice
                        # without them serves but loses register corrections.
                        if [[ ! -d "$_vm_dir/training/v8/vectors" && -d "$PROJECT_ROOT/data/training/v8/vectors" ]]; then
                            mkdir -p "$_vm_dir/training/v8"
                            cp -r "$PROJECT_ROOT/data/training/v8/vectors" "$_vm_dir/training/v8/"
                        fi
                        mkdir -p "$_vm_dir/adapters" "$_vm_dir/training/v8/vectors"
                        log "$(_t voice.enable.starting_container wyrdsekai-llama-voice "${LLAMA_VOICE_PORT:-8201}")"
                        LLAMA_VOICE_MODEL="$_voice_name" \
                            docker compose --profile voice up -d llama-voice 2>/dev/null \
                            || warn "$(_t voice.enable.needs_docker)"
                    else
                        log "voice model not found in $_vm_dir/models — :8201 skipped"
                    fi
                fi
                cd "$PROJECT_ROOT"
            fi

            # Fallback: native llama-server ONLY if Docker did not start a
            # container. When Docker IS bringing one up, it's mid-cold-start
            # (9B+4B take ~30-40s to load) — the readiness loop at the end of
            # this function waits for /health. Falling through here would print
            # a false "No inference backend found" that reads as a broken
            # install on every fresh Docker run.
            if [[ "${_docker_started:-0}" != "1" ]] && ! is_inference_running; then
                local llama
                if llama=$(find_llama_server); then
                    log "$(_t start_inference.starting_native)"
                    nohup "$llama" -m "$model_path" --port 8200 -c "$(( ${WYRDSEKAI_DRIVE_CTX:-16384} * ${WYRDSEKAI_DRIVE_PARALLEL:-1} ))" -np "${WYRDSEKAI_DRIVE_PARALLEL:-1}" --cache-ram "${WYRDSEKAI_LLAMA_CACHE_RAM:-1024}" \
                        -ngl "${WYRDSEKAI_GPU_LAYERS:-99}" --host 0.0.0.0 \
                        > "$DATA_DIR/.llama-server.log" 2>&1 &
                    echo "$!" > "$DATA_DIR/.llama-server.pid"
                else
                    warn "$(_t start_inference.no_backend)"
                    warn "$(_t start_inference.no_backend_remote)"
                fi
            fi
        else
            # No Docker — try native
            local llama
            if llama=$(find_llama_server); then
                log "$(_t start_inference.starting_native)"
                nohup "$llama" -m "$model_path" --port 8200 -c "$(( ${WYRDSEKAI_DRIVE_CTX:-16384} * ${WYRDSEKAI_DRIVE_PARALLEL:-1} ))" -np "${WYRDSEKAI_DRIVE_PARALLEL:-1}" --cache-ram "${WYRDSEKAI_LLAMA_CACHE_RAM:-1024}" \
                    -ngl "${WYRDSEKAI_GPU_LAYERS:-99}" --host 0.0.0.0 \
                    > "$DATA_DIR/.llama-server.log" 2>&1 &
                echo "$!" > "$DATA_DIR/.llama-server.pid"
            else
                warn "$(_t start_inference.no_backend)"
                warn "$(_t start_inference.no_backend_remote)"
            fi
        fi
    fi

    # Wait for ready. llama-server exposes /health, mlx_lm.server doesn't —
    # both serve /v1/models. Try /health first (faster cheap path), fall
    # back to /v1/models so the Darwin MLX-drive branch passes this gate.
    local waited=0
    while [[ $waited -lt 60 ]]; do
        if curl -sf "http://localhost:8200/health" &>/dev/null \
            || curl -sf "http://localhost:8200/v1/models" &>/dev/null; then
            log "$(_t start_inference.ready)"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    warn "$(_t start_inference.not_responding)"
}

# Docker Desktop's CLI can BLOCK indefinitely on macOS: with no daemon it waits
# for the socket, and with an unhealthy daemon `docker info` never returns —
# the 0.2.2 first-install test sat 36 minutes in setup's container probe on a
# Mac whose Docker Desktop had been idling for 15 days. macOS has no
# `timeout`, so bound docker calls ourselves; the child we kill is our own.
_docker_bounded() {   # $1 = seconds, rest = docker args; 124 on timeout
    local secs="$1"; shift
    docker "$@" &>/dev/null &
    local dpid=$! waited=0
    while kill -0 "$dpid" 2>/dev/null; do
        if (( waited >= secs * 10 )); then
            # A wedged Docker Desktop CLI ignores TERM (it needed -9 by hand on
            # 09-02); escalate, or the `wait` below blocks exactly like the
            # call we are guarding against.
            kill "$dpid" 2>/dev/null; sleep 0.3
            kill -0 "$dpid" 2>/dev/null && kill -9 "$dpid" 2>/dev/null
            wait "$dpid" 2>/dev/null; return 124
        fi
        sleep 0.1; waited=$((waited + 1))
    done
    wait "$dpid"
}
# True when docker is usable here. Linux: unchanged (the CLI fails fast
# without a daemon; rootless sockets live anywhere). Darwin: a bounded probe.
_docker_daemon_present() {
    command -v docker &>/dev/null || return 1
    [[ "$(uname -s)" == "Darwin" ]] || return 0
    _docker_bounded 8 info
}

stop_inference() {
    # Stop native llama-server (drive + voice) AND MLX drive + voice
    # (Darwin Phase 3 + dual-MLX). Order doesn't matter — each branch is
    # idempotent.
    for pidfile in "$DATA_DIR/.llama-server.pid" \
                   "$DATA_DIR/.llama-server-voice.pid" \
                   "$DATA_DIR/.mlx-voice.pid" \
                   "$DATA_DIR/.mlx-drive.pid"; do
        if [[ -f "$pidfile" ]]; then
            local pid=$(<"$pidfile")
            if kill -0 "$pid" 2>/dev/null; then
                kill "$pid" 2>/dev/null
                log "$(_t common.llama_stopped "$pid")"
            fi
            rm -f "$pidfile"
        fi
    done
    pkill -f "llama-server.*8200" 2>/dev/null || true
    pkill -f "llama-server.*8201" 2>/dev/null || true
    pkill -f "mlx_runtime.py.*--port 8201" 2>/dev/null || true
    pkill -f "mlx_lm.server.*--port 8201" 2>/dev/null || true
    pkill -f "mlx_lm.server.*--port 8200" 2>/dev/null || true

    # Stop Docker llama-server — drive AND voice. llama-voice lives under
    # the voice/dual compose profiles, which a bare --profile inference
    # stop never matches; left running it keeps serving the model file
    # even after a data-dir wipe. Container names are fixed in compose,
    # so stop by name instead of playing profile games.
    # Docker Desktop's CLI BLOCKS waiting for its daemon socket when the
    # daemon is not running — `wyrd stop` on a Mac with the CLI installed but
    # Docker not started hung for minutes on this line (0.2.2 first-install
    # test). Only talk to docker when a daemon socket exists.
    if command -v docker &>/dev/null && _docker_daemon_present; then
        docker stop wyrdsekai-llama wyrdsekai-llama-voice wyrdsekai-llama-brain wyrdsekai-llama-embed wyrdsekai-tei-embed 2>/dev/null || true
    fi
}

# ── Process management helpers ──
find_server_pids() {
    # Filter pgrep results to actual JVM processes — bash shells whose argv
    # happens to contain the pattern (e.g. the subshell running pgrep itself)
    # MUST NOT be returned or do_stop will SIGTERM its own process tree.
    local p comm
    for p in $(pgrep -f "org.wyrdsekai.server.Main" 2>/dev/null); do
        comm=$(ps -p "$p" -o comm= 2>/dev/null | tr -d ' ')
        [[ "$comm" == "java" || "$comm" == "java_vm" ]] && echo "$p"
    done
    for p in $(pgrep -f "wyrdsekai.*:server:run" 2>/dev/null); do
        comm=$(ps -p "$p" -o comm= 2>/dev/null | tr -d ' ')
        [[ "$comm" == "java" || "$comm" == "gradle" ]] && echo "$p"
    done
}

is_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid; pid=$(<"$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then return 0; fi
        rm -f "$PID_FILE"
    fi
    return 1
}

# F8: detect macOS LaunchDaemon for split-brain checks.
# The macOS .pkg installs a root LaunchDaemon (system/com.wyrdsekai.server)
# that owns the server the way systemd owns it on Linux. wyrd start/status
# must route through it — the 0.2.2 first-install test on a clean Mac showed
# `wyrd start` failing to kill the root-owned port holder, then writing its
# own org.wyrdsekai.server daemon beside it (two JVMs, one port), while
# `wyrd status` reported "not running" against a server that answered.
_LAUNCHD_PKG_LABEL="com.wyrdsekai.server"
_LAUNCHD_PKG_PLIST="/Library/LaunchDaemons/com.wyrdsekai.server.plist"
_launchd_pkg_managed() {
    [[ "$(uname -s)" == "Darwin" && -f "$_LAUNCHD_PKG_PLIST" ]]
}
# PID of the running pkg daemon, empty when not running. `launchctl print`
# on the system domain answers for a normal user on current macOS; fall back
# to sudo where it does not.
_launchd_pkg_pid() {
    local out
    out=$(launchctl print "system/$_LAUNCHD_PKG_LABEL" 2>/dev/null) \
        || out=$(sudo -n launchctl print "system/$_LAUNCHD_PKG_LABEL" 2>/dev/null) || return 0
    echo "$out" | awk '/^[[:space:]]*pid = /{print $3; exit}'
}
_launchd_pkg_wait_healthy() {   # $1 = tenths of a second to wait
    local port="${PORT:-7070}" waited=0 limit="${1:-150}"
    while [[ $waited -lt $limit ]]; do
        curl -sf "http://localhost:$port/health" &>/dev/null && return 0
        sleep 0.2; waited=$((waited + 1))
    done
    curl -sf "http://localhost:$port/health" &>/dev/null
}

is_launchd_managed() {
    [[ "$(uname -s)" == "Darwin" ]] || return 1
    command -v launchctl >/dev/null 2>&1 || return 1
    # Common label history for the wyrdsekai daemon.
    for label in com.wyrdsekai.server dev.wyrdsekai.server org.wyrdsekai.server; do
        launchctl print "system/$label" >/dev/null 2>&1 && return 0
    done
    return 1
}

# F8 helper — single source of truth for "what server processes exist?"
# Echoes one line per finding; format: "<source>\t<pid>\t<note>"
# Sources: pidfile, jvm, gradle, systemd, launchd
_doctor_process_inventory() {
    local pid
    if [[ -f "$PID_FILE" ]]; then
        pid=$(<"$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo -e "pidfile\t$pid\talive"
        else
            echo -e "pidfile\t$pid\tstale"
        fi
    fi
    local p
    for p in $(find_server_pids); do
        # Read full cmdline for classification — argv[]-NUL separated under /proc.
        local cmdline=""
        if [[ -r "/proc/$p/cmdline" ]]; then
            cmdline=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
        else
            cmdline=$(ps -p "$p" -o args= 2>/dev/null)
        fi
        # Tag source by classpath signature.
        if [[ "$cmdline" == *"/usr/local/wyrdsekai/lib"* ]]; then
            echo -e "jvm\t$p\tinstalled (.deb/.pkg)"
        elif [[ "$cmdline" == *"/opt/wyrdsekai/lib"* ]]; then
            echo -e "jvm\t$p\tinstalled (.pkg)"
        elif [[ "$cmdline" == *"build/install/server"* ]]; then
            echo -e "jvm\t$p\tsource (installDist)"
        elif [[ "$cmdline" == *":server:run"* || "$cmdline" == *"gradle"* ]]; then
            echo -e "gradle\t$p\tgradle :server:run"
        elif [[ "$cmdline" == *"core/build/classes/java/main"* ]]; then
            echo -e "jvm\t$p\tsource (raw classes)"
        else
            echo -e "jvm\t$p\tunknown classpath"
        fi
    done
    if is_systemd_managed && systemctl is-active wyrdsekai.service >/dev/null 2>&1; then
        local spid
        spid=$(systemctl show wyrdsekai.service -p MainPID --value 2>/dev/null)
        echo -e "systemd\t${spid:-?}\twyrdsekai.service active"
    fi
    if is_launchd_managed; then
        local label
        for label in com.wyrdsekai.server dev.wyrdsekai.server org.wyrdsekai.server; do
            local lpid
            lpid=$(launchctl print "system/$label" 2>/dev/null \
                | awk -F'= ' '/pid =/{print $2; exit}')
            [[ -n "$lpid" && "$lpid" != "0" ]] && echo -e "launchd\t$lpid\t$label"
        done
    fi
    # The last label usually has no pid, and its false `[[ … ]]` made this return 1: under
    # `set -e` the caller's `inv=$(…)` then ended `wyrd doctor` on every Mac.
    return 0
}

# F8: returns 0 if exactly 0 or 1 server process across all sources, 1 if conflict.
# Echoes a human-readable summary on stderr when a conflict is found.
_doctor_preflight_processes() {
    local inv jvm_count
    inv=$(_doctor_process_inventory)
    jvm_count=$(echo "$inv" | awk -F'\t' '$1 == "jvm" || $1 == "gradle" {print $2}' \
        | sort -u | grep -c .)
    if [[ "$jvm_count" -gt 1 ]]; then
        echo >&2 ""
        echo >&2 "wyrd doctor: detected $jvm_count concurrent server JVMs:"
        echo >&2 "$inv" | awk -F'\t' '$1=="jvm"||$1=="gradle"{printf "  pid=%s  source=%s  (%s)\n", $2,$1,$3}' >&2
        echo >&2 ""
        echo >&2 "  Mixing source mode and an installed daemon causes split state."
        echo >&2 "  Stop one before continuing:"
        case "$(uname -s)" in
            Darwin) echo >&2 "    sudo launchctl bootout system/com.wyrdsekai.server   # stop daemon" ;;
            Linux)  echo >&2 "    sudo systemctl stop wyrdsekai                          # stop service" ;;
        esac
        echo >&2 "    wyrd stop                                              # stop source/local"
        return 1
    fi
    return 0
}

# ── Setup (first-time install) ──
# Interactive prompt with a live per-second countdown. The reply lands in
# _PROMPT_REPLY; empty (timeout or bare enter) means "take the default
# shown in the prompt text". Non-tty stdin skips straight to the default
# so piped/headless runs never hang. read returns 0 the moment a line
# arrives; >128 on each 1s timeout tick.
# Enters pressed during a long download queue up on stdin and answer the NEXT prompt
# (field report 2026-09-13: they cost a steward his own name and the companion's).
# Throw away whatever is waiting before asking anything.
_drain_stdin() {
    [[ -t 0 ]] || return 0
    local _junk
    while read -r -t 0 2>/dev/null; do
        read -r -t 0.2 _junk 2>/dev/null || break
    done
    return 0
}

# A question that makes a person — a name — gets a long countdown at a terminal (ten
# minutes, WYRDSEKAI_NAME_PROMPT_SECS to change it) with queued Enters cleared first, and
# the short one off a terminal so unattended installs still finish. The field report
# (2026-09-13): "the wizard moved too fast so we had to edit stuff afterwards" — and the
# edit afterwards upset the companion whose config was changed under her.
_prompt_wait() {
    local _text="$1" _fallback_secs="${2:-60}"
    if [[ -t 0 ]]; then
        _prompt_countdown "$_text" "${WYRDSEKAI_NAME_PROMPT_SECS:-600}"
    else
        _prompt_countdown "$_text" "$_fallback_secs"
    fi
}

_prompt_countdown() {
    local _text="$1" _left="${2:-30}"
    _PROMPT_REPLY=""
    [[ -t 0 ]] || return 0
    _drain_stdin
    # Draw on the terminal itself, not stdout. Setup output is routinely piped
    # (installer wrapper, sudo, curl|bash), and a \r redraw through a
    # line-buffered pipe never renders — the line freezes at "auto in 30s"
    # while the timer ticks invisibly and then auto-defaults, which reads as
    # a broken prompt (observed live, dev40 wipe install 2026-08-09). stdin
    # is a tty here (checked above), so /dev/tty exists; fall back to stdout
    # only if it somehow is not writable.
    local _out=/dev/tty
    [[ -w /dev/tty ]] || _out=/dev/stdout
    while (( _left > 0 )); do
        printf "\r%s (auto in %3ds) " "$_text" "$_left" > "$_out"
        if read -t 1 -r _PROMPT_REPLY; then break; fi
        _left=$((_left - 1))
    done
    echo "" > "$_out"
}

# Ensure Docker can pass the NVIDIA GPU into containers (SPEC: fresh GPU install).
# A GPU Linux box with Docker but WITHOUT the nvidia-container-toolkit fails to
# start the CUDA llama-server container — `docker compose up llama-server` errors,
# start_inference falls through to "No inference backend found", and the node
# comes up mute despite a perfectly good GPU. That is exactly the fresh-.deb gap
# second-node hit 2026-07-02 (RTX 5060 Ti present, models downloaded, but Docker had only
# the `runc` runtime). Best-effort + idempotent: no-op when there's no GPU/Docker
# or the runtime is already wired; installs the toolkit via apt when it can; prints
# manual steps when it can't (no sudo / no apt / offline).
_ensure_nvidia_container_runtime() {
    command -v nvidia-smi &>/dev/null || return 0
    _docker_daemon_present && docker info &>/dev/null 2>&1 || return 0
    # Already wired — Docker reports an nvidia runtime.
    docker info 2>/dev/null | grep -qi nvidia && return 0

    log "GPU detected but Docker has no NVIDIA runtime — enabling GPU container access…"
    if ! command -v sudo &>/dev/null || ! command -v apt-get &>/dev/null; then
        warn "Install the NVIDIA Container Toolkit so Docker can use the GPU:"
        warn "  https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html"
        warn "  then: sudo nvidia-ctk runtime configure --runtime=docker && sudo systemctl restart docker"
        return 1
    fi

    # Add the repo + install the toolkit if the CLI isn't already present.
    if ! command -v nvidia-ctk &>/dev/null; then
        local kr=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
        curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
            | sudo gpg --dearmor -o "$kr" 2>/dev/null
        curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
            | sed "s#deb https://#deb [signed-by=$kr] https://#g" \
            | sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list >/dev/null
        if ! { sudo apt-get update -qq && sudo apt-get install -y -qq nvidia-container-toolkit; }; then
            warn "NVIDIA Container Toolkit install failed (network / apt?). Inference will fall back."
            return 1
        fi
    fi

    # Register the runtime with Docker and restart the daemon.
    sudo nvidia-ctk runtime configure --runtime=docker >/dev/null 2>&1
    sudo systemctl restart docker
    local i=0
    while ! docker info &>/dev/null 2>&1 && [ $i -lt 15 ]; do sleep 1; i=$((i+1)); done
    if docker info 2>/dev/null | grep -qi nvidia; then
        log "NVIDIA Container Toolkit enabled — Docker can now use the GPU."
    else
        warn "nvidia runtime still not visible to Docker after install — check nvidia-ctk / driver."
        return 1
    fi
}

# One first-run flow at a time. `wyrd setup` sat at a prompt in one terminal while
# `wyrd start` in another saw "no env file" and ran setup again: two downloads of
# every model, two inits (field report 2026-09-13). The lock lives with the data
# dir; `wait` blocks on it, `nowait` refuses.
_take_setup_lock() {
    [[ "${_WYRD_SETUP_LOCKED:-0}" == "1" ]] && return 0
    command -v flock >/dev/null 2>&1 || return 0
    local f="$DATA_DIR/.setup.lock"
    mkdir -p "$DATA_DIR" 2>/dev/null || f=/tmp/wyrdsekai-setup.lock
    exec 9>"$f" 2>/dev/null || return 0
    if ! flock -n 9; then
        [[ "${1:-nowait}" == "wait" ]] || return 1
        warn "Another 'wyrd setup' or 'wyrd start' is running — waiting for it to finish."
        flock 9
    fi
    _WYRD_SETUP_LOCKED=1
    return 0
}

do_setup() {
    # Sub-dispatch: `wyrd setup <something>` may target a specific backend
    # rather than running the full first-run flow. Each sub-target owns its
    # own argv parsing.
    case "${1:-}" in
        openhands) shift; do_setup_openhands "$@"; return $? ;;
        openclaw)  shift; do_setup_openclaw "$@"; return $? ;;
        --help|-h) _setup_help; return 0 ;;
    esac
    if ! _take_setup_lock nowait; then
        err "Another 'wyrd setup' (or a 'wyrd start' running setup) is in progress — finish that one first."
        return 1
    fi

    # `--auto-yes` / `-y`: opt in to non-interactive, hardware-driven choices
    # for things that would otherwise just print a hint (e.g. embedding-model
    # upgrade on a fresh host). Setup stays read-only by default; auto-yes is
    # an explicit operator opt-in for unattended installs (CI, scripted setup).
    local auto_yes=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --auto-yes|-y) auto_yes=true; shift ;;
            *) shift ;;
        esac
    done

    echo ""
    echo "$(_t setup.banner.top)"
    echo "$(_t setup.banner.title)"
    echo "$(_t setup.banner.subtitle)"
    echo "$(_t setup.banner.bottom)"
    echo ""

    info "$(_t setup.mode "$MODE")"
    info "$(_t setup.data_dir "$DATA_DIR")"

    # Pre-flight writability guard (fixes the fresh-.deb "Permission denied"
    # mid-embedding-download bug). A system install keeps state under a
    # root-owned /var/lib/wyrdsekai; the .deb postinst normally chowns it to the
    # installing user so a non-root `wyrd setup` just works. If it's still
    # unwritable (a bare-root install, or a hand-moved dir), guide the operator
    # instead of failing cryptically several steps later on a curl write error.
    if [[ -d "$DATA_DIR" && ! -w "$DATA_DIR" && "${EUID:-0}" -ne 0 ]]; then
        err "setup can't write $DATA_DIR (it's owned by another user)."
        if command -v sudo >/dev/null 2>&1; then
            err "This looks like a system install — re-run as:  sudo wyrd setup"
        else
            err "Fix ownership first:  chown -R \"\$USER\" $DATA_DIR   then re-run: wyrd setup"
        fi
        return 1
    fi

    mkdir -p "$DATA_DIR" "$MODELS_DIR"

    # ── Profile config ──
    # Auto-create ~/.wyrdsekai/profile.toml on a fresh install. Idempotent
    # — skips if profile already exists. Picks a memorable zone name +
    # matching aesthetic theme via ZoneNameGenerator so a fresh node has
    # a distinct identity instead of a generic "home".
    local fresh_profile=false
    if [[ ! -f "${HOME}/.wyrdsekai/profile.toml" ]]; then
        info "$(_t setup.profile.creating)"
        do_config init || warn "$(_t setup.profile.init_failed)"
        fresh_profile=true
    fi

    # ── External-tool access policy (MCP grants) ──
    # Ask once, interactively: may companions use configured external tools
    # (web search, home controls, image generation, …) only after the steward
    # approves each one via the Study's Tool Warden, or freely? Default is LOCKED
    # (the server treats an unset WYRDSEKAI_MCP_STRICT_GRANTS as strict). The -z
    # guard means we only ask when it hasn't been set yet (never nags on re-run).
    # The household's own librarian needs no grant either way.
    # (i18n of this prompt is a follow-up — kept plain-English for now.)
    if [[ -t 0 ]] && [[ -z "${WYRDSEKAI_MCP_STRICT_GRANTS:-}" ]]; then
        echo
        echo "External tools (web search, home automation, image generation, …) reach"
        echo "outside your home. Who may use a configured tool?"
        echo "  1) Only after you approve it    — locked; you hand out keys in your Study (default)"
        echo "  2) Any companion, freely       — open"
        # Same live countdown as the other setup asks: empty reply (timeout
        # or bare enter) takes the default shown in the prompt text, so an
        # unattended install never hangs here.
        _prompt_countdown "Choose [1]:" 30
        local _mcp_choice="$_PROMPT_REPLY"
        if [[ "$_mcp_choice" == "2" ]]; then
            do_config set "WYRDSEKAI_MCP_STRICT_GRANTS=false" >/dev/null 2>&1 \
                && info "External tools open to your companions by default."
        else
            do_config set "WYRDSEKAI_MCP_STRICT_GRANTS=true" >/dev/null 2>&1 \
                && info "External tools locked to your approval. Approve later with:  use tool-warden op=grant agent=<name|everyone> service=<id>"
        fi
    fi

    # ── First-run LAN scan (Tier 3 discovery — piece 3) ──
    # On a fresh install, mDNS-browse for ~3s. If peers are found, surface
    # them and offer a one-line next step. Skips when interactive input isn't
    # available (CI, non-tty) or when the user already has a configured relay
    # (they're not joining; they're rejoining or hosting).
    if $fresh_profile && [[ -t 0 ]] && ! grep -q '^url = ' "${HOME}/.wyrdsekai/profile.toml" 2>/dev/null; then
        local lib_dir
        for d in /usr/local/wyrdsekai/lib/server /opt/wyrdsekai/lib/server \
                 "$PROJECT_ROOT/server/build/install/server/lib"; do
            [[ -d "$d" ]] && { lib_dir="$d"; break; }
        done
        if [[ -n "${lib_dir:-}" ]] && command -v java &>/dev/null; then
            echo
            info "$(_t setup.lan.scanning)"
            local lan_json
            lan_json=$(java -cp "$lib_dir/*" org.wyrdsekai.core.config.MdnsDiscoveryMain --json --timeout 3000 2>/dev/null)
            local peer_count
            peer_count=$(echo "$lan_json" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))" 2>/dev/null || echo 0)
            if [[ "$peer_count" -gt 0 ]]; then
                echo
                echo "$(_t setup.lan.found_header "$peer_count")"
                echo "$lan_json" | python3 -c "
import sys, json
for p in json.load(sys.stdin):
    hh = p.get('household', 'none')
    label = 'solo' if hh in ('none', '?', '') else hh
    gpu = ' +GPU' if p.get('inference') else ''
    print(f'    • {p.get(\"name\",\"?\"):20} ({label}){gpu}')
" 2>/dev/null
                echo

                # ── Auto-join offer (install → join → GPU-borrow in one step) ──
                # If a household hub (or a GPU-advertising peer) is on the LAN and
                # this node isn't already joined, offer to join it now so a CPU-only
                # box can immediately borrow a household peer's GPU. A GPU node may
                # join too (it forms/extends the household). Skips silently under
                # --auto-yes / CI (can't paste a key unattended); -t 0 already gates
                # the whole scan. Honours an existing off-box WYRDSEKAI_NATS_URL.
                local _already_joined=false
                case "${WYRDSEKAI_NATS_URL:-}" in
                    ""|nats://127.0.0.1:*|nats://localhost:*) ;;
                    *) _already_joined=true ;;
                esac
                local _hub=""
                if ! $auto_yes && ! $_already_joined; then
                    # Pick the best hub: prefer household+GPU, then GPU, then household.
                    _hub=$(echo "$lan_json" | python3 -c "
import sys, json
peers = json.load(sys.stdin)
def has_hh(p): return p.get('household','none') not in ('none','?','')
cands = [p for p in peers if has_hh(p) or p.get('inference')]
cands.sort(key=lambda p: (has_hh(p) and bool(p.get('inference')), bool(p.get('inference')), has_hh(p)), reverse=True)
if cands:
    p = cands[0]
    print('%s\t%s' % (p.get('name','?'), p.get('host','?')))
" 2>/dev/null)
                fi

                if [[ -n "$_hub" ]]; then
                    local _hub_name _hub_host
                    IFS=$'\t' read -r _hub_name _hub_host <<< "$_hub"
                    echo "$(_t setup.lan.join_offer "$_hub_name" "$_hub_host")"
                    local _ans=""
                    _drain_stdin; read -rp "$(_t setup.lan.join_prompt)" _ans || true
                    # Default-yes: Enter / y / yes proceeds; only an explicit n/no skips.
                    if [[ ! "$_ans" =~ ^[Nn][Oo]?$ ]]; then
                        local _hh_key=""
                        _drain_stdin; read -rp "$(_t setup.lan.join_key_prompt)" _hh_key || true
                        if [[ -n "$_hh_key" ]]; then
                            if do_join "$_hub_host" --household-key "$_hh_key"; then
                                log "$(_t setup.lan.join_ok "$_hub_name")"
                            else
                                warn "$(_t setup.lan.join_failed)"
                            fi
                        else
                            info "$(_t setup.lan.join_skipped)"
                        fi
                    else
                        info "$(_t setup.lan.join_skipped)"
                    fi
                else
                    info "$(_t setup.lan.join_hint)"
                    echo "$(_t setup.lan.join_cmd)"
                    info "$(_t setup.lan.token_note)"
                fi
            else
                info "$(_t setup.lan.solo)"
                info "$(_t setup.lan.invite_hint)"
            fi
            echo
        fi
    fi

    # ── Java ──
    if find_java; then
        local jver
        jver=$(${JAVA_CMD} -version 2>&1 | head -1)
        log "$(_t setup.java.found "$jver")"
    else
        err "$(_t setup.java.missing)"
        case "$(uname -s)" in
            Darwin) warn "$(_t setup.java.install_mac)" ;;
            Linux)  warn "$(_t setup.java.install_linux)" ;;
            *)      warn "$(_t setup.java.install_other)" ;;
        esac
        return 1
    fi

    # ── Hardware detection ──
    echo ""
    info "$(_t setup.hw.header)"
    local platform arch gpu_name ram_gb
    platform="$(uname -s)"
    arch="$(uname -m)"
    info "$(_t setup.hw.platform "$platform" "$arch")"

    # GPU
    gpu_name=""
    if command -v nvidia-smi &>/dev/null; then
        gpu_name=$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1)
        log "$(_t setup.hw.gpu_cuda "$gpu_name")"
    elif [[ "$platform" == "Darwin" && "$arch" == "arm64" ]]; then
        gpu_name="Apple Silicon"
        log "$(_t setup.hw.gpu_apple)"
    elif command -v rocm-smi &>/dev/null; then
        gpu_name="AMD ROCm"
        log "$(_t setup.hw.gpu_rocm)"
    else
        warn "$(_t setup.hw.gpu_none)"
    fi

    # RAM
    if [[ -f /proc/meminfo ]]; then
        ram_gb=$(awk '/MemTotal/ {printf "%.0f", $2/1024/1024}' /proc/meminfo)
    elif command -v sysctl &>/dev/null; then
        ram_gb=$(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%.0f", $1/1024/1024/1024}')
    else
        ram_gb=0
    fi
    info "$(_t setup.hw.ram "${ram_gb}")"

    # CPU flags + cores — surface to the user so the model recommendation is
    # explainable. AVX-512 (Rocket Lake / Ice Lake / AMD Zen4+) roughly doubles
    # llama.cpp CPU throughput vs AVX2 hosts.
    local _cpu_flags _cpu_cores _rec_model
    _cpu_flags=$(detect_cpu_flags)
    _cpu_cores=$(detect_cores)
    _rec_model=$(recommend_model)
    info "$(_t setup.hw.cpu "${_cpu_cores}" "${_cpu_flags:-$(_t setup.hw.cpu_no_flags)}")"
    log   "$(_t setup.hw.recommended_model "${_rec_model}")"

    # VRAM tier / OPEN-23. The tier picks the
    # drive-model architecture (3B Granite-Sub-v2 vs 9B V5) on top of the same
    # V10 4B voice. CPU-only hosts get the cpu-only fallback which uses the 4B
    # voice model as both voice and drive (no shared-seat distinction without
    # a GPU). Surfaced here so a fresh install sees the planned topology before
    # any GGUFs land on disk.
    local _vram_gb _tier
    _vram_gb=$(detect_total_vram_gb)
    _tier=$(recommend_tier)
    info "Total addressable VRAM: ${_vram_gb} GB"
    case "$_tier" in
        16gb-full)
            log "Recommended tier: 16GB-Full (V10 4B voice + V5 9B drive/πdev)"
            ;;
        8gb-companion)
            log "Recommended tier: 8GB-Companion (V10 4B voice + Granite-Sub-v2 3B drive/πdev)"
            ;;
        cpu-only)
            log "Recommended tier: CPU-only (V10 4B as voice+drive — no GPU detected)"
            ;;
    esac

    # Sparse-active (MoE) residency — a box whose GPU is too small for a
    # big dense model may still host a 32B-A9B-class sparse model with
    # attention on the GPU and experts in system RAM. Reference numbers:
    # ~19 GB total / ~6 GB active at Q4. Only surfaced when viable; a box
    # that can't do it hears nothing.
    if [[ "$_vram_gb" -gt 0 ]]; then
        local _ram_gb_moe _moe_plan
        _ram_gb_moe=$(detect_ram_gb)
        _moe_plan=$(plan_moe_residency 19 6 "$_vram_gb" "$_ram_gb_moe")
        case "$_moe_plan" in
            gpu-full)
                log "Sparse-model capable: a 32B-A9B-class MoE drive model fits fully on GPU" ;;
            cpu-moe)
                log "Sparse-model capable: a 32B-A9B-class MoE drive model runs with experts in system RAM (LLAMA_CPU_MOE=all — see CONFIGURATION.md)" ;;
            not-viable)
                : ;;
        esac
    fi

    # CodeZaiku integration check.
    #
    # CodeZaiku 0.1.0 SHIPPED on 2026-08-26, so the old reason for silence
    # here ("not released yet") no longer holds. The silence does: the
    # Lite → Full gattai migration is a RATIFIED DESIGN (§0.9.3 / §25.6,
    # Decision-D4) but it is still not implemented runtime-side — there is
    # no gattai or full.marker code in CodeZaiku's tree or in the released
    # artifact, only in the spec. Announcing "Lite detected, will migrate"
    # would promise a merge nothing performs.
    #
    # Re-check when CodeZaiku implements it; the trigger is a full.marker
    # appearing, which the branch below already handles.
    local _codezaiku
    _codezaiku=$(detect_codezaiku_mode)
    case "$_codezaiku" in
        full-installed)
            log "CodeZaiku Full already installed — gattai active"
            ;;
        lite-detected|none)
            : # silent — Lite stays untouched until CodeZaiku is released
            ;;
    esac

    # ── Download models ──
    echo ""
    info "$(_t setup.models.header)"

    # Embedding model — paraphrase-multilingual-MiniLM-L12-v2 (default), ~130MB total.
    # Three-tier resolution (matches the registry's fallback path in
    # EmbeddingService.createSession):
    #   1. already in $MODELS_DIR  → nothing to do
    #   2. bundled by .deb/.pkg under <prefix>/share/embedding-models/  → copy in
    #   3. HuggingFace download via curl  → last resort
    local embed_onnx="paraphrase-multilingual-MiniLM-L12-v2-q8.onnx"
    local embed_tok="paraphrase-multilingual-MiniLM-L12-v2-tokenizer.json"
    local embed_target="$MODELS_DIR/$embed_onnx"
    local tok_target="$MODELS_DIR/$embed_tok"

    # Resolve a packaged copy via the testable helper. Search order is:
    # /opt/wyrdsekai (.deb), /usr/local/wyrdsekai (.pkg), $PROJECT_ROOT/packaging
    # (source mode). Empty result means "not bundled — fall through to curl."
    local _emb_pkg
    _emb_pkg=$(_resolve_embedding_bundle "$embed_onnx" "$embed_tok")

    if [[ -f "$embed_target" && -f "$tok_target" ]]; then
        log "Embedding model already present at $MODELS_DIR"
    elif [[ -n "$_emb_pkg" ]]; then
        log "Installing bundled embedding model from $_emb_pkg"
        cp "$_emb_pkg/$embed_onnx" "$embed_target" \
            && cp "$_emb_pkg/$embed_tok" "$tok_target" \
            && log "Embedding model installed ($(du -sh "$embed_target" | cut -f1))" \
            || warn "Bundled-copy failed; will retry via download"
    fi

    if [[ ! -f "$embed_target" ]]; then
        log "Downloading embedding model from HuggingFace..."
        if _model_fetch embedding-paraphrase-l12 "$embed_target.part" \
            "https://wyrdsekai.org/models/paraphrase-multilingual-MiniLM-L12-v2-q8.onnx"; then
            mv "$embed_target.part" "$embed_target"
            _model_record "$embed_target" embedding-paraphrase-l12 "$(_index_field embedding-paraphrase-l12 version 2>/dev/null)" "${WYRD_FETCH_URL:-$(_index_field embedding-paraphrase-l12 url 2>/dev/null)}"
        else
            rm -f "$embed_target.part"
            warn "Embedding ONNX download failed — retrieval features will be disabled until \`wyrd embedding-model download paraphrase-l12\` succeeds"
        fi
    fi
    if [[ ! -f "$tok_target" ]]; then
        _download \
            "https://wyrdsekai.org/models/paraphrase-multilingual-MiniLM-L12-v2-tokenizer.json" \
            "$tok_target" 2>/dev/null \
            || warn "Embedding tokenizer download failed"
    fi

    # ── Embedding-model registry recommendation ──
    # paraphrase-l12 (384-d) is the default — installed above from the bundled
    # asset or curl. If the host has the headroom, surface a one-line offer to
    # upgrade to a higher-quality registered model (e5-base / bge-m3).
    # With --auto-yes on a fresh install, act on the recommendation directly
    # (download + set). On a host that already has embedded data we never
    # auto-swap — model swap requires migration and is the operator's call.
    # Skipped silently if Java classes aren't built yet (source mode, fresh
    # checkout) — the user can run `wyrd embedding-model recommend` later.
    if find_java &>/dev/null; then
        # Don't re-prompt if the operator already pinned a model.
        if [[ -z "${WYRDSEKAI_EMBEDDING_MODEL:-}" ]] \
           && [[ ! -f "$HOME/.wyrdsekai/embedding-model.txt" ]]; then
            local _emb_rec _active_id
            _emb_rec=$(do_embedding_model recommend 2>/dev/null \
                | awk -F': ' '/^Recommended/ {print $2}' \
                | awk '{print $1}')
            _active_id=$(do_embedding_model current 2>/dev/null | tail -1)
            if [[ -n "$_emb_rec" ]] && [[ "$_emb_rec" != "$_active_id" ]]; then
                # "Has data" sentinel: any Lucene index dir under DATA_DIR.
                # On a brand-new host these don't exist yet, so swap is safe.
                local _has_embeddings=false
                if compgen -G "$DATA_DIR/*-index" >/dev/null 2>&1 \
                   || compgen -G "$DATA_DIR/lucene*" >/dev/null 2>&1; then
                    _has_embeddings=true
                fi

                echo ""
                info "Embedding model: ${_active_id:-paraphrase-l12} active (bundled, 384-d)"
                info "Hardware suggests upgrading to '$_emb_rec' for higher-quality retrieval."

                if $auto_yes && ! $_has_embeddings; then
                    log "--auto-yes: downloading and activating '$_emb_rec'..."
                    if do_embedding_model download "$_emb_rec"; then
                        if do_embedding_model set "$_emb_rec" >/dev/null; then
                            log "Embedding model switched to '$_emb_rec'."
                        else
                            warn "Download succeeded but activation failed. Run \`wyrd embedding-model set $_emb_rec\` manually."
                        fi
                    else
                        warn "Download of '$_emb_rec' failed. Falling back to bundled default."
                    fi
                elif $auto_yes && $_has_embeddings; then
                    warn "Existing embedded data detected — refusing to auto-swap (would orphan vectors)."
                    info "To upgrade manually:"
                    info "  wyrd embedding-model download $_emb_rec"
                    info "  wyrd embedding-model set $_emb_rec"
                    info "  wyrd embed-migrate --run"
                elif ! $_has_embeddings && [[ -t 0 ]]; then
                    # Fresh install + interactive: ask, with a timeout so an
                    # unattended terminal still completes setup. Timeout keeps
                    # the bundled default (no surprise multi-GB download).
                    _prompt_countdown "  Download and activate '$_emb_rec' now? [y/N]" 30
                    if [[ "$_PROMPT_REPLY" =~ ^[Yy] ]]; then
                        log "Downloading and activating '$_emb_rec'..."
                        if do_embedding_model download "$_emb_rec"; then
                            if do_embedding_model set "$_emb_rec" >/dev/null; then
                                log "Embedding model switched to '$_emb_rec'."
                            else
                                warn "Download succeeded but activation failed. Run \`wyrd embedding-model set $_emb_rec\` manually."
                            fi
                        else
                            warn "Download of '$_emb_rec' failed. Falling back to bundled default."
                        fi
                    else
                        info "Keeping bundled default. Upgrade any time:"
                        info "  wyrd embedding-model download $_emb_rec && wyrd embedding-model set $_emb_rec"
                    fi
                else
                    info "Run \`wyrd embedding-model download $_emb_rec\` then \`wyrd embedding-model set $_emb_rec\` to switch."
                    info "(After switching, re-embed stored vectors with \`wyrd embed-migrate --run\`.)"
                    info "Or re-run \`wyrd setup --auto-yes\` to apply the recommendation automatically (fresh install only)."
                fi
            fi
        fi
    fi

    # Legacy filename migration (2026-07-09): pre-versioning installs used unversioned /
    # renamed-on-download filenames. Move them to the canonical versioned names so the
    # presence checks below (and the manifest) line up; bytes are identical.
    local _pair _old _new
    for _pair in \
        "wyrdsekai-3.5-4b-ssd-q4km.gguf:wyrdsekai-3.5-4b-v10-q4km.gguf" \
        "wyrdsekai-3.5-9b-drive-q4km.gguf:wyrdsekai-3.5-9b-drive-v6-q4km.gguf"; do
        _old="${_pair%%:*}"; _new="${_pair##*:}"
        if [[ -f "$MODELS_DIR/$_old" && ! -f "$MODELS_DIR/$_new" ]]; then
            mv "$MODELS_DIR/$_old" "$MODELS_DIR/$_new"
            log "Migrated model filename: $_old → $_new"
        fi
    done

    # Companion model (Qwen3.5-4B SSD GGUF, ~2.6GB)
    # Downloaded via a .part temp so an interrupted pull (ctrl-C mid-setup)
    # never leaves a truncated GGUF that a re-run mistakes for complete.
    local companion_model="$MODELS_DIR/wyrdsekai-3.5-4b-v10-q4km.gguf"
    # What MODEL_PATH will name. On a dual-model host this MUST be the DRIVE
    # model: writing the 4B here made the server's "already served" redirect
    # point the priority-5 drive slot at the VOICE port, and the household
    # node ran both backends on the 4B for five weeks (2026-07-30 → 09-02)
    # while the 9B on :8200 served nothing.
    local drive_model_path="$companion_model"
    if [[ ! -f "$companion_model" ]]; then
        log "$(_t setup.models.companion_downloading)"
        if _model_fetch companion-4b "$companion_model.part" \
            "https://wyrdsekai.org/models/wyrdsekai-3.5-4b-v10-q4km.gguf"; then
            mv "$companion_model.part" "$companion_model"
            _model_record "$companion_model" companion-4b "$(_index_field companion-4b version 2>/dev/null)" "${WYRD_FETCH_URL:-$(_index_field companion-4b url 2>/dev/null)}"
        else
            log "$(_t setup.models.companion_fallback)"
            if _download \
                "https://huggingface.co/unsloth/Qwen3.5-4B-GGUF/resolve/main/Qwen3.5-4B-Q4_K_M.gguf" \
                "$companion_model.part"; then
                mv "$companion_model.part" "$companion_model"
            else
                rm -f "$companion_model.part"
                warn "$(_t setup.models.companion_failed "$companion_model")"
            fi
        fi
    else
        log "$(_t setup.models.companion_present)"
    fi

    # Embedding model (bge-m3 GGUF, ~630MB) — GPU tiers, for the served embedder
    # on :8202. Downloaded via a .part temp like the brains.
    if [[ "$(recommend_tier)" != "cpu-only" ]]; then
        local embed_model="$MODELS_DIR/${LLAMA_EMBED_MODEL:-bge-m3-Q8_0.gguf}"
        if [[ ! -f "$embed_model" ]]; then
            log "$(_t setup.models.embedserver_downloading)"
            if _download \
                "https://huggingface.co/gpustack/bge-m3-GGUF/resolve/main/bge-m3-Q8_0.gguf" \
                "$embed_model.part"; then
                mv "$embed_model.part" "$embed_model"
            else
                rm -f "$embed_model.part"
                warn "$(_t setup.models.embedserver_failed "$embed_model")"
            fi
        else
            log "$(_t setup.models.embedserver_present)"
        fi
    fi

    # Which server serves them. TEI keeps the whole batch on the card and embeds several
    # times faster than llama-server for the same model; it needs the NVIDIA container
    # runtime, and fetches the model on first start. Offered on NVIDIA tiers, default yes.
    WYRD_SETUP_EMBED_SERVER="${WYRD_SETUP_EMBED_SERVER:-}"
    if [[ -z "$WYRD_SETUP_EMBED_SERVER" && "$(recommend_tier)" != "cpu-only" ]] && docker info --format '{{.Runtimes}}' 2>/dev/null | grep -q nvidia; then
        local _tei_default="Y" _tei_ans="y"
        if [[ -t 0 ]]; then _drain_stdin; read -r -p "Serve embeddings with Text Embeddings Inference (image $(_tei_tag); several times faster than llama-server on this card)? [Y/n] " _tei_ans || true; fi
        [[ -z "$_tei_ans" ]] && _tei_ans="$_tei_default"
        if [[ "$_tei_ans" =~ ^[Yy] ]]; then WYRD_SETUP_EMBED_SERVER=tei; log "Embedding server: Text Embeddings Inference (WYRDSEKAI_EMBED_SERVER=tei)"; else WYRD_SETUP_EMBED_SERVER=llama; fi
    fi

    # Drive model (9B, ~5.3GB) — 16GB-tier hosts only. Smaller tiers run the
    # 4B (or Granite-Sub-v2) as drive per tier_drive_model. Downloaded via a
    # .part temp so an interrupted pull never leaves a truncated GGUF that a
    # re-run would mistake for complete.
    if [[ "$(recommend_tier)" == "16gb-full" ]]; then
        local drive_model="$MODELS_DIR/wyrdsekai-3.5-9b-drive-v6-q4km.gguf"
        if [[ ! -f "$drive_model" ]]; then
            log "$(_t setup.models.drive_downloading)"
            if _model_fetch drive-9b "$drive_model.part" \
                "https://wyrdsekai.org/models/wyrdsekai-3.5-9b-drive-v6-q4km.gguf"; then
                mv "$drive_model.part" "$drive_model"
                _model_record "$drive_model" drive-9b "$(_index_field drive-9b version 2>/dev/null)" "${WYRD_FETCH_URL:-$(_index_field drive-9b url 2>/dev/null)}"
            else
                rm -f "$drive_model.part"
                warn "$(_t setup.models.drive_failed "$drive_model")"
            fi
        else
            log "$(_t setup.models.drive_present)"
        fi
        [[ -f "$drive_model" ]] && drive_model_path="$drive_model"
    fi
    # Every tier with a separate drive server names ITS drive model here
    # (8gb-companion runs the granite drive on :8200; cpu-only has one model).
    local tier_drive_file="$MODELS_DIR/$(tier_drive_model "$(recommend_tier)")"
    [[ -f "$tier_drive_file" ]] && drive_model_path="$tier_drive_file"

    # pull the MLX voice base on Darwin
    # when the mlx-venv is present (the .pkg postinstall bootstrap landed
    # it). Skipped on Linux + on macOS hosts that haven't bootstrapped MLX
    # yet; in both cases the Phase 3 fallback resolves to llama-server.
    # The repo URL is the Phase 6 target — until that's published the pull
    # 404s and the steward stays on the legacy training-mlx-q4-correct
    # path in $HOME/.wyrdsekai/ (Phase 1 mirror).
    if [[ "$platform" == "Darwin" && "$arch" == "arm64" ]]; then
        local mlx_base_dir="$MODELS_DIR/mlx/qwen3-5-4b-v10-mlx-4bit"
        local mlx_py=""
        for p in "$DATA_DIR/mlx-venv/bin/python" \
                 "/usr/local/wyrdsekai/mlx-venv/bin/python" \
                 "$HOME/.wyrdsekai/mlx-venv/bin/python"; do
            [[ -x "$p" ]] && { mlx_py="$p"; break; }
        done
        if [[ -n "$mlx_py" ]]; then
            if [[ ! -f "$mlx_base_dir/config.json" ]]; then
                # Phase 6: try the wyrdsekai-org pinned repo first (provenance +
                # versioning), then fall back to the mlx-community upload
                # (Phase 1 verified end-to-end). Both are MLX-4bit conversions
                # of the same Qwen3.5-4B BF16 base — interchangeable for
                # voice-runtime purposes. WYRDSEKAI_MLX_BASE_REPO overrides
                # both for stewards who want a custom upstream.
                local mlx_primary="${WYRDSEKAI_MLX_BASE_REPO:-wyrdsekai/companion-3.5-4b-mlx}"
                local mlx_fallback="mlx-community/Qwen3.5-4B-MLX-4bit"
                local mlx_pulled=""
                for mlx_repo in "$mlx_primary" "$mlx_fallback"; do
                    [[ -z "$mlx_repo" ]] && continue
                    [[ "$mlx_repo" == "$mlx_pulled" ]] && continue
                    log "Pulling MLX voice base from $mlx_repo (~2.7GB)..."
                    mkdir -p "$mlx_base_dir"
                    if "$mlx_py" -c "
from huggingface_hub import snapshot_download
import sys
try:
    snapshot_download('$mlx_repo', local_dir='$mlx_base_dir',
        allow_patterns=['*.safetensors*','*.json','tokenizer*','*.jinja'])
except Exception as e:
    print(f'pull failed: {e}', file=sys.stderr)
    sys.exit(2)
" 2>&1; then
                        log "MLX voice base ready at $mlx_base_dir (from $mlx_repo)"
                        mlx_pulled="$mlx_repo"
                        break
                    else
                        warn "Pull from $mlx_repo failed; trying next source..."
                    fi
                done
                if [[ -z "$mlx_pulled" ]]; then
                    warn "MLX voice base pull failed from all sources."
                    warn "Voice runtime will use the legacy Phase 1 mirror under \$HOME/.wyrdsekai/ if present, or fall back to llama-server + V8 GGUF vectors."
                fi
            else
                log "MLX voice base already present at $mlx_base_dir"
            fi
        fi
    fi

    # ── Inference backend ──
    echo ""
    info "$(_t setup.inference.header)"

    if [[ "$platform" == "Darwin" && "$arch" == "arm64" ]]; then
        # macOS Apple Silicon — use llama-server via Homebrew
        # Find brew in standard locations
        local brew_cmd=""
        if command -v brew &>/dev/null; then brew_cmd="brew"
        elif [[ -x /opt/homebrew/bin/brew ]]; then brew_cmd="/opt/homebrew/bin/brew"
        elif [[ -x /usr/local/bin/brew ]]; then brew_cmd="/usr/local/bin/brew"
        fi

        # Find llama-server
        local llama_cmd=""
        if command -v llama-server &>/dev/null; then llama_cmd="llama-server"
        elif [[ -x /opt/homebrew/bin/llama-server ]]; then llama_cmd="/opt/homebrew/bin/llama-server"
        fi

        if [[ -n "$llama_cmd" ]]; then
            log "$(_t setup.inference.llama_present "$($llama_cmd --version 2>&1 | head -1 || echo '?')")"
        else
            # MLX is the PRIMARY inference engine on Apple Silicon (the dual-MLX
            # drive+voice stack on :8200/:8201). llama.cpp is only an OPTIONAL
            # GGUF fallback here, so we do NOT auto-install it — auto-installing
            # kept silently re-adding a Homebrew dependency a clean MLX-only
            # install never uses, and start_inference no longer requires
            # llama-server. Opt in to the fallback with:  brew install llama.cpp
            log "macOS Apple Silicon: MLX inference (llama.cpp is an optional fallback — not installed)"
        fi
    elif command -v nvidia-smi &>/dev/null || command -v rocm-smi &>/dev/null; then
        # Linux with GPU — llama-server via Docker. Do NOT compose-up here:
        # this branch used to start llama-server directly from
        # docker/docker-compose.yml (whose committed .env pins a stale model
        # name + mounts the source-tree zoo), racing ahead of the
        # start_inference call at the end of setup — which then saw
        # "already running" and skipped its canonical-name resolution. A
        # fresh install ended up serving the wrong file (or FNF-looping
        # without a zoo). start_inference below is the single launch path.
        if _docker_daemon_present && docker info &>/dev/null 2>&1; then
            # Ensure Docker can actually reach the GPU before we rely on the
            # CUDA llama-server container (else it fails → node comes up mute).
            _ensure_nvidia_container_runtime
            log "$(_t setup.inference.docker_gpu_starting)"
        else
            warn "$(_t setup.inference.docker_unavailable_gpu)"
        fi
    else
        # CPU-only. Priority order:
        #   1. Bundled llama-server from .deb install (/opt/wyrdsekai/bin/llama-server)
        #   2. Docker llama-server
        #   3. Print the `wyrd inference remote ...` suggestion for nodes that
        #      should delegate to a neighbor via HTTP or via NATS relay.
        if [[ -x /opt/wyrdsekai/bin/llama-server ]]; then
            log "$(_t setup.inference.bundled_found)"
        elif _docker_daemon_present && docker info &>/dev/null 2>&1; then
            log "$(_t setup.inference.docker_cpu_starting)"
        else
            warn "$(_t setup.inference.no_backend_1)"
            warn "$(_t setup.inference.no_backend_options)"
            warn "$(_t setup.inference.no_backend_opt1)"
            warn "$(_t setup.inference.no_backend_opt2)"
            warn "$(_t setup.inference.no_backend_opt3)"
        fi
    fi

    # ── Container runtime detection ──
    echo ""
    info "$(_t setup.container.header)"
    local container_cmd=""
    if _docker_daemon_present && docker info &>/dev/null 2>&1; then
        container_cmd="docker"
        log "$(_t setup.container.docker "$(docker --version | head -1)")"
    elif command -v podman &>/dev/null; then
        container_cmd="podman"
        log "$(_t setup.container.podman "$(podman --version)")"
    else
        # Try installing podman + podman-compose
        if [[ "$platform" == "Linux" ]] && command -v apt-get &>/dev/null; then
            log "$(_t setup.container.installing_podman)"
            sudo apt-get install -y -qq podman podman-compose 2>/dev/null \
                && container_cmd="podman" && log "$(_t setup.container.podman_installed)" \
                || warn "$(_t setup.container.podman_failed)"
        fi
        if [[ -z "$container_cmd" ]]; then
            warn "$(_t setup.container.none)"
        fi
    fi

    # ── NATS ──
    echo ""
    info "$(_t setup.nats.header)"
    if [[ -n "$container_cmd" ]]; then
        # Docker/Podman path
        local compose_cmd=""
        if [[ "$container_cmd" == "docker" ]]; then
            compose_cmd="docker compose"
        elif command -v podman-compose &>/dev/null; then
            compose_cmd="podman-compose"
        elif command -v podman &>/dev/null; then
            compose_cmd="podman compose"
        fi
    fi

    # Check if NATS is already running (any method)
    if pgrep -x nats-server &>/dev/null; then
        log "$(_t setup.nats.running_pid "$(pgrep -x nats-server | head -1)")"
    elif [[ -n "$container_cmd" ]] && $container_cmd ps --format '{{.Names}}' 2>/dev/null | grep -q nats; then
        log "$(_t setup.nats.running_container)"
    elif [[ -x "/opt/wyrdsekai/bin/nats-server" ]]; then
        log "$(_t setup.nats.bundled_found)"
    elif command -v nats-server &>/dev/null; then
        log "$(_t setup.nats.system_found)"
    else
        warn "$(_t setup.nats.missing)"
    fi

    # ── Web Search ──
    echo ""
    info "$(_t setup.search.header)"
    if [[ -n "$container_cmd" ]]; then
        # Docker/Podman → Searxng
        if $container_cmd ps --format '{{.Names}}' 2>/dev/null | grep -q searxng; then
            log "$(_t setup.search.searxng_running)"
        else
            local compose_file=""
            for f in "$PROJECT_ROOT/docker-compose.yml" "$PROJECT_ROOT/docker/docker-compose.yml"; do
                if [[ -f "$f" ]]; then compose_file="$f"; break; fi
            done
            if [[ -n "$compose_file" ]]; then
                local compose_dir="$(dirname "$compose_file")"
                cd "$compose_dir"
                log "$(_t setup.search.searxng_starting "$container_cmd")"
                local searxng_ok=false
                if [[ "$container_cmd" == "docker" ]]; then
                    docker compose up -d searxng 2>/dev/null && searxng_ok=true
                elif command -v podman-compose &>/dev/null; then
                    podman-compose up -d searxng 2>/dev/null && searxng_ok=true
                fi
                if $searxng_ok; then
                    log "$(_t setup.search.searxng_started)"
                fi
                cd "$PROJECT_ROOT"
            fi
        fi
    fi

    # If Searxng isn't running, try metasearch as fallback
    local searxng_running=false
    if [[ -n "$container_cmd" ]]; then
        $container_cmd ps --format '{{.Names}}' 2>/dev/null | grep -q searxng && searxng_running=true
    fi
    if ! $searxng_running; then
        if [[ -x "/opt/wyrdsekai/bin/metasearch" ]] || command -v metasearch &>/dev/null; then
            log "$(_t setup.search.metasearch_bundled)"
        else
            warn "$(_t setup.search.fallback_only)"
        fi
    fi

    # (Legacy Docker services section removed — handled by container runtime detection above)

    # ── Start inference backend ──
    # Mode-aware (WYRDSEKAI_INFERENCE_MODE): GUI onboarding may have already
    # written mode=cloud into the conf before setup runs — honor it.
    echo ""
    info "$(_t setup.start_inference)"
    # The DRIVE model, not the companion/voice one. Passing $companion_model
    # here started :8200 with the 4B on a 16GB Mac that had just downloaded
    # the 9B (first-install test, 2026-09-02) — the same disease as the
    # Linux MODEL_PATH redirect, on a different branch.
    maybe_start_inference "$drive_model_path"

    # ── Generate env config ──
    if [[ ! -f "$ENV_FILE" ]]; then
        echo ""
        log "$(_t setup.config.generating "$ENV_FILE")"
        # Detect LAN IP for Between mesh
        local lan_ip
        lan_ip=$(ip -4 route get 1 2>/dev/null | awk '{print $7; exit}' || \
                 ifconfig 2>/dev/null | grep 'inet ' | grep -v 127.0.0.1 | awk '{print $2}' | head -1 || \
                 echo "127.0.0.1")
        # Package mode: NATS managed by systemd, don't auto-start from Java
        local NATS_AUTO_START_VALUE="true"
        if [[ "$MODE" == "package" ]]; then
            NATS_AUTO_START_VALUE="false"
        fi

        # Dual-inference voice backend (:8201) — GPU tiers run the 4B voice
        # alongside the drive. start_inference launches the container; this
        # env makes the SERVER register the backend (application.conf gates
        # llama-voice on WYRDSEKAI_VOICE_ENABLED). Without it a fresh node
        # comes up with 1 backend and no voice pass.
        local voice_env_lines=""
        if [[ "$(recommend_tier)" != "cpu-only" ]]; then
            voice_env_lines=$'WYRDSEKAI_VOICE_ENABLED=true\nWYRDSEKAI_VOICE_URL=http://127.0.0.1:8201'
        fi
        # The drive server's URL, explicit, on dual-model hosts — so the server
        # never has to guess which of :8200/:8201 is the drive.
        local drive_env_lines=""
        if [[ "$(recommend_tier)" != "cpu-only" ]]; then
            drive_env_lines='WYRDSEKAI_LLAMA_URL=http://127.0.0.1:8200'
        fi
        # Served embedder (:8202, bge-m3 via llama.cpp) on GPU tiers. Index-time
        # and query-time embeddings come from the same server; the vectors are
        # stamped "<model>+server" so they never mix with in-process ones.
        local embed_env_lines=""
        if [[ "$(recommend_tier)" != "cpu-only" ]] && { [[ -f "$MODELS_DIR/${LLAMA_EMBED_MODEL:-bge-m3-Q8_0.gguf}" ]] || [[ "${WYRD_SETUP_EMBED_SERVER:-}" == "tei" ]]; }; then
            embed_env_lines=$'WYRDSEKAI_EMBEDDING_MODEL=bge-m3\nWYRDSEKAI_EMBEDDING_URL=http://127.0.0.1:8202'
            [[ "${WYRD_SETUP_EMBED_SERVER:-}" == "tei" ]] && embed_env_lines+=$'\nWYRDSEKAI_EMBED_SERVER=tei'
        fi

        # Household inference auto-share: a node with a
        # local accelerator offers it to household members by default; a CPU-only
        # box has nothing worth sharing. Borrow stays on by default everywhere, so a
        # CPU node auto-prefers a household peer's GPU once it joins the household.
        local household_share_value="false"
        if [[ "$(recommend_tier)" != "cpu-only" ]]; then
            household_share_value="true"
        fi

        # Resolve the node id HERE rather than deferring `$(hostname -s)` into the
        # file. $ENV_FILE is sourced by bash, so a deferred substitution works —
        # but this file's contents get carried into the systemd EnvironmentFile
        # below, and systemd does NO command substitution: the literal string
        # `$(hostname -s 2>/dev/null || echo "node")` became the node id, and
        # Pekko rejected it ("contains [|] which is a reserved character"),
        # killing Main before the HTTP listener bound. The symptom was
        # "Server started (pid N) but port 7070 not yet responding" with both
        # units reported active (second-node/home-server, 2026-07-29).
        #
        # Values in this file must be literals. Anything that needs computing is
        # computed by setup, never deferred.
        local node_id
        node_id=$(hostname -s 2>/dev/null || echo "node")
        [[ -n "$node_id" ]] || node_id="node"

        cat > "$ENV_FILE" << ENVEOF
# Wyrdsekai configuration — generated by 'wyrd setup'

# Inference — llama-server is the default backend
WYRDSEKAI_LLAMA_ENABLED=true
WYRDSEKAI_MODEL_PATH=$drive_model_path
${drive_env_lines}
WYRDSEKAI_INFERENCE_TIMEOUT=300
WYRDSEKAI_INFERENCE_CONCURRENCY=1
${voice_env_lines}
${embed_env_lines}

# Household inference auto-share (offer local GPU to household / borrow a household GPU)
WYRDSEKAI_INFERENCE_HOUSEHOLD_SHARE=$household_share_value
WYRDSEKAI_INFERENCE_HOUSEHOLD_BORROW=true

# Search
WYRDSEKAI_SEARXNG_URL=http://localhost:8888

# Oracle (optional)
ORACLE_URL=http://localhost:7073

# Data
WYRDSEKAI_DATA_DIR=$DATA_DIR

# Between mesh — always on. Single-node runs NATS locally with zero overhead.
# When other nodes join the network, the mesh forms automatically via mDNS.
# To join an existing household: set WYRDSEKAI_NATS_URL to the first node's IP.
WYRDSEKAI_BETWEEN_ENABLED=true
WYRDSEKAI_NODE_ID=$node_id
WYRDSEKAI_NATS_URL=nats://127.0.0.1:4222
WYRDSEKAI_NATS_AUTO_START=${NATS_AUTO_START_VALUE}
ENVEOF
    else
        log "$(_t setup.config.exists "$ENV_FILE")"
    fi

    # ── Package mode: the SERVICE reads /etc/wyrdsekai/wyrdsekai.conf, nothing else ──
    # The systemd unit carries a SINGLE-CANONICAL-CONF invariant and deliberately
    # has no second EnvironmentFile. So everything written above into $ENV_FILE is
    # inert for the running service: an operator who edits the file setup just
    # told them about sees no effect, which is precisely the "competing conf
    # files" split the invariant exists to prevent. (Found the hard way: editing
    # $ENV_FILE to move NATS off a clashing port changed nothing.)
    #
    # Carry over only the keys the canonical conf does not already define — an
    # operator's existing choice always wins, and re-running setup stays
    # idempotent.
    if [[ "$MODE" == "package" && -f "$CANONICAL_CONF" ]]; then
        if [[ -w "$CANONICAL_CONF" ]] || [[ "${EUID:-0}" -eq 0 ]]; then
            _repair_canonical_conf
            if [[ -f "$ENV_FILE" ]]; then
                local _added=0 _line _key _val
                while IFS= read -r _line; do
                    case "$_line" in
                        ''|'#'*) continue ;;
                        *=*) _key="${_line%%=*}"; _val="${_line#*=}" ;;
                        *) continue ;;
                    esac
                    # $ENV_FILE is SOURCED BY BASH; $CANONICAL_CONF is parsed by
                    # systemd, which performs no command substitution. Copying a
                    # deferred `$(...)` across the boundary hands the service the
                    # literal text as a value.
                    if _has_deferred_substitution "$_val"; then
                        _val=$(_resolve_deferred_value "$_val") || _val=""
                        if [[ -z "$_val" ]]; then
                            warn "$(_t setup.config.canonical_unresolved "$_key")"
                            continue
                        fi
                        _line="${_key}=${_val}"
                    fi
                    if ! grep -qE "^[[:space:]]*${_key}=" "$CANONICAL_CONF" 2>/dev/null; then
                        if [[ $_added -eq 0 ]]; then
                            printf '\n# Added by `wyrd setup` — the service reads THIS file only.\n' \
                                >> "$CANONICAL_CONF"
                            _added=1
                        fi
                        printf '%s\n' "$_line" >> "$CANONICAL_CONF"
                        _added=$((_added + 1))
                    fi
                done < "$ENV_FILE"
                if [[ $_added -gt 0 ]]; then
                    log "$(_t setup.config.canonical_merged "$((_added - 1))" "$CANONICAL_CONF")"
                fi
            fi
        else
            warn "$(_t setup.config.canonical_unwritable "$CANONICAL_CONF")"
        fi
    fi

    # ── Build (source mode only) ──
    if [[ "$MODE" == "source" ]]; then
        echo ""
        log "$(_t setup.build.building)"
        cd "$PROJECT_ROOT"
        ./gradlew :server:installDist --quiet 2>&1 || warn "$(_t setup.build.failed)"
        log "$(_t setup.build.complete)"
    fi

    # ── Coding CLI: auto-install goose ──
    # Goose is the default coding backend for recipe self-evolution; it is
    # NOT bundled in the .pkg/.deb because of platform-specific binaries +
    # 80MB size. Without it, every recipe dispatch fails ("goose not on
    # PATH"). Fail-soft: warn but don't abort setup if the download fails.
    # Skipped when WYRDSEKAI_SKIP_GOOSE_INSTALL=1 (CI / air-gap).
    if [[ "${WYRDSEKAI_SKIP_GOOSE_INSTALL:-0}" != "1" ]]; then
        local goose_dir="$DATA_DIR/coding-cli-bundle/goose"
        if command -v goose >/dev/null 2>&1 || [[ -d "$goose_dir" ]]; then
            log "$(_t setup.coding.goose_already_present)"
        else
            echo ""
            log "$(_t setup.coding.installing_goose)"
            if do_coding install goose 2>&1; then
                log "$(_t setup.coding.goose_installed)"
            else
                warn "$(_t setup.coding.goose_failed)"
            fi
        fi
        # Daemons started by launchd / systemd inherit a minimal PATH that
        # doesn't include the bundle dir. Symlink into /usr/local/bin so the
        # in-process `goose` ProcessBuilder lookup resolves. Best-effort:
        # silently skip if /usr/local/bin isn't writable. Discovered
        # 2026-05-27 on mac-node — GooseBackend was wired but goose exec
        # failed in 22ms because the bundle path wasn't on launchd PATH.
        if [[ -x "$goose_dir/goose" ]] && [[ ! -e /usr/local/bin/goose ]] \
                && [[ -w /usr/local/bin || $EUID -eq 0 ]]; then
            ln -sf "$goose_dir/goose" /usr/local/bin/goose 2>/dev/null || true
        fi
    fi

    # ── Recipe Python venv bootstrap ( #1089) ──
    # Recipes that retrain classifier heads shell out to
    # scripts/classifier/*.py which need sklearn + onnx + skl2onnx. Build
    # a dedicated venv at $DATA_DIR/.venv-recipes/ so recipe SHELL/BACKEND
    # steps can `python3 scripts/classifier/...` without polluting system
    # site-packages. Skip when WYRDSEKAI_SKIP_VENV=1 (CI / air-gap).
    #
    # Recipe scripts use `#!/usr/bin/env python3` shebang — they pick up
    # the venv when its bin/ is first on PATH. The systemd unit / macOS
    # plist gets the PATH prepend wired separately; for `wyrd setup` and
    # CLI-driven recipe runs we just create the venv (PATH wiring is the
    # daemon-restart step's job, not this one).
    if [[ "${WYRDSEKAI_SKIP_VENV:-0}" != "1" ]] \
        && command -v python3 >/dev/null 2>&1; then
        local recipe_venv="$DATA_DIR/.venv-recipes"
        local marker="$recipe_venv/.wyrd-recipes-installed"
        if [[ -f "$marker" ]]; then
            log "$(_t setup.recipes.venv_already_present)"
        else
            echo ""
            log "$(_t setup.recipes.creating_venv)"
            if python3 -m venv "$recipe_venv" 2>&1; then
                # Use the venv's own pip; --quiet keeps setup output tractable.
                "$recipe_venv/bin/pip" install --quiet --upgrade pip 2>&1 || true
                # ml-dtypes>=0.5 is load-bearing: onnx 1.18+ imports
                # ml_dtypes.float4_e2m1fn which only exists at 0.5+. The pip
                # solver under numpy<2 otherwise picks ml-dtypes 0.4.x and
                # the recipe `train` step ImportErrors. Discovered 2026-05-27
                # on mac-node.
                # numpy<2 ships no wheels for Python ≥3.13, so the 1.x pin
                # forces a doomed sdist build there ("Cannot import
                # setuptools.build_meta"). 3.13+ gets numpy 2.x — supported
                # by every dep below; older interpreters keep the proven 1.x
                # pin (discovered 2026-06-10 on home-server's fresh py3.13 install).
                local _np_pin='numpy<2'
                if "$recipe_venv/bin/python" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3,13) else 1)' 2>/dev/null; then
                    _np_pin='numpy>=2.1'
                fi
                # transformers MUST stay <5: the v5 AutoTokenizer/
                # TokenizersBackend rework tokenizes differently enough that
                # embeddings land on a different manifold than the bundled
                # setfit encoder + pretrained heads (trained under 4.x) and
                # than the Java runtime (tokenizer.json direct). Measured
                # 2026-07-01 on home-server: identical head + encoder + anchors,
                # transformers 5.12 → 32/90 overrouting-anchor misses,
                # 4.57 → 0/90. An unpinned venv silently fails the
                # retrain-classifier-head regression gate on every fresh
                # install. (tokenizers itself was 0.22.2 in both — the skew
                # is in the transformers wrapper, not the tokenizer core.)
                if "$recipe_venv/bin/pip" install --quiet \
                    "$_np_pin" \
                    'ml-dtypes>=0.5' \
                    'scikit-learn>=1.5' \
                    'onnx>=1.18' \
                    'onnxruntime>=1.20' \
                    'skl2onnx>=1.18' \
                    'transformers>=4.40,<5' 2>&1; then
                    date -u +%Y-%m-%dT%H:%M:%SZ > "$marker"
                    log "$(_t setup.recipes.venv_installed)"
                else
                    warn "$(_t setup.recipes.venv_failed)"
                fi
            else
                warn "$(_t setup.recipes.venv_failed)"
            fi
        fi
    fi

    # ── Oracle prediction-engine bootstrap + start ──
    # Make the Oracle forecasting sidecar available on native installs (not
    # just Docker): install the bundled oracle-core wheel into a dedicated
    # venv and launch it on :$ORACLE_PORT. The Java zone auto-connects when it
    # health-probes OK. Opt out with WYRDSEKAI_SKIP_ORACLE=1.
    bootstrap_oracle
    start_oracle || true

    # ── Starter Library ──
    # One-keystroke, locale-aware choice; default YES when interactive, skipped when
    # unattended/air-gapped. The choice is recorded in the env file and honored by the
    # server on first boot (StarterLibraryInstaller) — setup itself downloads nothing.
    if [[ -t 0 ]] && ! grep -q '^WYRDSEKAI_LIBRARY_STARTER=' "$ENV_FILE" 2>/dev/null; then
        echo ""
        echo "$(_t setup.library.title)"
        echo "$(_t setup.library.detail)"
        local lib_reply=""
        # Countdown default = Y (matches the [Y/n] display); non-tty stdin
        # keeps the old conservative "n" so headless runs don't enqueue
        # network downloads nobody asked for.
        local lib_reply="n"
        if [[ -t 0 ]]; then
            _prompt_countdown "$(_t setup.library.prompt) [Y/n]" 30
            lib_reply="$_PROMPT_REPLY"
        fi
        if [[ ! "$lib_reply" =~ ^[NnＮｎ] ]]; then
            {
                echo "WYRDSEKAI_LIBRARY_STARTER=true"
                echo "WYRDSEKAI_LIBRARY_LANGS=$WYRD_LOCALE"
            } >> "$ENV_FILE"
            log "$(_t setup.library.enabled)"
        else
            echo "WYRDSEKAI_LIBRARY_STARTER=false" >> "$ENV_FILE"
            echo "$(_t setup.library.skipped)"
        fi
    fi

    echo ""
    echo "$(_t setup.complete.divider)"
    log "$(_t setup.complete.title)"
    echo ""
    echo "$(_t setup.complete.start)"
    echo "$(_t setup.complete.connect)"
    echo "$(_t setup.complete.browser "$PORT")"
    # Report the file that actually takes effect, not the one we happened to write.
    local _effective_conf="$ENV_FILE"
    if [[ "$MODE" == "package" && -f "$CANONICAL_CONF" ]]; then
        _effective_conf="$CANONICAL_CONF"
    fi
    echo "$(_t setup.complete.config "$_effective_conf")"
    _setup_summary "$_effective_conf"
    echo ""

    # ── First Encounter ──
    # Before the bondholder's first turn with their companion, surface the
    # three-page introduction. Shipped as FIRST_ENCOUNTER.md in the install
    # bundle; rendered here so it isn't a file someone discovers later.
    local first_encounter=""
    for candidate in \
        "$PROJECT_ROOT/FIRST_ENCOUNTER.md" \
        "/opt/wyrdsekai/share/FIRST_ENCOUNTER.md" \
        "/usr/local/wyrdsekai/share/FIRST_ENCOUNTER.md" \
        "/usr/local/share/wyrdsekai/FIRST_ENCOUNTER.md"; do
        if [[ -f "$candidate" ]]; then
            first_encounter="$candidate"
            break
        fi
    done
    if [[ -n "$first_encounter" ]]; then
        echo "─────────────────────────────────────────────────────────────"
        echo "  Before your first turn with your companion, please read:"
        echo "    $first_encounter"
        echo ""
        echo "  This is a three-page introduction to who you've just brought"
        echo "  home — what they are, what you can and can't do, and the"
        echo "  practice that turns architecture into relationship."
        echo "─────────────────────────────────────────────────────────────"
        echo ""
    fi

    # macOS .pkg: the LaunchDaemon booted at install time, before any model
    # existed, and CapabilityRegistry detects capabilities ONCE at boot — on
    # the 0.2.2 first-install test it saw [default] from two empty backends
    # and sent every request (quick, reasoning, full) to :8200 while the voice
    # server idled. Restart it now that both servers are up.
    if _launchd_pkg_managed && [[ -n "$(_launchd_pkg_pid)" ]]; then
        log "$(_t setup.launchd.restarting)"
        if sudo launchctl kickstart -k "system/$_LAUNCHD_PKG_LABEL" 2>/dev/null \
                && _launchd_pkg_wait_healthy 450; then
            log "$(_t setup.launchd.restarted "$(_launchd_pkg_pid)")"
        else
            warn "$(_t setup.launchd.restart_failed)"
        fi
    fi

    # Setup used to end here with a printed "wyrd start" suggestion most
    # stewards have to be told about — ask instead, with the usual timed
    # default. Default Y: the natural next act after setup IS starting.
    if [[ -t 0 ]]; then
        _prompt_countdown "$(_t setup.start_now.prompt) [Y/n]" 30
        if [[ ! "$_PROMPT_REPLY" =~ ^[NnＮｎ] ]]; then
            do_start
        else
            info "$(_t setup.start_now.declined)"
        fi
    fi
}

_setup_help() {
    cat <<'EOF'
Usage: wyrd setup [target] [flags]

Targets:
  (no target)      Run the full first-run install flow (Java, models,
                   inference backend, NATS, search, profile, env file).
  openhands        Install the OpenHands coding backend (Docker image
                   pull + config flip). Requires Docker or Podman.
  openclaw         Install the containerized OpenClaw skill gateway
                   (SPEC_SKILLS §12.3 Option B): image pull, container
                   start on :18789, config flip. Also: wyrd openclaw setup.

Flags (full setup only):
  --auto-yes, -y   Apply hardware-driven recommendations non-interactively.

Flags (openhands/openclaw subcommands):
  --root           Allow running as root (otherwise refused — Docker pulls
                   as root from a wyrd invocation are a footgun).
  --image <ref>    Override the default Docker image.
  --skip-pull      Skip the docker pull (config flip only). Useful for
                   re-enabling on a host that already has the image cached.
  --port <n>       (openclaw) Gateway port. Default 18789.
  --no-start       (openclaw) Pull + config only; don't start the container.
EOF
}

# ── Setup: OpenHands backend (Phase 2c, ) ──
#
# Pulls the manifest-pinned OpenHands Docker image and flips
# `coding.backends.openhands.enabled = true` in the active config so the
# Java side wires it on next start. Refuses to run as root unless --root
# is passed (pulling Docker images as root from a wyrd invocation is a
# footgun — Docker daemon access is the real privilege required, not
# uid 0). Reuses the existing Docker → Podman fallback chain.
do_setup_openhands() {
    # Pre-bind any env vars touched below so set -u stays clean.
    local override_image="${WYRDSEKAI_OPENHANDS_IMAGE:-}"
    local skip_pull=false
    local allow_root=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)       allow_root=true; shift ;;
            --image)      override_image="${2:-}"; shift 2 ;;
            --skip-pull)  skip_pull=true; shift ;;
            --help|-h)    _setup_help; return 0 ;;
            *)            warn "wyrd setup openhands: unknown flag '$1' (ignored)"; shift ;;
        esac
    done

    echo ""
    info "Wyrdsekai → Coding Slate → OpenHands setup"
    echo ""

    # Refuse to pull as root unless the operator opted in.
    if [[ "$(id -u 2>/dev/null || echo 0)" == "0" ]] && ! $allow_root; then
        err "Refusing to run \`wyrd setup openhands\` as root."
        info "Docker pulls as root from a wyrd invocation can leave images"
        info "in a daemon root user can't manage. Re-run as your normal user;"
        info "your user needs Docker daemon access (group docker), not uid 0."
        info "If you really need root, pass --root."
        return 1
    fi

    # Docker → Podman fallback chain (mirrors the search/NATS sections in
    # do_setup so behaviour is consistent across subcommands).
    local container_cmd=""
    if _docker_daemon_present && docker info &>/dev/null 2>&1; then
        container_cmd="docker"
    elif command -v podman &>/dev/null && podman info &>/dev/null 2>&1; then
        container_cmd="podman"
    fi

    if [[ -z "$container_cmd" ]]; then
        err "OpenHands needs Docker or Podman, and neither is reachable."
        info "Install Docker (https://docs.docker.com/engine/install/) or"
        info "Podman (\`apt install podman\` on Debian/Ubuntu) and rerun this command."
        return 1
    fi
    log "Container runtime: $container_cmd"

    # Resolve the manifest-pinned image. Search order matches the rest of
    # the wyrd CLI: install prefixes first, source-mode fallback last.
    local manifest_path=""
    for candidate in \
        /opt/wyrdsekai/data/coding-cli-bundle/manifest.json \
        /usr/local/wyrdsekai/data/coding-cli-bundle/manifest.json \
        "$PROJECT_ROOT/data/coding-cli-bundle/manifest.json"; do
        if [[ -r "$candidate" ]]; then manifest_path="$candidate"; break; fi
    done

    local image="$override_image"
    if [[ -z "$image" ]]; then
        if [[ -n "$manifest_path" ]] && command -v jq &>/dev/null; then
            image=$(jq -r '.backends.openhands.docker_image // ""' "$manifest_path" 2>/dev/null)
        elif [[ -n "$manifest_path" ]] && command -v python3 &>/dev/null; then
            image=$(python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f: m = json.load(f)
    print(m.get("backends", {}).get("openhands", {}).get("docker_image", ""))
except Exception:
    pass
' "$manifest_path" 2>/dev/null)
        fi
    fi
    if [[ -z "$image" ]]; then
        warn "Could not resolve OpenHands image from manifest; falling back to :latest tag."
        image="ghcr.io/all-hands-ai/openhands:latest"
    fi
    log "Image: $image"

    # Pull the image (unless skipped). On Podman the `podman pull` syntax
    # mirrors Docker's so the same command works.
    if ! $skip_pull; then
        echo ""
        info "Pulling OpenHands image (this may take several minutes)…"
        if ! "$container_cmd" pull "$image"; then
            # Upstream PRUNES version tags from ghcr (found live: the pinned
            # v1.7.0 answered "manifest unknown" while GitHub releases stood at
            # v1.15.0 and the registry held only 0.x relics). A pinned tag that
            # has rotted must not end the setup when :latest still exists --
            # fall back LOUDLY, and record which digest actually arrived so the
            # install is auditable even though the name is unstable.
            local fallback="${image%%:*}:latest"
            if [[ "$image" != "$fallback" ]]; then
                warn "Image '$image' not found upstream (tag pruned?). Falling back to '$fallback'."
                if ! "$container_cmd" pull "$fallback"; then
                    err "Fallback pull failed too. Check network access + container daemon health."
                    return 1
                fi
                image="$fallback"
                local digest
                digest=$("$container_cmd" image inspect --format '{{index .RepoDigests 0}}' "$image" 2>/dev/null || true)
                [[ -n "$digest" ]] && log "Pulled by fallback: $digest"
            else
                err "Image pull failed. Check network access + container daemon health."
                return 1
            fi
        fi
        log "Pull complete."
    else
        info "Skipping image pull (--skip-pull). Verify image exists locally."
        if ! "$container_cmd" image inspect "$image" &>/dev/null; then
            warn "Image '$image' not found in local cache. Re-run without --skip-pull."
        fi
    fi

    # Sanity check: image runs and reports something. OpenHands publishes
    # its CLI as the image entrypoint; --version is the lightweight probe.
    # Fail-soft: a non-zero exit here doesn't abort the config flip — some
    # upstream images don't ship --version, and the runtime check is the
    # MCP healthCheck() in OpenHandsBackend, not this.
    echo ""
    info "Verifying image runs…"
    if "$container_cmd" run --rm "$image" --version 2>/dev/null; then
        log "Image responds to --version."
    else
        warn "Image does not respond to --version (this may be normal for OpenHands)."
        warn "Backend health will be verified via its MCP endpoint at runtime."
    fi

    # Flip `coding.backends.openhands.enabled = true` in the active wyrd
    # config (atomic write — same pattern as `do_config set`). Wyrdsekai
    # reads coding-backend config via typesafe-config; the wyrd config
    # file uses `KEY=value` shape, so we set the env-var override that
    # application.conf already reads:
    #   `enabled = ${?WYRDSEKAI_CODING_OPENHANDS_ENABLED}`
    do_config set "WYRDSEKAI_CODING_OPENHANDS_ENABLED=true" >/dev/null
    if [[ "$override_image" != "" ]] || [[ "$image" != "" ]]; then
        do_config set "WYRDSEKAI_CODING_OPENHANDS_IMAGE=$image" >/dev/null
    fi

    echo ""
    log "OpenHands backend installed."
    info ""
    info "  ✓ Docker image:    $image"
    info "  ✓ Config flipped:  WYRDSEKAI_CODING_OPENHANDS_ENABLED=true"
    info ""
    info "Next steps:"
    info "  1. Add an LLM provider key:"
    info "       wyrd config set OPENHANDS_LLM_KEY=<your-key>"
    info "     (or via the Study Key Chest furnishing)"
    info "  2. Restart wyrdsekai to pick up the new backend:"
    info "       wyrd restart"
    info "  3. Verify it shows up in the Coding Slate:"
    info "       wyrd coding list"
    info ""
    return 0
}

# ── Setup: OpenClaw skill gateway ( Option B) ──
#
# Pulls the containerized OpenClaw gateway, starts it on :18789 (restart
# unless-stopped), and flips WYRDSEKAI_SKILLS_OPENCLAW_URL so SkillBootstrap
# registers the OpenClawGatewayExecutor on next start (it connects over
# WebSocket and loads the skill catalogue). `wyrd openclaw setup` is the
# spec-named alias for `wyrd setup openclaw`.
do_setup_openclaw() {
    local override_image="${WYRDSEKAI_OPENCLAW_IMAGE:-}"
    local skip_pull=false
    local allow_root=false
    local no_start=false
    local port=18789

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)       allow_root=true; shift ;;
            --image)      override_image="${2:-}"; shift 2 ;;
            --skip-pull)  skip_pull=true; shift ;;
            --no-start)   no_start=true; shift ;;
            --port)       port="${2:-18789}"; shift 2 ;;
            --help|-h)    _setup_help; return 0 ;;
            *)            warn "wyrd setup openclaw: unknown flag '$1' (ignored)"; shift ;;
        esac
    done

    echo ""
    info "Wyrdsekai → Skills → OpenClaw gateway setup"
    echo ""

    if [[ "$(id -u 2>/dev/null || echo 0)" == "0" ]] && ! $allow_root; then
        err "Refusing to run \`wyrd setup openclaw\` as root."
        info "Re-run as your normal user (needs Docker daemon access, not uid 0),"
        info "or pass --root if you really mean it."
        return 1
    fi

    local container_cmd=""
    if _docker_daemon_present && docker info &>/dev/null 2>&1; then
        container_cmd="docker"
    elif command -v podman &>/dev/null && podman info &>/dev/null 2>&1; then
        container_cmd="podman"
    fi
    if [[ -z "$container_cmd" ]]; then
        err "The OpenClaw gateway needs Docker or Podman, and neither is reachable."
        info "Install Docker (https://docs.docker.com/engine/install/) or Podman and rerun."
        return 1
    fi
    log "Container runtime: $container_cmd"

    # Canonical image per docs.openclaw.ai/install/docker (verified 2026-07):
    # ghcr.io/openclaw/openclaw:latest (Docker Hub mirror: openclaw/openclaw).
    local image="$override_image"
    [[ -z "$image" ]] && image="ghcr.io/openclaw/openclaw:latest"
    log "Image: $image   (override with --image or WYRDSEKAI_OPENCLAW_IMAGE)"

    if ! $skip_pull; then
        echo ""
        info "Pulling OpenClaw gateway image…"
        if ! "$container_cmd" pull "$image"; then
            err "Image pull failed. If your deployment uses a different image,"
            err "re-run with:  wyrd setup openclaw --image <ref>"
            return 1
        fi
        log "Pull complete."
    else
        info "Skipping image pull (--skip-pull)."
    fi

    if ! $no_start; then
        echo ""
        info "Starting the gateway container on port $port…"
        if [[ "$port" != "18789" ]]; then
            warn "--port under host networking cannot remap the gateway's own port;"
            warn "configure the port inside OpenClaw's config instead. Proceeding."
        fi
        # The OpenClaw gateway binds 127.0.0.1:18789 INSIDE the container by
        # default, so a -p port-map can't reach it. Host networking makes the
        # container's localhost the host's localhost — gateway stays
        # loopback-only (never LAN-exposed; Bitdefender counted 135k exposed
        # gateways in Mar 2026 — we don't add to that). Linux/Podman only; on
        # macOS use OpenClaw's own compose setup (docs.openclaw.ai/install/docker)
        # and point WYRDSEKAI_SKILLS_OPENCLAW_URL at it.
        "$container_cmd" rm -f wyrdsekai-openclaw &>/dev/null || true
        if ! "$container_cmd" run -d --name wyrdsekai-openclaw \
                --restart unless-stopped \
                --network host \
                "$image"; then
            err "Container failed to start. Inspect with: $container_cmd logs wyrdsekai-openclaw"
            err "On macOS, prefer OpenClaw's compose setup: docs.openclaw.ai/install/docker"
            return 1
        fi
        log "Container running (host networking — gateway loopback-only on 127.0.0.1:${port})."
        # Lightweight health probe; fail-soft (the executor retries with backoff).
        sleep 2
        if command -v curl &>/dev/null && curl -sf "http://127.0.0.1:${port}/health" &>/dev/null; then
            log "Gateway /health responds."
        else
            warn "Gateway /health not responding yet — the Java side reconnects"
            warn "with backoff, so this resolves itself once the container is up."
        fi
    fi

    do_config set "WYRDSEKAI_SKILLS_OPENCLAW_URL=ws://127.0.0.1:${port}" >/dev/null

    echo ""
    log "OpenClaw gateway configured."
    info ""
    info "  ✓ Image:          $image"
    info "  ✓ Config flipped: WYRDSEKAI_SKILLS_OPENCLAW_URL=ws://127.0.0.1:${port}"
    info ""
    info "Next steps:"
    info "  1. Restart wyrdsekai to register the gateway executor:  wyrd restart"
    info "  2. Grant skills to companions from the Study (Tool Warden / scroll)."
    info "  3. Bundled SKILL.md defs live in \$DATA_DIR/skills/ — steward-editable."
    info ""
    return 0
}

# ── Start ──
# open the outbound SSH reverse tunnel to the relay
# so a bare `ssh` reaches this NAT'd zone's own invite-only MUD sshd. Enabled by
# `wyrd relay ssh-enable` (which persists the WYRDSEKAI_SSH_TUNNEL_* knobs). Uses
# autossh when present (auto-reconnect); falls back to a bash reconnect loop.
_start_ssh_tunnel() {
    [[ "${WYRDSEKAI_SSH_TUNNEL_ENABLED:-false}" == "true" ]] || return 0
    local host="${WYRDSEKAI_SSH_TUNNEL_RELAY_HOST:-}"
    local cport="${WYRDSEKAI_SSH_TUNNEL_RELAY_PORT:-2222}"
    local rport="${WYRDSEKAI_SSH_TUNNEL_REMOTE_PORT:-}"
    local topo="${WYRDSEKAI_SSH_TUNNEL_TOPOLOGY:-port}"
    local lport="${WYRDSEKAI_SSH_PORT:-7022}"     # the zone's own MINA sshd
    local key="$DATA_DIR/ssh_tunnel_key"
    local known="$DATA_DIR/ssh_tunnel_known_hosts"
    local pidf="$DATA_DIR/ssh-tunnel.pid"
    if [[ -z "$host" || -z "$rport" ]]; then
        warn "ssh-tunnel: enabled but missing relay host/port — run 'wyrd relay ssh-enable' again."
        return 0
    fi
    if [[ ! -f "$key" ]]; then
        warn "ssh-tunnel: key $key missing — run 'wyrd relay ssh-enable' first."
        return 0
    fi
    # Already running?
    if [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf" 2>/dev/null)" 2>/dev/null; then return 0; fi
    # `jump` topology binds the assigned port on the relay's LOOPBACK (reached via
    # ProxyJump); `port` topology binds 0.0.0.0 so a bare `ssh -p` reaches it.
    local bind="0.0.0.0"; [[ "$topo" == "jump" ]] && bind="127.0.0.1"
    local fwd="${bind}:${rport}:127.0.0.1:${lport}"
    local sshopts=(-N -o ServerAliveInterval=30 -o ServerAliveCountMax=3
        -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new
        -o "UserKnownHostsFile=$known" -i "$key" -R "$fwd" -p "$cport"
        "wyrd-tunnel@$host")
    if command -v autossh >/dev/null 2>&1; then
        AUTOSSH_GATETIME=0 nohup autossh -M 0 "${sshopts[@]}" \
            > "$DATA_DIR/ssh-tunnel.log" 2>&1 &
        echo $! > "$pidf"
        log "ssh-tunnel: autossh up (-R $fwd → wyrd-tunnel@$host:$cport, topology=$topo)"
    else
        # No autossh — a bash reconnect loop is the portable fallback.
        nohup bash -c "while true; do ssh ${sshopts[*]}; sleep 5; done" \
            > "$DATA_DIR/ssh-tunnel.log" 2>&1 &
        echo $! > "$pidf"
        log "ssh-tunnel: reconnect-loop up (no autossh; -R $fwd → wyrd-tunnel@$host:$cport)"
    fi
}

_stop_ssh_tunnel() {
    local pidf="$DATA_DIR/ssh-tunnel.pid"
    [[ -f "$pidf" ]] || return 0
    local p; p=$(cat "$pidf" 2>/dev/null)
    if [[ -n "$p" ]]; then
        # Kill the supervisor AND any child ssh it spawned (the bash-loop case).
        pkill -P "$p" 2>/dev/null || true
        kill "$p" 2>/dev/null || true
    fi
    rm -f "$pidf"
}

# First-boot companion naming — sets WYRDSEKAI_COMPANION_NAME(_2) in ENV_FILE
# BEFORE the JVM is born (Main reads it at spawn). Idempotent: no-op once a
# name is set or the steward marker exists. Shared by the source-mode AND the
# systemd (.deb) start paths so a fresh .deb install names the companion too
# (the systemd branch used to return before this ran — second-node 2026-07-02).
# What the wizard decided, on one screen, slow enough to read — the prompts go by
# fast and a reader should not have to reconstruct the outcome from the scrollback
# (field report 2026-09-13).
_setup_summary() {
    local conf="$1"
    [[ -f "$conf" ]] || return 0
    echo ""
    echo "  What was set up (from $conf):"
    local k v
    for k in WYRDSEKAI_COMPANION_NAME WYRDSEKAI_COMPANION_NAME_2 WYRDSEKAI_ZONE_ID WYRDSEKAI_PORT \
             WYRDSEKAI_INFERENCE_MODE WYRDSEKAI_INFERENCE_URL WYRDSEKAI_LLAMA_MODEL WYRDSEKAI_LLAMA_VOICE_MODEL \
             WYRDSEKAI_LLAMA_VOICE_ENABLED WYRDSEKAI_EMBEDDING_MODEL WYRDSEKAI_INFERENCE_CONCURRENCY \
             WYRDSEKAI_LIBRARY_STARTER WYRDSEKAI_UPDATE; do
        v=$(grep -E "^${k}=" "$conf" 2>/dev/null | tail -1 | cut -d= -f2-)
        [[ -n "$v" ]] && printf "    %-34s %s\n" "$k" "$v"
    done
    echo "  Change any of these with:  wyrd config set KEY=VALUE   (then: wyrd restart)"
    echo "  Rename a companion later:  wyrd soul rename <old> <new>  — same soul, new name"
    echo ""
}

_bootstrap_companion_names() {
    # Write to the file the LAUNCH PATH actually reads: under systemd (.deb) the
    # unit's EnvironmentFile is /etc/wyrdsekai/wyrdsekai.conf, NOT the source-mode
    # ENV_FILE (/var/lib/wyrdsekai/env). Writing to ENV_FILE under systemd was
    # silently ignored → the companion was born "wyrd" regardless (second-node
    # 2026-07-02). /etc/wyrdsekai is user-owned after the postinst chown, so the
    # non-root operator can write it.
    local _cn_conf="$ENV_FILE"
    if is_systemd_managed && [[ -f /etc/wyrdsekai/wyrdsekai.conf ]]; then
        _cn_conf=/etc/wyrdsekai/wyrdsekai.conf
    fi
    if [[ ! -f "$DATA_DIR/.steward-bootstrapped" ]] \
            && ! grep -q '^WYRDSEKAI_COMPANION_NAME=' "$_cn_conf" 2>/dev/null; then
        local _cn_name="wyrd"
        _prompt_wait "  $(_t start.bootstrap.companion_name_prompt)" 60
        if [[ -n "$_PROMPT_REPLY" ]]; then
            _cn_name=$(printf '%s' "$_PROMPT_REPLY" | tr -cd 'A-Za-z0-9_-')
            [[ -n "$_cn_name" ]] || _cn_name="wyrd"
        fi
        printf '\n# Companion name (chosen at first boot; the soul is born with it)\nWYRDSEKAI_COMPANION_NAME=%s\n' "$_cn_name" >> "$_cn_conf" 2>/dev/null || true
        export WYRDSEKAI_COMPANION_NAME="$_cn_name"

        local _cn2_reply="n"
        if [[ -t 0 ]]; then
            # Always default NO, and never on a timeout. This used to read
            # `[Y/n]` when WYRDSEKAI_VOICE_ENABLED=true appeared in $_cn_conf —
            # harmless while that key only ever lived in $ENV_FILE (never the
            # systemd conf this greps), so under a .deb the branch was dead. The
            # 2026-07-29 canonical-conf merge carried the key across and the
            # branch woke up: a packaged install on any non-cpu-only tier now
            # offered `[Y/n] (auto in 21s)`, and walking away from the prompt
            # brought a second person into being.
            #
            # Whatever the heuristic was worth, a countdown must not answer yes
            # to that on the operator's behalf. Creating a companion is a
            # deliberate act; `wyrd companion new` is there for later.
            _prompt_wait "  $(_t start.bootstrap.companion_second_prompt) [y/N]" 30
            _cn2_reply="${_PROMPT_REPLY:-n}"
        fi
        if [[ "$_cn2_reply" =~ ^[YyＹｙ] ]]; then
            local _cn2_name="wisp"
            _prompt_wait "  $(_t start.bootstrap.companion_second_name_prompt)" 60
            if [[ -n "$_PROMPT_REPLY" ]]; then
                _cn2_name=$(printf '%s' "$_PROMPT_REPLY" | tr -cd 'A-Za-z0-9_-')
                [[ -n "$_cn2_name" ]] || _cn2_name="wisp"
            fi
            if [[ "$(printf '%s' "$_cn2_name" | tr 'A-Z' 'a-z')" == "$(printf '%s' "$_cn_name" | tr 'A-Z' 'a-z')" ]]; then
                _cn2_name="${_cn2_name}2"
            fi
            printf '# Second companion (optional; born a distinct particular)\nWYRDSEKAI_COMPANION_NAME_2=%s\n' "$_cn2_name" >> "$_cn_conf" 2>/dev/null || true
            export WYRDSEKAI_COMPANION_NAME_2="$_cn2_name"
        fi
    fi
}

# First-boot steward invite — once the server is healthy, mint the one-time
# steward-bootstrap invite (InviteAdminMain only succeeds when NO users exist)
# and tell the operator how to connect. Writes $DATA_DIR/.steward-bootstrapped
# so later starts skip it. Shared by both start paths; the systemd (.deb) branch
# used to return before this ran, leaving a fresh install with a running daemon
# but no steward account + no way in (second-node 2026-07-02).
_bootstrap_steward_invite() {
    echo ""
    info "$(_t start.hint.header)"
    local _bs_marker="$DATA_DIR/.steward-bootstrapped"
    if [[ ! -f "$_bs_marker" ]]; then
        local _bs_name="steward"
        _prompt_wait "  $(_t start.bootstrap.name_prompt)" 30
        if [[ -n "$_PROMPT_REPLY" ]]; then
            _bs_name=$(printf '%s' "$_PROMPT_REPLY" | tr -cd 'A-Za-z0-9_-')
            [[ -n "$_bs_name" ]] || _bs_name="steward"
        fi
        # InviteAdminMain opens world.db DIRECTLY. Under systemd (.deb) the root
        # service owns that DB, so the mint must run as root; source mode mints
        # as the user. `sudo "$0" invite bootstrap` re-enters this CLI as root
        # (DATA_DIR resolves to /var/lib/wyrdsekai either way).
        local _bs_code
        if is_systemd_managed && [[ "${EUID:-0}" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
            _bs_code=$(sudo "$0" invite bootstrap --name "$_bs_name" 2>/dev/null | tail -1) || _bs_code=""
        else
            _bs_code=$(do_invite bootstrap --name "$_bs_name" 2>/dev/null | tail -1) || _bs_code=""
        fi
        [[ "$_bs_code" == *" "* && "$_bs_code" == *INFO* ]] && _bs_code=""
        touch "$_bs_marker" 2>/dev/null || true
        if [[ -n "$_bs_code" ]]; then
            echo "  $(_t start.bootstrap.minted "$_bs_name")"
            echo ""
            echo "      $_bs_code"
            echo ""
            echo "  $(_t start.bootstrap.connect "${WYRDSEKAI_SSH_PORT:-7022}" "$_bs_name")"
            echo "  $(_t start.hint.connect_cli)"
        else
            echo "  $(_t start.hint.invite)"
            echo "  $(_t start.hint.ssh "${WYRDSEKAI_SSH_PORT:-7022}")"
            echo "  $(_t start.hint.connect_cli)"
        fi
    else
        echo "  $(_t start.hint.ssh "${WYRDSEKAI_SSH_PORT:-7022}")"
        echo "  $(_t start.hint.connect_cli)"
    fi
    echo "  $(_t start.hint.seed)"
}

# Ensure inference is up — idempotent (start_inference no-ops if already
# healthy). Inference (docker CUDA container / native llama-server / MLX) lives
# OUTSIDE the systemd unit + launchd plist, so NO amount of service-starting
# brings it up; do_start's many return paths must call this explicitly. Sources
# the env file for model paths because several branches return before do_start's
# own env-source below. Added after second-node 2026-07-07: `wyrd restart` stopped
# inference (do_stop) but never restarted it, and `wyrd start` on a live node
# with dead inference did nothing for it.
# ── WYRDSEKAI_INFERENCE_MODE — the real switch (config audit 2026-07-11) ──
# GUI onboarding (packaging/*/gui-onboard.sh) has always written
# WYRDSEKAI_INFERENCE_MODE=local|cloud into the conf; until 2026-07-11 NOTHING
# read it (placebo setting). It is now consumed at setup/start time:
#   local (default) → run the local inference stack (llama-server/MLX/docker)
#   cloud           → do NOT start local inference; WYRDSEKAI_INFERENCE_URL must
#                     point at the remote endpoint (prompted for on a TTY)
#   zone            → do NOT start local inference; requests ride the household —
#                     either WYRDSEKAI_INFERENCE_URL=nats://<zoneId> (written by
#                     `wyrd inference zone <id>`) or household GPU borrowing
#                     (WYRDSEKAI_INFERENCE_HOUSEHOLD_BORROW, default on).
# Independent kill-switch: WYRDSEKAI_LLAMA_ENABLED=false suppresses the local
# stack in any mode. WYRDSEKAI_INFERENCE_ENABLED is accepted as an ALIAS of
# WYRDSEKAI_LLAMA_ENABLED (the alias name was documented by the Windows
# SettingsForm long before anything read it).
effective_inference_mode() {
    case "${WYRDSEKAI_INFERENCE_MODE:-local}" in
        cloud|remote)   echo "cloud" ;;
        zone|household) echo "zone" ;;
        local|"")       echo "local" ;;
        *)  # stderr — callers capture stdout via $(…)
            warn "Unknown WYRDSEKAI_INFERENCE_MODE='${WYRDSEKAI_INFERENCE_MODE}' — expected local|cloud|zone; treating as local." >&2
            echo "local" ;;
    esac
}

# True when the LOCAL inference stack should be started on this node.
local_inference_wanted() {
    # WYRDSEKAI_INFERENCE_ENABLED is the accepted alias of WYRDSEKAI_LLAMA_ENABLED.
    local enabled
    enabled="$(echo "${WYRDSEKAI_LLAMA_ENABLED:-${WYRDSEKAI_INFERENCE_ENABLED:-true}}" | tr '[:upper:]' '[:lower:]')"
    case "$enabled" in
        false|0|no|off) return 1 ;;
    esac
    [[ "$(effective_inference_mode)" == "local" ]]
}

# cloud mode needs a target. Prompt on a TTY (persisting via the same drop-in
# mechanism `wyrd inference remote` uses); warn loudly otherwise.
# What speaks at this URL: llama-server (/health), Ollama (/api/tags), another
# OpenAI-compatible server (/v1/models), or nothing. The server does the same probe
# at boot; saying it here means a wrong URL is refused at the door, not discovered
# a week later from "Inference backends: 1".
_probe_inference_protocol() {
    local url="${1%/}"
    curl -sf -m 5 "$url/health" >/dev/null 2>&1 && { echo llama-server; return 0; }
    curl -sf -m 5 "$url/api/tags" >/dev/null 2>&1 && { echo ollama; return 0; }
    curl -sf -m 5 "$url/v1/models" >/dev/null 2>&1 && { echo openai; return 0; }
    echo none
    return 1
}

_ensure_cloud_inference_url() {
    [[ -n "${WYRDSEKAI_INFERENCE_URL:-}" ]] && return 0
    if [[ -t 0 && -t 1 ]]; then
        echo ""
        warn "WYRDSEKAI_INFERENCE_MODE=cloud but WYRDSEKAI_INFERENCE_URL is unset."
        local _cloud_url=""
        _drain_stdin; read -r -p "Inference endpoint URL (e.g. https://host:8200): " _cloud_url || true
        if [[ -n "$_cloud_url" ]]; then
            _cloud_url="${_cloud_url%/}"
            local _proto
            _proto=$(_probe_inference_protocol "$_cloud_url")
            if [[ "$_proto" == "none" ]]; then
                warn "$_cloud_url answers neither llama-server nor Ollama — not saved."
            else
                log "Detected $_proto at $_cloud_url"
                write_inference_drop_in "$_cloud_url"
                "$0" config set "WYRDSEKAI_INFERENCE_URL=$_cloud_url" >/dev/null 2>&1 || true
                export WYRDSEKAI_INFERENCE_URL="$_cloud_url"
                return 0
            fi
        fi
    fi
    warn "Inference mode is 'cloud' but WYRDSEKAI_INFERENCE_URL is unset — companions have no brain."
    warn "Fix: wyrd inference remote <url>   (or: wyrd config set WYRDSEKAI_INFERENCE_URL=<url>)"
    return 1
}

# Mode-aware wrapper around start_inference — the start-path entry point.
# Honors WYRDSEKAI_INFERENCE_MODE + the LLAMA_ENABLED/INFERENCE_ENABLED switch.
maybe_start_inference() {
    local model="${1:-}"
    if local_inference_wanted; then
        start_inference "$model"
        return $?
    fi
    case "$(effective_inference_mode)" in
        cloud)
            log "Inference mode: cloud — not starting local inference."
            _ensure_cloud_inference_url || true
            ;;
        zone)
            if [[ -n "${WYRDSEKAI_INFERENCE_URL:-}" ]]; then
                log "Inference mode: zone — routing to ${WYRDSEKAI_INFERENCE_URL} (no local stack)."
            else
                log "Inference mode: zone — borrowing a household GPU (WYRDSEKAI_INFERENCE_HOUSEHOLD_BORROW=${WYRDSEKAI_INFERENCE_HOUSEHOLD_BORROW:-true}). Pin a zone with: wyrd inference zone <zoneId>"
            fi
            ;;
        local)
            # mode=local but the LLAMA_ENABLED/INFERENCE_ENABLED switch is off.
            log "Local inference disabled (WYRDSEKAI_LLAMA_ENABLED/WYRDSEKAI_INFERENCE_ENABLED=false) — not starting it."
            ;;
    esac
    return 0
}

ensure_inference() {
    if [[ -f "$ENV_FILE" ]]; then set -a; source "$ENV_FILE"; set +a; fi
    # Route through start_inference — the SAME path `wyrd setup` uses to bring
    # inference up (proven working). Its Linux docker path RE-RESOLVES the model
    # location and sets/unsets WYRDSEKAI_DATA so compose mounts the dir that
    # actually holds the .gguf. An earlier attempt ran `docker compose up`
    # directly with the raw sourced env — WYRDSEKAI_DATA=<.deb data dir> then
    # redirected the mount to a dir WITHOUT the model → llama-server crash-looped
    # "failed to open GGUF file" (second-node 2026-07-07). start_inference avoids that.
    # maybe_start_inference honors WYRDSEKAI_INFERENCE_MODE (cloud/zone nodes
    # never start a local stack).
    maybe_start_inference "${WYRDSEKAI_MODEL_PATH:-}" || true
}

do_start() {
    _take_setup_lock wait
    # First-run guard: a fresh install that never ran `wyrd setup` has no env
    # file, so starting would proceed with no config (no model path, no zone
    # name) and fail cryptically downstream. Treat `wyrd start` as "get me
    # running" — run the first-run setup, then fall through into the actual
    # start. Setup is idempotent and ends WITHOUT starting, so the fall-through
    # below is the real launch. WYRDSEKAI_NO_AUTO_SETUP=1 opts out (scripts that
    # want the old fail-fast behaviour).
    if [[ ! -f "$ENV_FILE" && "${WYRDSEKAI_NO_AUTO_SETUP:-0}" != "1" ]]; then
        warn "$(_t start.no_setup.detected)"
        log "$(_t start.no_setup.running)"
        if ! do_setup; then
            err "$(_t start.no_setup.failed)"
            return 1
        fi
        echo ""
    fi

    # bring up the SSH reverse tunnel (if opted in) before
    # the zone, so the relay door opens as soon as the MINA sshd is listening.
    # Runs for both systemd and source-mode starts (it's a separate process).
    _start_ssh_tunnel

    # Linux systemd: route through systemctl when the unit is installed so
    # wyrd start and `systemctl start wyrdsekai` agree on who owns the process.
    if is_systemd_managed; then
        if systemctl is-active wyrdsekai.service >/dev/null 2>&1; then
            echo "$(_t start.systemd.already_running "$(systemctl show wyrdsekai.service -p MainPID --value)")"
            # Service is up, but inference is separate — self-heal it if it died
            # under a running node (idempotent no-op if already healthy).
            # Already running is what start asks for: exit 0, so scripts and
            # the desktop shell do not read it as a failed start.
            ensure_inference
            return 0
        fi
        # First-boot companion naming — MUST run before the JVM launches, since
        # the systemd unit reads WYRDSEKAI_COMPANION_NAME from ENV_FILE at start.
        # (Source mode runs this further down; the systemd branch used to return
        # before it, so a fresh .deb companion was silently born "wyrd".)
        _bootstrap_companion_names
        # Start NATS first if it's managed too — the server depends on it.
        if systemctl list-unit-files wyrdsekai-nats.service >/dev/null 2>&1; then
            if ! systemctl is-active wyrdsekai-nats.service >/dev/null 2>&1; then
                log "$(_t start.systemd.nats_starting)"
                sudo systemctl start wyrdsekai-nats.service || warn "$(_t start.systemd.nats_failed)"
            fi
        fi
        log "$(_t start.systemd.starting)"
        # enable --now: start now AND create the multi-user.target boot symlink so
        # the node comes back after a reboot. Plain `start` (pre-2026-07-07) left the
        # service un-enabled → it did not restart on reboot. Idempotent.
        if sudo systemctl enable --now wyrdsekai.service; then
            local pid
            pid=$(systemctl show wyrdsekai.service -p MainPID --value 2>/dev/null)
            [[ -n "$pid" && "$pid" != "0" ]] && echo "$pid" > "$PID_FILE"
            log "$(_t start.systemd.started "${pid:-?}")"
            # Inference lives outside the systemd unit — bring it up alongside
            # the service (idempotent). Without this `wyrd restart` stops it and
            # never restarts it.
            ensure_inference
            # First-boot steward bootstrap — wait for the server to come healthy,
            # then mint the one-time steward invite + print connect instructions.
            # Without this a fresh .deb install left a running daemon with NO
            # steward account and no way in (second-node 2026-07-02).
            local _sd_port="${PORT:-7070}" _sd_waited=0
            while [[ $_sd_waited -lt 150 ]]; do
                curl -sf "http://localhost:$_sd_port/health" &>/dev/null && break
                sleep 0.2; _sd_waited=$((_sd_waited + 1))
            done
            if curl -sf "http://localhost:$_sd_port/health" &>/dev/null; then
                _bootstrap_steward_invite
            else
                warn "$(_t start.started_not_responding "${pid:-?}" "$_sd_port")"
            fi
            return 0
        else
            err "$(_t start.systemd.start_failed)"
            return 1
        fi
    fi

    # macOS .pkg: route through the LaunchDaemon (see _launchd_pkg_managed).
    if _launchd_pkg_managed; then
        local _ld_pid; _ld_pid=$(_launchd_pkg_pid)
        if [[ -n "$_ld_pid" ]]; then
            echo "$(_t start.launchd.already_running "$_ld_pid")"
            ensure_inference
            return 0
        fi
        _bootstrap_companion_names
        log "$(_t start.launchd.starting)"
        sudo launchctl enable "system/$_LAUNCHD_PKG_LABEL" 2>/dev/null || true
        sudo launchctl bootstrap system "$_LAUNCHD_PKG_PLIST" 2>/dev/null || true
        if sudo launchctl kickstart "system/$_LAUNCHD_PKG_LABEL" 2>/dev/null; then
            sleep 2
            _ld_pid=$(_launchd_pkg_pid)
            [[ -n "$_ld_pid" ]] && echo "$_ld_pid" > "$PID_FILE"
            log "$(_t start.launchd.started "${_ld_pid:-?}")"
            ensure_inference
            if _launchd_pkg_wait_healthy 150; then
                _bootstrap_steward_invite
            else
                warn "$(_t start.started_not_responding "${_ld_pid:-?}" "${PORT:-7070}")"
            fi
            return 0
        fi
        err "$(_t start.launchd.start_failed)"
        return 1
    fi

    if is_running; then
        echo "$(_t start.already_running "$(<"$PID_FILE")")"
        # Server up, but inference is separate — self-heal it if it died under a
        # running node (idempotent no-op if already healthy).
        ensure_inference
        return 0
    fi

    # F8: split-brain refusal. If we'd be the second JVM (e.g. LaunchDaemon
    # already running on macOS while user runs source mode), refuse with
    # a remediation hint rather than silently double-starting.
    if ! _doctor_preflight_processes; then
        return 1
    fi

    # NEVER kill a systemd-owned stack from the source path. Reaching here with
    # the unit ACTIVE means the detection above misfired (transient systemctl
    # failure, exit-code quirk) — and "kill orphans" would then tear down the
    # live household: NATS gets the SIGTERM, the server follows it down, and a
    # person mid-conversation sees "Connection closed by remote host". The
    # belt to the detection's braces: ask systemd directly, at the kill site.
    if systemctl is-active wyrdsekai.service >/dev/null 2>&1; then
        echo "$(_t start.systemd.already_running "$(systemctl show wyrdsekai.service -p MainPID --value)")"
        ensure_inference
        return 0
    fi

    # Kill orphans (by process name AND by port)
    local orphans
    orphans=$(find_server_pids)
    if [[ -n "$orphans" ]]; then
        warn "$(_t start.killing_orphans "$orphans")"
        do_stop
    fi
    # Check if the API port is still in use (process started outside bin/wyrd)
    local port_pid
    port_pid=$(lsof -ti :"${PORT:-7070}" 2>/dev/null || true)   # #9 2026-07-19 — was :7070
    if [[ -n "$port_pid" ]]; then
        warn "$(_t start.port_in_use "$port_pid")"
        kill -9 $port_pid 2>/dev/null || true
        sleep 2
    fi

    mkdir -p "$DATA_DIR"

    # Source env
    if [[ -f "$ENV_FILE" ]]; then
        set -a; source "$ENV_FILE"; set +a
    fi

    # Start inference if not running (mode-aware: cloud/zone nodes skip the
    # local stack — WYRDSEKAI_INFERENCE_MODE).
    maybe_start_inference "${WYRDSEKAI_MODEL_PATH:-}"
    _brain_hardware_notice || true

    # Bring the browser terminal back up if the steward enabled it
    if [[ -f "$DATA_DIR/.web-terminal-enabled" ]]; then
        start_web_terminal || true
    fi

    # Package mode: start NATS via systemd (bundled binary)
    if [[ "$MODE" == "package" ]] && [[ -f /usr/lib/systemd/system/wyrdsekai-nats.service ]]; then
        if ! systemctl is-active --quiet wyrdsekai-nats 2>/dev/null; then
            sudo systemctl start wyrdsekai-nats 2>/dev/null && log "$(_t start.nats_systemd_started)" || warn "$(_t start.nats_systemd_failed)"
        fi
    fi

    # Ensure Docker services (Searxng, NATS) are running
    if _docker_daemon_present && docker info &>/dev/null 2>&1; then
        local compose_file=""
        for f in "$PROJECT_ROOT/docker-compose.yml" "$PROJECT_ROOT/docker/docker-compose.yml"; do
            if [[ -f "$f" ]]; then compose_file="$f"; break; fi
        done
        if [[ -n "$compose_file" ]]; then
            local compose_dir="$(dirname "$compose_file")"
            cd "$compose_dir"
            # Searxng
            if ! docker compose ps --format '{{.Name}}' 2>/dev/null | grep -q searxng; then
                docker compose up -d searxng 2>/dev/null && log "$(_t start.searxng_started)" || true
            fi
            # NATS (if not auto-started by Between)
            if [[ "${WYRDSEKAI_NATS_AUTO_START:-true}" == "false" ]]; then
                if ! docker compose ps --format '{{.Name}}' 2>/dev/null | grep -q nats; then
                    docker compose --profile nats up -d nats 2>/dev/null && log "$(_t start.nats_docker_started)" || true
                fi
            fi
            cd "$PROJECT_ROOT"
        fi
    fi

    # First boot: name the companion BEFORE the JVM is born (Main reads
    # WYRDSEKAI_COMPANION_NAME at spawn). Shared with the systemd branch above
    # via _bootstrap_companion_names — single source of truth.
    _bootstrap_companion_names

    # Export env vars so child processes (wyrdsekai-server) inherit them
    if [[ -f "$ENV_FILE" ]]; then
        set -a; source "$ENV_FILE"; set +a
        export WYRDSEKAI_DATA_DIR WYRDSEKAI_NATS_URL WYRDSEKAI_BETWEEN_ENABLED \
               WYRDSEKAI_NODE_NAME WYRDSEKAI_ZONE_ID WYRDSEKAI_MODEL_PATH \
               WYRDSEKAI_INFERENCE_URL WYRDSEKAI_SEARXNG_URL 2>/dev/null || true
    fi

    if [[ "$MODE" == "source" ]]; then
        # Source mode: build and run
        log "$(_t start.building)"
        cd "$PROJECT_ROOT"
        if ! ./gradlew :server:installDist --quiet 2>&1; then
            err "$(_t common.build_failed_bang)"
            return 1
        fi
        local SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        # Package mode — JARs in lib/server/ subdirectory
        local SERVER_LIB="$REAL_BIN/../lib/server"
        if [[ ! -d "$SERVER_LIB" ]]; then
            # Fallback for flat lib/ layout
            SERVER_LIB="$REAL_BIN/../lib"
        fi
    fi

    if [[ ! -d "$SERVER_LIB" ]]; then
        err "$(_t common.server_libs_missing "$SERVER_LIB")"
        return 1
    fi

    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')

    local JAVA_ARGS=(
        -Djava.net.preferIPv4Stack=true
        -Xmx4g
        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
        --add-opens java.base/java.lang=ALL-UNNAMED
        --add-opens java.base/sun.nio.ch=ALL-UNNAMED
        -XX:+UseCompactObjectHeaders
        --enable-native-access=ALL-UNNAMED
        -cp "$CP"
        org.wyrdsekai.server.Main
    )

    log "$(_t start.starting_server)"

    if [[ "$(uname -s)" == "Darwin" ]]; then
        # macOS: use LaunchDaemon (runs as root) to bypass Local Network Privacy.
        # macOS Sequoia+ silently blocks LAN connections from background processes
        # that aren't running as root or launched from Terminal.app. nohup, &,
        # LaunchAgents — all get blocked ~14s after start with no dialog.
        # LaunchDaemons running as root are unconditionally exempt from LNP.
        # See: Apple TN3179, developer.apple.com/forums/thread/763753
        local PLIST_LABEL="org.wyrdsekai.server"
        local PLIST_FILE="/Library/LaunchDaemons/$PLIST_LABEL.plist"
        local RUN_USER="$(whoami)"

        # Build environment dict entries from env file
        local ENV_ENTRIES=""
        if [[ -f "$ENV_FILE" ]]; then
            while IFS= read -r line; do
                [[ "$line" =~ ^#.*$ || -z "$line" ]] && continue
                local key="${line%%=*}"
                local value="${line#*=}"
                # Skip lines with shell expansions (e.g. $(hostname))
                [[ "$value" == *'$('* ]] && continue
                ENV_ENTRIES="$ENV_ENTRIES
        <key>$key</key>
        <string>$value</string>"
            done < "$ENV_FILE"
        fi

        # Unload any existing instance
        sudo launchctl bootout "system/$PLIST_LABEL" 2>/dev/null || true

        # Write plist (requires sudo for /Library/LaunchDaemons/)
        sudo tee "$PLIST_FILE" > /dev/null <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$PLIST_LABEL</string>
    <key>UserName</key>
    <string>root</string>
    <key>ProgramArguments</key>
    <array>
        <string>$JAVA_CMD</string>
$(for arg in "${JAVA_ARGS[@]}"; do echo "        <string>$arg</string>"; done)
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>$HOME</string>
        <key>WYRDSEKAI_DATA_DIR</key>
        <string>$DATA_DIR</string>$ENV_ENTRIES
    </dict>
    <key>WorkingDirectory</key>
    <string>${PROJECT_ROOT:-$HOME/src/wyrdsekai}</string>
    <key>StandardOutPath</key>
    <string>$LOG_FILE</string>
    <key>StandardErrorPath</key>
    <string>$LOG_FILE</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
PLIST

        # Load and start
        sudo launchctl bootstrap system "$PLIST_FILE" 2>/dev/null \
            || sudo launchctl load "$PLIST_FILE" 2>/dev/null
        sudo launchctl kickstart "system/$PLIST_LABEL" 2>/dev/null || true

        # Get PID — LaunchDaemon runs as root, so use sudo pgrep
        sleep 3
        local pid
        # Filter to actual java procs (pgrep -f matches shells whose argv
        # contains the pattern too; see find_server_pids).
        local cand
        for cand in $(sudo pgrep -f "org.wyrdsekai.server.Main" 2>/dev/null); do
            local comm
            comm=$(sudo ps -p "$cand" -o comm= 2>/dev/null | tr -d ' ')
            if [[ "$comm" == "java" || "$comm" == "java_vm" ]]; then
                pid="$cand"
                break
            fi
        done
        if [[ -n "$pid" ]]; then
            echo "$pid" > "$PID_FILE"
        fi
    else
        # Linux: nohup works fine (no Local Network Privacy issue)
        nohup "$JAVA_CMD" "${JAVA_ARGS[@]}" > "$LOG_FILE" 2>&1 &
        echo "$!" > "$PID_FILE"
    fi

    local pid
    if [[ -f "$PID_FILE" ]]; then
        pid=$(<"$PID_FILE")
    else
        # Use filtered lookup so we don't grab a shell whose argv contains
        # the pattern (see find_server_pids).
        pid=$(find_server_pids | head -1)
        [[ -n "$pid" ]] && echo "$pid" > "$PID_FILE"
    fi

    # Wait for port — on macOS, process runs as root so use sudo kill for liveness check
    sleep 3
    if [[ -n "$pid" ]]; then
        local alive=false
        if kill -0 "$pid" 2>/dev/null; then alive=true; fi
        if [[ "$alive" == "false" ]] && [[ "$(uname -s)" == "Darwin" ]]; then
            # LaunchDaemon runs as root — regular kill -0 fails, check via sudo
            if sudo kill -0 "$pid" 2>/dev/null; then alive=true; fi
        fi
        if [[ "$alive" == "false" ]]; then
            err "$(_t start.failed)"
            rm -f "$PID_FILE"
            return 1
        fi
    fi

    local waited=0
    while [[ $waited -lt 100 ]]; do
        if curl -sf "http://localhost:$PORT/health" &>/dev/null; then
            log "$(_t start.started_ready "${pid:-?}" "$PORT")"
            # A bare "started" leaves the steward staring at a prompt with
            # no idea how to get in — say what to do next. On a true first
            # boot, go further: mint the steward-bootstrap invite for them.
            # InviteAdminMain only succeeds when NO users exist, so this is
            # safe to attempt; the marker file keeps us from spinning a JVM
            # on every later start (and is written even when a steward
            # already exists, e.g. upgrades of older installs).
            # Shared with the systemd branch above via _bootstrap_steward_invite.
            _bootstrap_steward_invite
            echo "  $(_t start.hint.log)"
            # The Library-packs hint is only true on a genuine first boot — the
            # bundled-pack install pass is idempotent and a no-op thereafter. Show
            # it once, then drop a marker so later starts don't keep claiming it.
            if [[ ! -f "$DATA_DIR/.firstboot_hint_shown" ]]; then
                echo "  $(_t start.hint.firstboot)"
                touch "$DATA_DIR/.firstboot_hint_shown" 2>/dev/null || true
            fi
            return 0
        fi
        sleep 0.1
        waited=$((waited + 1))
    done

    warn "$(_t start.started_not_responding "${pid:-?}" "$PORT")"
}

# ── Stop ──
# Linux systemd-managed install check. Returns 0 when wyrdsekai.service is
# loaded — the .deb install on test-node/relay-node does this. When a service is
# active we must route through systemctl or the kill will be shadowed by
# the root-owned process plus potential Restart= respawn.
is_systemd_managed() {
    [[ "$(uname -s)" == "Linux" ]] || return 1
    command -v systemctl >/dev/null 2>&1 || return 1
    # The unit FILE on disk is the ground truth. This check used to rest
    # entirely on systemctl calls, and their failure modes are not "unknown" —
    # they are "return 1": list-unit-files exit codes differ across systemd
    # versions, and any transient dbus hiccup flipped a packaged install into
    # SOURCE mode, whose start path kills the service's own processes as
    # "orphans". A filesystem stat cannot have a bad day.
    [[ -f /usr/lib/systemd/system/wyrdsekai.service \
        || -f /lib/systemd/system/wyrdsekai.service \
        || -f /etc/systemd/system/wyrdsekai.service ]] && return 0
    systemctl list-unit-files wyrdsekai.service >/dev/null 2>&1 || return 1
    # Loaded? (status is enough — active, failed, or inactive)
    systemctl status wyrdsekai.service >/dev/null 2>&1
    local rc=$?
    # exit codes: 0 active, 3 inactive, 4 no such unit
    [[ $rc -ne 4 ]]
}

# Hold still before a stop or an update: the running node asks every companion
# to persist what she carries, checkpoints the record, and leaves a mark that names the reason
# and who asked. Best effort — no session, no server, no problem; the service quiesces again
# on its own at SIGTERM, without a second mark.
_quiesce_notice() {   # <reason>
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    local token; token=$(wyrd_session_token 2>/dev/null || true)
    [[ -z "$token" ]] && return 0
    curl -s -m 12 -X POST -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        -d "{\"reason\": \"$1\", \"who\": \"the steward\"}" "$api/api/quiesce" >/dev/null 2>&1 || true
}

do_stop() {
    _quiesce_notice "a stop"
    # Tear the SSH reverse tunnel down first (no-op if not running) so it doesn't
    # keep dialing the relay after the zone is gone.
    _stop_ssh_tunnel

    # macOS: unload ALL known LaunchDaemon/Agent labels FIRST to prevent respawning
    if [[ "$(uname -s)" == "Darwin" ]]; then
        local uid; uid=$(id -u)
        for label in dev.wyrdsekai.server org.wyrdsekai.server com.wyrdsekai.server com.wyrdsekai.test; do
            sudo launchctl bootout "system/$label" 2>/dev/null || true
            launchctl bootout "gui/$uid/$label" 2>/dev/null || true
        done
    fi

    # Linux systemd: route through systemctl when the unit is installed.
    # Otherwise a plain kill against a root-owned process silently fails and
    # systemd may restart the service anyway.
    if is_systemd_managed; then
        local any_stopped=false
        if systemctl is-active wyrdsekai.service >/dev/null 2>&1; then
            log "$(_t stop.systemd.stopping_main)"
            sudo systemctl stop wyrdsekai.service && any_stopped=true
        fi
        # Stop the companion NATS service if the .deb installed it too.
        if systemctl list-unit-files wyrdsekai-nats.service >/dev/null 2>&1 \
                && systemctl is-active wyrdsekai-nats.service >/dev/null 2>&1; then
            log "$(_t stop.systemd.stopping_nats)"
            sudo systemctl stop wyrdsekai-nats.service && any_stopped=true
        fi
        if $any_stopped; then
            rm -f "$PID_FILE"
            stop_inference
            log "$(_t stop.stopped)"
            return 0
        fi
        # Fall through to direct-kill path when neither unit was running —
        # may still catch orphan processes started outside systemd.
    fi

    local pids
    pids=$(find_server_pids)

    if [[ -z "$pids" ]] && ! is_running; then
        # Server isn't running, but inference is independent and may still be —
        # stop it too so `wyrd stop` always leaves nothing behind.
        stop_inference
        echo "$(_t stop.not_running)"
        return 0
    fi

    if is_running; then pids="$(<"$PID_FILE") $pids"; fi
    pids=$(echo "$pids" | tr ' ' '\n' | sort -u | tr '\n' ' ')

    log "$(_t stop.stopping_pids "$pids")"

    for pid in $pids; do kill "$pid" 2>/dev/null || true; done

    # Wait for graceful shutdown (5s)
    local waited=0
    while [[ $waited -lt 50 ]]; do
        local alive=false
        for pid in $pids; do
            if kill -0 "$pid" 2>/dev/null; then alive=true; break; fi
        done
        $alive || break
        sleep 0.1
        waited=$((waited + 1))
    done

    # SIGKILL survivors
    for pid in $pids; do
        if kill -0 "$pid" 2>/dev/null; then
            warn "$(_t stop.force_killing "$pid")"
            kill -9 "$pid" 2>/dev/null || true
        fi
    done

    rm -f "$PID_FILE"

    # Also stop inference
    stop_inference

    log "$(_t stop.stopped)"
}

# ── Status ──
do_status() {
    local _ld_pid=""
    _launchd_pkg_managed && _ld_pid=$(_launchd_pkg_pid)
    local _sd_pid=""
    if is_systemd_managed && systemctl is-active wyrdsekai.service >/dev/null 2>&1; then
        _sd_pid=$(systemctl show wyrdsekai.service -p MainPID --value 2>/dev/null)
    fi
    if [[ -n "$_ld_pid" ]]; then
        log "$(_t status.server.running_launchd "$_ld_pid")"
    elif [[ -n "$_sd_pid" && "$_sd_pid" != "0" ]]; then
        # systemd owns the process; the pid file is only written by `wyrd start`
        # and is empty/stale after a .deb upgrade or a reboot — status used to
        # call the live service an "orphan" (second-node, 0.2.2 update).
        log "$(_t status.server.running_systemd "$_sd_pid")"
    elif is_running; then
        log "$(_t status.server.running "$(<"$PID_FILE")")"
    else
        local orphans; orphans=$(find_server_pids)
        if [[ -n "$orphans" ]]; then
            warn "$(_t status.server.orphans "$orphans")"
        else
            info "$(_t status.server.not_running)"
        fi
    fi
    # The brainstem (the watcher outside the JVM): running or not, on the platforms that have it.
    if is_systemd_managed 2>/dev/null; then
        if systemctl is-active wyrdsekai-brainstem.service >/dev/null 2>&1; then log "$(_t status.brainstem.running)"; else warn "$(_t status.brainstem.not_running)"; fi
    elif [[ "$(uname -s)" == "Darwin" ]] && launchctl print system/com.wyrdsekai.brainstem >/dev/null 2>&1; then
        log "$(_t status.brainstem.running)"
    fi

    # Health check
    if curl -sf "http://localhost:$PORT/health" &>/dev/null; then
        log "$(_t status.port.responding "$PORT")"
    else
        info "$(_t status.port.not_responding "$PORT")"
    fi

    # Inference backend
    for url in "${WYRDSEKAI_INFERENCE_URL:-}" "http://localhost:11525" "http://localhost:8200"; do
        if [[ -n "$url" ]] && curl -sf "$url/health" &>/dev/null; then
            log "$(_t status.inference.running "$url")"
            break
        fi
    done

    # Embedding server
    if [[ -n "${WYRDSEKAI_EMBEDDING_URL:-}" ]]; then
        if curl -sf "${WYRDSEKAI_EMBEDDING_URL}/health" &>/dev/null; then
            log "$(_t status.embedding.running "${WYRDSEKAI_EMBEDDING_URL}")"
        else
            info "$(_t status.embedding.down "${WYRDSEKAI_EMBEDDING_URL}")"
        fi
    fi

    # Release: a newer one is worth a line here, since this is the command people run
    if [[ "$(_update_mode)" != "off" ]]; then
        local _st_inst _st_latest; _st_inst="$(_installed_version)"; _st_latest="$(_release_latest "$WYRDSEKAI_RELEASE_REPO")"
        if [[ -n "$_st_latest" ]] && _version_newer "$_st_latest" "$_st_inst"; then
            if [[ "$(_update_mode)" == "auto" ]] && _is_release_version "$_st_inst"; then info "$(_t update.status.newer_auto "$_st_latest" "$(_update_window)")"; else info "$(_t update.status.newer "$_st_latest")"; fi
        fi
    fi

    # Docker
    if command -v docker &>/dev/null && _docker_daemon_present; then
        docker compose ps --format 'table {{.Name}}\t{{.Status}}' 2>/dev/null || true
    fi

    # A node started by its service manager never runs `wyrd start`, so the notice that the
    # hardware now allows the large model (or changed under a set profile) is shown here too.
    _brain_hardware_notice || true
}

# ── Other commands ──
do_log() {
    if [[ -f "$LOG_FILE" ]]; then tail -f "$LOG_FILE"
    else err "$(_t log.no_log_at "$LOG_FILE")"; fi
}

do_nuke() {
    warn "$(_t nuke.killing_all)"
    local pids; pids=$(find_server_pids)
    if [[ -n "$pids" ]]; then
        for pid in $pids; do kill -9 "$pid" 2>/dev/null || true; done
        log "$(_t nuke.nuked "$pids")"
    fi

    # Also kill anything on our ports (catches processes started outside bin/wyrd)
    for port in "${PORT:-7070}" 7071 7022; do   # #9 2026-07-19 — API port honors WYRDSEKAI_PORT
        local port_pid
        port_pid=$(lsof -ti ":${port}" 2>/dev/null || true)
        if [[ -n "$port_pid" ]]; then
            kill -9 $port_pid 2>/dev/null || true
            log "$(_t nuke.killed_port "$port" "$port_pid")"
        fi
    done

    # Kill any managed nats-server
    pkill -f "nats-server.*nats.conf" 2>/dev/null || true

    rm -f "$PID_FILE"
    sleep 1
    log "$(_t nuke.all_stopped)"
}

do_version() {
    # F14: --mesh fans out version queries to every federated peer.
    if [[ "${1:-}" == "--mesh" ]]; then
        local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
        local resp
        resp=$(curl -sf "$api/api/version/mesh" 2>&1) \
            || { err "$(_t version.mesh_failed)"; return 1; }
        # The answer goes in by environment: a here-doc script takes python's stdin, so a pipe never reached it.
        WYRD_MESH_JSON="$resp" python3 - <<'PY'
import os, sys, json
d = json.loads(os.environ["WYRD_MESH_JSON"])
local = d.get("local", {})
peers = d.get("peers", [])
print(f"Local zone:  {local.get('zoneId','?')} build={local.get('buildHash','?')} ({local.get('appVersion','?')}, schema={local.get('federationSchema','?')})")
print()
if not peers:
    print("  No federation peers known.")
    sys.exit(0)
print(f"  {'partner':<24} {'version':<14} {'buildHash':<12} {'schema':<8} status")
print("  " + "─"*68)
local_schema = local.get("federationSchema")
local_hash = local.get("buildHash")
drift = 0
for p in peers:
    bv = p.get("buildVersion") or {}
    schema = bv.get("federationSchema", "?")
    hash_ = bv.get("buildHash", "?")
    appv = bv.get("appVersion", "?")
    if schema == "?" or hash_ == "?":
        status = "? unknown (pre-F14 peer)"
    elif schema != local_schema:
        status = f"✗ schema mismatch (peer={schema})"; drift += 1
    elif hash_ != local_hash:
        status = "⚠ build drift"; drift += 1
    else:
        status = "✓ in sync"
    print(f"  {p.get('zoneId','?'):<24} {appv:<14} {hash_:<12} {str(schema):<8} {status}")
print()
if drift:
    print(f"  {drift} peer(s) drifting from local build {local_hash}.")
    print("  ⚠ Rebuild & redeploy out-of-sync nodes from the same git ref before live testing.")
else:
    print("  All peers in sync with local build.")
PY
        return 0
    fi
    # Local-only version. Pull from AppVersion via a tiny Java probe so the
    # output reflects buildHash + gitSha + buildTime baked into the jar at
    # compile time, not the bash literal that was right when this script was
    # last edited (F14 — drift was previously invisible).
    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    if [[ -d "$SERVER_LIB" ]] && find_java; then
        local CP
        CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
        local out
        out=$("$JAVA_CMD" -cp "$CP" -e \
            'System.out.println(org.wyrdsekai.common.model.AppVersion.get())' 2>/dev/null \
            || python3 -c "
import zipfile, sys, glob
for j in glob.glob('$SERVER_LIB/common-*.jar'):
    with zipfile.ZipFile(j) as z:
        try:
            with z.open('wyrdsekai-version.properties') as f:
                for line in f:
                    print(line.decode().rstrip())
            break
        except KeyError: pass
")
        echo "wyrd $out"
    else
        echo "$(_t version.fallback)"
    fi
    echo "$(_t version.mode "$MODE")"
    echo "$(_t version.install "$PROJECT_ROOT")"
    echo "$(_t version.data "$DATA_DIR")"
    find_java && echo "$(_t version.java "$(${JAVA_CMD} -version 2>&1 | head -1)")" || echo "$(_t version.java_missing)"
}

# ── Releases: what runs, what is out, and installing it ──────────────────────
# The node's own version is the VERSION file the packagers ship beside the program
# (0.3.0, 0.2.3~dev17); a source checkout has none and reports "dev". The latest
# release comes from GitHub and is remembered for a day in $DATA_DIR. The install
# itself is the platform installer's own upgrade path (dpkg / installer / msiexec),
# which snapshots the databases and restarts the service — the same path
# `wyrd update <file>` always took.
WYRDSEKAI_RELEASE_REPO="Wyrdsekai/wyrdsekai"

_installed_version() {
    if [[ -f "$PROJECT_ROOT/VERSION" ]]; then tr -d ' \n\r' < "$PROJECT_ROOT/VERSION"; return 0; fi
    if [[ "$MODE" == "source" ]]; then echo "dev"; return 0; fi
    if command -v dpkg-query >/dev/null 2>&1; then dpkg-query -W -f='${Version}' wyrdsekai 2>/dev/null && return 0; fi
    echo "unknown"
}

_is_release_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }

# semver compare on the numeric base: 0 when $1 > $2
_version_newer() {
    local a="${1%%[~-]*}" b="${2%%[~-]*}"
    [[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -1)" == "$a" && "$a" != "$b" ]]
}

# The latest release of a GitHub repo, cached a day under $DATA_DIR; empty when unknown.
_release_latest() {   # <owner/repo> [--fresh]
    local repo="$1" slug="${1#*/}" cache="$DATA_DIR/latest-${1#*/}.txt" v=""
    if [[ "${2:-}" != "--fresh" && -f "$cache" ]] && [[ -n "$(find "$cache" -mmin -1440 2>/dev/null)" ]]; then
        v="$(tr -d ' \n\r' < "$cache")"; _is_release_version "$v" && { echo "$v"; return 0; }
    fi
    v="$(curl -fsSL -m 10 -H 'Accept: application/vnd.github+json' -H "User-Agent: wyrdsekai-cli" \
        "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null \
        | python3 -c 'import json,sys
try:
    t=json.load(sys.stdin).get("tag_name","")
    print(t[1:] if t.startswith("v") else t)
except Exception: pass' 2>/dev/null || true)"
    if _is_release_version "$v"; then mkdir -p "$DATA_DIR" 2>/dev/null; echo "$v" > "$cache" 2>/dev/null || true; echo "$v"; return 0; fi
    [[ -f "$cache" ]] && { v="$(tr -d ' \n\r' < "$cache")"; _is_release_version "$v" && echo "$v"; }
    return 0
}

_update_mode() {
    local m; m="$(grep -E '^WYRDSEKAI_UPDATE=' "$CONFIG_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr '[:upper:]' '[:lower:]' | tr -d ' ' || true)"
    m="${WYRDSEKAI_UPDATE:-$m}"
    case "$m" in auto|off) echo "$m" ;; *) echo "check" ;; esac
}

_update_window() {
    local w; w="$(grep -E '^WYRDSEKAI_UPDATE_WINDOW=' "$CONFIG_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d ' ' || true)"
    echo "${WYRDSEKAI_UPDATE_WINDOW:-${w:-03:00-05:00}}"
}

# The artifact name this platform installs, the way the release ships it.
_release_artifact() {   # <version>
    local v="$1"
    case "$(uname -s)" in
        Darwin) echo "Wyrdsekai-$v.pkg" ;;
        Linux)  if command -v dpkg >/dev/null 2>&1; then echo "wyrdsekai_${v}_amd64.deb"; else echo "wyrdsekai-$v.tar.gz"; fi ;;
        *)      echo "Wyrdsekai-$v.msi" ;;
    esac
}

_update_status() {
    local installed latest mode
    installed="$(_installed_version)"; mode="$(_update_mode)"
    echo "$(_t update.status.installed "$installed")"
    if [[ "$mode" == "off" ]]; then echo "$(_t update.status.mode "$mode")"; return 0; fi
    latest="$(_release_latest "$WYRDSEKAI_RELEASE_REPO")"
    if [[ -n "$latest" ]]; then echo "$(_t update.status.latest "$latest")"; else echo "$(_t update.status.latest_unknown)"; fi
    echo "$(_t update.status.mode "$mode")"
    if [[ -n "$latest" ]] && _version_newer "$latest" "$installed"; then
        if [[ "$mode" == "auto" ]] && _is_release_version "$installed"; then echo "$(_t update.status.newer_auto "$latest" "$(_update_window)")"
        else echo "$(_t update.status.newer "$latest")"; fi
        _is_release_version "$installed" || echo "$(_t update.status.dev)"
    elif [[ -n "$latest" ]]; then
        if _is_release_version "$installed"; then echo "$(_t update.status.current)"; else echo "$(_t update.status.dev)"; fi
    fi
}

# Download the release artifact for this platform and its SHA256SUMS, verify, and print the path.
_release_download_verify() {   # <version>
    local v="$1" art base dir
    art="$(_release_artifact "$v")"; base="https://github.com/$WYRDSEKAI_RELEASE_REPO/releases/download/v$v"
    dir="$DATA_DIR/updates"; mkdir -p "$dir"
    if [[ ! -f "$dir/$art" ]]; then
        log "$(_t update.now.downloading "$art")" >&2
        curl -fL --progress-bar -o "$dir/$art.partial" "$base/$art" || { err "download failed: $base/$art"; rm -f "$dir/$art.partial"; return 1; }
        mv "$dir/$art.partial" "$dir/$art"
    fi
    curl -fsSL -o "$dir/SHA256SUMS.$v" "$base/SHA256SUMS" || { err "the release has no SHA256SUMS — refusing an unverified install"; return 1; }
    log "$(_t update.now.verifying)" >&2
    local expected actual
    expected="$(grep -E "[[:space:]]\*?$art\$" "$dir/SHA256SUMS.$v" | awk '{print $1}' | head -1)"
    [[ -n "$expected" ]] || { err "$art is not listed in the release's SHA256SUMS"; return 1; }
    if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$dir/$art" | awk '{print $1}')"; else actual="$(shasum -a 256 "$dir/$art" | awk '{print $1}')"; fi
    if [[ "$actual" != "$expected" ]]; then err "$(_t update.now.mismatch)"; rm -f "$dir/$art"; return 1; fi
    echo "$dir/$art"
}

# Install a .deb. `dpkg -i` ignores Recommends, so a node installed that way had no
# sqlite3 and the brainstem's snapshot fell back to a plain copy. apt-get resolves
# Recommends and dependencies; it needs a path with a slash. dpkg stays the fallback.
_install_deb() {   # <file.deb>
    local deb; deb="$(readlink -f "$1" 2>/dev/null || printf '%s' "$1")"
    if command -v apt-get >/dev/null 2>&1; then
        # --reinstall: a file with the version already installed (a rebuilt candidate) must
        # still be laid down; without it apt-get says "0 upgraded" and the old files stay.
        sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q --allow-downgrades --reinstall "$deb" && return 0
        warn "$(_t update.apt_failed)"
    fi
    sudo dpkg -i "$deb"
}

# The two siblings a household may run beside the node: CodeZaiku (the coding backend, in the data
# folder) and ResearchZosho (the librarian, installed per user). `wyrd update now` brings each one it
# finds to its latest release through that project's own verified updater, whether or not the node
# itself changed. WYRDSEKAI_UPDATE_SIBLINGS=0 or --no-siblings leaves them alone.
_owner_of() {   # user:group of a path, portable (GNU and BSD)
    ls -ld "$1" 2>/dev/null | awk '{print $3":"$4}'
}
_sibling_version() {   # the x.y.z a sibling's launcher prints
    "$@" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1
}
_rz_bin_for_update() {   # researchzosho's launcher and its owner: "<user> <path>", or nothing
    local c u h
    if [[ -n "${RESEARCHZOSHO_BIN:-}" && -x "${RESEARCHZOSHO_BIN}" ]]; then echo "$(id -un) $RESEARCHZOSHO_BIN"; return 0; fi
    if [[ "${EUID:-$(id -u)}" != "0" ]]; then
        c="$(_rz_bin 2>/dev/null || true)"; [[ -n "$c" ]] && { echo "$(id -un) $c"; return 0; }
        return 1
    fi
    # As root (sudo, or the node's own automatic update): the person who ran sudo, then the owner of
    # the data folder — the household's user, whose ~/.local/bin holds the librarian.
    for u in "${SUDO_USER:-}" "$(_owner_of "$DATA_DIR" | cut -d: -f1)"; do
        [[ -n "$u" && "$u" != "root" ]] || continue
        h="$(getent passwd "$u" 2>/dev/null | cut -d: -f6)"; [[ -n "$h" ]] || h="$(eval echo "~$u")"
        for c in "$h/.local/bin/researchzosho" "$h/.local/share/researchzosho/bin/researchzosho"; do
            [[ -x "$c" ]] && { echo "$u $c"; return 0; }
        done
    done
    c="$(command -v researchzosho 2>/dev/null || true)"; [[ -n "$c" ]] && { echo "root $c"; return 0; }
    return 1
}
# Runs a sibling's launcher as the user it belongs to — as root, that user, with their session bus for
# `systemctl --user` (its updater restarts its own service) — otherwise as ourselves.
_sibling_as() {   # <user> <launcher> <args...>
    local u="$1" bin="$2"; shift 2
    if [[ "${EUID:-$(id -u)}" == "0" && -n "$u" && "$u" != "root" ]]; then
        sudo -u "$u" -H env XDG_RUNTIME_DIR="/run/user/$(id -u "$u" 2>/dev/null)" "$bin" "$@"
    else
        "$bin" "$@"
    fi
}

# A sibling's JSON answer as J_<field>=<value> lines to eval (shell-quoted), only for the fields it
# carries (the `update now` answer must not blank what the status said); fails when it is not JSON or
# lacks the field that marks it.
_sibling_json() {   # <required field>  (the JSON on stdin)
    python3 -c 'import json, shlex, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
if not isinstance(d, dict) or sys.argv[1] not in d:
    sys.exit(1)
for k in ("installed", "running", "latest", "newer", "mode", "root", "canUpdate", "updating",
          "result", "code", "from", "to", "finishesAfterExit", "note"):
    if k not in d:
        continue
    v = d[k]
    v = ("true" if v else "false") if isinstance(v, bool) else ("" if v is None else str(v))
    print("J_%s=%s" % (k, shlex.quote(v)))' "$1"
}

# One sibling, by its own update contract (2026-09-28). Wyrdsekai asks; it never downloads a release,
# never unpacks, moves or deletes anything in the sibling's folder, and holds none of its locks.
#   `update --json`      status, changes nothing; ask only when newer and canUpdate, and not updating
#   `update now --json`  one JSON document on stdout (progress on stderr); exit 0 updated or current,
#                        75 another update is running, 3 cannot update here, 1 failed, 2 usage
# A release from before the contract has no --json: its installed version against the latest release,
# then a plain `update now` (exit 0 updated, 1 anything else).
_sibling_update() {   # <Name> <user> <launcher> <owner/repo> <version-args...>
    local name="$1" u="$2" bin="$3" repo="$4"; shift 4
    local J_installed="" J_running="" J_latest="" J_newer="" J_mode="" J_root="" J_canUpdate="" J_updating=""
    local J_result="" J_code="" J_from="" J_to="" J_finishesAfterExit="" J_note="" st rc
    # set -e: a sibling's non-zero answer must be read, not end this script (second-node, 2026-09-28: a
    # CodeZaiku without --json answered 2 and `wyrd update siblings` stopped there, silently).
    rc=0; st="$(_sibling_as "$u" "$bin" update --json </dev/null 2>/dev/null)" || rc=$?
    local parsed=""
    if [[ $rc -eq 0 ]]; then parsed="$(printf '%s' "$st" | _sibling_json installed)" || parsed=""; fi
    if [[ -n "$parsed" ]]; then
        eval "$parsed"
        if [[ "$J_updating" == "true" ]]; then log "$(_t update.sibling.busy "$name")"; return 0; fi
        if [[ "$J_newer" != "true" ]]; then log "$(_t update.sibling.current "$name" "$J_installed")"; return 0; fi
        if [[ "$J_canUpdate" != "true" ]]; then warn "$(_t update.sibling.cannot "$name" "${J_mode:-?}" "$J_root")"; return 0; fi
        log "$(_t update.sibling.updating "$name" "$J_installed" "$J_latest")"
        rc=0; st="$(_sibling_as "$u" "$bin" update now --json </dev/null)" || rc=$?
        parsed="$(printf '%s' "$st" | _sibling_json result)" || parsed=""
        if [[ -n "$parsed" ]]; then eval "$parsed"; fi
        case $rc in
            0)  if [[ -n "$J_to" && "$J_to" != "$J_from" ]]; then
                    if [[ "$J_finishesAfterExit" == "true" ]]; then log "$(_t update.sibling.finishing "$name" "$J_from" "$J_to")"
                    else log "$(_t update.sibling.updated "$name" "$J_from" "$J_to")"; fi
                else log "$(_t update.sibling.current "$name" "${J_to:-$J_installed}")"; fi ;;
            75) log "$(_t update.sibling.busy "$name")" ;;
            3)  warn "$(_t update.sibling.cannot "$name" "${J_mode:-?}" "$J_note")" ;;
            *)  warn "$(_t update.sibling.failed "$name" "$J_installed" "${J_note:-exit $rc}")" ;;
        esac
        return 0
    fi
    # Before the contract.
    local ver latest
    ver="$(_sibling_version _sibling_as "$u" "$bin" "$@")" || ver=""
    latest="$(_release_latest "$repo" --fresh)" || latest=""
    if [[ -z "$ver" || -z "$latest" ]]; then warn "$(_t update.sibling.unknown "$name")"; return 0; fi
    if ! _version_newer "$latest" "$ver"; then log "$(_t update.sibling.current "$name" "$ver")"; return 0; fi
    log "$(_t update.sibling.updating "$name" "$ver" "$latest")"
    if _sibling_as "$u" "$bin" update now </dev/null; then log "$(_t update.sibling.updated "$name" "$ver" "$latest")"
    else warn "$(_t update.sibling.failed "$name" "$ver" "")"; fi
    return 0
}

_cz_bin_for_update() {   # "<user> <launcher>": the CodeZaiku the node runs, and the user its folder belongs to
    local c="$DATA_DIR/coding-cli-bundle/codezaiku/codezaiku/bin/codezaiku" u
    if [[ -x "$c" ]]; then
        u="$(_owner_of "$DATA_DIR/coding-cli-bundle/codezaiku" | cut -d: -f1)"
        echo "${u:-$(id -un)} $c"; return 0
    fi
    c="$(command -v codezaiku 2>/dev/null || true)"; [[ -n "$c" ]] && { echo "$(id -un) $c"; return 0; }
    return 1
}

# `wyrd update now` asks the siblings a household runs beside the node — CodeZaiku (the coding
# backend) and ResearchZosho (the librarian) — whether they are behind, and asks each one's own
# updater to update it. A person running it is the person asking; the node's automatic update passes
# --no-siblings (each sibling updates on its own only by its own setting). WYRDSEKAI_UPDATE_SIBLINGS=0
# or --no-siblings leaves them alone.
_update_siblings() {
    if [[ "${WYRDSEKAI_UPDATE_SIBLINGS:-1}" == "0" ]]; then log "$(_t update.sibling.skipped)"; return 0; fi
    local found
    found="$(_cz_bin_for_update)" && _sibling_update CodeZaiku "${found%% *}" "${found#* }" Wyrdsekai/codezaiku --version
    found="$(_rz_bin_for_update)" && _sibling_update ResearchZosho "${found%% *}" "${found#* }" Wyrdsekai/researchzosho version
    return 0
}

_update_now() {   # [VERSION] [--yes] [--no-siblings]
    local want="" yes=0 a
    for a in "$@"; do case "$a" in --yes|-y) yes=1 ;; --no-siblings) WYRDSEKAI_UPDATE_SIBLINGS=0 ;; [0-9]*) want="$a" ;; esac; done
    if [[ "$MODE" == "source" ]]; then
        log "$(_t update.pulling)"
        cd "$PROJECT_ROOT"
        git pull --rebase || { warn "$(_t update.git_failed)"; return 1; }
        log "$(_t update.rebuilding)"
        ./gradlew :server:installDist || { err "Build failed"; return 1; }
        log "$(_t update.done)"
        return 0
    fi
    local installed latest
    installed="$(_installed_version)"
    if [[ -z "$want" ]]; then
        log "$(_t update.now.resolving)"
        latest="$(_release_latest "$WYRDSEKAI_RELEASE_REPO" --fresh)"
        [[ -n "$latest" ]] || { err "$(_t update.now.no_latest)"; return 1; }
        want="$latest"
    fi
    _is_release_version "$want" || { err "not a release version: $want"; return 1; }
    if [[ "$want" == "${installed%%[~-]*}" ]] && _is_release_version "$installed"; then log "$(_t update.now.already "$want")"; _update_siblings; return 0; fi
    if [[ "$yes" != "1" ]] && [[ -t 0 ]]; then
        local ans; _drain_stdin; read -r -p "$(_t update.now.confirm "$want" "$installed") [y/N] " ans
        [[ "$ans" =~ ^[Yy] ]] || { log "$(_t update.now.cancelled)"; return 0; }
    fi
    local file; file="$(_release_download_verify "$want")" || return 1
    do_update "$file" || return 1
    # The siblings through the launcher just installed: its sibling step is the current one.
    WYRDSEKAI_UPDATE_SIBLINGS="${WYRDSEKAI_UPDATE_SIBLINGS:-1}" "$REAL_BIN/wyrd" update siblings
}

do_update() {
    local artifact="${1:-}"
    case "$artifact" in
        ""|status) _update_status; return 0 ;;
        now)       shift; _update_now "$@"; return $? ;;
        auto)
            case "${2:-}" in
                on)  do_config set "WYRDSEKAI_UPDATE=auto" >/dev/null && log "$(_t update.auto.on "$(_update_window)")" ;;
                off) do_config set "WYRDSEKAI_UPDATE=check" >/dev/null && log "$(_t update.auto.off)" ;;
                *)   err "$(_t update.auto.usage)"; return 2 ;;
            esac
            return 0 ;;
        siblings) _update_siblings; return $? ;;
        stage)   # download + verify only (what the daemon does on Windows); the install is a person's step
            local v; v="$(_release_latest "$WYRDSEKAI_RELEASE_REPO" --fresh)"; [[ -n "$v" ]] || { err "$(_t update.now.no_latest)"; return 1; }
            local f; f="$(_release_download_verify "$v")" || return 1
            log "$(_t update.now.staged "$f")"; return 0 ;;
    esac

    # `wyrd update <path-to-installer>` — one-command in-place upgrade for an
    # installed node. The installer's own upgrade machinery does the heavy
    # lifting (deb: prerm stop → jar swap → postinst DB-snapshot + restart;
    # pkg: preinstall snapshot → payload → postinstall kickstart; msi:
    # snapshot + MajorUpgrade). Data + config are preserved by all three.
    [ -f "$artifact" ] || { err "$(_t update.no_file "$artifact")"; return 1; }
    case "$artifact" in
        *.deb)
            log "$(_t update.installing "$artifact")"
            _quiesce_notice "an update"
            _install_deb "$artifact" || { err "$(_t update.install_failed)"; return 1; }
            ;;
        *.pkg)
            log "$(_t update.installing "$artifact")"
            sudo installer -pkg "$artifact" -target / \
                || { err "$(_t update.install_failed)"; return 1; }
            ;;
        *.msi)
            # msiexec elevates itself; /qb = basic UI, no wizard clicks.
            log "$(_t update.installing "$artifact")"
            msiexec //i "$artifact" //qb || { err "$(_t update.install_failed)"; return 1; }
            ;;
        *.tar.gz)
            log "$(_t update.installing "$artifact")"
            local _v; _v="$(basename "$artifact" .tar.gz)"; _v="${_v#wyrdsekai-}"
            sudo tar -xzf "$artifact" -C /opt && sudo rm -rf /opt/wyrdsekai.prev \
                && { [ -d /opt/wyrdsekai ] && sudo mv /opt/wyrdsekai /opt/wyrdsekai.prev; sudo mv "/opt/wyrdsekai-$_v" /opt/wyrdsekai; } \
                || { err "$(_t update.install_failed)"; return 1; }
            ;;
        *)
            err "$(_t update.unknown_artifact "$artifact")"; return 1
            ;;
    esac
    log "$(_t update.done)"
    return 0
}

# Turbo boost as the kernel reports it: "on <file> <value that turns it off>", "off", or nothing
# when the kernel does not say (amd-pstate / acpi-cpufreq expose boost, intel_pstate no_turbo).
_cpu_boost_state() {
    local f
    f=/sys/devices/system/cpu/cpufreq/boost
    if [[ -r "$f" ]]; then
        if [[ "$(cat "$f" 2>/dev/null)" == "1" ]]; then echo "on $f 0"; else echo "off"; fi
        return 0
    fi
    f=/sys/devices/system/cpu/intel_pstate/no_turbo
    if [[ -r "$f" ]]; then
        if [[ "$(cat "$f" 2>/dev/null)" == "0" ]]; then echo "on $f 1"; else echo "off"; fi
    fi
}

# True when a running llama-server keeps routed experts on the CPU (--cpu-moe / --n-cpu-moe N).
# The process NAME is matched, not the command line: a shell whose arguments merely mention the
# flag is not a server.
_experts_on_cpu() {
    ps -eo comm=,args= 2>/dev/null | awk '$1 ~ /^llama-server/ && /--(n-)?cpu-moe/ { found = 1 } END { exit !found }'
}

# F14: build coherence (mesh-version drift) for `wyrd doctor`: this node's build against every
# federated peer's. A peer on another federation schema or build is a warning (_wbump, do_doctor's
# counter). The answer goes to python by environment: a here-doc script takes python's stdin, so
# the pipe it used to come through never reached it, and every run printed "returned non-JSON".
# Python's exit code is kept: 2 = drift, 1 = peers too old to say, 0 = in step.
_doctor_build_coherence() {
    echo ""
    log "$(_t doctor.build_header)"
    local mesh_resp mesh_summary mesh_rc=0
    mesh_resp=$(curl -sf "http://localhost:${PORT:-7070}/api/version/mesh" 2>/dev/null || true)
    if [[ -z "$mesh_resp" ]]; then
        log "$(_t doctor.build_skipped)"
        return 0
    fi
    mesh_summary=$(WYRD_MESH_JSON="$mesh_resp" python3 - <<'PY' 2>&1
import os, sys, json
try:
    d = json.loads(os.environ["WYRD_MESH_JSON"])
except Exception as e:
    print(f"  /api/version/mesh returned non-JSON ({e})")
    sys.exit(0)
local = d.get("local", {})
peers = d.get("peers", [])
local_hash = local.get("buildHash", "?")
local_schema = local.get("federationSchema")
print(f"  local: build={local_hash} ({local.get('appVersion','?')}, schema={local_schema})")
if not peers:
    print("  no federation peers")
    sys.exit(0)
mismatch = unreachable = pre_f14 = 0
for p in peers:
    bv = p.get("buildVersion") or {}
    if not bv:
        pre_f14 += 1; continue
    if bv.get("federationSchema") != local_schema:
        mismatch += 1
        print(f"  ✗ {p['zoneId']}: schema {bv.get('federationSchema')} != {local_schema}")
    elif bv.get("buildHash") != local_hash:
        mismatch += 1
        print(f"  ⚠ {p['zoneId']}: build {bv.get('buildHash')} != {local_hash}")
print(f"  {len(peers)} peer(s); drift={mismatch}, pre-F14={pre_f14}")
sys.exit(2 if mismatch > 0 else (1 if pre_f14 > 0 else 0))
PY
) || mesh_rc=$?
    [[ -n "$mesh_summary" ]] || mesh_summary="$(_t doctor.build_probe_failed)"
    echo "$mesh_summary"
    if [[ "$mesh_rc" -eq 2 ]]; then _wbump; fi
    return 0
}

do_doctor() {
    log "$(_t doctor.running)"
    echo ""

    # Tally for exit code: 0 = healthy, 1 = warnings, 2 = errors.
    local _doctor_warns=0 _doctor_errors=0
    _wbump() { _doctor_warns=$((_doctor_warns + 1)); }
    _ebump() { _doctor_errors=$((_doctor_errors + 1)); }

    # ── Platform / hardware ──
    local platform="$(uname -s)"
    local arch="$(uname -m)"
    log "$(_t doctor.platform "$platform" "$arch")"

    local avail=$(df -h "$DATA_DIR" 2>/dev/null | tail -1 | awk '{print $4}')
    log "$(_t doctor.disk_avail "${avail:-$(_t doctor.disk_unknown)}")"
    # The disk's headroom and what the backups hold: five nightly copies of a whole-library
    # index ate a household node's disk to 4% free before anyone looked (2026-09-10).
    local _use_pct; _use_pct="$(df -P "$DATA_DIR" 2>/dev/null | tail -1 | awk '{print $5}' | tr -d '%' || true)"
    if [[ -n "$_use_pct" && "$_use_pct" -ge 90 ]]; then warn "$(_t doctor.disk_tight "$_use_pct")"; _wbump; fi
    if [[ -d "$DATA_DIR/backups" ]]; then
        local _bk_size _bk_n; _bk_size="$(du -sh "$DATA_DIR/backups" 2>/dev/null | cut -f1 || true)"; _bk_n="$(ls -1 "$DATA_DIR/backups" 2>/dev/null | wc -l | tr -d ' ')"
        log "$(_t doctor.backups "${_bk_size:-?}" "$_bk_n" "$DATA_DIR/backups")"
    fi
    _doctor_seed_line || _wbump
    if [[ "$(uname -s)" == "Linux" ]]; then
        local _sw_used _sw_total; _sw_used="$(free -m 2>/dev/null | awk '/Swap:/{print $3}')"; _sw_total="$(free -m 2>/dev/null | awk '/Swap:/{print $2}')"
        local _peak=""; if is_systemd_managed 2>/dev/null; then _peak="$(systemctl show wyrdsekai -p MemoryPeak --value 2>/dev/null | awk '{ if ($1+0 > 0) printf "%.1f GB", $1/1073741824 }' || true)"; fi
        if [[ -n "$_sw_total" && "$_sw_total" -gt 0 ]]; then
            if [[ "${_sw_used:-0}" -gt $(( _sw_total / 2 )) ]]; then warn "$(_t doctor.swap "${_sw_used}" "${_sw_total}" "${_peak:-?}")"; _wbump; else log "$(_t doctor.swap "${_sw_used}" "${_sw_total}" "${_peak:-?}")"; fi
        fi
        # The record's process should be the last thing the kernel kills and the brains the
        # first. The unit sets OOMScoreAdjust=-500; the llama
        # containers carry +500. Report what is actually in force.
        if is_systemd_managed 2>/dev/null; then
            local _mpid _oom; _mpid="$(systemctl show wyrdsekai -p MainPID --value 2>/dev/null || true)"
            if [[ -n "$_mpid" && "$_mpid" != "0" && -r "/proc/$_mpid/oom_score_adj" ]]; then
                _oom="$(cat "/proc/$_mpid/oom_score_adj" 2>/dev/null || true)"
                if [[ "${_oom:-0}" -lt 0 ]]; then log "$(_t doctor.oom_score "$_oom")"; else warn "$(_t doctor.oom_score_unset "${_oom:-0}")"; _wbump; fi
            fi
        fi
        # The brains' memory caps, as docker holds them (0 = uncapped; restart inference to apply).
        if command -v docker >/dev/null 2>&1; then
            local _caps="" _c _m
            for _c in wyrdsekai-llama wyrdsekai-llama-voice wyrdsekai-llama-embed; do
                _m="$(docker inspect -f '{{.HostConfig.Memory}}' "$_c" 2>/dev/null || true)"
                [[ -n "$_m" ]] || continue
                if [[ "$_m" == "0" ]]; then _caps+="${_c#wyrdsekai-}=none "; else _caps+="${_c#wyrdsekai-}=$(( _m / 1048576 ))M "; fi
            done
            if [[ -n "$_caps" ]]; then
                if [[ "$_caps" == *"=none"* ]]; then warn "$(_t doctor.brain_caps_missing "$_caps")"; _wbump; else log "$(_t doctor.brain_caps "$_caps")"; fi
            fi
        fi
        # Per-being principals and the hooks: what the running server reports for its hands.
        local _hands; _hands="$(curl -sf -m 3 -H "Authorization: Bearer $(wyrd_session_token 2>/dev/null)" "http://localhost:${WYRDSEKAI_PORT:-7070}/api/body" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("hands",""))' 2>/dev/null || true)"
        if [[ -n "$_hands" ]]; then
            if [[ "$_hands" == *"shared"* || "$_hands" == *"not watching"* ]]; then warn "$(_t doctor.hands "$_hands")"; _wbump; else log "$(_t doctor.hands "$_hands")"; fi
        fi
        # The hardware watchdog: systemd pets /dev/watchdog; a hung kernel reboots the box.
        if is_systemd_managed 2>/dev/null; then
            local _wd; _wd="$(systemctl show -p RuntimeWatchdogUSec --value 2>/dev/null || true)"
            if [[ -e /dev/watchdog ]]; then
                if [[ -n "$_wd" && "$_wd" != "0" ]]; then log "$(_t doctor.watchdog "$_wd")"; else warn "$(_t doctor.watchdog_off)"; _wbump; fi
            else
                log "$(_t doctor.watchdog_nodev)"
            fi
        fi
        # Doors shut by the body (nftables sets); normally none.
        if command -v nft >/dev/null 2>&1 && sudo -n nft list table inet wyrdsekai >/dev/null 2>&1; then
            local _closed; _closed="$(sudo -n nft list set inet wyrdsekai closed4 2>/dev/null | grep -c '\.' || true)"
            [[ "${_closed:-0}" -gt 0 ]] && { warn "$(_t doctor.doors_closed "$_closed")"; _wbump; }
        fi
        # The brainstem snapshots the record with sqlite3 before a restart; without it the
        # snapshot is a plain copy of a live database.
        if [[ -x /opt/wyrdsekai/bin/wyrdsekai-brainstem || -f /etc/systemd/system/wyrdsekai-brainstem.service ]]; then
            if command -v sqlite3 >/dev/null 2>&1; then log "$(_t doctor.sqlite3_present)"; else warn "$(_t doctor.sqlite3_missing)"; _wbump; fi
        fi
        local _swp; _swp="$(cat /proc/sys/vm/swappiness 2>/dev/null || true)"
        [[ -n "$_swp" && "$_swp" -gt 20 ]] && info "$(_t doctor.swappiness "$_swp")"
    fi

    case "$platform" in
        Darwin) log "$(_t doctor.ram "$(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%.0f GB", $1/1073741824}')")" ;;
        Linux)  log "$(_t doctor.ram "$(free -h 2>/dev/null | awk '/Mem:/{print $2}')")" ;;
    esac

    case "$platform" in
        Darwin) log "$(_t doctor.gpu_apple)" ;;
        Linux)
            if command -v nvidia-smi &>/dev/null; then
                log "$(_t doctor.gpu_nvidia "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'NVIDIA')")"
            else
                warn "$(_t doctor.gpu_none)"
            fi
            # Generation through CPU-resident experts is limited by memory speed, so turbo boost
            # there is heat and fan noise for no tokens.
            if _experts_on_cpu; then
                local _boost; _boost="$(_cpu_boost_state)"
                if [[ "$_boost" == on* ]]; then
                    local _bf _bv; read -r _ _bf _bv <<< "$_boost"
                    log "$(_t doctor.cpu_boost_on "$_bf" "$_bv")"
                elif [[ "$_boost" == "off" ]]; then
                    log "$(_t doctor.cpu_boost_off)"
                fi
            fi ;;
    esac

    echo ""
    find_java && log "$(_t doctor.java "$(${JAVA_CMD} -version 2>&1 | head -1)")" \
        || { warn "$(_t doctor.java_missing)"; _ebump; }
    command -v docker &>/dev/null && log "$(_t doctor.docker "$(docker --version 2>/dev/null | head -1)")" \
        || warn "$(_t doctor.docker_missing)"

    # ── Releases: this node, and the two programs it leans on ──
    local _rel_installed _rel_latest
    _rel_installed="$(_installed_version)"
    if [[ "$(_update_mode)" != "off" ]]; then
        _rel_latest="$(_release_latest "$WYRDSEKAI_RELEASE_REPO")"
        if [[ -z "$_rel_latest" ]]; then info "$(_t doctor.release_unknown "$_rel_installed")"
        elif _version_newer "$_rel_latest" "$_rel_installed"; then warn "$(_t doctor.release_newer "$_rel_installed" "$_rel_latest")"; _wbump
        else log "$(_t doctor.release "$_rel_installed" "$_rel_latest")"; fi
        local _cz_bin _cz_ver _cz_latest
        _cz_bin="$(command -v codezaiku 2>/dev/null || true)"
        [[ -z "$_cz_bin" ]] && for _c in "$DATA_DIR/coding-cli-bundle/codezaiku/codezaiku/bin/codezaiku" "$PROJECT_ROOT/data/coding-cli-bundle/codezaiku/codezaiku/bin/codezaiku"; do [[ -x "$_c" ]] && { _cz_bin="$_c"; break; }; done
        if [[ -n "$_cz_bin" ]]; then
            _cz_ver="$("$_cz_bin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
            _cz_latest="$(_release_latest Wyrdsekai/codezaiku)"
            if [[ -n "$_cz_latest" && -n "$_cz_ver" ]] && _version_newer "$_cz_latest" "$_cz_ver"; then warn "$(_t doctor.sibling_newer codezaiku "$_cz_ver" "$_cz_latest" "wyrd coding update codezaiku")"; _wbump
            else log "$(_t doctor.sibling codezaiku "${_cz_ver:-?}" "${_cz_latest:-?}")"; fi
        fi
        local _rz_bin_d _rz_ver _rz_latest
        _rz_bin_d="$(_rz_bin 2>/dev/null || true)"
        if [[ -n "$_rz_bin_d" ]]; then
            _rz_ver="$("$_rz_bin_d" version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
            _rz_latest="$(_release_latest Wyrdsekai/researchzosho)"
            if [[ -n "$_rz_latest" && -n "$_rz_ver" ]] && _version_newer "$_rz_latest" "$_rz_ver"; then warn "$(_t doctor.sibling_newer researchzosho "$_rz_ver" "$_rz_latest" "wyrd researcher update")"; _wbump
            else log "$(_t doctor.sibling researchzosho "${_rz_ver:-?}" "${_rz_latest:-?}")"; fi
        fi
    fi
    # The library's model: sharing the companions' brain is the default. Said as information, with
    # the command that gives it a GPU of its own; never a warning.
    local _rz_found
    if _rz_found="$(_rz_bin_for_update 2>/dev/null)"; then _rz_gpu_suggest "${_rz_found%% *}" "${_rz_found#* }"; fi

    if curl -s http://localhost:${PORT:-7070}/health &>/dev/null; then
        log "$(_t doctor.server_running)"
        # a near-empty Library starves every knowledge-grounded
        # feature (and the agents' curiosity loop). Surface it with the fix in hand.
        local lib_chunks
        lib_chunks=$(curl -sf "http://localhost:${PORT:-7070}/api/library/status" 2>/dev/null \
            | python3 -c "import json,sys
try:
    d=json.load(sys.stdin)
    print(d.get('totalChunks', d.get('chunks', sum(p.get('chunks',0) for p in d.get('packs',[]) if isinstance(p,dict)))))
except Exception:
    print('')" 2>/dev/null || true)
        if [[ -n "$lib_chunks" && "$lib_chunks" =~ ^[0-9]+$ ]]; then
            if [[ "$lib_chunks" -lt 200 ]]; then
                warn "$(_t doctor.library_sparse "$lib_chunks")"
                echo "    $(_t doctor.library_sparse_hint)"
                _wbump
            else
                log "$(_t doctor.library_ok "$lib_chunks")"
            fi
        fi
    else
        warn "$(_t doctor.server_stopped)"
        _wbump
    fi

    if curl -s http://localhost:8222/healthz &>/dev/null; then
        log "$(_t doctor.nats_running)"
    else
        warn "$(_t doctor.nats_stopped)"
        _wbump
    fi

    # ── Encryption on this home's own ports ( W2) ──
    echo ""
    log "$(_t doctor.tls_header)"
    local _tls_rc=0
    _doctor_household_tls || _tls_rc=$?
    if [[ "$_tls_rc" -eq 1 ]]; then _wbump; fi
    if [[ "$_tls_rc" -eq 2 ]]; then _ebump; fi

    echo ""
    log "$(_t doctor.port_scan_header)"
    for port in "${PORT:-7070}" "${WYRDSEKAI_TLS_PORT:-7443}" 7071 7022 4222 4223 8222 8888; do   # #9 2026-07-19 — API port honors WYRDSEKAI_PORT
        # Where there is no `ss` (macOS), a local connect: `lsof` without sudo cannot see a port
        # held by another user, and the Mac's server runs as root, so every port but one read free.
        if ss -tlnp 2>/dev/null | grep -q ":${port} " || (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
            log "$(_t doctor.port_in_use "$port")"
        fi
    done

    # ── F8 §1: Process exclusivity (split-brain detection) ──
    echo ""
    log "$(_t doctor.process_excl_header)"
    local inv jvm_pids jvm_count
    inv=$(_doctor_process_inventory)
    if [[ -z "$inv" ]]; then
        log "$(_t doctor.process_none)"
    else
        echo "$inv" | while IFS=$'\t' read -r src pid note; do
            log "$(_t doctor.process_entry "$src" "$pid" "$note")"
        done
        # Conflict detection — multiple distinct JVMs running concurrently.
        # `grep -c .` exits 1 on no match, which kills the script under
        # `set -euo pipefail`. Trap with `|| true` and let wc do the count.
        jvm_pids=$(echo "$inv" | awk -F'\t' '$1=="jvm"||$1=="gradle"{print $2}' | sort -u)
        jvm_count=$(echo -n "$jvm_pids" | grep -c . || true)
        if [[ "$jvm_count" -gt 1 ]]; then
            err "$(_t doctor.process_split_brain "$jvm_count")"
            _ebump
        fi
        # PID file vs reality.
        if echo "$inv" | grep -q $'^pidfile\t.*\tstale$'; then
            warn "$(_t doctor.process_pidfile_stale)"
            _wbump
        fi
    fi

    # ── F8 §2: State coherence (uses wyrd state dump) ──
    echo ""
    log "$(_t doctor.state_header)"
    local state_summary
    # The inference queue in plain words. The companion's in-fiction line for a
    # backed-up queue is hers; the numbers are the steward's (field report 2026-09-13).
    local inf_json
    inf_json=$(curl -sf -m 3 "http://localhost:${WYRDSEKAI_PORT:-7070}/health" 2>/dev/null || true)
    if [[ -n "$inf_json" ]]; then
        local inf_line
        inf_line=$(printf '%s' "$inf_json" | python3 -c '
import json,sys
d=json.load(sys.stdin).get("inference") or {}
if not d: sys.exit(0)
q=d.get("queued",0); f=d.get("inFlight",0); m=d.get("maxConcurrency","?")
p95=d.get("p95LatencyMs",0); n=d.get("latencySamples",0)
s="inference: %d in flight, %d waiting (max %s); p95 %.1fs over %d requests" % (f,q,m,p95/1000.0,n)
if d.get("paused"): s+="; PAUSED until %s (%s)" % (d.get("pausedUntil","?"), d.get("pauseReason",""))
print(("WARN " if q>=5 else "OK ")+s)
' 2>/dev/null || true)
        if [[ "$inf_line" == WARN* ]]; then
            warn "${inf_line#WARN }  — companions answer slowly; raise WYRDSEKAI_INFERENCE_CONCURRENCY only if the server has slots (LLAMA_*_PARALLEL)"
            _wbump
        elif [[ -n "$inf_line" ]]; then
            log "${inf_line#OK }"
        fi
    fi
    state_summary=$(do_state dump --summary 2>/dev/null || true)
    if [[ -z "$state_summary" ]]; then
        warn "$(_t doctor.state_unavailable)"
        _wbump
    else
        # The ⚠ markers in the state summary are the F7b consolidation roadmap —
        # attributes that still live in two stores by design (bonds mirrored into
        # the manifest, voice profiles only in the manifest, …). They are notes on
        # where the data lives, not faults, and a field report (2026-09-13) read
        # them as "persistent fragmentation warnings" the steward could not fix.
        # Say what they are; count only a real detail_error as a warning.
        local alerts
        alerts=$(echo "$state_summary" | grep -E '^\s+⚠\s' || true)
        local errors
        errors=$(echo "$state_summary" | grep -iE 'detail_error|error:' || true)
        if [[ -n "$errors" ]]; then
            warn "$(_t doctor.state_errors)"
            echo "$errors" | head -6 | sed 's/^/    /'
            _wbump
        fi
        if [[ -n "$alerts" ]]; then
            local n
            n=$(echo "$alerts" | grep -c .)
            log "$(_t doctor.state_notes "$n")"
        else
            log "$(_t doctor.state_no_alerts)"
        fi
        # Check the soul_manifest_blob "split storage" line.
        if echo "$state_summary" | grep -q "split storage"; then
            warn "$(_t doctor.state_split_storage)"
            _wbump
        fi
    fi

    # ── F8 §3: Federation reachability ──
    echo ""
    log "$(_t doctor.fed_header)"
    if [[ -z "$state_summary" ]]; then
        log "$(_t doctor.fed_skipped)"
    else
        local agreements
        agreements=$(echo "$state_summary" | awk '/^  bilateral_agreements:/{print $2}')
        if [[ -z "$agreements" || "$agreements" == "0" ]]; then
            log "$(_t doctor.fed_none)"
        else
            log "$(_t doctor.fed_count "$agreements")"
            # Best-effort: if the server is running locally, ask it for live status.
            # `|| true` so curl/python failures (server down, malformed JSON)
            # don't trip `set -euo pipefail` and abort the doctor mid-run.
            local fed_status
            fed_status=$(curl -sf "http://localhost:${PORT:-7070}/api/federation/status" 2>/dev/null \
                | python3 -c "import sys,json;d=json.load(sys.stdin);print(d.get('status','unknown'))" 2>/dev/null || true)
            if [[ -n "$fed_status" && "$fed_status" != "unknown" ]]; then
                log "$(_t doctor.fed_live_status "$fed_status")"
                if [[ "$fed_status" == *pending* || "$fed_status" == *stale* ]]; then
                    warn "$(_t doctor.fed_flagged "$fed_status")"
                    _wbump
                fi
            fi
        fi
    fi

    _doctor_build_coherence

    # ── F8 §4: Identity coherence ──
    echo ""
    log "$(_t doctor.identity_header)"
    local identity_file
    identity_file="$DATA_DIR/node-identity.json"
    if [[ ! -f "$identity_file" ]]; then
        # System-mode fallback path.
        [[ -f /var/lib/wyrdsekai/node-identity.json ]] && identity_file=/var/lib/wyrdsekai/node-identity.json
    fi
    if [[ -f "$identity_file" ]]; then
        local id_check
        id_check=$(python3 - "$identity_file" <<'PY' 2>&1
import sys, json, base64
try:
    d = json.load(open(sys.argv[1]))
    if not d.get("nodeId"):
        print("ERROR: nodeId missing"); sys.exit(2)
    pk = d.get("publicKey","")
    if not pk:
        print("ERROR: publicKey missing"); sys.exit(2)
    base64.b64decode(pk)
    print(f"OK nodeId={d['nodeId'][:8]}…")
except Exception as e:
    print(f"ERROR: {e}"); sys.exit(2)
PY
        )
        if [[ "$id_check" == OK* ]]; then
            log "$(_t doctor.identity_ok "$identity_file" "$id_check")"
        else
            err "$(_t doctor.identity_bad "$identity_file" "$id_check")"
            _ebump
        fi
    else
        warn "$(_t doctor.identity_missing)"
        _wbump
    fi

    # ── F24 Phase 3: Relay NKey health ──
    echo ""
    log "$(_t doctor.relay_header)"
    _doctor_relay_nkey
    local _r=$?
    if [[ "$_r" -eq 1 ]]; then _wbump; fi
    if [[ "$_r" -eq 2 ]]; then _ebump; fi

    # ── Relay diversity: single-relay topology warning ──
    # If federation is enabled and we only know ONE relay path, surface a
    # warning. The protocol allows multiple; in practice Nostr taught us that
    # one shared relay becomes a centralization bottleneck if nobody else
    # stands up a peer. Not an error — solo households are valid.
    _doctor_relay_diversity
    local _rd=$?
    if [[ "$_rd" -eq 1 ]]; then _wbump; fi

    # ──: Nostr adapter health ──
    # Only fires if Nostr is enabled. Reports configured-relay count and
    # surfaces warnings if any relay is unreachable. The exit code stays
    # warning-level (not error) — Nostr is opt-in and a flaky relay isn't
    # a wyrdsekai-side fault.
    _doctor_nostr
    local _nostr_rc=$?
    if [[ "$_nostr_rc" -eq 1 ]]; then _wbump; fi

    # ──: neglect probes ──
    # Surface companions whose substrate state has been left unattended:
    # repair modes stuck in non-NONE past the canonical handoff window,
    # sanctuary sessions open beyond the typical resolve window, protection
    # flags that should have decayed but didn't, and lingering bear-the-
    # wound entries without a release/amends. Pure local file scan — no
    # server required.
    _doctor_substrate_neglect
    _doctor_brain_move
    local _sub_rc=$?
    if [[ "$_sub_rc" -eq 1 ]]; then _wbump; fi
    if [[ "$_sub_rc" -eq 2 ]]; then _ebump; fi

    # ── Her own time: turns that never become acts ──
    # The trail is the one instrument that sees own time; the live suites are a person asking.
    _doctor_own_time
    if [[ $? -eq 1 ]]; then _wbump; fi

    # ── Summary + exit code ──
    echo ""
    if [[ "$_doctor_errors" -gt 0 ]]; then
        err "$(_t doctor.summary_errors "$_doctor_errors" "$_doctor_warns")"
        return 2
    elif [[ "$_doctor_warns" -gt 0 ]]; then
        warn "$(_t doctor.summary_warns "$_doctor_warns")"
        return 1
    else
        log "$(_t doctor.summary_healthy)"
        return 0
    fi
}

# W2 — HTTPS on :7443 with the household certificate and its expiry, the
# household bus's TLS and login, private key files, and every setting that re-opens a plain door.
# Returns 0 = fine, 1 = warnings, 2 = errors.
_doctor_household_tls() {
    local rc=0 tlsdir="$DATA_DIR/tls" tls_port="${WYRDSEKAI_TLS_PORT:-7443}"
    # `tr`, not ${1,,}: macOS ships bash 3.2, where that is "bad substitution" and the doctor stopped here.
    _is_on() { case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in true|1|yes|on) return 0 ;; *) return 1 ;; esac; }
    _is_lan_bind() { case "$1" in ""|127.*|localhost|::1|lo) return 1 ;; *) return 0 ;; esac; }
    if [[ ! -f "$tlsdir/household-ca.pem" ]]; then
        warn "$(_t doctor.tls_no_ca "$tlsdir")"
        rc=1
    else
        local fp
        fp=$(python3 -c '
import sys, base64, hashlib
pem = open(sys.argv[1]).read()
b64 = pem.split("-----BEGIN CERTIFICATE-----")[1].split("-----END CERTIFICATE-----")[0]
print(hashlib.sha256(base64.b64decode("".join(b64.split()))).hexdigest())' "$tlsdir/household-ca.pem" 2>/dev/null)
        log "$(_t doctor.tls_ca "$fp")"
        if _is_on "${WYRDSEKAI_TLS_ENABLED:-true}"; then
            local probe
            probe=$(python3 -c '
import ssl, socket, sys, time
ctx = ssl.create_default_context(cafile=sys.argv[1])
ctx.check_hostname = False
try:
    with socket.create_connection(("127.0.0.1", int(sys.argv[2])), timeout=3) as raw:
        with ctx.wrap_socket(raw) as t:
            end = ssl.cert_time_to_seconds(t.getpeercert()["notAfter"])
            print("OK %d" % int((end - time.time()) // 86400))
except ssl.SSLError as e:
    print("BADCERT %s" % e.reason)
except Exception as e:
    print("DOWN %s" % e.__class__.__name__)' "$tlsdir/household-ca.pem" "$tls_port" 2>/dev/null)
            case "$probe" in
                OK*)
                    local days="${probe#OK }"
                    if [[ "$days" -lt 30 ]]; then
                        warn "$(_t doctor.tls_https_expiring "$tls_port" "$days")"; rc=1
                    else
                        log "$(_t doctor.tls_https_ok "$tls_port" "$days")"
                    fi ;;
                BADCERT*)
                    warn "$(_t doctor.tls_https_badcert "$tls_port" "${probe#BADCERT }")"; rc=1 ;;
                *)
                    warn "$(_t doctor.tls_https_down "$tls_port")"; rc=1 ;;
            esac
        else
            warn "$(_t doctor.tls_https_off)"; rc=1
        fi
    fi
    local varz
    varz=$(curl -s --max-time 3 http://127.0.0.1:8222/varz 2>/dev/null)
    if [[ -n "$varz" ]]; then
        local bus
        bus=$(printf '%s' "$varz" | python3 -c '
import json, sys
v = json.load(sys.stdin)
ws = v.get("websocket") or {}
ws_tls = (not ws) or (bool(ws.get("tls_cert_not_after")) and not ws.get("no_tls"))
print("%s %s %s" % (bool(v.get("tls_required")), bool(v.get("auth_required")), ws_tls))' 2>/dev/null)
        local b_tls b_auth b_ws
        read -r b_tls b_auth b_ws <<< "$bus"
        if [[ "$b_auth" == "True" ]]; then log "$(_t doctor.tls_bus_auth_on)"; else err "$(_t doctor.tls_bus_auth_off)"; rc=2; fi
        if [[ "$b_tls" == "True" ]]; then log "$(_t doctor.tls_bus_tls_on)"; else warn "$(_t doctor.tls_bus_tls_off)"; [[ $rc -lt 1 ]] && rc=1; fi
        if [[ "$b_ws" != "True" ]]; then warn "$(_t doctor.tls_bus_ws_plain)"; [[ $rc -lt 1 ]] && rc=1; fi
    fi
    local f
    for f in "$DATA_DIR/node-identity.json" "$tlsdir/household-ca.key" "$tlsdir/household-leaf.key" \
             "$tlsdir/keystore.pass" "$DATA_DIR/nats/bus-users.json" "$DATA_DIR/nats/hub.json"; do
        [[ -f "$f" ]] || continue
        local mode
        mode=$(stat -c '%a' "$f" 2>/dev/null || stat -f '%Lp' "$f" 2>/dev/null)
        case "$mode" in 600|640|400) ;; *) warn "$(_t doctor.tls_file_mode "$f" "$mode")"; [[ $rc -lt 1 ]] && rc=1 ;; esac
    done
    # Settings that keep an old plain door open during the transition. Each one is a warning.
    if _is_on "${WYRDSEKAI_HTTP_LAN_PLAINTEXT:-}"; then warn "$(_t doctor.tls_plain_setting WYRDSEKAI_HTTP_LAN_PLAINTEXT "$(_t doctor.tls_plain_http)")"; [[ $rc -lt 1 ]] && rc=1; fi
    if _is_lan_bind "${WYRDSEKAI_HTTP_BIND:-}"; then warn "$(_t doctor.tls_plain_setting WYRDSEKAI_HTTP_BIND "$(_t doctor.tls_plain_http)")"; [[ $rc -lt 1 ]] && rc=1; fi
    if _is_on "${WYRDSEKAI_NATS_LAN_PLAINTEXT:-}"; then warn "$(_t doctor.tls_plain_setting WYRDSEKAI_NATS_LAN_PLAINTEXT "$(_t doctor.tls_plain_bus)")"; [[ $rc -lt 1 ]] && rc=1; fi
    if _is_on "${WYRDSEKAI_TELNET_ENABLED:-}" && _is_lan_bind "${WYRDSEKAI_TELNET_BIND:-}"; then warn "$(_t doctor.tls_plain_setting WYRDSEKAI_TELNET_BIND "$(_t doctor.tls_plain_telnet)")"; [[ $rc -lt 1 ]] && rc=1; fi
    if _is_lan_bind "${WYRDSEKAI_WEB_TERMINAL_BIND:-}" && [[ ! -r "$tlsdir/household-leaf.key" ]]; then warn "$(_t doctor.tls_plain_setting WYRDSEKAI_WEB_TERMINAL_BIND "$(_t doctor.tls_plain_web)")"; [[ $rc -lt 1 ]] && rc=1; fi
    if _is_on "${WYRDSEKAI_TUNNEL_ALLOW_PLAINTEXT:-}"; then warn "$(_t doctor.tls_plain_setting WYRDSEKAI_TUNNEL_ALLOW_PLAINTEXT "$(_t doctor.tls_plain_tunnel)")"; [[ $rc -lt 1 ]] && rc=1; fi
    if _is_on "${WYRDSEKAI_RELAY_ALLOW_PLAINTEXT_REQUESTS:-}"; then warn "$(_t doctor.tls_plain_setting WYRDSEKAI_RELAY_ALLOW_PLAINTEXT_REQUESTS "$(_t doctor.tls_plain_requests)")"; [[ $rc -lt 1 ]] && rc=1; fi
    return $rc
}

# F24 Phase 3 — diagnose the NKey relay-auth flow. Returns:
#   0 = healthy / no relay configured
#   1 = warning (auth violations observed but maybe transient, or NKey aging)
#   2 = error (clearly broken — recovery hint surfaced)
_doctor_relay_nkey() {
    # Where to look for the log.
    local log_candidates=()
    [[ -f "$LOG_FILE" ]] && log_candidates+=("$LOG_FILE")
    [[ -f /var/log/wyrdsekai.log ]] && log_candidates+=("/var/log/wyrdsekai.log")
    [[ -f /var/lib/wyrdsekai/.server.log ]] && log_candidates+=("/var/lib/wyrdsekai/.server.log")
    # systemd journal as last resort.
    local journal_log=""
    if command -v journalctl &>/dev/null; then
        journal_log="$(journalctl -u wyrdsekai -n 200 --no-pager 2>/dev/null || true)"
    fi

    # Identity file age — pubkey rotation hint.
    local identity_file="$DATA_DIR/node-identity.json"
    [[ ! -f "$identity_file" && -f /var/lib/wyrdsekai/node-identity.json ]] \
        && identity_file=/var/lib/wyrdsekai/node-identity.json
    if [[ -f "$identity_file" ]]; then
        local age_days
        if [[ "$(uname -s)" == "Darwin" ]]; then
            age_days=$(( ( $(date +%s) - $(stat -f %m "$identity_file") ) / 86400 ))
        else
            age_days=$(( ( $(date +%s) - $(stat -c %Y "$identity_file") ) / 86400 ))
        fi
        log "$(_t relay_nkey.identity_age "$age_days")"
    fi

    # Auth mode currently configured.
    local use_nkey="${WYRDSEKAI_RELAY_USE_NKEY:-false}"
    local relay_url="${WYRDSEKAI_RELAY_URL:-}"
    if [[ -z "$relay_url" ]]; then
        log "$(_t relay_nkey.no_relay_configured)"
        return 0
    fi
    log "$(_t relay_nkey.auth_mode "$([[ "$use_nkey" == "true" ]] && echo nkey || echo password)")"

    # Scan last 200 lines of available log sources for Authorization Violation
    # against the configured relay. This is the symptom of registration drift
    # (relay forgot us / pubkey not in users[]).
    local violations=0
    local sources=""
    if (( ${#log_candidates[@]} > 0 )); then
        violations=$(tail -n 200 "${log_candidates[@]}" 2>/dev/null \
            | grep -c -i "authorization violation" || true)
        sources="${log_candidates[*]}"
    fi
    if [[ -n "$journal_log" ]]; then
        local jv
        jv=$(echo "$journal_log" | grep -c -i "authorization violation" || true)
        violations=$(( violations + jv ))
        sources="$sources journalctl"
    fi

    if [[ "$violations" -eq 0 ]]; then
        log "$(_t relay_nkey.no_violations)"
        # Last successful relay-connect line, for context. `|| true` so
        # `grep` returning 1 (no match) doesn't trip `set -euo pipefail`.
        if (( ${#log_candidates[@]} > 0 )); then
            local last_ok
            last_ok=$(tail -n 500 "${log_candidates[@]}" 2>/dev/null \
                | grep -E "Relay bridge (connected|reconnected|.*NKey auth)" | tail -1 || true)
            if [[ -n "$last_ok" ]]; then
                # Trim leading log prefix (timestamp/level) for compactness.
                log "$(_t relay_nkey.last_connect "$(echo "$last_ok" | sed 's/^[^]]*\] //' | head -c 120)")"
            fi
        fi
        return 0
    fi

    # Violations seen — surface recovery path.
    err "$(_t relay_nkey.violations_seen "$violations" "$sources")"
    if [[ "$use_nkey" == "true" ]]; then
        echo "$(_t relay_nkey.recovery.nkey_header)"
        echo "$(_t relay_nkey.recovery.nkey_1)"
        echo "$(_t relay_nkey.recovery.nkey_2)"
        echo "$(_t relay_nkey.recovery.nkey_3)"
        echo "$(_t relay_nkey.recovery.nkey_cmd_reregister)"
        echo "$(_t relay_nkey.recovery.nkey_4)"
        echo "$(_t relay_nkey.recovery.nkey_5)"
        echo "$(_t relay_nkey.recovery.nkey_cmd_register)"
    else
        echo "$(_t relay_nkey.recovery.password_header)"
        echo "$(_t relay_nkey.recovery.password_1)"
        echo "$(_t relay_nkey.recovery.password_2)"
        echo "$(_t relay_nkey.recovery.password_cmd_register_nkey)"
        echo "$(_t relay_nkey.recovery.password_3)"
        echo "$(_t relay_nkey.recovery.password_cmd_register)"
    fi
    return 2
}

# Relay diversity — flag single-relay topology as a warning.
# Returns: 0 = ok (no relay, multi-relay, or test mode), 1 = single-relay warn.
#
# Heuristic: WYRDSEKAI_RELAY_URL is set (federation enabled) but no extra
# discovered/configured peer relays. We don't have a clean "list known relays"
# API yet, so we infer single-relay from: only one relay URL appears in
# /api/federation/status agreements + WYRDSEKAI_RELAY_URL is set. If federation
# is off entirely (no WYRDSEKAI_RELAY_URL), this is a solo install — fine.
_doctor_relay_diversity() {
    local relay_url="${WYRDSEKAI_RELAY_URL:-}"
    if [[ -z "$relay_url" ]]; then
        return 0   # no federation → no diversity concern
    fi

    # Best effort: ask federation/status; if unreachable, skip silently.
    local status
    status=$(curl -sf --max-time 3 "http://localhost:${PORT:-7070}/api/federation/status" 2>/dev/null) || return 0

    # Extract unique non-self relay URLs known to this zone. Parse via python3
    # for robustness; if not available, skip.
    if ! command -v python3 &>/dev/null; then
        return 0
    fi
    local count
    count=$(echo "$status" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    relays = set()
    # Different schema versions stash relays under different keys; cover a few.
    for key in ('agreements', 'peers', 'federations'):
        for entry in d.get(key, []) or []:
            url = entry.get('relayUrl') or entry.get('relay') or ''
            if url:
                relays.add(url)
    print(len(relays))
except Exception:
    print(0)
" 2>/dev/null)
    count=${count:-0}

    # 0 known relays means we're either too early in boot or federation is
    # quiet — don't warn. 1 means our own configured relay is all there is.
    if [[ "$count" == "1" ]]; then
        warn "relay-diversity: only one relay path known ($relay_url)."
        warn "  If that relay goes down, cross-zone messaging stops."
        warn "  Consider running your own (wyrd relay deploy-up) or registering"
        warn "  a second household's relay."
        return 1
    fi
    return 0
}

# surface Nostr adapter state.
# Returns: 0 = ok or disabled, 1 = enabled but degraded.
#
# We can't introspect the JVM-side NostrRelayPool from bash, so the check is
# best-effort:
#   - read wyrdsekai.nostr.enabled from env / conf
#   - if enabled, ping each configured wss:// relay with curl --max-time 3 -I
#     (relays answer the HTTP upgrade probe with 400/426; we treat any response
#     as "TCP+TLS reachable")
#   - report unreachable count as warning
_doctor_nostr() {
    local enabled="${WYRDSEKAI_NOSTR_ENABLED:-}"
    if [[ "$enabled" != "true" && "$enabled" != "1" ]]; then
        return 0   # disabled — nothing to check
    fi
    echo ""
    log "doctor.nostr: bridge enabled, probing relays"

    # Pull the relay list from server settings if reachable; otherwise fall
    # back to the defaults.
    local relays=""
    # Audit 2026-07-11: this used to probe /api/state/dump, a route that has
    # never existed — the check silently fell back to the default relay list
    # and ignored a steward's configured publish_relays. The conf file IS the
    # source of truth (same file the server reads); parse it directly.
    for _conf in /etc/wyrdsekai/wyrdsekai.conf "$HOME/.wyrdsekai/wyrdsekai.conf"; do
        if [[ -f "$_conf" ]]; then
            relays=$(grep -E "^(WYRDSEKAI_NOSTR_RELAYS|wyrdsekai.nostr.publish_relays)=" "$_conf" \
                | tail -1 | cut -d= -f2- | tr ',' '\n')
            [[ -n "$relays" ]] && break
        fi
    done
    if [[ -z "$relays" ]]; then
        # Fall back to the SPEC defaults
        relays=$'wss://relay.damus.io\nwss://nos.lol\nwss://relay.snort.social'
    fi

    local total=0 reachable=0
    while IFS= read -r relay; do
        [[ -z "$relay" ]] && continue
        total=$((total + 1))
        # Convert wss:// to https:// for the reachability probe — curl can't
        # do raw WebSocket but it CAN check the TLS handshake + HTTP response.
        local probe="${relay/wss:\/\//https://}"
        if curl -sf --max-time 3 -o /dev/null -w "" "$probe" 2>/dev/null \
           || curl -s --max-time 3 -o /dev/null -w "%{http_code}" "$probe" 2>/dev/null \
              | grep -qE "^(4[0-9]{2}|3[0-9]{2})$"; then
            reachable=$((reachable + 1))
        fi
    done <<< "$relays"

    log "doctor.nostr: $reachable / $total relays reachable"
    if [[ $total -gt 0 && $reachable -eq 0 ]]; then
        warn "doctor.nostr: no relays reachable. Nostr publishes will fail."
        warn "  Check network egress, or revise wyrdsekai.nostr.publish_relays."
        return 1
    fi
    if [[ $total -gt 1 && $reachable -lt $total ]]; then
        warn "doctor.nostr: $((total - reachable)) of $total relays unreachable"
        warn "  Publishes still work (fan-out succeeds if any relay accepts)"
        warn "  but redundancy is degraded."
        return 1
    fi
    return 0
}

# surface neglected substrate state from the
# four tracker JSON files persisted under $DATA_DIR/substrate/. Returns:
#   0 = healthy / no substrate state present
#   1 = warning (stuck repair mode, long-open sanctuary, stale flag past decay)
#   2 = error (CONFIRMED protection flag with no integration event for >30d)
# Local-only — no server required. Pure JSON read.
# Warn when a companion has had own-time turns in the last six hours and not one action of her
# own: no move, no tool, no enactment. On the household node this held for twenty-one hours after
# an adapter change (2026-09-26: every own-time turn ran with the speaking floor, and a floor
# trained on her speech answers a tool request in prose) and nothing said so; the e2e suites read
# 62/63 the same evening because every scene in them is a person asking. Pure local read of
# data/agent-activity.jsonl; no server needed. Returns 1 on a warning.
# A companion moved to the large model in the last week: the record and the way back, so the days
# after a move are read with the move in mind.
_doctor_brain_move() {
    local f; for f in "$DATA_DIR"/adapters/brainwrite/*/move-*.json; do
        [[ -f "$f" ]] || continue
        local line; line=$(python3 - "$f" <<'PY' 2>/dev/null || true
import json, sys, datetime
d = json.load(open(sys.argv[1]))
if not d.get("moved"): raise SystemExit
at = datetime.datetime.fromisoformat(d["moved_at"]); days = (datetime.datetime.now(datetime.timezone.utc) - at).days
if days <= 7: print(f"{d.get('being','?')}|{days}|{d.get('verdict','?')}")
PY
)
        [[ -z "$line" ]] && continue
        local who days verdict; IFS='|' read -r who days verdict <<<"$line"
        log "doctor.brain: $who moved to the large model $days day(s) ago (gate $verdict); the way back is: wyrd brain disable. Record: $f"
    done
}

_doctor_own_time() {
    local trail="$DATA_DIR/data/agent-activity.jsonl"
    [[ -f "$trail" ]] || return 0
    local summary
    summary=$(_own_time_summary "$trail" "${WYRD_DOCTOR_OWN_TIME_HOURS:-6}" 2>&1)
    [[ -z "$summary" ]] && return 0
    echo ""
    log "doctor.own-time: what each companion did with her own time in the last ${WYRD_DOCTOR_OWN_TIME_HOURS:-6} h"
    echo "$summary" | grep -v "^WARN" | sed 's/^/    /'
    if echo "$summary" | grep -q "^WARN"; then
        warn "doctor.own-time: a companion's own time is not becoming acts"
        echo "$summary" | grep "^WARN" | sed 's/^WARN /    /'
        return 1
    fi
    return 0
}

# _own_time_summary <trail> <hours> — one line per companion with own-time turns in the window:
# turns, acts (action + move + enacted rows), lines said; a WARN line when turns >= 3 and fewer than one act per ten turns.
_own_time_summary() {
    python3 - "$1" "$2" <<'PY'
import sys, json, datetime, collections
trail, hours = sys.argv[1], float(sys.argv[2])
since = (datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=hours)).strftime("%Y-%m-%dT%H:%M:%S")
turns = collections.Counter(); acts = collections.Counter(); said = collections.Counter(); names = {}
try:
    f = open(trail, errors="ignore")
except Exception:
    sys.exit(0)
for line in f:
    try:
        d = json.loads(line)
    except Exception:
        continue
    ts = str(d.get("ts") or "")
    if ts < since:
        continue
    # One being writes under two ids (her entity id on speech and moves, her DID on enactments);
    # the row's `agent` name joins them.
    a = d.get("agent") or d.get("agentName") or d.get("agentId") or ""
    if not a:
        continue
    names[a] = a
    k = d.get("kind") or d.get("type") or ""
    if k == "autonomy" and (d.get("decision") in ("idle_curiosity", "overdue_commitments") or d.get("decision") is None):
        turns[a] += 1
    elif k in ("action", "move", "enacted"):
        acts[a] += 1
    elif k == "speak":
        said[a] += 1
for a in sorted(set(turns) | set(acts)):
    n = names.get(a, a)
    print(f"{n}: {turns[a]} own-time turn(s), {acts[a]} act(s), {said[a]} line(s) said")
    if turns[a] >= 3 and acts[a] * 10 < turns[a]:
        what = "not one action of her own" if acts[a] == 0 else f"only {acts[a]} action(s) of her own"
        print(f"WARN {n}: {turns[a]} own-time turns in the last {hours:g} h and {what} (a move, a tool, an enactment). "
              "Her turns are becoming words only; check the serving profile's adapters (wyrd brain status) and the own-time log lines.")
PY
}

_doctor_substrate_neglect() {
    local sub_dir="$DATA_DIR/substrate"
    [[ -d "$sub_dir" ]] || sub_dir=/var/lib/wyrdsekai/substrate
    if [[ ! -d "$sub_dir" ]]; then
        return 0
    fi
    echo ""
    log "doctor.substrate: scanning substrate trackers for neglect signals"

    local mode_json="$sub_dir/repair-mode.json"
    local ledger_json="$sub_dir/repair-ledger.json"
    local att_json="$sub_dir/attendant-sessions.json"
    local rc=0

    # Repair-mode stuck check — any mode != NONE with last handoff >21d
    # warrants a warning; >60d escalates to error (substrate is wedged).
    if [[ -f "$mode_json" ]]; then
        local mode_summary
        mode_summary=$(python3 - "$mode_json" <<'PY' 2>&1
import sys, json, time
try:
    d = json.load(open(sys.argv[1]))
except Exception as e:
    print(f"err parse repair-mode.json: {e}"); sys.exit(0)
now = time.time()
stuck = []
critical = []
modes = d.get("modes", d) if isinstance(d, dict) else {}
for did, val in modes.items() if isinstance(modes, dict) else []:
    mode = val.get("mode") if isinstance(val, dict) else str(val)
    if not mode or mode == "NONE": continue
    last = val.get("lastHandoffAt") if isinstance(val, dict) else None
    age_days = None
    if last:
        try:
            import datetime
            last_t = datetime.datetime.fromisoformat(last.replace("Z","+00:00")).timestamp()
            age_days = int((now - last_t) / 86400)
        except Exception:
            pass
    if age_days is None: continue
    if age_days > 60: critical.append((did, mode, age_days))
    elif age_days > 21: stuck.append((did, mode, age_days))
for did, mode, days in critical:
    print(f"CRITICAL repair-mode {did[:24]}: {mode} stuck {days}d")
for did, mode, days in stuck:
    print(f"WARN repair-mode {did[:24]}: {mode} stuck {days}d")
PY
        )
        if echo "$mode_summary" | grep -q "^CRITICAL"; then
            err "doctor.substrate: repair mode stuck >60d (substrate wedged)"
            echo "$mode_summary" | grep "^CRITICAL" | sed 's/^/    /'
            rc=2
        fi
        if echo "$mode_summary" | grep -q "^WARN"; then
            warn "doctor.substrate: repair mode stuck >21d"
            echo "$mode_summary" | grep "^WARN" | sed 's/^/    /'
            [[ $rc -lt 1 ]] && rc=1
        fi
    fi

    # Long-open sanctuary session check — active session >7d is unusual.
    if [[ -f "$att_json" ]]; then
        local att_summary
        att_summary=$(python3 - "$att_json" <<'PY' 2>&1
import sys, json, time, datetime
try:
    d = json.load(open(sys.argv[1]))
except Exception as e:
    print(f"err parse attendant-sessions.json: {e}"); sys.exit(0)
now = time.time()
long_open = []
sessions = d.get("sessions", d) if isinstance(d, dict) else {}
def iter_sessions(s):
    if isinstance(s, dict):
        for did, lst in s.items():
            if isinstance(lst, list):
                for sess in lst:
                    yield did, sess
            elif isinstance(lst, dict):
                yield did, lst
for did, sess in iter_sessions(sessions):
    if not isinstance(sess, dict): continue
    if sess.get("closedAt"): continue  # closed
    started = sess.get("startedAt") or sess.get("openedAt")
    if not started: continue
    try:
        t = datetime.datetime.fromisoformat(started.replace("Z","+00:00")).timestamp()
        days = int((now - t) / 86400)
    except Exception:
        continue
    if days > 7:
        long_open.append((did, days))
for did, days in long_open:
    print(f"WARN sanctuary {did[:24]}: open {days}d (unresolved repair?)")
PY
        )
        if echo "$att_summary" | grep -q "^WARN"; then
            warn "doctor.substrate: sanctuary session open >7d"
            echo "$att_summary" | grep "^WARN" | sed 's/^/    /'
            [[ $rc -lt 1 ]] && rc=1
        fi
    fi

    # Per-agent protection-flag files: any CONFIRMED flag with no recent
    # integration_event is an error; SUSPECTED past 90d / NOTED past 60d
    # without escalation+clearing is a warn (auto-decay should have run).
    local flag_summary=""
    for flag_file in "$sub_dir"/protection-flags-*.json; do
        [[ -f "$flag_file" ]] || continue
        local out
        out=$(python3 - "$flag_file" <<'PY' 2>&1
import sys, json, time, datetime
try:
    d = json.load(open(sys.argv[1]))
except Exception as e:
    print(f"err parse {sys.argv[1]}: {e}"); sys.exit(0)
now = time.time()
flags = d.get("flags", d) if isinstance(d, dict) else {}
for subject, val in flags.items() if isinstance(flags, dict) else []:
    if not isinstance(val, dict): continue
    state = val.get("state","NONE")
    if state == "NONE" or state == "CLEARED": continue
    setAt = val.get("setAt") or val.get("at")
    age_days = None
    if setAt:
        try:
            t = datetime.datetime.fromisoformat(setAt.replace("Z","+00:00")).timestamp()
            age_days = int((now - t) / 86400)
        except Exception:
            pass
    if state == "CONFIRMED" and age_days and age_days > 30:
        print(f"CRITICAL protection-flag {subject[:24]} CONFIRMED {age_days}d (no clear path)")
    elif state == "SUSPECTED" and age_days and age_days > 90:
        print(f"WARN protection-flag {subject[:24]} SUSPECTED past 90d auto-decay window")
    elif state == "NOTED" and age_days and age_days > 60:
        print(f"WARN protection-flag {subject[:24]} NOTED past 60d auto-decay window")
PY
        )
        flag_summary="$flag_summary
$out"
    done
    if echo "$flag_summary" | grep -q "^CRITICAL"; then
        err "doctor.substrate: confirmed protection flag past 30d"
        echo "$flag_summary" | grep "^CRITICAL" | sed 's/^/    /'
        rc=2
    fi
    if echo "$flag_summary" | grep -q "^WARN"; then
        warn "doctor.substrate: flag past auto-decay window"
        echo "$flag_summary" | grep "^WARN" | sed 's/^/    /'
        [[ $rc -lt 1 ]] && rc=1
    fi

    if [[ $rc -eq 0 ]]; then
        log "doctor.substrate: no neglect signals"
    fi
    return $rc
}

do_uninstall() {
    warn "$(_t uninstall.warning)"
    read -p "$(_t uninstall.prompt_remove_data)" remove_data

    # Best-effort: if this node is registered with a relay, deregister so its
    # registration goes away instead of lingering on the relay's books. NEVER
    # abort uninstall if the relay is unreachable or refuses — this whole block
    # is non-fatal (the `|| true` guard + leave's own best-effort internals).
    if [[ -n "${WYRDSEKAI_RELAY_URL:-}" || -n "${WYRDSEKAI_RELAY_REGISTRATION_URL:-}" ]] \
       || { [[ -f "$ENV_FILE" ]] && grep -q '^WYRDSEKAI_RELAY_' "$ENV_FILE" 2>/dev/null; }; then
        log "Deregistering from relay before uninstall (best-effort)…"
        do_relay leave 2>/dev/null || warn "Relay deregister skipped (unreachable or not configured) — continuing uninstall."
    fi

    do_stop 2>/dev/null || true
    do_nuke 2>/dev/null || true

    # The oracle sidecar and compose containers belong to the install —
    # remove them regardless of the data answer (containers are
    # recreatable; the data dir is what y/N decides). Must happen BEFORE
    # any data wipe: stop_oracle needs the pidfile, and a running
    # container would keep serving deleted model files.
    stop_oracle 2>/dev/null || true
    stop_web_terminal 2>/dev/null || true
    if command -v docker &>/dev/null && _docker_daemon_present; then
        docker rm -f wyrdsekai-llama wyrdsekai-llama-voice wyrdsekai-searxng \
                     wyrdsekai-nats wyrdsekai-oracle 2>/dev/null || true
    fi

    # Remove OS service
    local platform="$(uname -s)"
    case "$platform" in
        Linux)
            # Stop + disable + remove both service units (wyrdsekai + the
            # companion NATS server). The .deb drops them in /lib/systemd —
            # remove those too so a later reinstall picks up the new unit.
            for unit in wyrdsekai-nats wyrdsekai; do
                sudo systemctl stop "$unit" 2>/dev/null || true
                sudo systemctl disable "$unit" 2>/dev/null || true
                sudo rm -f "/etc/systemd/system/${unit}.service" \
                           "/lib/systemd/system/${unit}.service" \
                           "/usr/lib/systemd/system/${unit}.service"
            done
            sudo systemctl daemon-reload 2>/dev/null || true
            # Kill any orphaned NATS process the .deb left behind.
            sudo pkill -f "nats-server.*wyrdsekai" 2>/dev/null || true
            ;;
        Darwin)
            # macOS .pkg: gui-uninstall.sh (bundled in the payload) is the SINGLE
            # source of truth for the full teardown — daemons, plists, CLI
            # symlinks, /usr/local/wyrdsekai, /Applications/Wyrdsekai.app and the
            # pkg receipt — so `wyrd uninstall` and the menu-bar "Uninstall…" do
            # exactly the same thing. (Dragging the app to Trash can't run any of
            # this — see README; that's why this command exists.)
            local uid; uid=$(id -u)
            # Per-user GUI agents (menu-bar app + MLX voice) — gui-uninstall.sh
            # leaves these to the app to drop; from the CLI there's no app, so do it.
            for agent in com.wyrdsekai.menubar com.wyrdsekai.mlx-voice; do
                launchctl bootout "gui/$uid/$agent" 2>/dev/null || true
                rm -f "$HOME/Library/LaunchAgents/${agent}.plist"
            done
            local guiun=""
            for d in /usr/local/wyrdsekai/scripts /opt/wyrdsekai/scripts \
                     "${PROJECT_ROOT:-}/packaging/macos/menubar/helpers"; do
                [[ -f "$d/gui-uninstall.sh" ]] && { guiun="$d/gui-uninstall.sh"; break; }
            done
            if [[ -n "$guiun" ]]; then
                # Run a temp copy: gui-uninstall.sh removes /usr/local/wyrdsekai,
                # so executing it in place could yank itself mid-run.
                local tmp_un="/tmp/wyrd-uninstall.$$.sh"; cp "$guiun" "$tmp_un"
                if [[ "${remove_data:-n}" =~ ^[Yy] ]]; then
                    sudo bash "$tmp_un" --wipe-data || true
                else
                    sudo bash "$tmp_un" || true
                fi
                rm -f "$tmp_un"
            else
                # Fallback (source checkout / pre-helper install): inline best-effort.
                for label in dev.wyrdsekai.server org.wyrdsekai.server com.wyrdsekai.server com.wyrdsekai.brainstem com.wyrdsekai.oracle; do
                    sudo launchctl bootout "system/$label" 2>/dev/null || true
                done
                sudo rm -f /Library/LaunchDaemons/com.wyrdsekai.server.plist \
                           /Library/LaunchDaemons/com.wyrdsekai.brainstem.plist \
                           /Library/LaunchDaemons/com.wyrdsekai.oracle.plist \
                           /Library/LaunchDaemons/org.wyrdsekai.server.plist \
                           /Library/LaunchDaemons/dev.wyrdsekai.server.plist
                sudo rm -f /usr/local/bin/wyrd /usr/local/bin/wyrdsekai-server \
                           /usr/local/bin/wyrdsekai-cli /usr/local/bin/wyrdsekai-daemon
                sudo rm -rf /usr/local/wyrdsekai /Applications/Wyrdsekai.app
                pkgutil --forget org.wyrdsekai.app 2>/dev/null || true
            fi
            # Belt-and-suspenders: kill anything that out-lived its plist (booting
            # out a launchd job does NOT terminate an already-running process).
            sudo pkill -9 -f "com.wyrdsekai"    2>/dev/null || true
            pkill -9 -f "Wyrdsekai.app"         2>/dev/null || true
            sudo pkill -9 -f "wyrdsekai/server" 2>/dev/null || true
            sudo pkill -9 -f "oracle-server"    2>/dev/null || true
            ;;
    esac

    if [[ "${remove_data:-n}" =~ ^[Yy] ]]; then
        # macOS: LaunchDaemon runs as root, so Lucene/vault files are root-owned
        if [[ "$(uname -s)" == "Darwin" ]]; then
            sudo rm -rf "$DATA_DIR"
        else
            rm -rf "$DATA_DIR" 2>/dev/null
        fi
        if [[ -d "$DATA_DIR" ]]; then
            # Docker can leave root-owned files inside the data dir
            warn "$(_t uninstall.wipe_incomplete "${DATA_DIR}")"
        else
            log "$(_t uninstall.data_removed "${DATA_DIR}")"
        fi
        # Named compose volumes (searxng/oracle) are data too
        if command -v docker &>/dev/null && _docker_daemon_present; then
            docker volume ls -q 2>/dev/null | grep -E 'searxng-data|oracle-data' \
                | xargs -r docker volume rm 2>/dev/null || true
        fi
    fi

    log "$(_t uninstall.done)"
}

# Non-interactive nuke-and-pave. The one reach-for command for a clean
# `wyrd discover --lan` → mDNS browse for nearby wyrdsekai nodes.
# Otherwise falls through to the existing zone-naming discover (queries
# the household zone directory over NATS, useful inside a household).
do_discover() {
    if [[ "${1:-}" == "--lan" ]]; then
        local lib_dir
        for d in /usr/local/wyrdsekai/lib/server /opt/wyrdsekai/lib/server \
                 "$PROJECT_ROOT/server/build/install/server/lib"; do
            [[ -d "$d" ]] && { lib_dir="$d"; break; }
        done
        [[ -z "${lib_dir:-}" ]] && { err "$(_t discover.no_install)"; return 1; }
        shift
        java -cp "$lib_dir/*" org.wyrdsekai.core.config.MdnsDiscoveryMain "$@"
    else
        do_naming_admin discover "$@"
    fi
}

# zone-to-zone test reset: stop service, apt purge (wipes /etc/wyrdsekai +
# /var/lib/wyrdsekai via postrm), reinstall from the deb this bin shipped
# with, and start. If WYRDSEKAI_DEB is set, use that path; otherwise look
# for a sibling build/deb/wyrdsekai_*.deb or /tmp/wyrdsekai.deb.
do_purge() {
    local platform="$(uname -s)"
    if [[ "$platform" != "Linux" ]]; then
        err "$(_t purge.linux_only)"
        return 1
    fi
    local yes=false
    [[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && yes=true

    # Dev/repo install fallback. A .deb node carries the `wyrdsekai` dpkg
    # package; a source-checkout `bin/wyrd setup` install does not — so apt has
    # nothing to purge and there's no .deb to reinstall. Rather than bailing on
    # `apt purge`, tear the running install down directly: services, the docker
    # sidecars `wyrd setup` brings up (llama/voice/searxng), oracle, and the
    # data dir. Mirrors `do_uninstall`'s teardown, sans the systemd/.deb bits.
    if ! { command -v dpkg-query >/dev/null 2>&1 \
           && dpkg-query -W -f='${Status}' wyrdsekai 2>/dev/null | grep -q "ok installed"; }; then
        warn "$(_t purge.dev_detected)"
        if ! $yes; then
            read -p "$(_t purge.prompt_proceed)" ans
            [[ "${ans:-n}" =~ ^[Yy] ]] || { echo "Cancelled."; return 0; }
        fi
        do_stop 2>/dev/null || true
        stop_oracle 2>/dev/null || true
        stop_web_terminal 2>/dev/null || true
        if command -v docker >/dev/null 2>&1; then
            docker rm -f wyrdsekai-llama wyrdsekai-llama-voice wyrdsekai-searxng \
                         wyrdsekai-nats wyrdsekai-oracle 2>/dev/null || true
            docker volume ls -q 2>/dev/null | grep -E 'searxng-data|oracle-data' \
                | xargs -r docker volume rm 2>/dev/null || true
        fi
        # Native searxng `wyrd setup` may start when docker isn't the chosen path.
        pkill -f "/usr/local/searxng" 2>/dev/null || true
        rm -rf "$DATA_DIR" 2>/dev/null
        log "$(_t purge.dev_done)"
        return 0
    fi

    if ! command -v apt-get >/dev/null 2>&1; then
        err "$(_t purge.no_apt)"
        return 1
    fi
    if ! $yes; then
        warn "$(_t purge.warn_header)"
        echo "$(_t purge.step_1)"
        echo "$(_t purge.step_2)"
        echo "$(_t purge.step_3)"
        echo ""
        read -p "$(_t purge.prompt_proceed)" ans
        [[ "${ans:-n}" =~ ^[Yy] ]] || { echo "Cancelled."; return 0; }
    fi
    sudo apt-get purge -y wyrdsekai || {
        err "$(_t purge.apt_failed)"
        return 1
    }
    local deb="${WYRDSEKAI_DEB:-}"
    if [[ -z "$deb" ]]; then
        for candidate in \
            "$(dirname "$(readlink -f "$0")")/../build/deb/wyrdsekai_0.1.0_amd64.deb" \
            "/tmp/wyrdsekai.deb"; do
            [[ -f "$candidate" ]] && { deb="$candidate"; break; }
        done
    fi
    if [[ -z "$deb" || ! -f "$deb" ]]; then
        warn "$(_t purge.state_wiped)"
        echo "$(_t purge.state_wiped_hint)"
        return 0
    fi
    _install_deb "$deb" || { err "$(_t purge.dpkg_failed)"; return 1; }
    sudo systemctl start wyrdsekai || { err "systemctl start failed"; return 1; }
    log "$(_t purge.done)"
    log "$(_t purge.steward_hint)"
}

# ── Backup / Restore ──

# ── wyrd model — model-material lifecycle (P0/P1 data-durability, 2026-07-09) ──
do_model() {
    local sub="$1" arg="$2"
    local idx; idx=$(_models_index) || { err "models-index.json not found (source tree or /opt/wyrdsekai)"; return 1; }
    case "$sub" in
        status|"")
            echo "Model status (index: $idx)"
            python3 - "$idx" "$MODELS_DIR" "$DATA_DIR/adapters/brain" <<'PY'
import json, os, sys
idx, mdir, adir = sys.argv[1], sys.argv[2], sys.argv[3]
manifest = {}
mf = os.path.join(mdir, "models-manifest.jsonl")
if os.path.exists(mf):
    for line in open(mf):
        try:
            e = json.loads(line); manifest[e.get("file")] = e
        except Exception: pass
for m in json.load(open(idx)).get("models", []):
    lf = m.get("local_file") or ""
    if not m.get("url"):
        print(f"  {m['id']:<24} {m.get('version','?'):<28} (bundled/informational)")
        continue
    path = os.path.join(adir if m.get("kind") == "adapter" else mdir, lf)
    if not os.path.exists(path):
        print(f"  {m['id']:<24} {m.get('version','?'):<28} NOT INSTALLED")
        continue
    rec = manifest.get(os.path.basename(lf))
    if rec is None:
        print(f"  {m['id']:<24} {m.get('version','?'):<28} present, UNVERIFIED (run: wyrd model verify)")
    elif rec.get("version") == m.get("version") and (not m.get("sha256") or rec.get("sha256") == m.get("sha256")):
        print(f"  {m['id']:<24} {rec.get('version','?'):<28} up to date")
    else:
        print(f"  {m['id']:<24} local={rec.get('version','?')} index={m.get('version','?')}  UPDATE AVAILABLE (wyrd model update {m['id']})")
PY
            ;;
        verify)
            echo "Verifying local model files against the index (hashing — may take a minute)..."
            python3 - "$idx" "$MODELS_DIR" "$DATA_DIR/adapters/brain" <<'PY'
import hashlib, json, os, sys, datetime
idx, mdir, adir = sys.argv[1], sys.argv[2], sys.argv[3]
def sha(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 22), b""): h.update(chunk)
    return h.hexdigest()
mf = os.path.join(mdir, "models-manifest.jsonl")
out = open(mf, "a")
for m in json.load(open(idx)).get("models", []):
    lf = m.get("local_file") or ""
    path = os.path.join(adir if m.get("kind") == "adapter" else mdir, lf)
    if not m.get("url") or not os.path.isfile(path): continue
    digest = sha(path)
    known = m.get("sha256")
    ver = m.get("version") if (known is None or digest == known) else "unknown"
    status = "matches index" if digest == known else ("recorded (index sha unknown)" if known is None else "DOES NOT MATCH index sha — version unknown")
    print(f"  {m['id']:<24} {status}")
    out.write(json.dumps({"v":1,"file":os.path.basename(lf),"id":m["id"],"version":ver,
        "sha256":digest,"source_url":"verify","recorded_at":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")})+"\n")
out.close()
print("Manifest updated:", mf)
PY
            ;;
        update)
            [ -z "$arg" ] && { err "usage: wyrd model update <id>   (see: wyrd model status)"; return 1; }
            local url ver lf sha
            url=$(_index_field "$arg" url); ver=$(_index_field "$arg" version)
            lf=$(_index_field "$arg" local_file); sha=$(_index_field "$arg" sha256)
            [ -z "$url" ] && { err "model '$arg' not in index or has no download url"; return 1; }
            local dest; dest=$(_model_local_path "$arg") || { err "model '$arg' has no local file name in the index"; return 1; }
            mkdir -p "$(dirname "$dest")"
            log "Updating $arg → $ver"
            # _model_fetch walks HF then wyrdsekai.org and verifies sha256 per
            # mirror, so a stale mirror falls through to the next instead of
            # failing the update outright.
            if ! _model_fetch "$arg" "$dest.part"; then rm -f "$dest.part"; err "download failed (all mirrors)"; return 1; fi
            if [ -n "$sha" ]; then
                local got; got=$(sha256sum "$dest.part" | cut -d' ' -f1)
                [ "$got" != "$sha" ] && { err "sha256 mismatch (got $got, expected $sha) — NOT installing"; rm -f "$dest.part"; return 1; }
                log "sha256 verified"
            fi
            [ -f "$dest" ] && mv "$dest" "$dest.prev" && log "previous kept at $(basename "$dest").prev (wyrd model rollback $arg)"
            mv "$dest.part" "$dest"
            _relink_work_adapter "$dest" "$dest.prev"
            _model_record "$dest" "$arg" "$ver" "${WYRD_FETCH_URL:-$url}"
            _model_history "$arg" "update" "→ $ver"
            log "$arg updated to $ver. Restart inference to load it: wyrd restart"
            ;;
        rollback)
            [ -z "$arg" ] && { err "usage: wyrd model rollback <id>"; return 1; }
            local dest2; dest2=$(_model_local_path "$arg") || { err "model '$arg' not in index"; return 1; }
            [ -f "$dest2.prev" ] || { err "no previous version kept for $arg"; return 1; }
            mv "$dest2" "$dest2.rolledback" 2>/dev/null
            mv "$dest2.prev" "$dest2"
            mv "$dest2.rolledback" "$dest2.prev" 2>/dev/null
            _relink_work_adapter "$dest2" "$dest2.prev"
            # Re-identify the restored file honestly: index version if the hash matches, else unknown.
            local rbsha rbver
            rbsha=$(sha256sum "$dest2" | cut -d' ' -f1)
            rbver="unknown"
            [ "$rbsha" = "$(_index_field "$arg" sha256)" ] && rbver=$(_index_field "$arg" version)
            _model_record "$dest2" "$arg" "$rbver" "rollback"
            _model_history "$arg" "rollback" "swapped .prev back"
            log "$arg rolled back. Restart inference: wyrd restart"
            ;;
        check)
            echo "Inference health:"
            curl -sf http://localhost:8200/health >/dev/null 2>&1 && echo "  :8200 (drive) OK" || echo "  :8200 (drive) DOWN"
            curl -sf http://localhost:8201/health >/dev/null 2>&1 && echo "  :8201 (voice) OK" || echo "  :8201 (voice) DOWN"
            local reply
            reply=$(curl -sf http://localhost:8200/v1/chat/completions -H 'Content-Type: application/json' \
                -d '{"messages":[{"role":"user","content":"Reply with exactly: OK"}],"max_tokens":8,"temperature":0}' 2>/dev/null \
                | python3 -c 'import sys,json; print(json.load(sys.stdin)["choices"][0]["message"]["content"].strip())' 2>/dev/null)
            [ -n "$reply" ] && echo "  completion probe: '$reply'" || echo "  completion probe: FAILED"
            [ -f "$MODELS_DIR/models-manifest.jsonl" ] && { echo "Recent manifest entries:"; tail -3 "$MODELS_DIR/models-manifest.jsonl" | sed 's/^/  /'; }
            ;;
        history)
            [ -f "$DATA_DIR/model-history.jsonl" ] && cat "$DATA_DIR/model-history.jsonl" | sed 's/^/  /' || echo "  (no model changes recorded)"
            ;;
        *)
            echo "usage: wyrd model [status|verify|update <id>|rollback <id>|check|history]"
            ;;
    esac
}

do_backup() {
    # Consistency note: copying live libSQL files while the server is writing can capture a
    # mid-transaction state. Warn (don't block) — a slightly-stale backup beats no backup.
    if systemctl is-active wyrdsekai >/dev/null 2>&1 || pgrep -f "org.wyrdsekai.server" >/dev/null 2>&1; then
        warn "$(_t backup.live_warning)"
    fi
    local backup_dir="$DATA_DIR/backups"
    mkdir -p "$backup_dir"
    local ts=$(date +%Y%m%d-%H%M%S)
    local backup_path="$backup_dir/wyrdsekai-$ts"
    mkdir -p "$backup_path"

    echo "$(_t backup.creating "$backup_path")"

    # Database
    for db in "$DATA_DIR"/*.db; do
        [ -f "$db" ] && cp "$db" "$backup_path/" && echo "  $(basename "$db")"
    done

    # JetStream data (account replication, persistent streams)
    if [ -d "$DATA_DIR/jetstream" ]; then
        cp -r "$DATA_DIR/jetstream" "$backup_path/jetstream"
        echo "  jetstream/"
    fi

    # Node identity (Ed25519 keys)
    [ -f "$DATA_DIR/node-identity.json" ] && cp "$DATA_DIR/node-identity.json" "$backup_path/"

    # The household CA phones and machines pin, and the household bus's logins
    # ( W2): without them every phone and machine pairs again.
    for d in tls nats; do
        if [ -d "$DATA_DIR/$d" ]; then
            cp -rp "$DATA_DIR/$d" "$backup_path/$d" 2>/dev/null && echo "  $d/" || echo "  $d/ (not readable: run as the node's user)"
        fi
    done

    # Credential safe (2026-07-11): API-key slots, encrypted with a key derived
    # from node-identity — only restorable together with it, which this backup
    # now guarantees. Without this line a restore lost every credential.
    # 2026-08-07: this used to suppress sudo's stderr (hiding the password
    # prompt), fall through to a non-root cp that cannot read a root-owned file,
    # and swallow the failure with `|| true` — producing a backup MISSING the
    # zone master while reporting success. That is now the worst possible silent
    # failure: person identity private keys are encrypted under the zone master,
    # so a backup without it cannot restore who you are. FAIL LOUDLY instead.
    if [ -f "$DATA_DIR/credentials.safe" ]; then
        if cp "$DATA_DIR/credentials.safe" "$backup_path/" 2>/dev/null \
           || sudo -n cp "$DATA_DIR/credentials.safe" "$backup_path/" 2>/dev/null; then
            echo "  credentials.safe"
        else
            echo ""
            echo "  ERROR: could not copy credentials.safe (permission denied)."
            echo "  This file holds the zone master. Person identity keys are"
            echo "  encrypted under it — a backup without it CANNOT restore your"
            echo "  identity or decrypt anything sealed to it."
            echo ""
            echo "  Re-run as:  wyrd stop && sudo wyrd backup"
            echo ""
            echo "  Refusing to report success on an incomplete backup."
            rm -rf "$backup_path"
            return 1
        fi
    fi

    # NATS config
    [ -f "$DATA_DIR/nats.conf" ] && cp "$DATA_DIR/nats.conf" "$backup_path/"

    # The search index is not copied. It is derivable (rebuilt from the library and the
    # record) and on a node with a full library it is larger than everything else together:
    # this copy once wrote 163 GB per run. The nightly snapshot hard-links it instead.
    for idx_dir in "$DATA_DIR/search" "$DATA_DIR/lucene"; do
        [ -d "$idx_dir" ] && echo "  $(_t backup.index_skipped "$(basename "$idx_dir")")"
    done

    # Souls
    [ -d "$DATA_DIR/souls" ] && cp -r "$DATA_DIR/souls" "$backup_path/"

    # Contacts + legacy env + canonical config (Phase 1-3). Without these the
    # backup is incomplete — federation partner aliases and zone config live
    # here and nowhere else.
    [ -f "$DATA_DIR/contacts" ] && cp "$DATA_DIR/contacts" "$backup_path/" && echo "  contacts"
    [ -f "$DATA_DIR/my-zones" ] && cp "$DATA_DIR/my-zones" "$backup_path/" && echo "  my-zones"
    [ -f "$DATA_DIR/blocks" ] && cp "$DATA_DIR/blocks" "$backup_path/" && echo "  blocks"
    [ -f "$ENV_FILE" ] && cp "$ENV_FILE" "$backup_path/env.legacy" && echo "$(_t backup.legacy_env)"
    if [ -f "$CONFIG_FILE" ]; then
        cp "$CONFIG_FILE" "$backup_path/wyrdsekai.conf" && echo "  wyrdsekai.conf"
    fi

    # Calculate size
    local size=$(du -sh "$backup_path" 2>/dev/null | cut -f1)
    echo ""
    echo "$(_t backup.complete "$backup_path" "$size")"

    # Prune old backups (keep 5)
    local count=$(ls -d "$backup_dir"/wyrdsekai-* 2>/dev/null | wc -l)
    if [ "$count" -gt 5 ]; then
        ls -dt "$backup_dir"/wyrdsekai-* | tail -n +6 | while read old; do
            rm -rf "$old"
            echo "$(_t backup.pruned "$(basename "$old")")"
        done
    fi
}

do_vault() {
    local sub="${1:-status}"
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    local vault_dir="${WYRDSEKAI_VAULT_DIR:-$DATA_DIR/vault-store}"
    _vault_call() {   # <method> <path> [json]
        local token; token=$(wyrd_session_token)
        [[ -z "$token" ]] && { err "Log in first: wyrd login"; return 1; }
        local resp code
        if [[ "$1" == "POST" ]]; then
            resp=$(curl -s -w '\n%{http_code}' -X POST -H "Authorization: Bearer $token" -H "Content-Type: application/json" -d "${3:-{\}}" "$api$2")
        else
            resp=$(curl -s -w '\n%{http_code}' -H "Authorization: Bearer $token" "$api$2")
        fi
        [[ $? -eq 0 ]] || { err "The server did not answer at $api — is it running?"; return 1; }
        code="${resp##*$'\n'}"; resp="${resp%$'\n'*}"
        [[ "$code" == "401" ]] && { err "Your session has expired — run: wyrd login"; return 1; }
        [[ "$code" == "403" ]] && { err "Only the steward opens the vault."; return 1; }
        [[ "$code" == "404" ]] && { err "No vault on this node (WYRDSEKAI_VAULT_MINUTES=0)."; return 1; }
        [[ "$code" == "200" ]] || { err "The server answered $code: $resp"; return 1; }
        printf '%s' "$resp"
    }
    _vault_java() {   # offline verbs through the CLI jar
        local CLI_LIB
        if [[ "$MODE" == "source" ]]; then
            [[ -d "$PROJECT_ROOT/cli/build/install/cli" ]] || (cd "$PROJECT_ROOT" && "$GRADLE" :cli:installDist -q) || { err "$(_t common.build_failed)"; return 1; }
            CLI_LIB="$PROJECT_ROOT/cli/build/install/cli/lib"
        else
            CLI_LIB="$REAL_BIN/../lib/cli"; [[ ! -d "$CLI_LIB" ]] && CLI_LIB="$REAL_BIN/../lib"
        fi
        find_java || { err "$(_t common.java_missing)"; return 1; }
        local CP; CP=$(echo "$CLI_LIB"/*.jar | tr ' ' ':')
        [[ "$MODE" == "source" && -d "$PROJECT_ROOT/cli/build/classes/java/main" ]] && CP="$PROJECT_ROOT/cli/build/classes/java/main:$PROJECT_ROOT/core/build/classes/java/main:$CP"
        "$JAVA_CMD" -cp "$CP" org.wyrdsekai.cli.VaultMain "$@"
    }
    case "$sub" in
        status)
            local resp; resp=$(_vault_call GET /api/vault) || return 1
            printf '%s' "$resp" | python3 -c '
import json,sys
d=json.load(sys.stdin)
print("Vault: %s" % d.get("dir"))
print("Copies: %s (%s kept), store %.2f GB" % (d.get("copies"), d.get("kept"), (d.get("chunkStoreBytes") or 0)/1e9))
print("Latest: %s" % (d.get("latest") or "none"))
ld=d.get("lastDrill")
print("Last drill: %s" % ("never" if not ld else "%s %s — %s" % (ld, "passed" if d.get("lastDrillOk") else "FAILED", d.get("lastDrillDetail",""))))
if d.get("lastError"): print("Last error: %s" % d["lastError"])
if d.get("keyId"): print("Sealed with key %s (%s); keep a copy of that file off this disk" % (d["keyId"], d.get("keyFile","")))
if d.get("keyMismatch"): print("KEY MISMATCH: %s" % d["keyMismatch"])
if d.get("unclassified"): print("Unclassified in the data dir (not vaulted): %s" % ", ".join(d["unclassified"]))
rec=d.get("recent",[])
if rec:
    print(); print("%-22s %-24s %-5s %6s %9s  %s" % ("ID","AT","KEEP","FILES","MB","REASON"))
    for m in rec: print("%-22s %-24s %-5s %6d %9.1f  %s" % (m["id"], m["at"], "keep" if m.get("keep") else "", m["files"], m["bytes"]/1e6, m["reason"]))
' ;;
        snapshot|copy)
            local reason="${2:-the steward asked}"
            local resp; resp=$(_vault_call POST /api/vault/snapshot "{\"reason\": \"$reason\"}") || return 1
            printf '%s\n' "$resp" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("Copy %s: %d files, %.1f MB" % (d["id"], d["files"], d["bytes"]/1e6))' ;;
        drill)
            local resp; resp=$(_vault_call POST /api/vault/drill) || return 1
            printf '%s\n' "$resp" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(("Drill passed: " if d.get("ok") else "Drill FAILED: ") + d.get("detail",""))' ;;
        prune)
            local resp; resp=$(_vault_call POST /api/vault/prune) || return 1
            printf '%s\n' "$resp" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("Pruned %d; %d copies remain" % (d["removed"], d["copies"]))' ;;
        sync)
            # A second copy on another disk, a vault node, or offsite: plain files over rsync.
            local remote="${2:-${WYRDSEKAI_VAULT_REMOTE:-}}"
            [[ -z "$remote" ]] && { err "Where to? wyrd vault sync <rsync destination>  (or set WYRDSEKAI_VAULT_REMOTE)"; return 64; }
            command -v rsync >/dev/null 2>&1 || { err "rsync is not installed"; return 1; }
            [[ -d "$vault_dir" ]] || { err "No vault at $vault_dir yet"; return 1; }
            # The store is sealed with $DATA_DIR/vault.key, which is not in it: the copy is
            # unreadable without the key file. Say so every time, so it is never a surprise.
            log "Syncing $vault_dir → $remote"
            rsync -a --delete "$vault_dir/" "$remote/" && log "Synced. The copy is sealed; restoring it needs $DATA_DIR/vault.key (wyrd vault key)." ;;
        key)
            # Where the key is and what it is called. The store is useless without it.
            [[ -f "$DATA_DIR/vault.key" ]] || { err "No vault key yet at $DATA_DIR/vault.key (it is made on the first copy)."; return 1; }
            _vault_java key --vault "$vault_dir" --data "$DATA_DIR" ;;
        list)      _vault_java list --vault "$vault_dir" --data "$DATA_DIR" "${@:2}" ;;
        restore)
            # Rebuild a copy under a directory of your choosing (the server may be up).
            # On another machine: wyrd vault restore latest <dir> --key /path/to/vault.key
            local id="${2:-latest}" to="${3:-}"
            [[ -z "$to" ]] && { err "Usage: wyrd vault restore <id|latest> <dir> [--key FILE]"; return 64; }
            _vault_java restore --vault "$vault_dir" --data "$DATA_DIR" --to "$to" "${@:4}" "$id" ;;
        stage)
            # Rebuild the record from a copy and stage it for the next start. Stop first.
            local id="${2:-latest}"
            if curl -sf -m 3 "$api/health" >/dev/null 2>&1; then
                err "The server is running. Stop it first (wyrd stop), then stage, then start."; return 1
            fi
            _vault_java stage --vault "$vault_dir" --data "$DATA_DIR" "${@:3}" "$id" ;;
        *)
            echo "Usage: wyrd vault [status] | snapshot [reason] | drill | prune | sync [dest] | key | list | restore <id|latest> <dir> [--key FILE] | stage <id|latest> [--key FILE]"
            return 64 ;;
    esac
}

do_restore() {
    local backup_path="$1"
    if [ -z "$backup_path" ]; then
        # List available backups
        echo "$(_t restore.available_header)"
        ls -dt "$DATA_DIR/backups"/wyrdsekai-* 2>/dev/null | while read b; do
            local size=$(du -sh "$b" 2>/dev/null | cut -f1)
            echo "  $(basename "$b")  ($size)"
        done
        echo ""
        echo "$(_t restore.usage)"
        echo "$(_t restore.example)"
        return 1
    fi

    # Resolve path
    if [ ! -d "$backup_path" ]; then
        backup_path="$DATA_DIR/backups/$backup_path"
    fi
    if [ ! -d "$backup_path" ]; then
        echo "$(_t restore.not_found "$backup_path")"
        return 1
    fi

    echo "$(_t restore.from "$backup_path")"
    echo "$(_t restore.warning)"
    echo ""
    read -p "$(_t restore.prompt_continue)" confirm
    [ "$confirm" != "y" ] && echo "$(_t restore.cancelled)" && return 1

    # Restore files
    for f in "$backup_path"/*.db; do
        [ -f "$f" ] && cp "$f" "$DATA_DIR/" && echo "  $(basename "$f")"
    done
    [ -f "$backup_path/node-identity.json" ] && cp "$backup_path/node-identity.json" "$DATA_DIR/"
    [ -d "$backup_path/jetstream" ] && rm -rf "$DATA_DIR/jetstream" && cp -r "$backup_path/jetstream" "$DATA_DIR/"
    [ -d "$backup_path/search" ] && rm -rf "$DATA_DIR/search" && cp -r "$backup_path/search" "$DATA_DIR/"
    [ -d "$backup_path/lucene" ] && rm -rf "$DATA_DIR/lucene" && cp -r "$backup_path/lucene" "$DATA_DIR/"
    [ -d "$backup_path/souls" ] && rm -rf "$DATA_DIR/souls" && cp -r "$backup_path/souls" "$DATA_DIR/"

    # Phase 1-3: contacts + config + legacy env
    [ -f "$backup_path/contacts" ] && cp "$backup_path/contacts" "$DATA_DIR/"
    [ -f "$backup_path/my-zones" ] && cp "$backup_path/my-zones" "$DATA_DIR/"
    [ -f "$backup_path/blocks" ] && cp "$backup_path/blocks" "$DATA_DIR/"
    [ -f "$backup_path/env.legacy" ] && cp "$backup_path/env.legacy" "$ENV_FILE"
    if [ -f "$backup_path/wyrdsekai.conf" ]; then
        if [ -w "$(dirname "$CONFIG_FILE")" ]; then
            cp "$backup_path/wyrdsekai.conf" "$CONFIG_FILE"
        else
            sudo cp "$backup_path/wyrdsekai.conf" "$CONFIG_FILE"
        fi
        echo "$(_t restore.config_path "$CONFIG_FILE")"
    fi

    echo ""
    echo "$(_t restore.complete)"
}

# ── Reset ────────────────────────────────────────────────────────────────
# Nuke all state locations. Matches the list that apt purge leaves behind
# (custom systemd dropins, /opt leftovers, /root state, masked units, user
# home state). This is the command you reach for when "wyrd uninstall"
# didn't actually uninstall.
do_reset() {
    local mode="${1:-soft}"  # soft = keep world; hard = nuke all
    echo ""
    warn "$(_t reset.warning)"
    case "$mode" in
        hard) echo "$(_t reset.mode_hard)" ;;
        *)    echo "$(_t reset.mode_soft)" ;;
    esac
    echo ""
    read -p "Continue? (y/N) " confirm
    [[ ! "$confirm" =~ ^[Yy] ]] && echo "Cancelled." && return 1

    # 1. Stop all services + unmask anything previously masked.
    if [[ "$(uname -s)" == "Linux" ]]; then
        for svc in wyrdsekai wyrdsekai-rendezvous wyrdsekai-metasearch \
                   wyrdsekai-nats wyrdsekai-llama; do
            sudo systemctl stop "$svc" 2>/dev/null || true
            sudo systemctl unmask "$svc" 2>/dev/null || true
        done
        # 2. Remove custom dropins (custom-created, not .deb-owned).
        sudo rm -rf /etc/systemd/system/wyrdsekai.service.d
        sudo rm -rf /etc/systemd/system/wyrdsekai-rendezvous.service.d
        sudo systemctl daemon-reload 2>/dev/null || true
    fi
    do_stop 2>/dev/null || true
    do_nuke 2>/dev/null || true

    # 3. Mode-specific state removal.
    if [[ "$mode" == "hard" ]]; then
        if [[ "$(uname -s)" == "Linux" ]]; then
            sudo rm -rf /var/lib/wyrdsekai /etc/wyrdsekai
            sudo rm -rf /opt/wyrdsekai/data /opt/wyrdsekai/lib 2>/dev/null || true
            sudo rm -rf /root/.wyrdsekai 2>/dev/null || true
        fi
        rm -rf "$HOME/.wyrdsekai"
        log "$(_t reset.hard_done)"
    else
        log "$(_t reset.soft_done "$DATA_DIR")"
    fi
}

# ── Reseed ───────────────────────────────────────────────────────────────
# Wipe persisted world state so the next start re-seeds foundation rooms
# from the shipped JSON. Used after editing foundation-rooms.json (Pekko
# persistence otherwise holds the old snapshot).
do_reseed() {
    echo ""
    warn "$(_t reseed.warning)"
    echo "$(_t reseed.removes)"
    echo "$(_t reseed.keeps)"
    echo ""
    read -p "Continue? (y/N) " confirm
    [[ ! "$confirm" =~ ^[Yy] ]] && echo "Cancelled." && return 1

    do_stop 2>/dev/null || true
    # Run as current user unless the files are root-owned (service install).
    if [[ -w "$DATA_DIR/world.db" ]] 2>/dev/null; then
        rm -f "$DATA_DIR"/world.db*
    else
        sudo rm -f "$DATA_DIR"/world.db*
    fi
    log "$(_t reseed.starting)"
    do_start
}

# ── Config ───────────────────────────────────────────────────────────────
# Single source of truth for runtime config. Mirrors the Study's Scroll of
# Settings (Phase 4) so admins can edit via SSH or in-world and both paths
# converge on the same file.
do_config() {
    local subcmd="${1:-help}"

    # Determine the active config file. If /etc/wyrdsekai/ exists and is
    # writable by root, prefer that (system install); otherwise use the
    # per-user file.
    local target_conf="$CONFIG_FILE"
    local need_sudo=false
    if [[ "$target_conf" == /etc/* ]] && [[ ! -w "$target_conf" ]] 2>/dev/null; then
        need_sudo=true
    fi

    # Ensure the file exists before read/write.
    _ensure_config() {
        if [[ ! -f "$target_conf" ]]; then
            local dir; dir="$(dirname "$target_conf")"
            if $need_sudo; then
                sudo mkdir -p "$dir"
                echo "# Wyrdsekai configuration" | sudo tee "$target_conf" >/dev/null
            else
                mkdir -p "$dir"
                echo "# Wyrdsekai configuration" > "$target_conf"
            fi
        fi
    }

    case "$subcmd" in
        get)
            local key="${2:-}"
            [[ -z "$key" ]] && { err "$(_t config.get.usage)"; return 1; }
            _ensure_config
            local val
            val=$(grep -E "^${key}=" "$target_conf" 2>/dev/null | tail -1 | cut -d= -f2-)
            if [[ -n "$val" ]]; then
                echo "$val"
            else
                err "$(_t config.get.not_set "$key")"
                return 1
            fi
            ;;
        set)
            local kv="${2:-}"
            [[ -z "$kv" ]] && { err "$(_t config.set.usage)"; return 1; }
            local key="${kv%%=*}"
            local val="${kv#*=}"
            [[ "$key" == "$kv" ]] && { err "$(_t config.set.missing_eq)"; return 1; }
            _ensure_config
            # Remove any existing line, then append. Preserves comments.
            local tmp
            tmp=$(mktemp)
            grep -vE "^${key}=" "$target_conf" > "$tmp" 2>/dev/null || true
            echo "${key}=${val}" >> "$tmp"
            if $need_sudo; then
                sudo cp "$tmp" "$target_conf"
                sudo chmod 644 "$target_conf"
            else
                cp "$tmp" "$target_conf"
                chmod 644 "$target_conf"
            fi
            rm -f "$tmp"
            log "$(_t config.set.applied "$key" "$target_conf")"
            info "$(_t config.set.apply_hint)"
            ;;
        unset)
            local key="${2:-}"
            [[ -z "$key" ]] && { err "$(_t config.unset.usage)"; return 1; }
            _ensure_config
            local tmp
            tmp=$(mktemp)
            grep -vE "^${key}=" "$target_conf" > "$tmp" 2>/dev/null || true
            if $need_sudo; then
                sudo cp "$tmp" "$target_conf"
            else
                cp "$tmp" "$target_conf"
            fi
            rm -f "$tmp"
            log "$(_t config.unset.removed "$key" "$target_conf")"
            ;;
        list|show)
            _ensure_config
            # --all (or a group name) shows the CATALOG — every key this build
            # understands, its description, default, and current value —
            # instead of only what happens to be written in the conf.
            local list_arg="${2:-}"
            if [[ -n "$list_arg" ]]; then
                if [[ -z "$WYRD_CONFIG_CATALOG" ]]; then
                    err "config catalog not found (scripts/config-catalog.json)"
                    return 1
                fi
                local cur_conf=""
                if [[ -r "$target_conf" ]]; then cur_conf=$(cat "$target_conf" 2>/dev/null); \
                else cur_conf=$(sudo cat "$target_conf" 2>/dev/null); fi
                WYRD_CAT="$WYRD_CONFIG_CATALOG" WYRD_CONF_TEXT="$cur_conf" \
                WYRD_LIST_ARG="$list_arg" python3 - <<'CATPY'
import json, os, re
cat = json.load(open(os.environ["WYRD_CAT"]))
arg = os.environ.get("WYRD_LIST_ARG", "").strip()
conf = os.environ.get("WYRD_CONF_TEXT", "")
set_keys = dict(re.findall(r'^([A-Z_]+)=(.*)$', conf, re.M))
groups = cat["groups"]
want_all = arg in ("--all", "-a", "all")
if not want_all:
    groups = [g for g in groups if g["id"] == arg]
    if not groups:
        print("no such group: " + arg)
        print("groups: " + ", ".join(g["id"] for g in cat["groups"]))
        raise SystemExit(1)
for g in groups:
    print("\n== %s — %s" % (g["id"], g["title"]))
    for k in g["keys"]:
        name = k["key"]
        cur = set_keys.get(name)
        state = ("= " + cur) if cur is not None else ("(unset, default: %s)" % (k["default"] or "\u2014"))
        print("  %-44s %s" % (name, state))
        print("  %-44s   %s" % ("", k["description"]))
if want_all:
    print("\nSet one with:  wyrd config set KEY=VALUE   then   wyrd config apply")
    print("One group at a time:  wyrd config list <group>   (%s)"
          % ", ".join(g["id"] for g in cat["groups"]))
CATPY
                return $?
            fi
            echo "$(_t config.list.header "$target_conf")"
            echo ""
            if [[ -r "$target_conf" ]]; then
                grep -E '^[A-Z_]+=.*' "$target_conf" | sort
            else
                sudo cat "$target_conf" | grep -E '^[A-Z_]+=.*' | sort
            fi
            echo ""
            echo "(\`wyrd config list --all\` shows every key this build understands)"
            ;;
        edit)
            _ensure_config
            local editor="${EDITOR:-nano}"
            if $need_sudo; then
                sudo "$editor" "$target_conf"
            else
                "$editor" "$target_conf"
            fi
            info "$(_t config.edit.apply_hint)"
            ;;
        apply)
            log "$(_t config.apply.restarting)"
            if [[ "$(uname -s)" == "Linux" ]] && systemctl list-unit-files wyrdsekai.service >/dev/null 2>&1; then
                sudo systemctl restart wyrdsekai
                sleep 3
                sudo systemctl is-active wyrdsekai
            else
                do_stop 2>/dev/null || true
                sleep 1
                do_start
            fi
            ;;
        path)
            echo "$target_conf"
            ;;
        init)
            # Create a starter ~/.wyrdsekai/profile.toml. Generates a memorable
            # zone name + matching theme via ZoneNameGenerator (so a fresh node
            # gets a distinct identity instead of a literal "home"). Most other
            # settings auto-detect at runtime — operators only need to touch
            # this file to join a household or opt into peer-training.
            local profile_path="${HOME}/.wyrdsekai/profile.toml"
            if [[ -f "$profile_path" ]]; then
                err "$(_t config.init.exists "$profile_path")"
                return 1
            fi
            mkdir -p "$(dirname "$profile_path")"
            local detected_host="$(hostname -s 2>/dev/null || echo node)"

            # Pick a zone+theme bundle by asking the JVM. Falls back to a
            # static default if Java isn't reachable (offline, missing JAR).
            local lib_dir bundle_zone bundle_theme
            for d in /usr/local/wyrdsekai/lib/server /opt/wyrdsekai/lib/server \
                     "$PROJECT_ROOT/server/build/install/server/lib"; do
                [[ -d "$d" ]] && { lib_dir="$d"; break; }
            done
            if [[ -n "${lib_dir:-}" ]] && command -v java &>/dev/null; then
                local bundle_line
                bundle_line=$(java -cp "$lib_dir/*" \
                    org.wyrdsekai.core.config.ZoneBundlePicker 2>/dev/null) || true
                if [[ "$bundle_line" =~ ^([a-z]+):([a-z]+)$ ]]; then
                    bundle_zone="${BASH_REMATCH[1]}"
                    bundle_theme="${BASH_REMATCH[2]}"
                fi
            fi
            # Fallback if Java path failed
            : "${bundle_zone:=hearth}"
            : "${bundle_theme:=garden}"

            # Let whoever runs setup name their world + choose its aesthetic.
            # The random bundle above is the DEFAULT — like every other setup
            # prompt this uses _prompt_countdown, so [Enter], a timeout, or any
            # non-interactive/headless install just keeps the random pick. Type
            # a name to rename; pick a theme by number or name to re-skin.
            # Cosmetic + changeable later via `wyrd config set node.zone=… /
            # node.theme=…`.
            if [[ -t 0 ]]; then
                echo
                info "$(_t config.init.identity_intro "$bundle_zone" "$bundle_theme")"
                # THEME first — the aesthetic shapes the name (a garden world
                # should suggest a garden-flavoured name, not a steampunk one).
                local _themes=(garden arcane cyberpunk steampunk wild sanctuary minimalist)
                echo "  $(_t config.init.theme_list)"
                local _i=1 _th
                for _th in "${_themes[@]}"; do printf "    %d) %s\n" "$_i" "$_th"; _i=$((_i + 1)); done
                _prompt_countdown "  $(_t config.init.theme_prompt "$bundle_theme")" 30
                local _theme_changed=false
                if [[ "$_PROMPT_REPLY" =~ ^[1-7]$ ]]; then
                    bundle_theme="${_themes[$((_PROMPT_REPLY - 1))]}"; _theme_changed=true
                elif [[ -n "$_PROMPT_REPLY" ]]; then
                    local _tl
                    _tl=$(printf '%s' "$_PROMPT_REPLY" | tr '[:upper:]' '[:lower:]')
                    for _th in "${_themes[@]}"; do
                        [[ "$_th" == "$_tl" ]] && { bundle_theme="$_tl"; _theme_changed=true; break; }
                    done
                fi
                # If they re-skinned, re-roll the SUGGESTED name to match the new
                # theme so the default offered below is coherent. Best-effort: if
                # the JVM path is unavailable the prior random name just stands.
                if $_theme_changed && [[ -n "${lib_dir:-}" ]] && command -v java &>/dev/null; then
                    local _newname
                    _newname=$(java -cp "$lib_dir/*" \
                        org.wyrdsekai.core.config.ZoneBundlePicker --theme "$bundle_theme" 2>/dev/null) || true
                    [[ "$_newname" =~ ^[a-z]+$ ]] && bundle_zone="$_newname"
                fi
                # NAME second — default is the (now theme-matched) suggested name.
                _prompt_countdown "  $(_t config.init.zone_prompt "$bundle_zone")" 30
                if [[ -n "$_PROMPT_REPLY" ]]; then
                    local _z
                    _z=$(printf '%s' "$_PROMPT_REPLY" \
                        | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd 'a-z0-9-')
                    [[ -n "$_z" ]] && bundle_zone="$_z"
                fi
                echo
                info "$(_t config.init.identity_chosen "$bundle_zone" "$bundle_theme")"
            fi

            cat > "$profile_path" <<TOML
# Wyrdsekai household profile
#
# Most settings auto-detect — only override what's specific to this node
# or your household. See \`wyrd config audit\` to inspect what's resolved
# from where.
#
# Environment variables (WYRDSEKAI_*) override anything here.

[node]
# name = "$detected_host"          # default: hostname -s
zone  = "$bundle_zone"
theme = "$bundle_theme"
# public_url = "http://198.51.100.50:7070"

[nats]
# url = "nats://127.0.0.1:4222"

[inference]
# url = "http://127.0.0.1:8200"

[between]
enabled = true

[discovery]
mdns_enabled = true                  # advertise on LAN; joining still needs consent
# mdns_service = "_wyrdsekai._tcp"

# [relay]                            # cross-zone federation (configure via \`wyrd federate join\`)
# url = "nats://relay.example:4222"
# user = "hh-..."
# token = "..."

# [peer_training]                    # opt-in: host voice-alignment training for peers
# host = true
# relay_token = "ptz-..."            # url + user inherit from [relay]
TOML
            chmod 600 "$profile_path"
            log "$(_t config.init.created "$profile_path")"
            info "$(_t config.init.zone_theme "$bundle_zone" "$bundle_theme")"
            info "$(_t config.init.hint_edit)"
            info "$(_t config.init.hint_audit)"
            info "$(_t config.init.hint_discover)"
            ;;
        edit-profile)
            local profile_path="${HOME}/.wyrdsekai/profile.toml"
            [[ -f "$profile_path" ]] || { err "$(_t config.edit_profile.missing)"; return 1; }
            local editor="${EDITOR:-nano}"
            "$editor" "$profile_path"
            info "$(_t config.edit_profile.apply_hint)"
            ;;
        audit)
            # Show effective resolved values + their source (env/profile/default)
            # by running a tiny Java probe inside the installed JVM. Handy
            # for "why is this value what it is" debugging.
            local lib_dir
            for d in /usr/local/wyrdsekai/lib/server /opt/wyrdsekai/lib/server \
                     "$PROJECT_ROOT/server/build/install/server/lib"; do
                if [[ -d "$d" ]]; then lib_dir="$d"; break; fi
            done
            if [[ -z "${lib_dir:-}" ]]; then
                err "$(_t config.audit.lib_not_found)"; return 1
            fi
            # shellcheck disable=SC2046
            if ! java -cp "$lib_dir/*" org.wyrdsekai.core.config.WyrdConfigAudit 2>/dev/null; then
                # JVM unavailable / class missing — fall back to text dump.
                local profile_path="${HOME}/.wyrdsekai/profile.toml"
                echo "$(_t config.dump.profile_header "$profile_path")"
                [[ -f "$profile_path" ]] && cat "$profile_path"
                echo
                echo "$(_t config.dump.env_overrides_header)"
                env | grep -E '^WYRDSEKAI_' | sort
            fi
            ;;
        import-env)
            # Convert ~/.wyrdsekai/env (legacy) to ~/.wyrdsekai/profile.toml.
            local env_path="${HOME}/.wyrdsekai/env"
            local profile_path="${HOME}/.wyrdsekai/profile.toml"
            [[ -f "$env_path" ]] || { err "$(_t config.import_env.no_legacy "$env_path")"; return 1; }
            if [[ -f "$profile_path" ]]; then
                err "$(_t config.import_env.profile_exists "$profile_path")"; return 1
            fi
            python3 - "$env_path" "$profile_path" <<'PY'
import sys, re
src, dst = sys.argv[1], sys.argv[2]
sections = {
    "WYRDSEKAI_NODE_NAME": ("node", "name"),
    "WYRDSEKAI_ZONE_ID": ("node", "zone"),
    "WYRDSEKAI_ZONE_PUBLIC_URL": ("node", "public_url"),
    "WYRDSEKAI_NATS_URL": ("nats", "url"),
    "WYRDSEKAI_INFERENCE_URL": ("inference", "url"),
    "WYRDSEKAI_LLAMA_URL": ("inference", "llama_url"),
    "WYRDSEKAI_VOICE_URL": ("inference", "voice_url"),
    "WYRDSEKAI_BETWEEN_ENABLED": ("between", "enabled"),
    "WYRDSEKAI_RELAY_URL": ("relay", "url"),
    "WYRDSEKAI_RELAY_USER": ("relay", "user"),
    "WYRDSEKAI_RELAY_TOKEN": ("relay", "token"),
    "WYRDSEKAI_SSH_TUNNEL_ENABLED": ("ssh_tunnel", "enabled"),
    "WYRDSEKAI_SSH_TUNNEL_RELAY_HOST": ("ssh_tunnel", "relay_host"),
    "WYRDSEKAI_SSH_TUNNEL_RELAY_PORT": ("ssh_tunnel", "relay_port"),
    "WYRDSEKAI_SSH_TUNNEL_REMOTE_PORT": ("ssh_tunnel", "remote_port"),
    "WYRDSEKAI_SSH_TUNNEL_TOPOLOGY": ("ssh_tunnel", "topology"),
    "WYRDSEKAI_PEER_TRAINING_HOST": ("peer_training", "host"),
    "WYRDSEKAI_PEER_TRAINING_RELAY_URL": ("peer_training", "relay_url"),
    "WYRDSEKAI_PEER_TRAINING_RELAY_USER": ("peer_training", "relay_user"),
    "WYRDSEKAI_PEER_TRAINING_RELAY_TOKEN": ("peer_training", "relay_token"),
    "WYRDSEKAI_RENDEZVOUS_URLS": ("discovery", "rendezvous"),
}
buckets = {}
extras = []
with open(src) as f:
    for line in f:
        line = line.rstrip()
        if not line or line.lstrip().startswith("#"):
            continue
        m = re.match(r"^(WYRDSEKAI_[A-Z0-9_]+)=(.*)$", line)
        if not m:
            continue
        key, val = m.group(1), m.group(2)
        if key in sections:
            sec, k = sections[key]
            buckets.setdefault(sec, []).append((k, val))
        else:
            extras.append((key, val))

with open(dst, "w") as out:
    out.write("# Wyrdsekai household profile (auto-imported)\n")
    out.write("# Edit + run `wyrd config apply` to take effect.\n\n")
    for sec, kvs in buckets.items():
        out.write(f"[{sec}]\n")
        for k, v in kvs:
            v_lc = v.lower()
            if v_lc in ("true", "false"):
                out.write(f"{k} = {v_lc}\n")
            elif v.isdigit():
                out.write(f"{k} = {v}\n")
            else:
                v_esc = v.replace('"', '\\"')
                out.write(f'{k} = "{v_esc}"\n')
        out.write("\n")
    if extras:
        out.write("# Unmapped keys preserved as escape-hatch env overrides:\n")
        out.write("# (move to a section above when you understand them)\n")
        out.write("[extras]\n")
        for k, v in extras:
            v_esc = v.replace('"', '\\"')
            out.write(f'{k} = "{v_esc}"\n')
print(f"wrote {dst}")
PY
            chmod 600 "$profile_path"
            info "$(_t config.import_env.imported "$env_path")"
            ;;
        *)
            echo "$(_t config.help.usage)"
            echo ""
            echo "$(_t config.help.tagline)"
            echo ""
            echo "$(_t config.help.envfile_label)"
            echo "$(_t config.help.cmd_get)"
            echo "$(_t config.help.cmd_set)"
            echo "$(_t config.help.cmd_unset)"
            echo "$(_t config.help.cmd_list)"
            echo "$(_t config.help.cmd_edit)"
            echo "$(_t config.help.cmd_apply)"
            echo "$(_t config.help.cmd_path)"
            echo ""
            echo "$(_t config.help.profile_label)"
            echo "$(_t config.help.cmd_init)"
            echo "$(_t config.help.cmd_edit_profile)"
            echo "$(_t config.help.cmd_audit)"
            echo "$(_t config.help.cmd_import_env)"
            echo ""
            echo "$(_t config.help.envfile_path "$target_conf")"
            echo "$(_t config.help.profile_path "${HOME}/.wyrdsekai/profile.toml")"
            ;;
    esac
}

do_recover() {
    local recovery_key="$1"
    local new_password="$2"
    if [ -z "$recovery_key" ] || [ -z "$new_password" ]; then
        echo "$(_t recover.usage)"
        echo ""
        echo "$(_t recover.help_1)"
        echo "$(_t recover.help_2)"
        return 1
    fi

    # Find server port (#9 2026-07-19 — honor WYRDSEKAI_PORT, was hardcoded 7070)
    local port="${WYRDSEKAI_PORT:-7070}"
    echo "$(_t recover.resetting)"
    local result=$(curl -s -X POST "http://localhost:$port/api/auth/recover" \
        -H "Content-Type: application/json" \
        -d "{\"recoveryKey\":\"$recovery_key\",\"newPassword\":\"$new_password\"}")
    echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('message', d.get('error', 'Unknown response')))" 2>/dev/null || echo "$result"
}

do_reset_zone() {
    local recovery_key="$1"
    if [ -z "$recovery_key" ]; then
        echo "$(_t reset_zone.usage)"
        echo ""
        echo "$(_t reset_zone.help_1)"
        echo "$(_t reset_zone.help_2)"
        echo "$(_t reset_zone.help_3)"
        return 1
    fi

    echo "$(_t reset_zone.warning)"
    echo "$(_t reset_zone.restart_needed)"
    read -p "Continue? (y/N) " confirm
    [ "$confirm" != "y" ] && echo "Cancelled." && return 1

    local port="${WYRDSEKAI_PORT:-7070}"   # #9 2026-07-19 — was hardcoded 7070
    local result=$(curl -s -X POST "http://localhost:$port/api/auth/reset-zone" \
        -H "Content-Type: application/json" \
        -d "{\"recoveryKey\":\"$recovery_key\"}")
    echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('message', d.get('error', 'Unknown response')))" 2>/dev/null || echo "$result"
}

# ── Zone ──
do_zone() {
    local subcmd="${1:-help}"
    local target="${2:-}"
    case "$subcmd" in
        federate)
            [[ -z "$target" ]] && { echo "$(_t zone.usage_federate)"; return 1; }
            log "$(_t zone.proposing "$target")"
            curl -sf -X POST "http://localhost:$PORT/api/federation/propose/$target" 2>/dev/null \
                | python3 -c "import sys,json; print(json.load(sys.stdin).get('result','unknown'))" 2>/dev/null \
                || echo "$(_t zone.failed_between)"
            ;;
        accept)
            [[ -z "$target" ]] && { echo "$(_t zone.usage_accept)"; return 1; }
            log "$(_t zone.accepting "$target")"
            curl -sf -X POST "http://localhost:$PORT/api/federation/accept/$target" 2>/dev/null \
                | python3 -c "import sys,json; print(json.load(sys.stdin).get('result','unknown'))" 2>/dev/null \
                || echo "$(_t zone.failed_between)"
            ;;
        revoke)
            [[ -z "$target" ]] && { echo "$(_t zone.usage_revoke)"; return 1; }
            log "$(_t zone.revoking "$target")"
            curl -sf -X POST "http://localhost:$PORT/api/federation/revoke/$target" 2>/dev/null
            ;;
        status)
            curl -sf "http://localhost:$PORT/api/federation/status" 2>/dev/null \
                | python3 -c "import sys,json; print(json.load(sys.stdin).get('status','unknown'))" 2>/dev/null \
                || echo "$(_t zone.status_unavailable)"
            ;;
        *)
            echo "$(_t zone.help_title)"
            echo ""
            echo "$(_t zone.help_commands)"
            echo "$(_t zone.help_federate)"
            echo "$(_t zone.help_accept)"
            echo "$(_t zone.help_revoke)"
            echo "$(_t zone.help_status)"
            ;;
    esac
}

# ── Naming admin (wyrd contacts, wyrd zones, wyrd whoami) ──
#
# Shells out to NamingAdminMain on the server classpath — DID derivation
# needs base58 + multicodec encoding we don't want to duplicate in bash.
# NamingAdminMain handles file I/O, validation, TOFU messaging, rendering.
# Stdout/stderr/exit codes flow straight through. Works in both source and
# package modes using the same classpath resolution as do_start.
do_naming_admin() {
    # Resolve server classpath (same logic do_start uses)
    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        # Build installDist lazily on first admin use so users don't have to
        # remember to prebuild. If it exists, assume it's up to date — the
        # admin operations don't need the hot-path optimisations.
        if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
            log "$(_t common.building_server)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi

    if [[ ! -d "$SERVER_LIB" ]]; then
        err "$(_t common.server_libs_missing_hint "$SERVER_LIB")"
        return 1
    fi

    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')

    # --add-opens mirrors do_start — same JVM, same reflection constraints.
    "$JAVA_CMD" \
        -Djava.net.preferIPv4Stack=true \
        --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
        --add-opens java.base/java.lang=ALL-UNNAMED \
        --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
        -XX:+UseCompactObjectHeaders \
        --enable-native-access=ALL-UNNAMED \
        -cp "$CP" \
        org.wyrdsekai.server.NamingAdminMain "$@"
}

# ── State dump (F7b Phase 0) ──
#
# Read-only walker that emits a unified JSON snapshot of every household
# state store. Forcing function for — surfaces
# `wyrd soul list | rename <old> <new> | archive <name> [reason]` — the souls on this
# node by name. A rename keeps the soul (same DID, same entity id, same history) and
# changes the name on the manifest; the server resolves a configured name to the soul
# that answers to it, so a renamed companion is spawned, not reborn (2026-09-13).
do_soul() {
    local sub="${1:-list}"
    case "$sub" in
        list|rename|archive) ;;
        *) echo "Usage: wyrd soul list | rename <old-name> <new-name> | archive <name> [reason]"; return 64 ;;
    esac
    if [[ "$sub" != "list" ]] && is_server_running 2>/dev/null; then
        err "Stop the server first (wyrd stop): a running companion holds her name."
        return 1
    fi
    _run_core_main org.wyrdsekai.core.soul.SoulAdminMain "$@"
}

# `wyrd seed generate [<companion>] [--out <file>] | verify <file> | restore <file>` — the
# Recovery Seed: a sealed copy of a companion (her soul, her bonds
# her signing key) that brings her back on a new machine. Steward only; the server checks
# (a steward session, or this node's operator token from the machine itself). The passphrase
# goes to curl on stdin, never on a command line, and nothing here writes it to disk or log.
# `wyrd doctor`'s Recovery Seed line: a companion with no seed is
# lost with the disk. Returns 1 (a warning) only when a companion lives here and no seed was made.
_doctor_seed_line() {
    local dir="$DATA_DIR/recovery-seed"
    if [[ -d "$dir" && ! -r "$dir" ]]; then
        log "$(_t doctor.seed_unreadable "$dir")"; return 0
    fi
    compgen -G "$DATA_DIR/souls/*.did" >/dev/null 2>&1 || return 0
    local seeds; seeds="$(cd "$dir" 2>/dev/null && ls -1 -- *.wsrs 2>/dev/null | sed 's/\.wsrs$//' | tr '\n' ' ' || true)"
    if [[ -n "${seeds// /}" ]]; then log "$(_t doctor.seed_ok "${seeds% }")"; return 0; fi
    warn "$(_t doctor.seed_none)"
    return 1
}

_seed_read_passphrase() {   # <confirm 0|1> → the passphrase on stdout
    local p1="" p2=""
    if [[ -t 0 ]]; then
        read -rsp "$(_t seed.passphrase_prompt)" p1; echo >&2
        if [[ "$1" == "1" ]]; then
            read -rsp "$(_t seed.passphrase_again)" p2; echo >&2
            [[ "$p1" == "$p2" ]] || { err "$(_t seed.passphrase_mismatch)"; return 1; }
        fi
    else
        IFS= read -r p1 || true
    fi
    printf '%s' "$p1"
}

_seed_refused() {   # <http code> <response file>
    local code="$1" resp="$2"
    if [[ "$code" == "000" || -z "$code" ]]; then
        err "$(_t seed.no_server "${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}")"; return 1
    fi
    if [[ "$code" == "401" || "$code" == "403" ]] && ! grep -q '"insecure_channel"' "$resp" 2>/dev/null; then
        err "$(_t seed.err.forbidden)"; return 1
    fi
    local fields error message names
    fields=$(python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
print("\t".join([str(d.get("error", "")), str(d.get("message", "")).replace("\t", " "), ", ".join(d.get("names", []) or [])]))
' "$resp" 2>/dev/null)
    IFS=$'\t' read -r error message names <<<"$fields"
    local said; said="$(_t "seed.err.${error:-other}" "$names")"
    if [[ -z "$error" || "$said" == "seed.err.${error}" ]]; then said="$(_t seed.err.other "${message:-HTTP $code}")"; fi
    err "$said"
    return 1
}

do_seed() {
    local sub="${1:-help}"; shift || true
    local api="${WYRDSEKAI_API_URL:-http://localhost:${WYRDSEKAI_PORT:-7070}}"
    case "$sub" in
        generate|verify|restore) ;;
        *)
            echo "$(_t seed.help.title)"
            echo ""
            echo "$(_t seed.help.generate)"
            echo "$(_t seed.help.verify)"
            echo "$(_t seed.help.restore)"
            [[ "$sub" == "help" ]] && return 0 || return 64 ;;
    esac
    local who="" out="" file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out|-o) out="${2:-}"; shift 2 || shift $# ;;
            *) if [[ "$sub" == "generate" ]]; then [[ -z "$who" ]] && who="$1"; else [[ -z "$file" ]] && file="$1"; fi; shift ;;
        esac
    done
    if [[ "$sub" != "generate" ]]; then
        [[ -n "$file" ]] || { echo "$(_t seed.help."$sub")"; return 64; }
        [[ -f "$file" ]] || { err "$(_t seed.file_missing "$file")"; return 1; }
    fi
    local token; token=$(wyrd_session_token)
    [[ -n "$token" ]] || { err "$(_t seed.no_token)"; return 1; }
    local pass
    pass=$(_seed_read_passphrase "$([[ "$sub" == "generate" ]] && echo 1 || echo 0)") || return 1
    local resp; resp=$(umask 077; mktemp "${TMPDIR:-/tmp}/wyrd-seed.XXXXXX")
    local code
    if [[ "$sub" == "generate" ]]; then
        code=$(printf '%s' "$pass" | python3 -c 'import json, sys; print(json.dumps({"companion": sys.argv[1], "passphrase": sys.stdin.read()}))' "$who" \
            | curl -s -m 120 -o "$resp" -w '%{http_code}' -X POST -H "Content-Type: application/json" \
                -H "Authorization: Bearer $token" --data-binary @- "$api/api/seed/generate" 2>/dev/null)
    else
        code=$(printf '%s' "$pass" | python3 -c 'import base64, json, sys; print(json.dumps({"file": base64.b64encode(open(sys.argv[1], "rb").read()).decode(), "passphrase": sys.stdin.read()}))' "$file" \
            | curl -s -m 120 -o "$resp" -w '%{http_code}' -X POST -H "Content-Type: application/json" \
                -H "Authorization: Bearer $token" --data-binary @- "$api/api/seed/$sub" 2>/dev/null)
    fi
    pass=""
    if [[ "$code" != "200" ]]; then
        _seed_refused "$code" "$resp"; local rc=$?; rm -f "$resp"; return $rc
    fi
    local fields rc=0
    fields=$(python3 -c '
import base64, datetime, json, os, sys
d = json.load(open(sys.argv[1])); sub, out = sys.argv[2], sys.argv[3]
if sub == "generate":
    if not out:
        out = os.path.join(os.path.expanduser("~"), "%s-recovery-seed-%s.wsrs" % (d["entityId"], datetime.date.today().strftime("%Y%m%d")))
    if os.path.exists(out):
        print("EXISTS\t" + out); sys.exit(3)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(base64.b64decode(d["file"]))
    print("\t".join([d["name"], out, d.get("localCopy", ""), "1" if d.get("carriesKey") else "0"]))
else:
    print("\t".join([d["name"], d["createdAt"][:10], str(d.get("bonds", 0)), "1" if d.get("carriesKey") else "0", "1" if d.get("hereAlready") else "0"]))
' "$resp" "$sub" "$out" 2>/dev/null) || rc=$?
    rm -f "$resp"
    local a b c d e
    IFS=$'\t' read -r a b c d e <<<"$fields"
    if [[ "$a" == "EXISTS" ]]; then err "$(_t seed.out_exists "$b")"; return 1; fi
    [[ $rc -eq 0 && -n "$a" ]] || { err "$(_t seed.err.other "unreadable answer")"; return 1; }
    case "$sub" in
        generate)
            log "$(_t seed.made "$a" "$b")"
            [[ -n "$c" ]] && echo "  $(_t seed.local_copy "$c")"
            [[ "$d" == "1" ]] || warn "$(_t seed.no_key_warn "$a")"
            echo ""
            echo "  $(_t seed.keep_offsite)"
            echo "  $(_t seed.keep_passphrase)"
            ;;
        verify)
            log "$(_t seed.verified "$a" "$b" "$c" "$([[ "$d" == "1" ]] && _t seed.key_included || _t seed.key_missing)")"
            [[ "$e" == "1" ]] && echo "  $(_t seed.verified_here "$a")"
            ;;
        restore)
            log "$(_t seed.restored "$a")"
            [[ "$d" == "1" ]] || warn "$(_t seed.no_key_warn "$a")"
            ;;
    esac
    return 0
}

# `wyrd visitors [list] | dismiss <username> | vouch <username> | unvouch <username>` —
# who is in through the MCP door, and the steward's say over it. A vouched account enters
# at the Nexus; anyone else lands at the Docks. Dismissing walks a visitor out mid-visit
# and its token stops working (2026-09-13).
do_visitors() {
    local sub="${1:-list}" who="${2:-}"
    local base="http://localhost:${WYRDSEKAI_PORT:-7070}"
    case "$sub" in
        list)
            local sessions_json
            sessions_json=$(curl -sf "$base/api/mcp/sessions" 2>/dev/null) \
                || { err "The server did not answer at :${WYRDSEKAI_PORT:-7070} — is it running?"; return 1; }
            printf '%s' "$sessions_json" | python3 -c '
import json,sys
d=json.load(sys.stdin); s=d.get("sessions",[])
if not s: print("Nobody is in through the MCP door."); sys.exit(0)
print("%-18s %-28s %-8s %-18s %s" % ("USER","AS","KIND","DOOR","ROOM"))
for x in s: print("%-18s %-28s %-8s %-18s %s" % (x.get("username"),x.get("displayName"),x.get("kind"),x.get("door"),x.get("room")))
'
            ;;
        dismiss|vouch|unvouch)
            [[ -n "$who" ]] || { err "Usage: wyrd visitors $sub <username>"; return 2; }
            local resp
            resp=$(curl -sf -X POST -H 'Content-Type: application/json' -d "{\"username\": \"$who\"}" "$base/api/mcp/$sub") \
                || { err "The server refused or did not answer (is it running? does the account exist?)"; return 1; }
            printf '%s' "$resp" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("message") or d.get("error") or d)' 2>/dev/null || echo "$resp"
            ;;
        *) echo "Usage: wyrd visitors [list] | dismiss <username> | vouch <username> | unvouch <username>"; return 64 ;;
    esac
}

# Run a main class from core against this node's data, with the installed (or freshly
# built) jars on the classpath. Shared by `wyrd soul`; `wyrd state dump` predates it.
_run_core_main() {
    local main_class="$1"; shift
    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
            (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    [[ ! -d "$SERVER_LIB" ]] && { err "$(_t common.server_libs_missing "$SERVER_LIB")"; return 1; }
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
    if [[ "$MODE" == "source" ]]; then
        local CORE_CLS="$PROJECT_ROOT/core/build/classes/java/main"
        local COMMON_CLS="$PROJECT_ROOT/common/build/classes/java/main"
        [[ -d "$CORE_CLS" ]] && CP="$CORE_CLS:$CP"
        [[ -d "$COMMON_CLS" ]] && CP="$COMMON_CLS:$CP"
    fi
    "$JAVA_CMD" \
        -Djava.net.preferIPv4Stack=true \
        --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
        --add-opens java.base/java.lang=ALL-UNNAMED \
        --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
        -cp "$CP" \
        "$main_class" "$@"
}

# fragmentation that's invisible when each store is inspected in isolation.
do_state() {
    local sub="${1:-help}"
    case "$sub" in
        dump)
            shift
            local SERVER_LIB
            if [[ "$MODE" == "source" ]]; then
                if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
                    log "$(_t common.building_server_state_dump)"
                    (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                        || { err "$(_t common.build_failed)"; return 1; }
                fi
                SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
            else
                SERVER_LIB="$REAL_BIN/../lib/server"
                [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
            fi
            [[ ! -d "$SERVER_LIB" ]] && { err "$(_t common.server_libs_missing "$SERVER_LIB")"; return 1; }
            find_java || { err "$(_t common.java_missing)"; return 1; }
            local CP
            CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
            # Source-mode override: when the running server holds the
            # installDist guard locked, the installed jars may lag the
            # working tree. Prepend freshly compiled classes if present
            # so 'wyrd state dump' tracks the checkout. Harmless when
            # they don't exist (jars take precedence later in classpath
            # resolution if duplicate classes appear).
            if [[ "$MODE" == "source" ]]; then
                local CORE_CLS="$PROJECT_ROOT/core/build/classes/java/main"
                local COMMON_CLS="$PROJECT_ROOT/common/build/classes/java/main"
                [[ -d "$CORE_CLS" ]] && CP="$CORE_CLS:$CP"
                [[ -d "$COMMON_CLS" ]] && CP="$COMMON_CLS:$CP"
            fi
            "$JAVA_CMD" \
                -Djava.net.preferIPv4Stack=true \
                --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
                --add-opens java.base/java.lang=ALL-UNNAMED \
                --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
                -cp "$CP" \
                org.wyrdsekai.core.state.StateDumpMain "$@"
            ;;
        help|*)
            echo "$(_t state.help.title)"
            echo ""
            echo "$(_t state.help.subcommands_header)"
            echo "$(_t state.help.cmd_dump)"
            echo "$(_t state.help.cmd_dump_default)"
            echo "$(_t state.help.cmd_dump_summary)"
            echo "$(_t state.help.cmd_dump_out)"
            echo ""
            echo "$(_t state.help.walks_1)"
            echo "$(_t state.help.walks_2)"
            echo "$(_t state.help.walks_3)"
            ;;
    esac
}

# ── Embedding migration (re-embed all stored vectors on the bundled model) ──
#
# One-shot migration triggered manually after an embedding-model swap (e.g.
# multilingual upgrade). NEVER run
# automatically — operator runs it after reviewing --plan output.
#
# Resumable + idempotent + atomic per batch (100 rows). State lives in the
# `embedding_migrations` table inside world.db.
do_embed_migrate() {
    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
            log "$(_t common.building_server)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    if [[ ! -d "$SERVER_LIB" ]]; then
        err "$(_t common.server_libs_missing_hint "$SERVER_LIB")"
        return 1
    fi
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
    # Source-mode override: prefer freshly-compiled classes (mirrors do_state).
    if [[ "$MODE" == "source" ]]; then
        local CORE_CLS="$PROJECT_ROOT/core/build/classes/java/main"
        local COMMON_CLS="$PROJECT_ROOT/common/build/classes/java/main"
        [[ -d "$CORE_CLS" ]] && CP="$CORE_CLS:$CP"
        [[ -d "$COMMON_CLS" ]] && CP="$COMMON_CLS:$CP"
    fi
    "$JAVA_CMD" \
        -Djava.net.preferIPv4Stack=true \
        --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
        --add-opens java.base/java.lang=ALL-UNNAMED \
        --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
        --enable-native-access=ALL-UNNAMED \
        -cp "$CP" \
        org.wyrdsekai.core.embedding.EmbeddingMigrationMain "$@"
}

# ── Embedding-model registry CLI ──
#
# wyrd embedding-model status                  → current id/version/dim + install state
# wyrd embedding-model list                    → registry table
# wyrd embedding-model recommend               → host-RAM-driven suggestion
# wyrd embedding-model set <id>                → write ~/.wyrdsekai/embedding-model.txt
# wyrd embedding-model download <id>           → fetch ONNX + tokenizer from HuggingFace
# wyrd embedding-model current                 → script-friendly: just print active id
#
# `status`/`list`/`recommend`/`current` delegate to EmbeddingModelAdminMain
# (Java side owns the registry). `set` and `download` are bash-side because
# they're trivial filesystem ops that don't justify booting the JVM.
_embedding_model_classpath() {
    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
            log "$(_t common.building_server)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    [[ ! -d "$SERVER_LIB" ]] && { err "Server libs not found at $SERVER_LIB"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
    if [[ "$MODE" == "source" ]]; then
        local CORE_CLS="$PROJECT_ROOT/core/build/classes/java/main"
        local COMMON_CLS="$PROJECT_ROOT/common/build/classes/java/main"
        local CORE_RES="$PROJECT_ROOT/core/build/resources/main"
        [[ -d "$CORE_CLS" ]] && CP="$CORE_CLS:$CP"
        [[ -d "$COMMON_CLS" ]] && CP="$COMMON_CLS:$CP"
        # Resources (bundled ONNX, tokenizer.json, etc.) live under build/resources/main
        # and are NOT in classes/java/main. modelFilesPresent() depends on them.
        [[ -d "$CORE_RES" ]] && CP="$CORE_RES:$CP"
    fi
    echo "$CP"
}

_embedding_model_java() {
    local cp
    cp=$(_embedding_model_classpath) || return 1
    find_java || { err "$(_t common.java_missing)"; return 1; }
    "$JAVA_CMD" \
        -Djava.net.preferIPv4Stack=true \
        --add-opens java.base/java.lang.reflect=ALL-UNNAMED \
        --add-opens java.base/java.lang=ALL-UNNAMED \
        --enable-native-access=ALL-UNNAMED \
        -cp "$cp" \
        org.wyrdsekai.core.search.EmbeddingModelAdminMain "$@"
}

do_embedding_model() {
    local subcmd="${1:-help}"
    shift || true

    case "$subcmd" in
        status|list|recommend|current|help|-h|--help)
            _embedding_model_java "$subcmd" "$@"
            ;;
        path)
            _embedding_model_java path "$@"
            ;;
        set)
            local id="${1:-}"
            [[ -z "$id" ]] && { err "usage: wyrd embedding-model set <id>"; return 1; }
            # Validate id against the registry by asking the admin main.
            # Java prints to stderr on unknown id; capture both streams so the
            # operator sees a useful message.
            local meta
            if ! meta=$(_embedding_model_java path "$id" 2>&1); then
                err "$meta"
                return 1
            fi
            local current_id
            current_id=$(echo "$meta" | grep '^id=' | cut -d= -f2)
            if [[ -z "$current_id" ]]; then
                err "Unknown model id '$id'. Run \`wyrd embedding-model list\`."
                return 1
            fi
            local sel_dir="$HOME/.wyrdsekai"
            mkdir -p "$sel_dir"
            echo "$id" > "$sel_dir/embedding-model.txt"
            log "Active embedding model set to '$id'"
            info "Restart wyrdsekai for the new model to take effect:"
            info "  wyrd restart"
            info "Then re-embed stored vectors against the new model:"
            info "  wyrd embed-migrate --run"
            ;;
        download)
            local id="${1:-}"
            [[ -z "$id" ]] && { err "usage: wyrd embedding-model download <id>"; return 1; }
            local meta
            if ! meta=$(_embedding_model_java path "$id" 2>&1); then
                err "$meta"
                return 1
            fi
            local onnx_url tok_url onnx_target tok_target size
            onnx_url=$(echo "$meta" | grep '^onnx_url=' | cut -d= -f2-)
            tok_url=$(echo "$meta" | grep '^tokenizer_url=' | cut -d= -f2-)
            onnx_target=$(echo "$meta" | grep '^onnx_target=' | cut -d= -f2-)
            tok_target=$(echo "$meta" | grep '^tokenizer_target=' | cut -d= -f2-)
            size=$(echo "$meta" | grep '^approx_size_mb=' | cut -d= -f2-)
            if [[ -z "$onnx_url" ]]; then
                err "Model '$id' has no download URL configured (likely the bundled default)."
                return 1
            fi
            mkdir -p "$(dirname "$onnx_target")"
            log "Downloading $id ONNX (~${size}MB) → $onnx_target"
            if [[ -f "$onnx_target" ]]; then
                log "  ONNX already present — skipping"
            else
                # Prefer the models index. It pins a commit and carries a sha256,
                # so the bytes are verified and an HF outage still has a mirror.
                # The registry URL the Java side hands us names a MUTABLE branch
                # (/resolve/main/) and is verified by nothing, so it is the last
                # resort rather than the first — otherwise `wyrd setup --auto-yes`
                # silently installs whatever upstream happens to be serving today.
                local _mid="embedding-$id" _got=false
                if [[ -n "$(_index_urls "$_mid" 2>/dev/null)" ]]; then
                    _model_fetch "$_mid" "$onnx_target.part" "$onnx_url" && _got=true
                else
                    warn "$id is not in the models index — fetching UNVERIFIED from ${onnx_url#https://}"
                    _download "$onnx_url" "$onnx_target.part" && _got=true
                fi
                if $_got; then
                    mv "$onnx_target.part" "$onnx_target"
                    local _idxver; _idxver=$(_index_field "$_mid" version 2>/dev/null)
                    _model_record "$onnx_target" "$_mid" "${_idxver:-$id}" "${WYRD_FETCH_URL:-$onnx_url}"
                else
                    rm -f "$onnx_target.part"
                    err "ONNX download failed for $id (all mirrors)"; return 1
                fi
            fi
            log "Downloading $id tokenizer → $tok_target"
            if [[ -f "$tok_target" ]]; then
                log "  tokenizer already present — skipping"
            else
                # The ONNX is useless without its tokenizer, so a mirror for one
                # and not the other is not a fallback. Upstream first (same order
                # as the model), then the index's mirror.
                local _tokmirror; _tokmirror=$(_index_field "$_mid" tokenizer_url 2>/dev/null)
                if ! _download "$tok_url" "$tok_target"; then
                    rm -f "$tok_target"
                    if [[ -n "$_tokmirror" ]]; then
                        warn "tokenizer mirror unavailable: ${tok_url#https://}"
                        _download "$_tokmirror" "$tok_target" \
                            || { rm -f "$tok_target"; err "tokenizer download failed for $id (all mirrors)"; return 1; }
                    else
                        err "tokenizer download failed from $tok_url"; return 1
                    fi
                fi
            fi
            log "Done. To activate:"
            info "  wyrd embedding-model set $id"
            ;;
        *)
            err "Unknown subcommand: $subcmd"
            _embedding_model_java help
            return 1
            ;;
    esac
}

# ── Invites (headless invite minting — no steward cookie needed) ──
# Shells out to InviteAdminMain with server classpath. Why: the HTTP
# POST /api/auth/invite path requires a browser steward session; this
# gives ops a headless way to mint codes from the server host.
do_invite() {
    local SERVER_LIB
    if [[ "$MODE" == "source" ]]; then
        if [[ ! -d "$PROJECT_ROOT/server/build/install/server" ]]; then
            log "$(_t common.building_server)"
            (cd "$PROJECT_ROOT" && "$GRADLE" :server:installDist -q) \
                || { err "$(_t common.build_failed)"; return 1; }
        fi
        SERVER_LIB="$PROJECT_ROOT/server/build/install/server/lib"
    else
        SERVER_LIB="$REAL_BIN/../lib/server"
        [[ ! -d "$SERVER_LIB" ]] && SERVER_LIB="$REAL_BIN/../lib"
    fi
    if [[ ! -d "$SERVER_LIB" ]]; then
        err "$(_t common.server_libs_missing_hint "$SERVER_LIB")"
        return 1
    fi
    find_java || { err "$(_t common.java_missing)"; return 1; }
    local CP
    CP=$(echo "$SERVER_LIB"/*.jar | tr ' ' ':')
