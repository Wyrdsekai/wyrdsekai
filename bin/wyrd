    reset-zone) do_reset_zone "$2" ;;
    update)     do_update "$2" ;;
    doctor)     do_doctor ;;
    inference)  do_inference "${2:-help}" "${3:-}" ;;
    coding)     do_coding "${@:2}" ;;
    voice)      do_voice "${@:2}" ;;
    sleepwrite) do_sleepwrite "${@:2}" ;;
