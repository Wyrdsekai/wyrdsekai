{
  "manifest_version": 3,
  "name": "Wyrdsekai — Send to Study",
  "version": "0.1.0",
  "description": "Send browsing activity to your Wyrdsekai Study. The Oracle uses it to understand your interests and make predictions.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:7070/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
